package rendering

import "strings"
import "menata.app/internal/domain"

// RoleApplication is one Application a member can hold a role in, as the Members screens need it:
// its declared vocabulary plus the form field that carries it.
//
// It replaces appRoleOptions, a hardcoded []string{"", "approver", "submitter", "reviewer"} whose
// own comment already conceded it was "this slice's single-Application role vocabulary" -- true
// while one Application existed, wrong the moment a second did, since Project Management has no
// "approver". The vocabulary now comes from each Application's own roles: declaration
// (domain.Application.Roles), built by internal/web.roleApplications.
//
// Applications declaring no roles never appear here at all, so these screens never render an
// empty dropdown or borrow another Application's words.
type RoleApplication struct {
	ID    string
	Name  string
	Field string
	Roles []string
}

// personInitials is the avatar glyph for a member row: built from the person's real name when the
// runtime knows one, and from their email's local part when it does not (an invitation that has
// not been accepted has no name yet, by design -- only its owner ever states it).
//
// It duplicates what composition.Initials does, on purpose: internal/rendering cannot import
// internal/composition (composition already imports rendering), and threading a per-member
// initials slice through the handler for one avatar would be a worse trade than the lines here.
//
// This replaced an email-only memberInitials on 2026-09-22, whose own comment had been waiting for
// exactly this ("When Fase 3 gives a member a real display name, both callers should take it from
// there instead") -- the name arrived from the identity rather than from Fase 3, but it arrived.
func personInitials(name, email string) string {
	source, sep := name, func(r rune) bool { return r == ' ' }
	if strings.TrimSpace(name) == "" {
		source, _, _ = strings.Cut(email, "@")
		sep = func(r rune) bool { return r == '.' || r == '_' || r == '-' || r == '+' }
	}
	parts := strings.FieldsFunc(source, sep)
	switch {
	case len(parts) == 0:
		return "?"
	case len(parts) == 1:
		return strings.ToUpper(parts[0][:1])
	default:
		return strings.ToUpper(parts[0][:1] + parts[1][:1])
	}
}

// workspaceRoleBadge is a member's or an invitation's Workspace role: admin in the info tone, any other
// role neutral. An invitation carries the role it will become on acceptance (data.PendingInvite).
templ workspaceRoleBadge(role string) {
	if role == "admin" {
		@statusBadge(role, domain.ToneInfo, domain.BadgeRegular)
	} else {
		@statusBadge(displayRole(role), domain.ToneNeutral, domain.BadgeRegular)
	}
}

// roleSelect is one Application's role dropdown, shared by Invite and Edit member. "" is offered
// first and means no role in this Application -- stored as the absence of a row, not as a blank
// value (internal/data.SetMemberAppRole).
templ roleSelect(id string, app RoleApplication, selected string) {
	<select
		id={ id }
		name={ app.Field }
		class={ "h-10.5", radiusClass(ctx, domain.RadiusControl), "border", borderClass(ctx, domain.BorderControl), backgroundClass(ctx, domain.BackgroundRaised) + " px-3 text-[15px] sm:h-9.5 sm:w-56 sm:text-sm" }
	>
		<option value="" selected?={ selected == "" }>No access</option>
		for _, r := range app.Roles {
			<option value={ r } selected?={ r == selected }>{ r }</option>
		}
	</select>
}

// avatarLabel is an avatar's accessible name: the person's own name when known, their email otherwise.
//
// It exists because `domain.ComponentAvatar`'s contract declares `label` *required* -- the initials are not a
// name -- and two of the four sites have both a name and an email while two have only an email. Resolving the
// fallback here rather than inside the Component keeps the Component bounded: it is handed a string and does
// not decide what a person is called.
func avatarLabel(name, email string) string {
	if strings.TrimSpace(name) != "" {
		return name
	}
	return email
}
