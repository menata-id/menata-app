package rendering

import (
	"fmt"
	"time"

	"menata.app/internal/domain"
)

// SnapshotRow is one saved installation of this Workspace as the Settings hub lists it. The handler maps
// installer.Snapshot onto it (rendering may not import the installer); ID is what the restore form posts back.
type SnapshotRow struct {
	ID      string
	TakenAt time.Time
	Size    int64
}

func snapshotLabel(r SnapshotRow) string {
	return fmt.Sprintf("%s UTC · %d KB", r.TakenAt.UTC().Format("2006-01-02 15:04:05"), (r.Size+1023)/1024)
}

// WorkspaceSettingsPage is the Workspace-level Settings hub (Flow 2 gap study Tahap 5,
// 2026-09-25, M04a-Settings.dc.html) -- Application Settings hub's Workspace-level counterpart
// (appsettings.templ's ApplicationSettingsPage), and considerably simpler: there is no per-viewer
// derivation here (the route itself is requireWorkspaceAdmin-gated, so every viewer who reaches
// this page sees the identical rows) and no detail sub-route -- every real row here already has
// its own full screen elsewhere (Workspace Home, Workspace Members); this page only indexes them.
//
// Real vs. placeholder, row by row, checked against the mockup rather than assumed:
//   - General: placeholder. domain.Workspace has no logo/time zone/language field, and no UI
//     renames one after creation.
//   - Applications: real -- nav_home's own Title/Description ("Applications" / "The applications
//     you can open here, based on the roles assigned to you.") already say exactly what this row's
//     mockup copy asks for, reused rather than retyped.
//   - Members / Invitations: both real, and both resolve to the *same* route
//     (nav_workspace_members) -- internal/web.showWorkspaceMembers already renders two lists on
//     one page (members, and invitations not yet accepted; ROADMAP.md 2026-09-22, "an invitation
//     is not a membership"), so two mockup rows sharing one physical destination is the identical
//     shape nav_my_documents/nav_assigned_to_me already established for the Approval Inbox.
//   - Authentication, Audit log: placeholder. Neither exists in any form -- ROADMAP.md's own Flow 2
//     gap-study entry names a workspace audit log as a wholly new concept, and internal/web's
//     /activity feed is a different thing (a running feed for any member, owned by Project
//     Management's own navigation, not an admin-only permanent record) -- reusing it here would
//     overstate what it does.
//   - Danger zone: half real, half placeholder, since Tahap 7 shipped only one of its two named
//     actions. Archive is real (submitArchiveWorkspace, internal/web/workspacesettings.go) --
//     confirmed with hx-confirm, matching this app's existing destructive-action convention
//     (the generic delete button's "Delete this record?", reviseDocument's own confirm) rather than
//     inventing a type-the-name confirmation the mockup doesn't show either. Restoring an archived
//     Workspace happens from *outside* it (Choose Workspace's own archived list), never from this
//     page -- see internal/web.restoreWorkspaceIfAdmin's own doc comment. Transfer ownership stays
//     a settingsPlaceholderRow: the owner's own scope decision (2026-09-26) was Archive/Restore
//     only, since there is no singular Workspace Owner concept today to transfer and no second real
//     case forcing one yet (ROADMAP.md's Tahap 7 entry has the full reasoning).
// Workspace settings sections, named once so the hub's rows and the sidebar the admin screens share cannot
// word the same section two ways. General, Authentication and Audit log have no page (see the hub's comment),
// which is why the sidebar draws them as settingsPlaceholderRow rather than hiding them: M04a shows them.
const (
	wsGeneralTitle       = "General"
	wsGeneralBlurb       = "Name, logo, time zone and language."
	wsInvitationsTitle   = "Invitations"
	wsInvitationsBlurb   = "Pending and expired invitations."
	wsAuthTitle          = "Authentication"
	wsAuthBlurb          = "Two-step verification, allowed email domains."
	wsAuditTitle         = "Audit log"
	wsAuditBlurb         = "Permanent record of changes."
	wsDangerTitle        = "Danger zone"
	wsSectionMembers     = "members"
	wsSectionGroups      = "groups"
	wsDangerZoneAnchorID = "danger-zone"

	wsInstallationAnchorID = "installation"
	wsInstallationTitle    = "Installation"
	wsReloadLabel          = "Reload from disk"
	wsReloadBlurb          = "Re-read this workspace's files after editing them by hand. A file that does not load changes nothing."
	wsSnapshotsTitle       = "Saved installations"
	wsSnapshotsBlurb       = "Taken before each install, publish or restore. Restoring saves the current one first, so it can be undone."
	wsSnapshotsEmpty       = "No saved installations yet."
	wsRestoreLabel         = "Restore"
	wsRestoreConfirm       = "Restore this saved installation? The current one is saved first."
)

// workspaceSettingsFrame puts a sidebar of the Workspace's settings sections beside an admin screen (S2.3;
// boards 04/05). Desktop only: below `sm` the aside is hidden and the hub (WorkspaceSettingsPage) is the
// list, the same split ApplicationSettingsPage makes. The screens inside it keep their own headings, so
// the frame adds navigation and nothing else.
//
// Every destination is a navigation item looked up by id. "Applications" is nav_home until S3.2 gives it a
// page of its own (boards 04b/04c), and "Invitations" shares Members' route because one page lists both
// (an invitation is not a membership, but it is drawn beside one).
templ workspaceSettingsFrame(active string) {
	@columnsLayout(domain.GapLoose, domain.ColumnsAlignStart) {
		<aside class="hidden w-55 shrink-0 flex-col gap-5 sm:flex" aria-label={ labelByID(ctx, "nav_workspace_settings") }>
			<div class="flex flex-col gap-0.5">
				<a href={ templ.SafeURL(routeByID(ctx, "nav_workspace_settings")) } class="px-3 pb-1 text-xs text-blue-600 hover:text-blue-800">← { labelByID(ctx, "nav_workspace_settings") }</a>
				@settingsPlaceholderRow(wsGeneralTitle, wsGeneralBlurb)
				@settingsRow(routeByID(ctx, "nav_home"), titleByID(ctx, "nav_home"), "", false)
				@settingsRow(routeByID(ctx, "nav_workspace_members"), labelByID(ctx, "nav_workspace_members"), "", active == wsSectionMembers)
				@settingsRow(routeByID(ctx, "nav_workspace_groups"), labelByID(ctx, "nav_workspace_groups"), "", active == wsSectionGroups)
				@settingsRow(routeByID(ctx, "nav_workspace_members"), wsInvitationsTitle, "", false)
				@settingsPlaceholderRow(wsAuthTitle, wsAuthBlurb)
				@settingsPlaceholderRow(wsAuditTitle, wsAuditBlurb)
				@settingsRow(routeByID(ctx, "nav_workspace_settings")+"#"+wsDangerZoneAnchorID, wsDangerTitle, "", false)
			</div>
		</aside>
		<div class="flex min-w-0 flex-1 flex-col gap-4">
			{ children... }
		</div>
	}
}

templ WorkspaceSettingsPage(workspaceName string, viewer Viewer, switchWorkspaceHref string, snapshots []SnapshotRow) {
	@appShell(titleByID(ctx, "nav_workspace_settings"), workspaceName, viewer, switchWorkspaceHref) {
		<div class="flex flex-col gap-1">
			@staticText(domain.StaticHeading, titleByID(ctx, "nav_workspace_settings"))
			<p class="m-0 text-sm leading-6 text-slate-500">{ descriptionByID(ctx, "nav_workspace_settings") }</p>
		</div>
		<div class="flex max-w-md flex-col gap-4">
			<div class="flex flex-col gap-0.5">
				<h2 class="px-3 pb-1 text-3xs font-medium tracking-wide text-slate-400 uppercase">Workspace</h2>
				@settingsPlaceholderRow(wsGeneralTitle, wsGeneralBlurb)
				@settingsRow(routeByID(ctx, "nav_home"), titleByID(ctx, "nav_home"), descriptionByID(ctx, "nav_home"), false)
			</div>
			<div class="flex flex-col gap-0.5">
				<h2 class="px-3 pb-1 text-3xs font-medium tracking-wide text-slate-400 uppercase">People</h2>
				@settingsRow(routeByID(ctx, "nav_workspace_members"), labelByID(ctx, "nav_workspace_members"), "Workspace role and application access.", false)
				@settingsRow(routeByID(ctx, "nav_workspace_members"), wsInvitationsTitle, wsInvitationsBlurb, false)
			</div>
			<div class="flex flex-col gap-0.5">
				<h2 class="px-3 pb-1 text-3xs font-medium tracking-wide text-slate-400 uppercase">Security</h2>
				@settingsPlaceholderRow(wsAuthTitle, wsAuthBlurb)
				@settingsPlaceholderRow(wsAuditTitle, wsAuditBlurb)
			</div>
			<div id={ wsInstallationAnchorID } class="flex flex-col gap-2">
				<h2 class="px-3 pb-1 text-3xs font-medium tracking-wide text-slate-400 uppercase">{ wsInstallationTitle }</h2>
				<form method="POST" action="/reload-workspace" class="flex flex-col gap-2 px-3">
					@csrfHiddenInput()
					@staticText(domain.StaticCaption, wsReloadBlurb)
					<div>
						@button(wsReloadLabel, domain.ButtonSecondary, "", "")
					</div>
				</form>
				<div class="flex flex-col gap-2 px-3">
					@staticText(domain.StaticSubheading, wsSnapshotsTitle)
					if len(snapshots) == 0 {
						@staticText(domain.StaticCaption, wsSnapshotsEmpty)
					} else {
						@staticText(domain.StaticCaption, wsSnapshotsBlurb)
						<ul class="m-0 flex list-none flex-col p-0">
							for _, snap := range snapshots {
								<li class={ "flex items-center justify-between gap-3 border-b py-2 last:border-b-0", borderClass(ctx, domain.BorderDivider) }>
									<span class="text-sm text-slate-700">{ snapshotLabel(snap) }</span>
									<form method="POST" action="/restore-workspace-snapshot" hx-confirm={ wsRestoreConfirm }>
										@csrfHiddenInput()
										@button(wsRestoreLabel, domain.ButtonSecondary, "snapshot", snap.ID)
									</form>
								</li>
							}
						</ul>
					}
				</div>
			</div>
			<div id={ wsDangerZoneAnchorID } class="flex flex-col gap-0.5 rounded-lg border border-red-200">
				<h2 class="px-3 pt-2 pb-1 text-3xs font-medium tracking-wide text-red-400 uppercase">{ wsDangerTitle }</h2>
				@settingsPlaceholderRow("Transfer ownership", "No single Workspace Owner exists yet to transfer.")
				<form method="POST" action="/workspace-settings/archive" hx-confirm="Archive this workspace? It becomes read-only and hidden from members until an admin restores it.">
					@csrfHiddenInput()
					<button type="submit" class="flex w-full cursor-pointer items-start gap-3 rounded-md p-3 text-left hover:bg-red-50">
						<span class="flex min-w-0 grow flex-col gap-0.5">
							<span class="text-sm font-medium text-red-700">Archive workspace</span>
							<span class="text-xs text-slate-500">Read-only and hidden from members until restored.</span>
						</span>
					</button>
				</form>
			</div>
		</div>
	}
}
