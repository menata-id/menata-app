package rendering

import "menata.app/internal/domain"

// settingsGroupHeading names one group of rows in a NavList (the settings sidebar and hub; boards 04, M04a). The rows and
// their headings are the runtime screens' own (domain.RuntimeScreens: SettingsSection, SettingsGroup), so nothing here words
// a section.
templ settingsGroupHeading(text string) {
	<h2 class={ "m-0 px-3 pb-1", textClass(ctx, domain.RoleEyebrow), weightClass(ctx, domain.WeightEmphasis), "tracking-wide", inkClass(ctx, domain.InkSecondary), "uppercase" }>{ text }</h2>
}
