package rendering

import (
	"fmt"
	"net/url"
	"time"

	"menata.app/internal/experience"
)

// TabMine and TabAssigned are two of the Approval Inbox's three ?tab= destinations (the third,
// Pending, is the route with no ?tab= at all). Declared here rather than only inline in
// internal/web.showApprovalInbox because this Page switches on the identical values to decide
// its own heading and body -- two independent string literals that happened to agree is exactly
// the drift a shared metadata-derived value exists to prevent elsewhere in this app, so the
// handler reads these instead of retyping "mine"/"assigned".
const (
	TabMine     = "mine"
	TabAssigned = "assigned"
)

// FilterChip is one query-param chip on the Approval Inbox's own two tabs that carry filters:
// the Inbox's SLA chips (board 07's "All / Overdue / Due today") and, since 2026-09-24, Assigned
// to me's decision chips ("All / Waiting for me / Not yet my turn / Approved by me / Rejected by
// me", board 07b). Plain data -- no Href -- on purpose: internal/web may not hold a literal route
// string metadata already declares (TestHandlersHaveNoHardcodedApplicationRoute), so the handler
// cannot build this chip's link, and filterChip below resolves it from ctx via routeByID instead,
// the same as every other in-page link this package renders.
type FilterChip struct {
	Key    string
	Label  string
	Count  int
	Active bool
}

// StepApprover is one approver on a pending card: who they are and where their step stands.
//
// Board 07 draws the approvers by name with each one's own state, which the previous
// `StepStates []string` could not express -- it carried the states and nothing to attach them to.
// Composed in internal/composition.stepStates from the names map buildInbox already assembles, so
// this costs no extra query.
//
// Fase 6b made it the *shared* step view model rather than the inbox card's own: board 10's
// Approval Progress list (reviewdocument.templ) renders the same slice. Sharing the data and not
// the markup is deliberate -- approvalstepper.templ still draws this concept for the Document
// detail page in pageStyles, and Tailwind's Preflight ties chrome to content, so one rendering
// cannot serve both until that page ports too.
type StepApprover struct {
	Name     string
	Initials string
	// State is done / current / rejected / waiting -- the same four
	// approvalStepRow renders on the Document detail page's vertical stepper.
	State string
	// Label is what this step is for -- mch_approval_step's own fld_step_name, falling back to
	// Name while that Field is empty (nothing writes it until board 08's wizard, Fase 6c). Board 07
	// does not show it; board 10 titles each step with it.
	Label string
	// Decided is when this step was approved or rejected, formatted "15:04" -- empty for a step
	// that has not been decided. Board 10 draws it beside the approver's name.
	Decided string
	// IsYou marks the step belonging to the viewer, which board 10 badges with a "You" pill. The
	// inbox card has no use for it: every card there is already the viewer's own.
	IsYou bool
}

// PendingApprovalCard is one "pending my approval" card (board 07's own grid). Richer than the
// shared recordSummaryCard/SummaryCard: SLA framing, a "Submitted by / date" line, the approver
// list and a progress bar, none of which any other screen needs -- so this stays an Approval
// Inbox-specific shape rather than a field added to SummaryCard.
type PendingApprovalCard struct {
	Reference    string
	Title        string
	DocumentType string
	// Mode is the Document's own fld_mode value (sequential/parallel) -- the older
	// document-approval.html mockup showed a fabricated "ALL"/"ANY" quorum label that no Field in
	// metadata/document.yaml models, so this renders the real Mode instead of inventing one.
	Mode        string
	Approved    int
	TotalSteps  int
	Submitter   string
	SubmittedAt string // formatted "2 Jan 2006"; empty if no submission event was found
	SLADue      any
	// Approvers is every step's approver and state, ordered by fld_sequence.
	Approvers []StepApprover
	Href      string
	// CardFields is mch_approval_step's own card_fields (007 §7.6 Projection), resolved by
	// composition.ProjectCardFields. Still empty: mch_approval_step declares none, so this branch
	// has never been taken. Fase 5 gave Projection its first real consumer on mch_document's
	// `cards` View, not here -- see menata-app-document's own correction of the "one-screen pilot"
	// claim. Kept because the wiring is real and the declaration is a metadata edit away.
	CardFields []ProjectedField
}

// AssignedRow is one row on the Assigned to me screen (board 07b): one Approval Step that has
// ever named this viewer, and where its decision stands. composition.AssignedToMe is the only
// writer -- see its own doc comment for why this is bespoke Go rather than a declared filter.
type AssignedRow struct {
	Reference    string
	Title        string
	DocumentType string
	From         string
	// RequestedAt is already formatted ("17 Sep 2026"), or "" when no submission event was found
	// -- the same degrade-rather-than-guess posture PendingApprovalCard.SubmittedAt already takes.
	RequestedAt string
	// Status is the Document's own fld_status, raw ("in_review"/"approved"/"rejected"), rendered
	// through reviewStatusPill (reviewdocument.templ) -- the same component board 10 uses, so a
	// Document's status reads identically wherever this app shows it.
	Status string
	// DecisionKey is one of composition.Assigned{Waiting,NotYet,Approved,Rejected} -- what the
	// filter chips and assignedDecisionPill both key on.
	DecisionKey   string
	DecisionLabel string
	Href          string
}

// ApprovalInboxPage is Case 3's worklist, ported to ui-sample/case-03-flow1/07-approval-inbox.html
// (Fase 6a, 2026-09-20), and since 2026-09-24 the same page's third tab, Assigned to me
// (board 07b).
//
// ONE BOARD ELEMENT IS DELIBERATELY NOT RENDERED. Board 07 shows "SLA breached · 4h" and "8h
// remaining"; this renders day-scale wording. That is not a formatting choice: mch_document's
// fld_due_date is `type: date`, stored as a bare calendar date with no time component, and
// domain.KnownFieldTypes has no datetime type at all. experience.EvaluateSLA truncates to day
// deliberately -- that is what makes "Due today" meaningful. Hour precision would need a new Field
// type built to satisfy one label, which is the shape-before-need this repo refuses. Same class as
// board 03's Procurement/HR cards and board 06's ProcessEdge: the board draws something the app
// has no data for. Recorded in ROADMAP.md's deferral table with that as its real blocker.
templ ApprovalInboxPage(filters []FilterChip, pending []PendingApprovalCard, mine []PendingApprovalCard, assigned []AssignedRow, assignedFilters []FilterChip, tab string, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	// The "Approval Inbox" / "My Documents" / "Assigned to me" section strip used to be this
	// Page's own nav here (inboxTabs, deleted with this change): appShell now renders the current
	// Application's own menu itself -- a second header row on desktop, a bottom bar on mobile --
	// generalized from this exact shape to every Application (appshell.templ's
	// defaultAppMenu/navItemActive).
	@appShell(labelByID(ctx, "nav_approval_inbox"), workspaceName, viewer, switchWorkspaceHref) {
		// Which of this screen's three declared destinations is being rendered -- all three are
		// ?tab= views of one route (document-approval.yaml's own comment on nav_my_documents), so
		// the heading and its subtitle come from whichever item the request names, not from a
		// branch of literals.
		//
		// The "APPROVAL" eyebrow that sat above this heading is gone (2026-09-24): board 07 has no
		// eyebrow, and it was a hardcoded word naming the Application on a screen whose chrome now
		// names it two rows up (appshell.templ's applicationMenuRow).
		{{ navID := "nav_approval_inbox" }}
		switch tab {
			case TabMine:
				{{ navID = "nav_my_documents" }}
			case TabAssigned:
				{{ navID = "nav_assigned_to_me" }}
		}
		<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div class="flex flex-col gap-2">
				<h1 class="m-0 text-xl font-medium">{ titleByID(ctx, navID) }</h1>
				if desc := descriptionByID(ctx, navID); desc != "" {
					<div class="text-sm text-slate-500">{ desc }</div>
				}
			</div>
			// "+ New Document" is Pending/My Documents' own call to action -- Assigned to me is a
			// worklist over decisions other people's documents asked of this viewer, not a place
			// to start one, so board 07b carries no such button and neither does this.
			//
			// METADATA CANNOT EXPRESS THIS YET, and the exception is deliberate (CLAUDE.md, "Deciding
			// whether a literal is a metadata-hardcoding violation", step 2). nav_new_approval was
			// deleted from metadata on 2026-09-21: the submit form is not a menu destination, it is
			// this screen's own call to action -- the same category as the Review screen, whose route
			// internal/composition has always built as a literal because no navigation item names it.
			// What is missing is a way for a Page to declare its own primary action (007 §12.3's
			// ActionBar component, still unbuilt; ROADMAP.md Fase 6's bespoke-screen note). Until
			// then the route and the label are literals here. Listed in writing-guide.md's "What
			// comes free vs. what's hardcoded today" table.
			if tab != TabAssigned {
				<a
					href="/documents/new"
					class={ controlPrimary }
				>
					+ New Document
				</a>
			}
		</div>
		switch tab {
			case TabMine:
				if len(mine) == 0 {
					@inboxEmpty("You haven't submitted any documents yet.")
				} else {
					@pendingApprovalCardGrid(mine)
				}
			case TabAssigned:
				{{ assignedChipPrefix := routeByID(ctx, "nav_assigned_to_me") + "&status=" }}
				<div role="group" aria-label="Filter" class="flex flex-wrap gap-2">
					for _, f := range assignedFilters {
						@filterChip(f, assignedChipPrefix)
					}
				</div>
				if len(assigned) == 0 {
					@inboxEmpty("No document has asked for your approval yet.")
				} else {
					@assignedTable(assigned)
				}
			default:
				{{ inboxChipPrefix := routeByID(ctx, "nav_approval_inbox") + "?filter=" }}
				<div role="group" aria-label="Filter" class="flex flex-wrap gap-2">
					for _, f := range filters {
						@filterChip(f, inboxChipPrefix)
					}
				</div>
				if len(pending) == 0 {
					@inboxEmpty("Nothing pending your approval.")
				} else {
					@pendingApprovalCardGrid(pending)
				}
		}
	}
}

// assignedTable is board 07b's own table: DOCUMENT / FROM / REQUESTED / YOUR DECISION / STATUS /
// Action. The same responsive flex-row construction workspacemembers.templ's member list already
// uses (a header row hidden below `sm`, each field labelled inline on a phone) rather than a third
// table idiom -- this screen's rows are exactly as tabular as that one's.
templ assignedTable(rows []AssignedRow) {
	<div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
		<div class="hidden items-center gap-4 border-b border-slate-200 bg-slate-50 px-4 py-2.5 text-xs text-slate-600 sm:flex">
			<span class="grow">Document</span>
			<span class="w-32">From</span>
			<span class="w-28">Requested</span>
			<span class="w-56">Your decision</span>
			<span class="w-24">Status</span>
			<span class="w-14"></span>
		</div>
		for _, r := range rows {
			<div class="flex flex-col gap-2 border-b border-slate-100 px-4 py-3 last:border-b-0 sm:flex-row sm:items-center sm:gap-4">
				<div class="flex min-w-0 grow flex-col gap-0.5">
					<span class="truncate text-sm font-medium text-slate-900">{ r.Title }</span>
					<span class="truncate text-2xs text-slate-400">{ r.Reference } · { r.DocumentType }</span>
				</div>
				<div class="text-xs text-slate-600 sm:w-32">{ r.From }</div>
				<div class="text-xs text-slate-500 sm:w-28">
					if r.RequestedAt != "" {
						{ r.RequestedAt }
					} else {
						—
					}
				</div>
				<div class="sm:w-56">
					@assignedDecisionLabel(r.DecisionKey, r.DecisionLabel)
				</div>
				<div class="sm:w-24">
					@reviewStatusPill(r.Status)
				</div>
				<div class="sm:w-14">
					<a href={ templ.SafeURL(r.Href) } class="text-sm text-blue-600 hover:text-blue-700">View</a>
				</div>
			</div>
		}
	</div>
}

// assignedDecisionLabel colours the YOUR DECISION column by composition.Assigned{Waiting,...}:
// waiting is the one state that asks the viewer to act, so it is the one state drawn in a colour
// that reads as an alert rather than a status report.
templ assignedDecisionLabel(key, label string) {
	<span
		class={ "text-xs",
			templ.KV("font-medium text-blue-700", key == "waiting"),
			templ.KV("text-slate-500", key != "waiting") }
	>
		{ label }
	</span>
}

// pendingApprovalCardGrid draws one card face for both of this screen's lists. Extracted when the
// owner asked for My Documents to look like the Inbox (2026-09-21) -- the second caller is what
// earned it a name, rather than the grid classes being written twice.
templ pendingApprovalCardGrid(cards []PendingApprovalCard) {
	<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
		for _, c := range cards {
			@pendingApprovalCard(c)
		}
	</div>
}

templ inboxEmpty(message string) {
	<div class="rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500">
		{ message }
	</div>
}

// filterChip is one SLA filter chip. It preserves the active tab for the same reason the tabs
// preserve the active filter -- neither may silently discard the other.
// hrefPrefix is everything before the chip's own key: a declared nav route plus the query
// separator and param name for that tab's own filter ("?filter=" on the Inbox's own route, which
// carries no query of its own yet; "&status=" on Assigned's, whose route already carries
// "?tab=assigned" and must keep it).
templ filterChip(f FilterChip, hrefPrefix string) {
	<a
		href={ templ.SafeURL(hrefPrefix + url.QueryEscape(f.Key)) }
		class={ "rounded-full border px-3 py-1 text-xs",
			templ.KV("border-slate-900 bg-slate-900 text-white", f.Active),
			templ.KV("border-slate-300 text-slate-600 hover:border-slate-400", !f.Active) }
	>
		{ f.Label } ({ fmt.Sprint(f.Count) })
	</a>
}

// pendingApprovalCard renders one PendingApprovalCard -- board 07's own grid card. A plain
// navigation to the step's own detail page (2026-09-19: dropped the hx-get/hx-target inline swap
// this used to layer on top -- a worklist click opens the record's page, not a pane below).
//
// Page-internal on purpose: capabilities.md records it as cataloged-but-not-yet-reused, which is
// the honest state until a second, genuinely different screen needs the identical shape.
templ pendingApprovalCard(c PendingApprovalCard) {
	{{ status, label := parseSLA(c.SLADue) }}
	<a
		href={ templ.SafeURL(c.Href) }
		class={ "flex flex-col gap-3 rounded-lg border bg-white p-5 text-slate-900 hover:border-blue-300",
			templ.KV("border-red-200", status == experience.SLAOverdue),
			templ.KV("border-slate-200", status != experience.SLAOverdue) }
	>
		if label != "" {
			<span
				class={ "self-start rounded-full px-2 py-0.5 text-3xs font-semibold tracking-wide uppercase",
					templ.KV("bg-red-50 text-red-700", status == experience.SLAOverdue),
					templ.KV("bg-amber-50 text-amber-700", status != experience.SLAOverdue) }
			>
				{ label }
			</span>
		}
		<div class="flex flex-col gap-1">
			<h2 class="m-0 text-[15px] font-medium">{ c.Title }</h2>
			<p class="m-0 text-2xs text-slate-400">{ c.Reference } · { c.DocumentType }</p>
		</div>
		// Omitted entirely when there is no submitter to name, which is what My Documents passes:
		// every card there was submitted by the viewer, so the line would read "Submitted by you"
		// on every one of them (composition.Inbox.Mine).
		if c.Submitter != "" {
			<p class="m-0 text-xs text-slate-500">
				Submitted by <span class="text-slate-700">{ c.Submitter }</span>
				if c.SubmittedAt != "" {
					{ " · " + c.SubmittedAt }
				}
			</p>
		}
		if len(c.Approvers) > 0 {
			<ul aria-label="Approvers" class="m-0 flex list-none flex-wrap gap-2 p-0">
				for _, a := range c.Approvers {
					@approverChip(a)
				}
			</ul>
		}
		@approvalProgress(c.Approved, c.TotalSteps)
		if len(c.CardFields) > 0 {
			<div class="flex flex-wrap gap-1.5">
				for _, f := range c.CardFields {
					@projectedFieldValue(f)
				}
			</div>
		}
	</a>
}

// approverChip is one approver on the card, labelled for a screen reader with their own state --
// board 07 gives each list item an aria-label saying exactly that.
templ approverChip(a StepApprover) {
	<li
		aria-label={ a.Name + ", " + approverStateLabel(a.State) }
		class={ "flex items-center gap-1.5 rounded-full py-0.5 pr-2.5 pl-0.5 text-2xs",
			templ.KV("bg-emerald-50 text-emerald-700", a.State == "done"),
			templ.KV("bg-blue-50 text-blue-700", a.State == "current"),
			templ.KV("bg-red-50 text-red-700", a.State == "rejected"),
			templ.KV("bg-slate-100 text-slate-500", a.State == "waiting") }
	>
		<span class="flex size-5 items-center justify-center rounded-full bg-white/70 text-3xs font-medium">
			if a.Initials != "" {
				{ a.Initials }
			} else {
				?
			}
		</span>
		if a.Name != "" {
			{ a.Name }
		} else {
			Unassigned
		}
	</li>
}

// approverStateLabel is the screen-reader wording for a step's state. Separate from the visual
// styling above so the two cannot drift.
func approverStateLabel(state string) string {
	switch state {
	case "done":
		return "approved"
	case "current":
		return "waiting for decision"
	case "rejected":
		return "rejected"
	default:
		return "not yet"
	}
}

// approvalProgress is board 07's progress bar. role="progressbar" with an aria-valuetext saying
// "N of M approved" -- the count in words, because a percentage alone tells a screen-reader user
// nothing about how many approvals remain.
templ approvalProgress(approved, total int) {
	<div class="flex items-center gap-2">
		<div
			role="progressbar"
			aria-label="Approval progress"
			aria-valuenow={ fmt.Sprint(progressPercent(approved, total)) }
			aria-valuemin="0"
			aria-valuemax="100"
			aria-valuetext={ fmt.Sprintf("%d of %d approved", approved, total) }
			class="h-1.5 grow overflow-hidden rounded-full bg-slate-100"
		>
			<div class="h-full rounded-full bg-emerald-500" style={ progressWidth(approved, total) }></div>
		</div>
		<span class="text-2xs whitespace-nowrap text-slate-400">{ fmt.Sprintf("%d of %d approved", approved, total) }</span>
	</div>
}

func progressPercent(approved, total int) int {
	if total <= 0 {
		return 0
	}
	return approved * 100 / total
}

// progressWidth is an inline style rather than a Tailwind class because the value is computed per
// record: a class name built at runtime is invisible to Tailwind's scanner and would silently
// never reach app.css (capabilities.md, "two scanner rules").
func progressWidth(approved, total int) string {
	return fmt.Sprintf("width:%d%%", progressPercent(approved, total))
}

// parseSLA turns a Document's own fld_due_date into a status and label, tolerating an unset or
// unparseable value (the card simply shows no SLA line). Day-scale by construction -- see
// ApprovalInboxPage's own note on why board 07's hour wording is not implementable.
func parseSLA(due any) (experience.SLAStatus, string) {
	s := fmt.Sprint(due)
	if s == "" || s == "<nil>" {
		return experience.SLAOK, ""
	}
	t, err := time.Parse("2006-01-02", s)
	if err != nil {
		return experience.SLAOK, ""
	}
	return experience.EvaluateSLA(t, time.Now())
}
