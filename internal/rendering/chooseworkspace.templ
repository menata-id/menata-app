package rendering

import "fmt"

// WorkspaceChoice is one row on the Choose Workspace screen: a Workspace this identity belongs to,
// and the Workspace-level role it holds there.
//
// Archived/ArchivedAt (Flow 2 gap study Tahap 7) split the list in two: a live row renders exactly
// as before, and an archived one only ever appears when Role is also "admin" -- an archived
// Workspace is hidden from an ordinary member entirely (WorkspaceArchived.dc.html's own "hidden
// from members"), so a non-admin archived membership is simply never turned into a row a plain
// member would recognize as unusual. ArchivedAt is pre-formatted ("12 Jul 2026") by the caller
// (internal/web.loadWorkspaceChoices), not raw, the same convention every other display date in
// this app already follows.
type WorkspaceChoice struct {
	ID         string
	Name       string
	Role       string
	Archived   bool
	ArchivedAt string
}

// ChooseWorkspacePage lists the Workspaces a signed-in identity belongs to, posting the pick to
// action. Two callers share it: the login-time flow (ROADMAP.md Phase 21 Step 4, shown only when
// an identity belongs to more than one Workspace -- a single-Workspace identity skips straight
// past it) at action="/choose-workspace", and the mid-session switcher at
// action="/switch-workspace" (the Workspace Home eyebrow's switch icon, matching
// ui-sample/workspace-home.html's own three-dot affordance). backHref/backLabel differ the same
// way: "back to signing in" pre-session, "back to the Workspace" mid-session.
//
// Ported to ui-sample/case-03-flow1/02-choose-workspace.html (Fase 1, 2026-09-20). The board's
// own rows carry a second line ("dokter-kecil · 24 members") that this app cannot fill yet: a
// Workspace has no slug and no member count on domain.Workspace, and inventing either here would
// be exactly the hardcoding CLAUDE.md's decision path rules out. The row therefore renders name +
// role only, and the slug/count line arrives when those become real fields (ROADMAP.md, Fase 3 --
// multi-application, which is when Workspace metadata grows anyway).
//
// The "admin" comparison below is the board's own two-tone badge (blue for an Admin membership,
// slate otherwise). It is a literal role value, but not a metadata-hardcoding violation under
// CLAUDE.md's decision path: a Workspace role is a `workspace_members.workspace_role` column
// value ("admin"/"member", written by registration.go and validated in workspacemembers.go), and
// no metadata/*.yaml declares roles at all -- "role" does not appear in 006 or 007 either. The
// forward pointer step 2b asks for is ROADMAP.md's Case 03 phase 7, which makes roles a declared
// runtime concept; when that lands, this branch should read the declaration instead of the column.
//
// canCreateWorkspace adds ui-sample/choose-workspace.html's dashed-border "Add workspace" row
// (2026-09-21), linking to /create-workspace -- CreateWorkspacePage, a runtime-level screen like
// this one (routed by a fixed router.go literal, not by any Application's metadata). The mockup's
// own comment gates it to an identity that is already Admin of at least one Workspace, so only
// the mid-session switcher call (showSwitchWorkspace) ever passes true; showChooseWorkspace's
// pre-session, pending-email call always passes false, since that identity has no session yet for
// /create-workspace's own auth-gated handler to act on.
templ ChooseWorkspacePage(choices []WorkspaceChoice, errorMsg string, action, backHref, backLabel string, canCreateWorkspace bool) {
	{{ live, archived := splitWorkspaceChoices(choices) }}
	@authShell("Choose a workspace", "Choose a workspace", "You have access to more than one workspace.") {
		@authCard("max-w-112") {
			<div class="flex flex-col gap-2 p-3">
				@authError(errorMsg)
				for _, c := range live {
					<form method="POST" action={ templ.SafeURL(action) }>
						@csrfHiddenInput()
						<input type="hidden" name="workspace_id" value={ c.ID }/>
						<button
							type="submit"
							class="flex w-full cursor-pointer items-center gap-3 rounded-md border border-slate-200 bg-white p-4 text-left hover:border-blue-300"
						>
							<span class="flex grow flex-col gap-2">
								<span class="text-[15px] font-medium text-slate-900">{ c.Name }</span>
							</span>
							if c.Role == "admin" {
								<span class="rounded-full bg-blue-50 px-2.5 py-1 text-xs text-blue-700">{ c.Role }</span>
							} else {
								<span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs text-slate-700">{ c.Role }</span>
							}
						</button>
					</form>
				}
				if canCreateWorkspace {
					<a
						href="/create-workspace"
						class="flex min-h-11 items-center justify-center gap-2 rounded-md border border-dashed border-slate-300 px-4 py-3.5 text-sm font-medium text-blue-600 transition hover:border-blue-400 hover:bg-blue-50"
					>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
						Add workspace
					</a>
				}
			</div>
		}
		// Archived workspaces (Flow 2 gap study Tahap 7, WorkspaceArchived.dc.html) -- admin-only,
		// collapsed by default via <details> (this app's own zero-JS disclosure convention,
		// groups.templ's "+ New group"), never shown to a plain member: splitWorkspaceChoices below
		// only ever puts an admin-held archived membership in this slice at all.
		if len(archived) > 0 {
			<div class="flex w-full max-w-112 flex-col gap-2">
				<details class="flex flex-col gap-2">
					<summary class="cursor-pointer list-none self-start text-xs text-slate-500 [&::-webkit-details-marker]:hidden">Archived workspaces ({ fmt.Sprint(len(archived)) })</summary>
					<div class="flex flex-col gap-2">
						for _, c := range archived {
							<div class="flex items-center gap-3 rounded-md border border-slate-200 bg-white p-3.5">
								<span class="flex min-w-0 grow flex-col gap-1">
									<span class="text-sm text-slate-500">{ c.Name }</span>
									<span class="text-xs text-slate-400">archived { c.ArchivedAt }</span>
								</span>
								<form method="POST" action={ templ.SafeURL(action + "/restore") }>
									@csrfHiddenInput()
									<input type="hidden" name="workspace_id" value={ c.ID }/>
									<button type="submit" class="h-9 cursor-pointer rounded-md border border-slate-300 bg-white px-3 text-sm text-slate-900 hover:bg-slate-50">Restore</button>
								</form>
							</div>
						}
						<p class="m-0 px-0.5 text-2xs leading-4 text-slate-400">Archived workspaces are read-only and hidden from members. Archive from Workspace settings.</p>
					</div>
				</details>
			</div>
		}
		@authFooterNote() {
			<a href={ templ.SafeURL(backHref) } class="text-slate-500 hover:text-slate-700">← { backLabel }</a>
		}
	}
}

// splitWorkspaceChoices separates the live Workspaces (rendered exactly as before) from the
// archived ones this identity may Restore -- an archived choice whose Role is not admin is
// dropped entirely rather than sorted into either slice, which is how "hidden from members"
// (WorkspaceArchived.dc.html's own words) is actually enforced on this screen.
func splitWorkspaceChoices(choices []WorkspaceChoice) (live, archived []WorkspaceChoice) {
	for _, c := range choices {
		switch {
		case !c.Archived:
			live = append(live, c)
		case c.Role == "admin":
			archived = append(archived, c)
		}
	}
	return live, archived
}
