package rendering

import (
	"net/url"

	"menata.app/internal/domain"
)

// segmentedControl is the registered renderer for `domain.ComponentSegmentedControl`: a row of mutually exclusive
// choices of the page itself, the selected one marked. It is the markup `viewSwitcher` drew by hand, with the group's
// name and the query parameter as inputs instead of the literals "View" and `view`.
//
// An unselected option is a link to the page's own route with one parameter (`?view=list`), relative on purpose: the
// control never holds a route, so no path appears here that no navigation item declares (007 §12.3), and on the record
// list it resolves to the address the hand-written link spelled out. The selected option is a `<span aria-current>`.
// The track and the knob follow the Theme (surface tile, raised and sunken fills, strong and secondary ink).
templ segmentedControl(label, query, options, selected, keep string) {
	@segmentedTrack(label, segmentTabs(query, options, selected, keep))
}

// SegmentTab is one choice of a segmented track already resolved to where it goes: the words, the address, whether it is the one
// the viewer is on. A SegmentedControl builds them from a query parameter; a view group's header from the routes of its screens.
type SegmentTab struct {
	Label, Href string
	Current     bool
}

// segmentTabs resolves a SegmentedControl's `options` to tabs: each unselected one is the page's own route with its parameter set and the request's
// other parameters (`keep`, a query string) left as they were.
func segmentTabs(query, options, selected, keep string) []SegmentTab {
	var tabs []SegmentTab
	for _, o := range domain.ParseSegmentOptions(options) {
		kept, _ := url.ParseQuery(keep)
		kept.Set(query, o.Value)
		tabs = append(tabs, SegmentTab{Label: o.Label, Href: "?" + kept.Encode(), Current: o.Value == selected})
	}
	return tabs
}

// segmentedTrack is the track and its knob: the one place a row of mutually exclusive choices is drawn, whether they switch a query
// parameter (SegmentedControl) or move between the screens of a view group (the shared header's Board / Table / Calendar).
templ segmentedTrack(label string, tabs []SegmentTab) {
	<nav class={ "inline-flex", layoutGap(ctx, domain.GapHair), tileClasses(ctx), backgroundClass(ctx, domain.BackgroundRaised), "p-0.5" } aria-label={ label }>
		for _, o := range tabs {
			if o.Current {
				<span class={ "rounded " + backgroundClass(ctx, domain.BackgroundSunken) + " px-3 py-1", textClass(ctx, domain.RoleMeta), weightClass(ctx, domain.WeightEmphasis), inkClass(ctx, domain.InkStrong) } aria-current="true">{ o.Label }</span>
			} else {
				<a class={ "rounded px-3 py-1", textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkSecondary), inkHoverClass(ctx, domain.InkStrong) } href={ templ.URL(o.Href) }>{ o.Label }</a>
			}
		}
	</nav>
}
