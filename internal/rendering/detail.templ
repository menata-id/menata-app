package rendering

import (
	"menata.app/internal/experience"
	"time"
	"fmt"

	"menata.app/internal/action"
	"menata.app/internal/authorization"
	"menata.app/internal/data"
	"menata.app/internal/domain"
)

// ChildSection is one resolved child collection ready to render: the child Machine, its records
// (already filtered to the parent being viewed, in sort_order), and the relation options those
// records' own reference fields need (development-history.md Phase 9).
type ChildSection struct {
	Machine   *domain.Machine
	Records   []*data.Record
	Relations RelationOptions
	// Checklist is set when the child Machine is drawn as a to-do list rather than a table.
	Checklist *Checklist
	// Attachments is set when the child Machine is drawn as a list of uploaded files.
	Attachments *Attachments
}

// RecordExtras is what a record's detail page draws beside its own Fields, resolved by Composition
// (Case 19 PM02): the tags its Machine declares and the record's own history. ShowActivity is separate
// from len(Activity) because "this Workspace keeps no activity log" and "this record has no history yet"
// are different answers, and only the second draws a section.
type RecordExtras struct {
	// Move is the record's own Move panel (PM02c), nil when its Machine has no board View to move within.
	Move               *RecordMove
	Tags               []CardTag
	ShowActivity       bool
	Activity           []ActivityEntry
	ActivityTruncation Truncation
	// Copy is the "Copy…" panel of the ⋯ menu, nil when the record's Machine cannot be copied
	// (domain.Machine.CopyTitleField).
	Copy *RecordCopy
	// Comments is the "Write a comment" box, set when the record's Machine has a child Machine drawn as
	// comments (a `comment` card role). It also makes the feed a section on its own, with or without an
	// activity log.
	Comments *CommentComposer
}

// CommentComposer is what the comment box writes: the child Machine's create route, the Field naming the
// record it belongs to, and the one the text goes in. Who wrote it is not here -- the runtime stamps it.
type CommentComposer struct {
	MachineID   string
	ParentField string
	BodyField   string
}

// RecordCopy is what the copy panel needs: the Field the copy is named through, and the name it starts with.
type RecordCopy struct {
	TitleField string
	Title      string
}

// RecordMove is what a detail page needs to offer the move a board card offers: the same PATCH (the group
// Field and `position`), addressed to the board View it is defined against so the server places the card
// the way a drop would. The panel is one contract with the card's and the drag's, not a third way to write.
type RecordMove struct {
	CardMove
	ViewID string
}

// CurrentLabel is the name of the list the record is in now: the target whose value it holds. Composition
// only builds a RecordMove when one does, so the empty answer is a fixture's, not a screen's.
func (mv RecordMove) CurrentLabel() string {
	for _, t := range mv.Targets {
		if t.Value == mv.Current {
			return t.Label
		}
	}
	return ""
}

// DocumentSignaturePlacement is the composed placement view the Document's own detail page embeds
// -- nil for every Machine other than mch_document.
//
// Since Fase 6c-3 it carries a resolved PlacementView rather than raw records, relation options
// and a Machine for the page to resolve itself. The embed and the dedicated screen now share one
// composed shape and differ only in markup, which is what let this file's neighbour leave the
// projection ratchet: a Page renders what Composition decided.
type DocumentSignaturePlacement struct {
	View PlacementView
}

// RecordDetailPage is a dedicated per-record view (development-history.md Phase 8), replacing inline-only
// editing (table row / board card) as the host for richer content later phases add (Phase 9's
// child collections, Phase 13's activity feed).
// actor is the viewing identity, needed only so an Action the viewer is not permitted to
// perform isn't offered in the first place (development-history.md Phase 16) -- the server enforces the same
// rule regardless, this only keeps the UI honest about it.
templ RecordDetailPage(m *domain.Machine, r *data.Record, relations RelationOptions, groups GroupOptions, children []ChildSection, actor domain.Actor, sigPlacement *DocumentSignaturePlacement, workspaceName string, viewer Viewer, switchWorkspaceHref string, extras RecordExtras, now time.Time) {
	@appShell(m.Name, workspaceName, viewer, switchWorkspaceHref) {
		@detailBackLink(m, extras)
		<div id="record-detail" class="flex flex-col gap-4">
			@RecordDetailView(m, r, relations, groups, children, actor, sigPlacement, extras, now)
		</div>
	}
}

// detailBackLink is Document/Approval Step's own back-link exception: those two Machines only
// exist as part of Case 3's Document Approval flow, so their own generic Machine page
// (/machines/mch_document, /machines/mch_approval_step) is POC scaffolding no real approver
// should land on (owner request, 2026-09-19) -- send them back to Approval Inbox instead, via the
// same routeByID/labelByID idiom documentsubmit.templ's own "← Approval Inbox" link already uses.
// Every other
// Machine (Task, Project, ...) has no bespoke flow of its own, so its generic page remains the
// real destination.
//
// The id match alone stopped being enough to take that branch on 2026-09-27: Workspace isolation
// lets a different Workspace's own, unrelated Machine share the bare id action.DocumentMachineID
// (a real "Document Tracking" Application did exactly this), and that Workspace declares no
// nav_approval_inbox at all -- routeByID's own panic-on-unknown-id is correct in general (a page
// linking to its own sibling screen should fail loudly on a typo), but this call was never
// actually linking to a sibling, only assuming one existed. hasNavItem checks first instead of
// assuming, so that Application's own generic page remains its own real destination, same as any
// other Machine with no bespoke flow.
templ detailBackLink(m *domain.Machine, extras RecordExtras) {
	if (action.IsDocument(m) || action.IsStep(m)) && hasNavItem(ctx, "nav_approval_inbox") {
		<a href={ templ.SafeURL(routeByID(ctx, "nav_approval_inbox")) } class="text-xs text-blue-600 hover:text-blue-700">← { labelByID(ctx, "nav_approval_inbox") }</a>
	} else if extras.Move != nil {
		@recordBreadcrumb(m, *extras.Move)
	} else {
		<a href={ templ.URL("/machines/" + m.ID) } class="text-xs text-blue-600 hover:text-blue-700">← { m.Name }</a>
	}
}

// recordBreadcrumb is PM02's "Tasks board / Pre-production": the Machine's own heading linking back to the
// board View the card sits on, then the list it is in. Both halves are what recordMove already resolved (the
// board View and the current list's title), so the breadcrumb and the Move panel cannot disagree about where
// the card is.
templ recordBreadcrumb(m *domain.Machine, mv RecordMove) {
	<nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs text-slate-500">
		<a href={ templ.URL(fmt.Sprintf("/machines/%s?view=%s", m.ID, mv.ViewID)) } class="text-blue-600 hover:text-blue-700">{ machineHeading(ctx, m) }</a>
		<span aria-hidden="true">/</span>
		<span aria-current="page">{ mv.CurrentLabel() }</span>
	</nav>
}

// RecordDetailView is one Record's read-only detail: every Field as a label/value pair, plus one
// section per child collection -- every record of another Machine that references this one
// (development-history.md Phase 9), reusing RecordRow exactly as table/board Layouts already do.
templ RecordDetailView(m *domain.Machine, r *data.Record, relations RelationOptions, groups GroupOptions, children []ChildSection, actor domain.Actor, sigPlacement *DocumentSignaturePlacement, extras RecordExtras, now time.Time) {
	<div id="record-detail" class="flex flex-col gap-4">
		<div class="flex flex-col gap-1">
			<h1 class="m-0 text-xl font-medium">{ recordTitle(m, r) }</h1>
			if action.IsDocument(m) {
				<code class="font-mono text-2xs text-slate-400">{ action.DocumentReference(r.SortOrder) }</code>
			} else {
				<code class="font-mono text-2xs text-slate-400">{ r.ID }</code>
			}
		</div>
		if len(extras.Tags) > 0 {
			@rowLayout(domain.GapTight, domain.RowAlignStretch, domain.RowJustifyStart) {
				for _, t := range extras.Tags {
					@tagChip(t)
				}
			}
		}
		<dl class="m-0 grid grid-cols-1 gap-x-4 gap-y-3 rounded-lg border border-slate-200 bg-white p-4 text-sm sm:grid-cols-[10rem_1fr]">
			for _, f := range m.Fields {
				if !hiddenDetailField(m, f) {
					<dt class="self-center text-2xs font-medium tracking-wide text-slate-500 uppercase">{ f.Name }</dt>
					<dd class="m-0 text-slate-900">
						if f.ID == m.SLAField {
							@slaBadge(experience.ResolveSLABadge(r.Values[f.ID], now))
						} else if f.Type == domain.FieldTypeFile {
							@fileLink(r.Values[f.ID])
							// The last Field-id literal in documentApprovalFieldCoupling (1 of 1), and it is
							// **a props decision, not a missing primitive** -- said that way because the
							// entry above it in that gate spent three stages claiming the opposite about the
							// wizard's form bindings and had to retract it.
							//
							// The value *is* derivable: the compositing Event already declares which Field
							// holds the Document's PDF (action.CompositeFields(...).SourceField, which
							// composition/review.go reads for exactly this Document). Two things stop it
							// being read here. It lives on the **step** Machine and this page holds only the
							// record's own, so the handler would have to resolve it into an eleventh
							// parameter on a signature already at ten -- which wants a props struct, a change
							// to every caller of a generic page, and is out of proportion to one thumbnail.
							//
							// And it would answer a *different question*. "Which file gets a preview" is
							// presentation; "which file the signing composites onto" is workflow. They name
							// the same Field today and need not: an approval Application that composites no
							// PDF would silently lose its thumbnail while the file is still a PDF. Deriving
							// from the nearest-looking declaration is the mistake Stage D named in place
							// (CLAUDE.md, "derive or declare").
							//
							// So it stays a literal, under CLAUDE.md's decision path step 2, with all three
							// obligations met rather than the none it carried until 2026-09-30: the missing
							// capability is a *presentation* declaration for "preview this file" (a
							// card_fields role, or a Field-level flag); the forward-checkable pointer is
							// 007 §7.6 Projection and §12.3 Component boundedness, which is where such a
							// role would have to fit; and it is listed in writing-guide.md's "What comes
							// free vs. what's hardcoded today" table. The trigger for building it is a
							// second case -- a second Machine wanting a file previewed -- per step 3, not
							// taste.
							if action.IsDocument(m) && f.ID == action.FieldDocumentFile {
								@pdfThumbnail(m.ID, r.ID)
							}
						} else if f.IsReference() {
							{ RelationLabel(relations, f.RelatedMachine, toString(r.Values[f.ID])) }
						} else if f.Type == domain.FieldTypeGroup {
							{ GroupLabel(groups, toString(r.Values[f.ID])) }
						} else if f.Type == domain.FieldTypeLongText {
							<div class="whitespace-pre-wrap">{ toString(r.Values[f.ID]) }</div>
						} else {
							{ fmt.Sprint(r.Values[f.ID]) }
						}
					</dd>
				}
			}
		</dl>
		if action.IsStep(m) {
			// Fase 6b: the Approve/Reject bar is no longer here. It lived on this generic page only
			// because an Approval Step had no screen of its own, and it cost the whole detail route
			// two Case 3 obligations -- reading fld_decision straight off the record, the reason
			// this file sat in internal/conformance's projection ratchet, and a signature lookup
			// run for every Machine's detail page, mch_task included. Board 10 is that screen now;
			// this links to it rather than rendering a second, quietly diverging copy of the same
			// decision.
			<a href={ templ.URL(fmt.Sprintf("/machines/%s/records/%s/review", m.ID, r.ID)) } class="text-sm font-medium text-blue-600 hover:text-blue-700">Review and decide →</a>
		}
		{{ deletable, blockedReason := canDeleteInView(m, r, children, actor) }}
		@rowLayout(domain.GapTight, domain.RowAlignCenter, domain.RowJustifyStart) {
			if action.IsDocument(m) {
				<a href={ templ.URL(fmt.Sprintf("/machines/%s/records/%s/signature-placement", m.ID, r.ID)) } class={ controlSecondary }>Signature Positions</a>
			}
			if authorization.AllowsAction(m, domain.ActionEdit, r.Values, actor) {
				<button
					class={ controlSecondary }
					hx-get={ fmt.Sprintf("/machines/%s/records/%s/edit", m.ID, r.ID) }
					hx-target="#record-detail"
					hx-swap="outerHTML"
				>Edit</button>
			}
			@recordActionsMenu(m, r, extras.Move != nil && authorization.AllowsAction(m, domain.ActionEdit, r.Values, actor), extras.Move, authorization.AllowsAction(m, domain.ActionCreate, r.Values, actor), extras.Copy)
			if deletable {
				<button
					class={ controlSecondary }
					hx-delete={ fmt.Sprintf("/machines/%s/records/%s", m.ID, r.ID) }
					hx-target="#record-detail"
					hx-confirm="Delete this record?"
				>Delete</button>
			} else {
				<span class="text-xs text-slate-500" title={ blockedReason }>Cannot delete: { blockedReason }</span>
			}
		}
		for _, cc := range children {
			if stepperView, ok := cc.Machine.StepperView(); ok {
				@sectionHeaderRow(stepperView.Name, "", "")
				@approvalStepper(cc.Machine, cc.Machine.Sequencing, r, cc.Records, cc.Relations)
			} else if cc.Attachments != nil {
				@attachmentsSection(cc.Machine, r.ID, cc.Attachments, authorization.AllowsAction(m, domain.ActionEdit, r.Values, actor))
			} else if cc.Checklist != nil {
				@checklistSection(cc.Machine, r.ID, cc.Checklist, authorization.AllowsAction(m, domain.ActionEdit, r.Values, actor))
			} else {
				@ChildSectionView(cc, groups, actor, now)
			}
		}
		if action.IsDocument(m) && sigPlacement != nil {
			@sectionHeaderRow("Signature Positions", "", "")
			@signaturePlacementBlock(sigPlacement.View)
		}
		if extras.Comments != nil {
			@commentsFeed(r.ID, extras, authorization.AllowsAction(m, domain.ActionEdit, r.Values, actor))
		} else if extras.ShowActivity {
			@recordActivity(extras)
		}
	</div>
}

// recordActionsMenu is PM02b's "⋯" card-actions menu. Move… opens PM02c's panel (List and Position: "the same
// result as dragging the card, for anyone who would rather not drag -- or who is working by keyboard"), sending
// the board's own PATCH and answering with HX-Refresh (this is not the Machine's own page), which redraws the
// detail with the new List in its Fields and the move in History. Copy… names a new record made from this one and
// posts to its own route, which answers with an HX-Redirect to the copy. Share copies the page's own address.
//
// Both are <details> so the menu opens and closes without script. Share is a clipboard write, which has no
// declarative form: a named exception to 007 §12.3's `actions` (the Component contract's gesture slot, not built
// yet), the same class as boardDragScript, and listed in writing-guide.md's "What comes free vs. what's
// hardcoded today". Join, Make template, Watch and Archive from the mockup need a write primitive or a Machine
// nothing declares yet, and are not drawn.
templ recordActionsMenu(m *domain.Machine, r *data.Record, canMove bool, move *RecordMove, canCopy bool, cp *RecordCopy) {
	<details class="relative">
		<summary aria-label="Card actions" class={ controlSecondary + " cursor-pointer list-none" }>⋯</summary>
		<div class="absolute top-full left-0 z-10 mt-1 flex w-72 flex-col gap-1 rounded-lg border border-slate-200 bg-white p-2 shadow-lg">
			if canMove && move != nil {
				<details>
					<summary class="flex cursor-pointer list-none flex-col rounded-md px-2 py-1.5 text-sm hover:bg-slate-50">
						Move…
						<span class="text-2xs text-slate-500">Another list</span>
					</summary>
					<form
						class="flex flex-col gap-3 p-2"
						hx-patch={ fmt.Sprintf("/machines/%s/records/%s?view=%s", m.ID, r.ID, move.ViewID) }
						hx-target="#record-detail"
					>
						<label class="flex flex-col gap-1 text-2xs font-medium tracking-wide text-slate-500 uppercase">
							List
							<select name={ move.Field } class={ controlField + " w-full" }>
								for _, t := range move.Targets {
									<option value={ t.Value } selected?={ t.Value == move.Current }>{ t.Label }</option>
								}
							</select>
						</label>
						<label class="flex flex-col gap-1 text-2xs font-medium tracking-wide text-slate-500 uppercase">
							Position
							<input type="number" name="position" min="1" value={ fmt.Sprint(move.Position) } class={ controlField + " w-full" }/>
						</label>
						<button type="submit" class={ controlPrimary }>Move</button>
					</form>
				</details>
			}
			if canCopy && cp != nil {
				<details>
					<summary class="flex cursor-pointer list-none flex-col rounded-md px-2 py-1.5 text-sm hover:bg-slate-50">Copy…</summary>
					<form
						class="flex flex-col gap-3 p-2"
						hx-post={ fmt.Sprintf("/machines/%s/records/%s/copy", m.ID, r.ID) }
						hx-swap="none"
					>
						<label class="flex flex-col gap-1 text-2xs font-medium tracking-wide text-slate-500 uppercase">
							Title
							<input type="text" name={ cp.TitleField } value={ cp.Title } required class={ controlField + " w-full" }/>
						</label>
						<button type="submit" class={ controlPrimary }>Copy</button>
					</form>
				</details>
			}
			<button
				type="button"
				class="flex cursor-pointer flex-col rounded-md border-0 bg-transparent px-2 py-1.5 text-left text-sm hover:bg-slate-50"
				onclick="navigator.clipboard.writeText(location.href).then(() => { this.querySelector('[data-share-hint]').textContent = 'Link copied' })"
			>
				Share
				<span data-share-hint class="text-2xs text-slate-500">Copy a link to this card</span>
			</button>
		</div>
	</details>
}

// recordActivity is the record's own history, newest first -- what happened to this record, in the
// words each event was logged with. It is read-only: an activity row is append-only, and what is *not*
// here is a comment box, which a Machine with a comment child collection draws instead (commentsFeed).
templ recordActivity(extras RecordExtras) {
	@sectionLayout(domain.GapDefault) {
		<h2 class="m-0 text-base font-medium">History</h2>
		@truncationNotice(extras.ActivityTruncation)
		if len(extras.Activity) == 0 {
			@staticText(domain.StaticMessage, "Nothing has happened to this record yet.")
		} else {
			@activityFeedListRow(extras.Activity)
		}
	}
}

// pdfThumbnail is a small preview of a Document's own PDF (Step 3's internal/pdf, ROADMAP.md's UI
// mockup conformance audit) -- the capability already existed, reachable only from the
// signature-placement screen; this is the detail page's own use of the same route, not a new one.
templ pdfThumbnail(machineID, recordID string) {
	<div class="mt-2">
		<a href={ templ.URL(fmt.Sprintf("/machines/%s/records/%s/pdf-preview", machineID, recordID)) } target="_blank">
			<img src={ fmt.Sprintf("/machines/%s/records/%s/pdf-preview?page=1", machineID, recordID) } alt="Document PDF preview, page 1" class="block max-w-40 rounded border border-slate-200"/>
		</a>
	</div>
}

// ChildSectionView renders one child collection: a compact table of the child Machine's records,
// each row the same generic RecordRow used everywhere else.
templ ChildSectionView(cc ChildSection, groups GroupOptions, actor domain.Actor, now time.Time) {
	<section class="flex flex-col gap-2">
		@sectionHeaderRow(fmt.Sprintf("%s (%d)", cc.Machine.Name, len(cc.Records)), "", "")
		<div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
			<table class="w-full border-collapse text-sm">
				<thead>
					<tr>
						for _, f := range cc.Machine.Fields {
							<th class={ tableHeadCell }>{ f.Name }</th>
						}
						<th class={ tableHeadCell }></th>
					</tr>
				</thead>
				<tbody>
					for _, rec := range cc.Records {
						@RecordRow(cc.Machine, rec, cc.Relations, groups, actor, now)
					}
				</tbody>
			</table>
		</div>
	</section>
}

// RecordDetailEdit is one Record's detail in edit mode: the same Field set as an inline form.
templ RecordDetailEdit(m *domain.Machine, r *data.Record, relations RelationOptions, groups GroupOptions) {
	<div id="record-detail" class="flex flex-col gap-4">
		<form
			class="flex flex-col gap-4"
			hx-put={ fmt.Sprintf("/machines/%s/records/%s", m.ID, r.ID) }
			hx-target="#record-detail"
			hx-swap="outerHTML"
			hx-encoding="multipart/form-data"
		>
			<div class="flex flex-col gap-1">
				<h1 class="m-0 text-xl font-medium">{ recordTitle(m, r) }</h1>
				<code class="font-mono text-2xs text-slate-400">{ r.ID }</code>
			</div>
			<dl class="m-0 grid grid-cols-1 items-center gap-x-4 gap-y-3 rounded-lg border border-slate-200 bg-white p-4 text-sm sm:grid-cols-[10rem_1fr]">
				for _, f := range m.Fields {
					<dt class="self-center text-2xs font-medium tracking-wide text-slate-500 uppercase">{ f.Name }</dt>
					<dd class="m-0">
						@fieldInput(f, r.Values[f.ID], relations, groups)
					</dd>
				}
			</dl>
			@rowLayout(domain.GapTight, domain.RowAlignCenter, domain.RowJustifyStart) {
				<button type="submit" class={ controlPrimary }>Save</button>
				<button
					type="button"
					class={ controlSecondary }
					hx-get={ fmt.Sprintf("/machines/%s/records/%s", m.ID, r.ID) }
					hx-target="#record-detail"
					hx-swap="outerHTML"
				>Cancel</button>
			}
		</form>
	</div>
}

// recordTitle uses the Machine's first Field as the record's display title, the same label-field
// convention already used for relation options (main.go's loadRelationOptions).
func recordTitle(m *domain.Machine, r *data.Record) string {
	if len(m.Fields) == 0 {
		return r.ID
	}
	return toString(r.Values[m.Fields[0].ID])
}

// hiddenDetailField skips an Approval Step's own raw signature-placement fields from the
// generic field list -- the raw percentages are noise, not information a viewer needs (the UX
// review that named this, 2026-09-19).
//
// The human-readable form now lives on the review screen (reviewdocument.templ's
// reviewSignaturePanel), not on this page: signatureConfirmation, which used to say it here in
// prose, moved with the decision bar in Fase 6b. This predicate stays because the fields are still
// declared on the Machine and would still render as five raw numbers without it.
//
// **Which** five Fields is no longer a list here: it is exactly the set this Machine's own
// signature_placement: block declares (Stage D, 2026-09-28), asked through
// domain.SignaturePlacement.Fields. So a step Machine naming its coordinates anything at all hides
// the right ones, and this predicate cannot drift from the declaration the placement screen writes
// through -- the two were separate lists until that block existed.
//
// What is still hardcoded is the *rule*, not the fields: "an Approval Step's placement Fields are
// noise on a detail page" is a judgement metadata cannot express today, because there is no
// per-Field "hide me on a detail page" declaration and 007 §12.4 says the answer is not a new
// `detail` ViewType either ("a View MUST NOT be required as the universal composition primitive").
// Forward-checkable pointer: ROADMAP.md's "A View composing other Views", the entry that would give
// a detail screen a declared arrangement.
func hiddenDetailField(m *domain.Machine, f domain.Field) bool {
	if !action.IsStep(m) {
		return false
	}
	for _, id := range m.SignaturePlacement.Fields() {
		if f.ID == id {
			return true
		}
	}
	return false
}

// canDeleteInView answers the same two questions internal/web's deleteAllowed enforces
// server-side: business state (action.CanDelete, the single source of truth RecordRow below and
// deleteAllowed both call too -- from data this page already has in hand: r's own Values, and a
// Document's own Approval Steps, already fetched as one of its child collections, Phase 9) and
// any declared domain.ActionDelete Permission (authorization.AllowsAction) -- so no extra query
// is needed just to decide whether to show the Delete button. Presentation only: the server is
// what actually protects the data either way, the same posture the Approve/Reject bar already
// established (now reviewdocument.templ's reviewDecisionBar).
func canDeleteInView(m *domain.Machine, r *data.Record, children []ChildSection, actor domain.Actor) (bool, string) {
	var steps []*data.Record
	for _, cc := range children {
		if action.IsStep(cc.Machine) {
			steps = cc.Records
		}
	}
	ok, reason := action.CanDelete(m, r.Values, steps)
	if ok && !authorization.AllowsAction(m, domain.ActionDelete, r.Values, actor) {
		return false, "not allowed"
	}
	return ok, reason
}
