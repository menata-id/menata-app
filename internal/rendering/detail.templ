package rendering

import (
	"fmt"

	"menata.app/internal/action"
	"menata.app/internal/authorization"
	"menata.app/internal/data"
	"menata.app/internal/domain"
)

// ChildSection is one resolved child collection ready to render: the child Machine, its records
// (already filtered to the parent being viewed, in sort_order), and the relation options those
// records' own reference fields need (ROADMAP.md Phase 9).
type ChildSection struct {
	Machine   *domain.Machine
	Records   []*data.Record
	Relations RelationOptions
}

// DocumentSignaturePlacement is what signaturePlacementBlock (signatureplacement.templ) needs to
// render inline on a Document's own detail page -- nil for every Machine other than mch_document.
// A second, genuinely different Page (RecordDetailView, alongside the dedicated
// SignaturePlacementPage) now composes that same Component, proving 007 §12.1/§12.3's Page vs
// Component split mechanically, with no metadata change.
type DocumentSignaturePlacement struct {
	Steps      []*data.Record
	Relations  RelationOptions
	Page       int
	TotalPages int
	// StepMachine is mch_approval_step, so signaturePlacementBlock can ask
	// authorization.AllowsAction whether the viewing actorID (RecordDetailView's own parameter)
	// may edit each step's own marker (ROADMAP.md Phase 16), the same reason it's threaded
	// through the dedicated SignaturePlacementPage too.
	StepMachine *domain.Machine
}

// RecordDetailPage is a dedicated per-record view (ROADMAP.md Phase 8), replacing inline-only
// editing (table row / board card) as the host for richer content later phases add (Phase 9's
// child collections, Phase 13's activity feed).
// actorID is the viewing identity, needed only so an Action the viewer is not permitted to
// perform isn't offered in the first place (ROADMAP.md Phase 16) -- the server enforces the same
// rule regardless, this only keeps the UI honest about it.
templ RecordDetailPage(m *domain.Machine, r *data.Record, appName string, relations RelationOptions, children []ChildSection, actorID string, hasSignature bool, sigPlacement *DocumentSignaturePlacement) {
	@pageShell(m.Name, appName) {
		@detailBackLink(m)
		<div id="record-detail">
			@RecordDetailView(m, r, relations, children, actorID, hasSignature, sigPlacement)
		</div>
	}
}

// detailBackLink is Document/Approval Step's own back-link exception: those two Machines only
// exist as part of Case 3's Document Approval flow, so their own generic Machine page
// (/machines/mch_document, /machines/mch_approval_step) is POC scaffolding no real approver
// should land on (owner request, 2026-09-19) -- send them back to Approval Inbox instead, via the
// same routeByID idiom documentsubmit.templ's own "← Approval Inbox" already uses. Every other
// Machine (Task, Project, ...) has no bespoke flow of its own, so its generic page remains the
// real destination.
templ detailBackLink(m *domain.Machine) {
	if m.ID == action.DocumentMachineID || m.ID == action.StepMachineID {
		<p><a href={ templ.SafeURL(routeByID("nav_approval_inbox")) }>← Approval Inbox</a></p>
	} else {
		<p><a href={ templ.URL("/machines/" + m.ID) }>← { m.Name }</a></p>
	}
}

// RecordDetailView is one Record's read-only detail: every Field as a label/value pair, plus one
// section per child collection -- every record of another Machine that references this one
// (ROADMAP.md Phase 9), reusing RecordRow exactly as table/board Layouts already do.
templ RecordDetailView(m *domain.Machine, r *data.Record, relations RelationOptions, children []ChildSection, actorID string, hasSignature bool, sigPlacement *DocumentSignaturePlacement) {
	<div id="record-detail">
		<h1>{ recordTitle(m, r) }</h1>
		if m.ID == action.DocumentMachineID {
			<code>{ action.DocumentReference(r.SortOrder) }</code>
		} else {
			<code>{ r.ID }</code>
		}
		<dl class="detail-fields">
			for _, f := range m.Fields {
				if !hiddenDetailField(m, f) {
					<dt>{ f.Name }</dt>
					<dd>
						if f.ID == m.View.SLAField {
							@slaBadge(r.Values[f.ID])
						} else if f.Type == domain.FieldTypeFile {
							@fileLink(r.Values[f.ID])
							if m.ID == action.DocumentMachineID && f.ID == action.FieldDocumentFile {
								@pdfThumbnail(m.ID, r.ID)
							}
						} else if f.IsReference() {
							{ relationLabel(relations, f.RelatedMachine, toString(r.Values[f.ID])) }
						} else {
							{ fmt.Sprint(r.Values[f.ID]) }
						}
					</dd>
				}
			}
		</dl>
		if m.ID == action.StepMachineID {
			@decideButtons(m, r, actorID, hasSignature)
		}
		{{ deletable, blockedReason := canDeleteInView(m, r, children, actorID) }}
		<div class="actions">
			if m.ID == action.DocumentMachineID {
				<a href={ templ.URL(fmt.Sprintf("/machines/%s/records/%s/signature-placement", m.ID, r.ID)) }>
					<button type="button">Signature Positions</button>
				</a>
			}
			if authorization.AllowsAction(m, domain.ActionEdit, r.Values, actorID) {
				<button
					hx-get={ fmt.Sprintf("/machines/%s/records/%s/edit", m.ID, r.ID) }
					hx-target="#record-detail"
					hx-swap="outerHTML"
				>Edit</button>
			}
			if deletable {
				<button
					hx-delete={ fmt.Sprintf("/machines/%s/records/%s", m.ID, r.ID) }
					hx-target="#record-detail"
					hx-confirm="Delete this record?"
				>Delete</button>
			} else {
				<span class="step-status" title={ blockedReason }>Cannot delete: { blockedReason }</span>
			}
		</div>
		for _, cc := range children {
			if m.ID == action.DocumentMachineID && cc.Machine.ID == action.StepMachineID {
				@sectionHeader("Approval Progress", "", "")
				@approvalStepper(cc.Records, toString(r.Values[action.FieldDocumentMode]), cc.Relations)
			} else {
				@ChildSectionView(cc, actorID)
			}
		}
		if m.ID == action.DocumentMachineID && sigPlacement != nil {
			@sectionHeader("Signature Positions", "", "")
			@signaturePlacementBlock(r, sigPlacement.Steps, sigPlacement.Relations, sigPlacement.Page, sigPlacement.TotalPages, sigPlacement.StepMachine, actorID)
		}
	</div>
}

// pdfThumbnail is a small preview of a Document's own PDF (Step 3's internal/pdf, ROADMAP.md's UI
// mockup conformance audit) -- the capability already existed, reachable only from the
// signature-placement screen; this is the detail page's own use of the same route, not a new one.
templ pdfThumbnail(machineID, recordID string) {
	<div class="pdf-thumb">
		<a href={ templ.URL(fmt.Sprintf("/machines/%s/records/%s/pdf-preview", machineID, recordID)) } target="_blank">
			<img src={ fmt.Sprintf("/machines/%s/records/%s/pdf-preview?page=1", machineID, recordID) } alt="Document PDF preview, page 1"/>
		</a>
	</div>
}

// decideButtons is Case 3's Approve/Reject action bar (ROADMAP.md Phase 12), shown only on an
// mch_approval_step's own detail page. A decided step shows its decision instead of buttons --
// deciding again isn't offered, matching action.CanDecide's own one-way semantics. On success the
// server redirects to the parent Document's page (POST .../decide), so no hx-target/swap is
// needed here.
//
// A pending step assigned to someone else shows who it's waiting on instead of buttons, asking
// authorization.AllowsAction the same question the handler asks (Phase 16). This is presentation,
// not enforcement: the server denies the POST either way.
//
// hasSignature (internal/web's hasSignatureForGate, computed with I/O the rendering plane can't do
// itself, 007 §20 -- the same reason signatureConfirmation below could never answer this) is the
// render-time half of the signature-capture gate (owner request, 2026-09-19): when false, Approve
// doesn't submit directly -- it opens signatureModal's own canvas dialog first, nested in the same
// form, so its own Approve button is one more submit control on the same hx-post. decideStep's own
// applyApprovalSignature is the write-time half of the same gate.
templ decideButtons(m *domain.Machine, r *data.Record, actorID string, hasSignature bool) {
	<div class="actions decide-actions">
		if toString(r.Values[action.FieldStepDecision]) != action.DecisionPending {
			<span class="badge">{ toString(r.Values[action.FieldStepDecision]) }</span>
		} else if authorization.AllowsAction(m, domain.ActionDecide, r.Values, actorID) {
			@signatureConfirmation(r)
			<form hx-post={ fmt.Sprintf("/machines/%s/records/%s/decide", m.ID, r.ID) }>
				if hasSignature {
					<button type="submit" name="decision" value={ action.DecisionApproved } class="primary">Approve</button>
				} else {
					<button type="button" class="primary sig-approve-trigger" data-modal={ "sig-modal-" + r.ID }>Approve</button>
				}
				<button type="submit" name="decision" value={ action.DecisionRejected }>Reject</button>
				if !hasSignature {
					@signatureModal(r.ID)
				}
			</form>
		} else {
			<span class="step-status">Awaiting its own assignee's decision</span>
		}
	</div>
}

// signatureModal is the canvas dialog decideButtons opens when its assignee has no signature on
// file yet (neither a saved mch_signature nor a one-time fld_signature_image already on this
// step) -- owner request, 2026-09-19: "draw it the first time, ask to remember it, don't ask again
// once it's saved." Nested inside decideButtons' own <form> so its own Approve button is just one
// more submit control on the same hx-post -- no second route, no separate page.
//
// Freehand drawing has no non-JS equivalent, so this is a second named vanilla-JS exception
// alongside signature-placement's own drag math (same file, same posture, README.md's "Tech
// stack"). Event delegation on document, matching signature-placement's own reasoning for reusing
// one listener rather than one per element -- this dialog is only ever rendered once per page
// (decideButtons itself is), so delegation isn't strictly required for re-binding after a swap the
// way it was there, but it keeps both scripts written the same way.
//
// The submit listener is registered with useCapture=true specifically so it runs before htmx's own
// submit handling (a bubble-phase listener on the form itself fires during the "at target" phase,
// before any bubble-phase document listener) -- without that, htmx would read the hidden
// signature_image input before this had a chance to fill it from the canvas.
templ signatureModal(stepID string) {
	<dialog id={ "sig-modal-" + stepID } class="sig-modal">
		<h3>Add your signature</h3>
		<p class="step-status">Draw your signature below to approve. It's only used for this document unless you choose to save it.</p>
		<canvas class="sig-modal-canvas" width="400" height="160"></canvas>
		<div class="sig-modal-row">
			<button type="button" class="sig-modal-clear">Clear</button>
			<label><input type="checkbox" name="save_signature"/> Save my signature for next time</label>
		</div>
		<input type="hidden" name="signature_image" class="sig-modal-image"/>
		<div class="sig-modal-row sig-modal-actions">
			<button type="button" class="sig-modal-cancel">Cancel</button>
			<button type="submit" name="decision" value={ action.DecisionApproved } class="primary sig-modal-approve">Approve</button>
		</div>
	</dialog>
	<script>
		(function () {
			document.addEventListener("click", function (e) {
				var trigger = e.target.closest(".sig-approve-trigger");
				if (trigger) {
					var modal = document.getElementById(trigger.dataset.modal);
					if (modal) modal.showModal();
					return;
				}
				var cancel = e.target.closest(".sig-modal-cancel");
				if (cancel) {
					cancel.closest("dialog").close();
					return;
				}
				var clear = e.target.closest(".sig-modal-clear");
				if (clear) {
					var canvas = clear.closest("dialog").querySelector(".sig-modal-canvas");
					canvas.getContext("2d").clearRect(0, 0, canvas.width, canvas.height);
				}
			});

			document.addEventListener("submit", function (e) {
				var submitter = e.submitter;
				if (!submitter || !submitter.classList.contains("sig-modal-approve")) return;
				var dialog = submitter.closest("dialog");
				var canvas = dialog.querySelector(".sig-modal-canvas");
				dialog.querySelector(".sig-modal-image").value = canvas.toDataURL("image/png");
			}, true);

			var drawing = false, lastX = 0, lastY = 0;
			document.addEventListener("pointerdown", function (e) {
				var canvas = e.target.closest(".sig-modal-canvas");
				if (!canvas) return;
				drawing = true;
				var rect = canvas.getBoundingClientRect();
				lastX = e.clientX - rect.left;
				lastY = e.clientY - rect.top;
				canvas.setPointerCapture(e.pointerId);
			});
			document.addEventListener("pointermove", function (e) {
				if (!drawing) return;
				var canvas = e.target.closest(".sig-modal-canvas");
				if (!canvas) return;
				var rect = canvas.getBoundingClientRect();
				var x = e.clientX - rect.left;
				var y = e.clientY - rect.top;
				var ctx = canvas.getContext("2d");
				ctx.strokeStyle = "#1a1a1a";
				ctx.lineWidth = 2;
				ctx.lineCap = "round";
				ctx.beginPath();
				ctx.moveTo(lastX, lastY);
				ctx.lineTo(x, y);
				ctx.stroke();
				lastX = x;
				lastY = y;
			});
			document.addEventListener("pointerup", function () { drawing = false; });
		})();
	</script>
}

// signatureConfirmation echoes a pending step's own signature placement back to its assignee
// before they approve (ROADMAP.md's UI mockup conformance audit) -- reusing the step record
// already fetched for this page and signatureplacement.templ's own field-reading helpers
// (signaturePlaced/signaturePage/signatureCoord/signatureWidth), no extra query. It only confirms
// where a placement will land, not whether a real signature image exists on file for this person
// -- that check needs I/O the rendering plane doesn't perform (007 §20); decideButtons' own
// hasSignature parameter is what actually gates Approve on that, computed in internal/web.
templ signatureConfirmation(r *data.Record) {
	if signaturePlaced(r) {
		<p class="step-status">
			{ fmt.Sprintf("Your signature will be stamped on page %d at %.0f%%, %.0f%% (%.0f%% wide) when you approve.",
				signaturePage(r), signatureCoord(r, action.FieldStepSignatureX), signatureCoord(r, action.FieldStepSignatureY), signatureWidth(r)) }
		</p>
	} else {
		<p class="step-status">
			You haven't placed your signature for this document yet --
			<a href={ templ.URL(fmt.Sprintf("/machines/%s/records/%s/signature-placement", action.DocumentMachineID, toString(r.Values[action.FieldStepDocument]))) }>place it now</a>.
		</p>
	}
}

// ChildSectionView renders one child collection: a compact table of the child Machine's records,
// each row the same generic RecordRow used everywhere else.
templ ChildSectionView(cc ChildSection, actorID string) {
	<h2>{ cc.Machine.Name } ({ fmt.Sprint(len(cc.Records)) })</h2>
	<table>
		<thead>
			<tr>
				for _, f := range cc.Machine.Fields {
					<th>{ f.Name }</th>
				}
				<th></th>
			</tr>
		</thead>
		<tbody>
			for _, rec := range cc.Records {
				@RecordRow(cc.Machine, rec, cc.Relations, actorID)
			}
		</tbody>
	</table>
}

// RecordDetailEdit is one Record's detail in edit mode: the same Field set as an inline form.
templ RecordDetailEdit(m *domain.Machine, r *data.Record, relations RelationOptions) {
	<div id="record-detail">
		<form
			hx-put={ fmt.Sprintf("/machines/%s/records/%s", m.ID, r.ID) }
			hx-target="#record-detail"
			hx-swap="outerHTML"
			hx-encoding="multipart/form-data"
		>
			<h1>{ recordTitle(m, r) }</h1>
			<code>{ r.ID }</code>
			<dl class="detail-fields">
				for _, f := range m.Fields {
					<dt>{ f.Name }</dt>
					<dd>
						@fieldInput(f, r.Values[f.ID], relations)
					</dd>
				}
			</dl>
			<div class="actions">
				<button type="submit" class="primary">Save</button>
				<button
					type="button"
					hx-get={ fmt.Sprintf("/machines/%s/records/%s", m.ID, r.ID) }
					hx-target="#record-detail"
					hx-swap="outerHTML"
				>Cancel</button>
			</div>
		</form>
	</div>
}

// recordTitle uses the Machine's first Field as the record's display title, the same label-field
// convention already used for relation options (main.go's loadRelationOptions).
func recordTitle(m *domain.Machine, r *data.Record) string {
	if len(m.Fields) == 0 {
		return r.ID
	}
	return toString(r.Values[m.Fields[0].ID])
}

// hiddenDetailField skips an Approval Step's own raw signature-placement fields from the
// generic field list -- approvalStepper and signatureConfirmation already present that same
// information in human-readable form elsewhere on this same page (the UX review that named this,
// 2026-09-19), so the raw percentages here would only be noise, not information a viewer needs.
func hiddenDetailField(m *domain.Machine, f domain.Field) bool {
	if m.ID != action.StepMachineID {
		return false
	}
	switch f.ID {
	case action.FieldStepSignaturePage, action.FieldStepSignatureX, action.FieldStepSignatureY, action.FieldStepSignatureWidth, action.FieldStepSignatureImage:
		return true
	default:
		return false
	}
}

// canDeleteInView answers the same two questions internal/web's deleteAllowed enforces
// server-side: business state (action.CanDeleteApprovalStep/CanDeleteDocument, from data this
// page already has in hand -- r's own Values, and a Document's own Approval Steps, already
// fetched as one of its child collections, Phase 9) and, since deleteAllowed now ANDs it in too,
// any declared domain.ActionDelete Permission (authorization.AllowsAction) -- so no extra query
// is needed just to decide whether to show the Delete button. Presentation only: the server is
// what actually protects the data either way, the same posture decideButtons already established
// for Approve/Reject.
func canDeleteInView(m *domain.Machine, r *data.Record, children []ChildSection, actorID string) (bool, string) {
	ok, reason := true, ""
	switch m.ID {
	case action.StepMachineID:
		ok, reason = action.CanDeleteApprovalStep(r.Values)
	case action.DocumentMachineID:
		status, _ := r.Values[action.FieldDocumentStatus].(string)
		steps := []*data.Record(nil)
		for _, cc := range children {
			if cc.Machine.ID == action.StepMachineID {
				steps = cc.Records
			}
		}
		ok, reason = action.CanDeleteDocument(status, steps)
	}
	if ok && !authorization.AllowsAction(m, domain.ActionDelete, r.Values, actorID) {
		return false, "not allowed"
	}
	return ok, reason
}
