package rendering

import (
	"fmt"

	"menata.app/internal/action"
	"menata.app/internal/authorization"
	"menata.app/internal/data"
	"menata.app/internal/domain"
)

// ChildSection is one resolved child collection ready to render: the child Machine, its records
// (already filtered to the parent being viewed, in sort_order), and the relation options those
// records' own reference fields need (ROADMAP.md Phase 9).
type ChildSection struct {
	Machine   *domain.Machine
	Records   []*data.Record
	Relations RelationOptions
}

// DocumentSignaturePlacement is the composed placement view the Document's own detail page embeds
// -- nil for every Machine other than mch_document.
//
// Since Fase 6c-3 it carries a resolved PlacementView rather than raw records, relation options
// and a Machine for the page to resolve itself. The embed and the dedicated screen now share one
// composed shape and differ only in markup, which is what let this file's neighbour leave the
// projection ratchet: a Page renders what Composition decided.
type DocumentSignaturePlacement struct {
	View PlacementView
}

// RecordDetailPage is a dedicated per-record view (ROADMAP.md Phase 8), replacing inline-only
// editing (table row / board card) as the host for richer content later phases add (Phase 9's
// child collections, Phase 13's activity feed).
// actor is the viewing identity, needed only so an Action the viewer is not permitted to
// perform isn't offered in the first place (ROADMAP.md Phase 16) -- the server enforces the same
// rule regardless, this only keeps the UI honest about it.
templ RecordDetailPage(m *domain.Machine, r *data.Record, relations RelationOptions, groups GroupOptions, children []ChildSection, actor domain.Actor, sigPlacement *DocumentSignaturePlacement, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	@appShell(m.Name, workspaceName, viewer, switchWorkspaceHref) {
		@detailBackLink(m)
		<div id="record-detail" class="flex flex-col gap-4">
			@RecordDetailView(m, r, relations, groups, children, actor, sigPlacement)
		</div>
	}
}

// detailBackLink is Document/Approval Step's own back-link exception: those two Machines only
// exist as part of Case 3's Document Approval flow, so their own generic Machine page
// (/machines/mch_document, /machines/mch_approval_step) is POC scaffolding no real approver
// should land on (owner request, 2026-09-19) -- send them back to Approval Inbox instead, via the
// same routeByID/labelByID idiom documentsubmit.templ's own "← Approval Inbox" link already uses.
// Every other
// Machine (Task, Project, ...) has no bespoke flow of its own, so its generic page remains the
// real destination.
templ detailBackLink(m *domain.Machine) {
	if m.ID == action.DocumentMachineID || m.ID == action.StepMachineID {
		<a href={ templ.SafeURL(routeByID(ctx, "nav_approval_inbox")) } class="text-xs text-blue-600 hover:text-blue-700">← { labelByID(ctx, "nav_approval_inbox") }</a>
	} else {
		<a href={ templ.URL("/machines/" + m.ID) } class="text-xs text-blue-600 hover:text-blue-700">← { m.Name }</a>
	}
}

// RecordDetailView is one Record's read-only detail: every Field as a label/value pair, plus one
// section per child collection -- every record of another Machine that references this one
// (ROADMAP.md Phase 9), reusing RecordRow exactly as table/board Layouts already do.
templ RecordDetailView(m *domain.Machine, r *data.Record, relations RelationOptions, groups GroupOptions, children []ChildSection, actor domain.Actor, sigPlacement *DocumentSignaturePlacement) {
	<div id="record-detail" class="flex flex-col gap-4">
		<div class="flex flex-col gap-1">
			<h1 class="m-0 text-xl font-medium">{ recordTitle(m, r) }</h1>
			if m.ID == action.DocumentMachineID {
				<code class="font-mono text-2xs text-slate-400">{ action.DocumentReference(r.SortOrder) }</code>
			} else {
				<code class="font-mono text-2xs text-slate-400">{ r.ID }</code>
			}
		</div>
		<dl class="m-0 grid grid-cols-1 gap-x-4 gap-y-3 rounded-lg border border-slate-200 bg-white p-4 text-sm sm:grid-cols-[10rem_1fr]">
			for _, f := range m.Fields {
				if !hiddenDetailField(m, f) {
					<dt class="self-center text-2xs font-medium tracking-wide text-slate-500 uppercase">{ f.Name }</dt>
					<dd class="m-0 text-slate-900">
						if f.ID == m.SLAField {
							@slaBadgePill(r.Values[f.ID])
						} else if f.Type == domain.FieldTypeFile {
							@fileLink(r.Values[f.ID])
							if m.ID == action.DocumentMachineID && f.ID == action.FieldDocumentFile {
								@pdfThumbnail(m.ID, r.ID)
							}
						} else if f.IsReference() {
							{ RelationLabel(relations, f.RelatedMachine, toString(r.Values[f.ID])) }
						} else if f.Type == domain.FieldTypeGroup {
							{ GroupLabel(groups, toString(r.Values[f.ID])) }
						} else {
							{ fmt.Sprint(r.Values[f.ID]) }
						}
					</dd>
				}
			}
		</dl>
		if m.ID == action.StepMachineID {
			// Fase 6b: the Approve/Reject bar is no longer here. It lived on this generic page only
			// because an Approval Step had no screen of its own, and it cost the whole detail route
			// two Case 3 obligations -- reading fld_decision straight off the record, the reason
			// this file sat in internal/conformance's projection ratchet, and a signature lookup
			// run for every Machine's detail page, mch_task included. Board 10 is that screen now;
			// this links to it rather than rendering a second, quietly diverging copy of the same
			// decision.
			<a href={ templ.URL(fmt.Sprintf("/machines/%s/records/%s/review", m.ID, r.ID)) } class="text-sm font-medium text-blue-600 hover:text-blue-700">Review and decide →</a>
		}
		{{ deletable, blockedReason := canDeleteInView(m, r, children, actor) }}
		<div class="flex flex-wrap items-center gap-2">
			if m.ID == action.DocumentMachineID {
				<a href={ templ.URL(fmt.Sprintf("/machines/%s/records/%s/signature-placement", m.ID, r.ID)) } class={ controlSecondary }>Signature Positions</a>
			}
			if authorization.AllowsAction(m, domain.ActionEdit, r.Values, actor) {
				<button
					class={ controlSecondary }
					hx-get={ fmt.Sprintf("/machines/%s/records/%s/edit", m.ID, r.ID) }
					hx-target="#record-detail"
					hx-swap="outerHTML"
				>Edit</button>
			}
			if deletable {
				<button
					class={ controlSecondary }
					hx-delete={ fmt.Sprintf("/machines/%s/records/%s", m.ID, r.ID) }
					hx-target="#record-detail"
					hx-confirm="Delete this record?"
				>Delete</button>
			} else {
				<span class="text-xs text-slate-500" title={ blockedReason }>Cannot delete: { blockedReason }</span>
			}
		</div>
		for _, cc := range children {
			if m.ID == action.DocumentMachineID && cc.Machine.ID == action.StepMachineID {
				@sectionHeaderRow("Approval Progress", "", "")
				@approvalStepper(cc.Machine.Sequencing, r, cc.Records, cc.Relations)
			} else {
				@ChildSectionView(cc, groups, actor)
			}
		}
		if m.ID == action.DocumentMachineID && sigPlacement != nil {
			@sectionHeaderRow("Signature Positions", "", "")
			@signaturePlacementBlock(sigPlacement.View)
		}
	</div>
}

// pdfThumbnail is a small preview of a Document's own PDF (Step 3's internal/pdf, ROADMAP.md's UI
// mockup conformance audit) -- the capability already existed, reachable only from the
// signature-placement screen; this is the detail page's own use of the same route, not a new one.
templ pdfThumbnail(machineID, recordID string) {
	<div class="mt-2">
		<a href={ templ.URL(fmt.Sprintf("/machines/%s/records/%s/pdf-preview", machineID, recordID)) } target="_blank">
			<img src={ fmt.Sprintf("/machines/%s/records/%s/pdf-preview?page=1", machineID, recordID) } alt="Document PDF preview, page 1" class="block max-w-40 rounded border border-slate-200"/>
		</a>
	</div>
}

// ChildSectionView renders one child collection: a compact table of the child Machine's records,
// each row the same generic RecordRow used everywhere else.
templ ChildSectionView(cc ChildSection, groups GroupOptions, actor domain.Actor) {
	<section class="flex flex-col gap-2">
		@sectionHeaderRow(fmt.Sprintf("%s (%d)", cc.Machine.Name, len(cc.Records)), "", "")
		<div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
			<table class="w-full border-collapse text-sm">
				<thead>
					<tr>
						for _, f := range cc.Machine.Fields {
							<th class={ tableHeadCell }>{ f.Name }</th>
						}
						<th class={ tableHeadCell }></th>
					</tr>
				</thead>
				<tbody>
					for _, rec := range cc.Records {
						@RecordRow(cc.Machine, rec, cc.Relations, groups, actor)
					}
				</tbody>
			</table>
		</div>
	</section>
}

// RecordDetailEdit is one Record's detail in edit mode: the same Field set as an inline form.
templ RecordDetailEdit(m *domain.Machine, r *data.Record, relations RelationOptions, groups GroupOptions) {
	<div id="record-detail" class="flex flex-col gap-4">
		<form
			class="flex flex-col gap-4"
			hx-put={ fmt.Sprintf("/machines/%s/records/%s", m.ID, r.ID) }
			hx-target="#record-detail"
			hx-swap="outerHTML"
			hx-encoding="multipart/form-data"
		>
			<div class="flex flex-col gap-1">
				<h1 class="m-0 text-xl font-medium">{ recordTitle(m, r) }</h1>
				<code class="font-mono text-2xs text-slate-400">{ r.ID }</code>
			</div>
			<dl class="m-0 grid grid-cols-1 items-center gap-x-4 gap-y-3 rounded-lg border border-slate-200 bg-white p-4 text-sm sm:grid-cols-[10rem_1fr]">
				for _, f := range m.Fields {
					<dt class="self-center text-2xs font-medium tracking-wide text-slate-500 uppercase">{ f.Name }</dt>
					<dd class="m-0">
						@fieldInput(f, r.Values[f.ID], relations, groups)
					</dd>
				}
			</dl>
			<div class="flex flex-wrap items-center gap-2">
				<button type="submit" class={ controlPrimary }>Save</button>
				<button
					type="button"
					class={ controlSecondary }
					hx-get={ fmt.Sprintf("/machines/%s/records/%s", m.ID, r.ID) }
					hx-target="#record-detail"
					hx-swap="outerHTML"
				>Cancel</button>
			</div>
		</form>
	</div>
}

// recordTitle uses the Machine's first Field as the record's display title, the same label-field
// convention already used for relation options (main.go's loadRelationOptions).
func recordTitle(m *domain.Machine, r *data.Record) string {
	if len(m.Fields) == 0 {
		return r.ID
	}
	return toString(r.Values[m.Fields[0].ID])
}

// hiddenDetailField skips an Approval Step's own raw signature-placement fields from the
// generic field list -- the raw percentages are noise, not information a viewer needs (the UX
// review that named this, 2026-09-19).
//
// The human-readable form now lives on the review screen (reviewdocument.templ's
// reviewSignaturePanel), not on this page: signatureConfirmation, which used to say it here in
// prose, moved with the decision bar in Fase 6b. This predicate stays because the fields are still
// declared on the Machine and would still render as five raw numbers without it.
//
// It is a hardcoded list of five Field ids, which metadata cannot express today -- there is no
// per-Field "hide me on a detail page" declaration and 007 §12.4 says the answer is not a new
// `detail` ViewType either ("a View MUST NOT be required as the universal composition
// primitive"). Forward-checkable pointer: ROADMAP.md's "A View composing other Views", the entry
// that would give a detail screen a declared arrangement.
func hiddenDetailField(m *domain.Machine, f domain.Field) bool {
	if m.ID != action.StepMachineID {
		return false
	}
	switch f.ID {
	case action.FieldStepSignaturePage, action.FieldStepSignatureX, action.FieldStepSignatureY, action.FieldStepSignatureWidth, action.FieldStepSignatureImage:
		return true
	default:
		return false
	}
}

// canDeleteInView answers the same two questions internal/web's deleteAllowed enforces
// server-side: business state (action.CanDelete, the single source of truth RecordRow below and
// deleteAllowed both call too -- from data this page already has in hand: r's own Values, and a
// Document's own Approval Steps, already fetched as one of its child collections, Phase 9) and
// any declared domain.ActionDelete Permission (authorization.AllowsAction) -- so no extra query
// is needed just to decide whether to show the Delete button. Presentation only: the server is
// what actually protects the data either way, the same posture the Approve/Reject bar already
// established (now reviewdocument.templ's reviewDecisionBar).
func canDeleteInView(m *domain.Machine, r *data.Record, children []ChildSection, actor domain.Actor) (bool, string) {
	var steps []*data.Record
	for _, cc := range children {
		if cc.Machine.ID == action.StepMachineID {
			steps = cc.Records
		}
	}
	ok, reason := action.CanDelete(m.ID, r.Values, steps)
	if ok && !authorization.AllowsAction(m, domain.ActionDelete, r.Values, actor) {
		return false, "not allowed"
	}
	return ok, reason
}
