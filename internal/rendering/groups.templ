package rendering

import "fmt"
import "menata.app/internal/data"
import "menata.app/internal/domain"

// GroupsPage lists a Workspace's Groups, ported from menata-runtime's own `groups.html`
// (CAP-O07's shipped design, copied into this repo's ui-sample/ alongside this port).
//
// A Group exists so a role can be assigned once and membership managed instead of editing every
// person's row. The cards therefore lead with what each Group *grants*, not just who is in it.
//
// Two deliberate differences from that mockup, both because it was drawn for a different shell:
// it carries menata-runtime's own ui-sample chrome and a client-side search box. The chrome is
// replaced by this app's appShell, and the search box is omitted for the same reason board 04's
// is -- search does not exist anywhere in this app (ROADMAP.md, "Planned"), and a box that
// filters nothing is worse than none.
templ GroupsPage(groups []data.Group, workspaceName string, viewer Viewer, roleApps []RoleApplication, switchWorkspaceHref string) {
	@appShell(labelByID(ctx, "nav_workspace_groups"), workspaceName, viewer, switchWorkspaceHref) {
		@workspaceSettingsFrame(wsSectionGroups) {
		@columnsLayout(domain.GapComfortable, domain.ColumnsAlignEnd) {
			<div class={ "flex flex-col", layoutGap(ctx, domain.GapTight) }>
				@staticText(domain.StaticOverline, "Administration")
				@staticText(domain.StaticHeading, labelByID(ctx, "nav_workspace_groups"))
				<div class={ "max-w-prose text-sm", inkClass(ctx, domain.InkSecondary) }>
					Assign a role to a Group once, then add or remove members — instead of editing every
					person's own row. A member's effective role in an Application is their direct
					assignment plus every role their Groups hold there.
				</div>
			</div>
			<a href={ templ.SafeURL(routeByID(ctx, "nav_workspace_members")) } class={ "text-xs", inkClass(ctx, domain.InkAccent), accentHoverClass(ctx) }>
				{ labelByID(ctx, "nav_workspace_members") } →
			</a>
		}
		@disclosure("+ New group") {
				<form method="POST" action={ templ.SafeURL(routeByID(ctx, "nav_workspace_groups")) } class={ "flex flex-col", layoutGap(ctx, domain.GapComfortable) }>
					@csrfHiddenInput()
					@authField("group_name", "name", "Group name", "text", "off", false)
					@authSubmit("Create group")
				</form>
		}
		if len(groups) == 0 {
			@emptyState("No groups yet. Create one to grant a role to several people at once.")
		}
		@gridLayout(domain.GapComfortable, domain.GridCols1, domain.GridCols2) {
			for _, g := range groups {
				<a href={ templ.SafeURL("/workspace-groups/" + g.ID) } class={ "flex flex-col", layoutGap(ctx, domain.GapDefault), surfaceClasses(ctx), paddingClass(ctx, domain.PaddingPanel), inkClass(ctx, domain.InkStrong) + " " + accentEdgeHoverClass(ctx) }>
					<div class={ "flex items-center justify-between", layoutGap(ctx, domain.GapDefault) }>
						<span class={ textClass(ctx, domain.RoleItem), weightClass(ctx, domain.WeightEmphasis) }>{ g.Name }</span>
						<span class={ "text-2xs", inkClass(ctx, domain.InkSecondary) }>{ fmt.Sprintf("%d member", g.MemberCount) }{ pluralS(g.MemberCount) }</span>
					</div>
					@rowLayout(domain.GapTight, domain.RowAlignStretch, domain.RowJustifyStart) {
						if len(g.Grants) == 0 {
							<span class={ "text-2xs", inkClass(ctx, domain.InkSecondary) }>Grants no role yet</span>
						}
						for _, app := range roleApps {
							if role, ok := g.Grants[app.ID]; ok {
								@statusBadge(app.Name+" · "+role, domain.ToneInfo, domain.BadgeRegular)
							}
						}
					}
				</a>
			}
		}
		}
	}
}

// GroupMemberChoice is one Workspace member offered on the Group detail screen, and whether they
// are currently in the Group.
type GroupMemberChoice struct {
	UserRecordID string
	Email        string
	InGroup      bool
}

// GroupDetailPage is one Group: its membership and the role it holds in each Application, ported
// from menata-runtime's `group-detail.html`.
//
// That mockup renders membership as removable chips plus a separate add-member checkbox list,
// which needs client-side state to assemble the result. This renders one checkbox list, pre-ticked
// for current members — the same thing the form actually submits, since data.SetGroupMembers takes
// the intended final set rather than a sequence of adds and removes. Same outcome, no JS.
//
// The role selects reuse roleSelect and the same RoleApplication vocabulary the member screens
// use, which is what the mockup's own note asks for: "same role vocabulary as a per-user
// assignment".
templ GroupDetailPage(group data.Group, members []GroupMemberChoice, workspaceName string, viewer Viewer, roleApps []RoleApplication, switchWorkspaceHref string) {
	@appShell(group.Name, workspaceName, viewer, switchWorkspaceHref) {
		@workspaceSettingsFrame(wsSectionGroups) {
		<a href={ templ.SafeURL(routeByID(ctx, "nav_workspace_groups")) } class={ "text-xs", inkClass(ctx, domain.InkAccent), accentHoverClass(ctx) }>← { labelByID(ctx, "nav_workspace_groups") }</a>
		<div class={ "flex items-center justify-between", layoutGap(ctx, domain.GapDefault) }>
			@staticText(domain.StaticHeading, group.Name)
			<span class={ "text-2xs", inkClass(ctx, domain.InkSecondary) }>{ fmt.Sprintf("%d member", group.MemberCount) }{ pluralS(group.MemberCount) }</span>
		</div>
		@sectionLayout(domain.GapComfortable) {
			<div class={ "flex flex-col", layoutGap(ctx, domain.GapMicro) }>
				@staticText(domain.StaticPanelHeading, "Members")
				<p class={ "m-0 text-2xs", inkClass(ctx, domain.InkSecondary) }>Everyone ticked here holds this Group's roles.</p>
			</div>
			<form method="POST" action={ templ.SafeURL("/workspace-groups/" + group.ID + "/members") } class={ "flex flex-col", layoutGap(ctx, domain.GapDefault) }>
				@csrfHiddenInput()
				if len(members) == 0 {
					@staticText(domain.StaticMessage, "This Workspace has no members to add.")
				}
				for _, m := range members {
					<label class={ "flex cursor-pointer items-center", layoutGap(ctx, domain.GapDefault), tileClasses(ctx), "p-3" + " " + accentEdgeHoverClass(ctx) }>
						<input type="checkbox" name="member" value={ m.UserRecordID } checked?={ m.InGroup } class={ "size-4", controlAccentClass(ctx) }/>
						@avatar(personInitials("", m.Email), m.Email, domain.AvatarInline, domain.AvatarPresent)
						<span class="truncate text-sm">{ m.Email }</span>
					</label>
				}
				<div class="flex justify-end">
					@authSubmit("Save members")
				</div>
			</form>
		}
		@sectionLayout(domain.GapComfortable) {
			<div class={ "flex flex-col", layoutGap(ctx, domain.GapMicro) }>
				@staticText(domain.StaticPanelHeading, "Application roles")
				@staticText(domain.StaticCaption, "The same role vocabulary each Application declares for a direct assignment.")
			</div>
			<form method="POST" action={ templ.SafeURL("/workspace-groups/" + group.ID + "/roles") } class={ "flex flex-col", layoutGap(ctx, domain.GapComfortable) }>
				@csrfHiddenInput()
				if len(roleApps) == 0 {
					@staticText(domain.StaticMessage, "No Application declares a role vocabulary yet.")
				}
				for _, app := range roleApps {
					@columnsLayout(domain.GapTight, domain.ColumnsAlignCenter) {
						<label for={ "grp_role_" + app.ID } class="text-sm">{ app.Name }</label>
						@roleSelect("grp_role_"+app.ID, app, group.Grants[app.ID])
					}
				}
				<div class="flex justify-end">
					@authSubmit("Save roles")
				</div>
			</form>
		}
		<form method="POST" action={ templ.SafeURL("/workspace-groups/" + group.ID + "/delete") } class="flex justify-end">
			@csrfHiddenInput()
			<button type="submit" class={ "cursor-pointer text-xs", inkClass(ctx, domain.InkSecondary), toneInkHoverClass(ctx, domain.ToneBad) }>Delete this group</button>
		</form>
		}
	}
}
