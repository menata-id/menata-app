package rendering

import (
	"fmt"

	"menata.app/internal/action"
	"menata.app/internal/domain"
)

// ReviewView is board 10's whole content, resolved by composition.ReviewDocument before this file
// is reached.
//
// Every field here is already a string, a number or a bool -- there is no *data.Record in the
// struct and no Values[...] anywhere in this file. That is a hard constraint, not a style: a new
// internal/rendering/*.templ cannot be added to internal/conformance's projection ratchet, which
// may only shrink. The same rule is what pushed the per-approver state into
// composition.stepStates during Fase 6a, and it is why this screen's arrival is what finally lets
// detail.templ out of that list.
type ReviewView struct {
	StepID     string
	DocumentID string
	// Reference is the Document's own human-readable identity (action.DocumentReference), not its
	// storage id -- DOC-0091 in the board.
	Reference    string
	Title        string
	DocumentType string
	Status       string
	SubmittedBy  string
	SubmittedAt  string
	// FileName/FileHref describe the attached PDF. Empty when no file is attached, which the
	// Document card renders as an explicit absence rather than a broken link.
	FileName string
	FileHref string
	// PDFPages is the attached PDF's page count, or 0 when it could not be read. Board 10 writes
	// "6 pages · 2.4 MB"; the byte size half is not rendered, because no part of this app stores an
	// uploaded file's size -- see ROADMAP.md's deferral table.
	PDFPages int
	// Steps is every step of this Document in sequence order, with the viewer's own marked IsYou.
	// Shared with the Approval Inbox's card (StepApprover) -- same data, different markup.
	Steps []StepApprover
	// StepLabel is what the viewer's own step is for, and Decision is where it stands
	// (pending/approved/rejected).
	StepLabel string
	Decision  string
	SLALabel  string
	// SLAOverdue distinguishes a breach from a countdown, which is a colour change rather than a
	// different sentence.
	SLAOverdue bool
	// CanDecide is whether to draw the Approve/Reject bar at all: the viewer is this step's own
	// assignee, the step is still pending, no earlier step is holding it, and the declared
	// Permission allows it. Presentation only -- the POST is refused server-side either way.
	CanDecide bool
	// HasSignature is false when Approve must first open the signature canvas, the render-time half
	// of a gate whose write-time half is decideStep's own applyApprovalSignature. It needs storage
	// I/O this plane cannot do (007 §20), so internal/web computes it.
	HasSignature bool
	// SignaturePage/SignaturePreviewHref/SignatureBoxes are the "Signature positions" panel
	// (2026-09-29 redesign): every sibling Approval Step's own signature marker overlaid on the one
	// page they share, not only the viewer's own -- the panel's previous shape. SignaturePage is 0
	// when no step has placed a marker at all, which the panel renders as an explicit prompt rather
	// than an empty page image with nothing on it.
	SignaturePage       int
	SignaturePreviewHref string
	SignatureBoxes       []ReviewSignatureBox
	// SignatureSignedCount/SignatureStepCount feed the panel's own "N of M signed" badge --
	// "signed" meaning a StepApprover.State of "done", exactly what reviewProgress already colours
	// green, so the badge and the progress list can never disagree.
	SignatureSignedCount int
	SignatureStepCount   int
	// AllPositionsHref is board 09's own screen (SignaturePlacementPage) -- "See all positions"
	// reuses that route rather than adding a second one.
	AllPositionsHref string
}

// ReviewSignatureBox is one Approval Step's own marker in the Signature positions panel: its
// numbered badge, where it sits on the shared page image, and how it renders.
//
// Kind is already resolved to exactly the three states the panel's own legend names --
// "signed" (State == "done"), "yours" (State == "current" and this is the viewer's own step) or
// "waiting" (everything else) -- from the same []StepApprover reviewProgress renders, so the two
// panels can never disagree about who has signed. It is a plain string, not a typed enum, matching
// StepApprover.State's own convention in this file.
type ReviewSignatureBox struct {
	Index int
	Label string
	Kind  string
	// ImageHref is the actual captured signature image, set only for a "signed" box that has one
	// (composition.signatureBoxes) -- rendered instead of the generic checkmark, the same posture
	// the Document card takes for its own file (an honest absence renders the checkmark, never a
	// broken <img>).
	ImageHref   string
	X           float64
	Y           float64
	Width       float64
}

// ReviewDocumentPage is board 10 (ui-sample/case-03-flow1/10-review-document.html, Fase 6b): the
// screen an approver decides on, which until now was the *generic* record-detail page every
// Machine shares.
//
// TWO BOARD ELEMENTS ARE DELIBERATELY NOT RENDERED, both because the app has no data for them
// rather than because they were missed:
//
//   - "Breached · 4 hours ago". fld_due_date is `type: date` with no time component and
//     domain.KnownFieldTypes has no datetime type; experience.EvaluateSLA truncates to day on
//     purpose, which is what makes "Due today" mean anything. Board 07 hit this first and
//     ROADMAP.md's deferral table carries it once for both screens.
//   - "2.4 MB" beside the page count. An uploaded file's byte size is stored nowhere -- not in the
//     record, not in internal/storage's key. The page count is real (internal/pdf.PageCount) and is
//     rendered; inventing the size would be worse than omitting it.
//
// The step titles ("Finance Review") are real as of this phase: fld_step_name is declared, and
// composition.stepLabel falls back to the assignee's name until board 08's wizard writes it in
// Fase 6c. A Document submitted today therefore reads exactly as it did before.
templ ReviewDocumentPage(v ReviewView, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	@appShell(v.Title, workspaceName, viewer, switchWorkspaceHref) {
		<a href={ templ.SafeURL(routeByID(ctx, "nav_approval_inbox")) } class="text-xs text-blue-600 hover:text-blue-700">
			← { labelByID(ctx, "nav_approval_inbox") }
		</a>
		<div class="flex flex-col gap-2">
			<div class="flex flex-wrap items-center gap-2">
				<code class="rounded bg-slate-100 px-2 py-0.5 text-2xs text-slate-600">{ v.Reference }</code>
				@reviewStatusPill(v.Status)
			</div>
			<h1 class="m-0 text-xl font-medium">{ v.Title }</h1>
			<div class="text-sm text-slate-500">
				{ v.DocumentType }
				if v.SubmittedBy != "" {
					{ " · submitted by " + v.SubmittedBy }
					if v.SubmittedAt != "" {
						{ " · " + v.SubmittedAt }
					}
				}
			</div>
		</div>
		<div class="grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,1fr)_320px]">
			<div class="flex flex-col gap-4">
				@reviewDocumentCard(v)
				@reviewProgress(v.Steps)
			</div>
			@reviewSignaturePanel(v)
		</div>
		@reviewDecisionBar(v)
	}
}

// reviewStatusPill renders fld_status's own value. The three known values get their own colour and
// anything else falls through to neutral grey rather than being hidden -- a status this screen has
// not been taught about is still a fact about the Document.
//
// It draws no pill of its own since 2026-09-29: statusPill (machine.templ) owns the shape, and this
// function is now only the part that is genuinely this screen's -- which of *fld_status's* values
// means what. The pill's second caller is the inference diagnostics page, over an unrelated closed
// vocabulary, and keeping the mapping here is what lets both exist without either knowing the other's
// words (007 §12.3's boundedness rule).
templ reviewStatusPill(status string) {
	@statusPill(status, reviewStatusTone(status))
}

// reviewStatusTone maps a Document's status to a tone. Unknown values fall through to neutral rather
// than being hidden -- a status this screen has not been taught about is still a fact about the
// Document, which was this function's own original reasoning and is unchanged.
func reviewStatusTone(status string) PillTone {
	switch status {
	case "in_review":
		return PillInfo
	case "approved":
		return PillGood
	case "rejected":
		return PillBad
	}
	return PillNeutral
}

// reviewDocumentCard is the board's "Document" panel: the file, its page count, and the two ways
// to open it.
//
// View PDF and Download point at the same /uploads/ URL and differ only by the HTML download
// attribute -- no second route and no change to serveUpload's own content sniffing. The board draws
// two affordances; the app has one file, so two links over one route is the honest rendering.
templ reviewDocumentCard(v ReviewView) {
	<section class="flex flex-col gap-4 rounded-lg border border-slate-200 bg-white p-5">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<h2 class="m-0 text-sm font-medium">Document</h2>
			if v.FileHref != "" {
				<div class="flex gap-2">
					<a href={ templ.SafeURL(v.FileHref) } target="_blank" class="flex h-8 items-center rounded-md border border-slate-200 px-3 text-xs hover:border-blue-300">View PDF</a>
					<a href={ templ.SafeURL(v.FileHref) } download class="flex h-8 items-center rounded-md border border-slate-200 px-3 text-xs hover:border-blue-300">Download</a>
				</div>
			}
		</div>
		if v.FileHref == "" {
			<p class="m-0 text-sm text-slate-400">No file is attached to this document.</p>
		} else {
			<div class="flex items-center gap-3 rounded-md bg-slate-50 p-3">
				<span class="flex size-10 shrink-0 items-center justify-center rounded-md bg-red-100 text-2xs font-medium text-red-700">PDF</span>
				<span class="flex min-w-0 flex-col">
					<span class="truncate text-sm">{ v.FileName }</span>
					if v.PDFPages > 0 {
						<span class="text-2xs text-slate-400">{ fmt.Sprintf("%d page", v.PDFPages) }{ pluralS(v.PDFPages) }</span>
					}
				</span>
			</div>
		}
	</section>
}

// reviewProgress is board 10's Approval Progress list: the same []StepApprover the Approval Inbox
// card renders as chips, drawn here as the board's vertical list.
//
// It is not approvalStepper (approvalstepper.templ). That component still serves the Document's own
// generic detail page and is written against pageStyles; Tailwind's Preflight ties chrome to
// content, so one markup cannot serve both until that page ports too. The *data* is shared, which
// is the part worth sharing -- see StepApprover's own doc comment.
templ reviewProgress(steps []StepApprover) {
	<section class="flex flex-col gap-4 rounded-lg border border-slate-200 bg-white p-5">
		<h2 class="m-0 text-sm font-medium">Approval Progress</h2>
		<ol class="m-0 flex list-none flex-col gap-4 p-0">
			for i, s := range steps {
				<li aria-label={ s.Label + ", " + approverStateLabel(s.State) } class="flex items-start gap-3">
					@reviewStepMarker(s, i+1)
					<span class="flex min-w-0 flex-col gap-0.5">
						<span class="flex flex-wrap items-center gap-2">
							<span class="text-sm">
								if s.Label != "" {
									{ s.Label }
								} else {
									Unassigned
								}
							</span>
							if s.IsYou {
								<span class="rounded-full bg-blue-50 px-2 py-0.5 text-3xs text-blue-700">You</span>
							}
						</span>
						<span class="text-2xs text-slate-400">{ reviewStepStatusLine(s) }</span>
					</span>
				</li>
			}
		</ol>
	</section>
}

// reviewStepMarker is the numbered circle: a tick for a decided step, its sequence number
// otherwise. aria-hidden because the <li> above already carries the step's name and state -- a
// screen reader announcing "2" between them would add nothing.
templ reviewStepMarker(s StepApprover, position int) {
	<span
		aria-hidden="true"
		class={ "flex size-6 shrink-0 items-center justify-center rounded-full text-3xs font-medium",
			templ.KV("bg-emerald-500 text-white", s.State == "done"),
			templ.KV("bg-blue-600 text-white ring-4 ring-blue-100", s.State == "current"),
			templ.KV("bg-red-500 text-white", s.State == "rejected"),
			templ.KV("bg-slate-200 text-slate-500", s.State == "waiting") }
	>
		switch s.State {
			case "done":
				✓
			case "rejected":
				✗
			default:
				{ fmt.Sprint(position) }
		}
	</span>
}

// reviewStepStatusLine is the sub-line under a step's title: who holds it, and what has happened.
// The approver's name lives here rather than in the title because the title is now the step's own
// purpose -- which is the whole reason fld_step_name was added.
func reviewStepStatusLine(s StepApprover) string {
	who := s.Name
	if who == "" {
		who = "Unassigned"
	}
	switch s.State {
	case "done":
		if s.Decided != "" {
			return who + " · Approved · " + s.Decided
		}
		return who + " · Approved"
	case "rejected":
		if s.Decided != "" {
			return who + " · Rejected · " + s.Decided
		}
		return who + " · Rejected"
	case "current":
		if s.IsYou {
			return "Pending your decision"
		}
		return who + " · Pending decision"
	default:
		return who + " · Waiting"
	}
}

// reviewSignaturePanel is the board's right column: every sibling Approval Step's own signature
// marker, drawn over the real page rather than described, plus a legend and a link to board 09's
// own full list -- the panel's shape since the 2026-09-29 redesign ("Signature positions").
//
// It reuses the pdf-preview route the signature-placement screen already serves, so this screen
// adds no rendering capability -- only a read-only framing of one the app had. Each marker's width
// is that step's own placed percentage; height is a fixed Tailwind size rather than the aspect
// ratio, because a marker now carries content (an icon, a line of text) that must stay legible
// regardless of how tall the rendered page is.
//
// Nobody has placed a marker at all when SignaturePage is 0 (composition.signatureBoxes' own zero
// value), which renders as an explicit prompt rather than an empty page image with nothing on it --
// the same posture the panel's previous single-marker shape took.
templ reviewSignaturePanel(v ReviewView) {
	<aside class="flex h-fit flex-col gap-3 rounded-lg border border-slate-200 bg-white p-5">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<h2 class="m-0 text-sm font-medium">Signature positions</h2>
			if v.SignatureStepCount > 0 {
				<span class="rounded-full bg-slate-100 px-2.5 py-1 text-2xs whitespace-nowrap text-slate-600">
					{ fmt.Sprintf("%d of %d signed", v.SignatureSignedCount, v.SignatureStepCount) }
				</span>
			}
		</div>
		if v.SignaturePage == 0 {
			<p class="m-0 text-2xs text-slate-500">No signature position has been placed for this document yet.</p>
		} else {
			<div class="relative overflow-hidden rounded-md border border-slate-200 bg-slate-50">
				<img src={ v.SignaturePreviewHref } alt={ fmt.Sprintf("Page %d of the document", v.SignaturePage) } class="block w-full"/>
				for _, b := range v.SignatureBoxes {
					@reviewSignatureBox(b)
				}
			</div>
			<div class="text-right text-3xs text-slate-400">{ reviewSignaturePageLabel(v) }</div>
			@reviewSignatureLegend()
			<p class="m-0 text-2xs leading-5 text-slate-500">
				Numbers match the approval steps on the left. Boxes sit where the submitter placed them.
				<a href={ templ.SafeURL(v.AllPositionsHref) } class="text-blue-600 hover:text-blue-700">See all positions →</a>
			</p>
		}
	</aside>
}

func reviewSignaturePageLabel(v ReviewView) string {
	if v.PDFPages > 0 {
		return fmt.Sprintf("Page %d of %d", v.SignaturePage, v.PDFPages)
	}
	return fmt.Sprintf("Page %d", v.SignaturePage)
}

// reviewSignatureBox is one marker: a numbered badge, a kind badge (check/pencil/clock, matching
// the legend below), and its content -- the actual captured signature image for a signed step
// that has one, a plain checkmark for a signed step that does not (composition.signatureBoxes
// leaves ImageHref empty rather than guess), "stamped when you approve" for the viewer's own
// still-pending step, or an empty dashed placeholder for anyone else's still-pending step.
// Positioned by percentage (the same convention the predecessor marker used) so it stays aligned
// as the page image scales; sized by a fixed Tailwind height rather than a page-relative one,
// because its content (an image or icon, a line of text) needs to stay legible regardless of how
// tall the rendered page is.
templ reviewSignatureBox(b ReviewSignatureBox) {
	<div style={ reviewSignatureBoxStyle(b) } class="absolute w-[90px] -translate-x-1/2 -translate-y-1/2 text-center">
		<div
			class={ "relative flex h-14 items-center justify-center rounded border",
				templ.KV("border-emerald-300 bg-emerald-50", b.Kind == "signed"),
				templ.KV("border-dashed border-blue-400 bg-blue-50 ring-2 ring-blue-100", b.Kind == "yours"),
				templ.KV("border-dashed border-slate-300 bg-slate-50", b.Kind == "waiting") }
		>
			switch {
				case b.Kind == "signed" && b.ImageHref != "":
					<img src={ b.ImageHref } alt={ fmt.Sprintf("%s's signature", b.Label) } class="h-9 max-w-[80%] object-contain"/>
				case b.Kind == "signed":
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
				case b.Kind == "yours":
					<span class="px-1 text-3xs leading-tight text-blue-700">stamped when you approve</span>
				default:
					<span aria-hidden="true" class="h-px w-2/3 border-t border-dotted border-slate-300"></span>
			}
			<span
				aria-hidden="true"
				class={ "absolute -top-1.5 -left-1.5 flex size-4 items-center justify-center rounded-full border bg-white text-3xs font-medium",
					templ.KV("border-emerald-500 text-emerald-600", b.Kind == "signed"),
					templ.KV("border-blue-500 text-blue-600", b.Kind == "yours"),
					templ.KV("border-slate-400 text-slate-500", b.Kind == "waiting") }
			>{ fmt.Sprint(b.Index) }</span>
			<span
				role="img"
				aria-label={ fmt.Sprintf("Step %d: %s", b.Index, reviewSignatureKindLabel(b.Kind)) }
				class={ "absolute -top-1.5 -right-1.5 flex size-4 items-center justify-center rounded-full border border-white",
					templ.KV("bg-emerald-500", b.Kind == "signed"),
					templ.KV("bg-blue-600", b.Kind == "yours"),
					templ.KV("bg-slate-400", b.Kind == "waiting") }
			>
				@reviewSignatureKindIcon(b.Kind)
			</span>
		</div>
		<div
			class={ "mt-1 truncate text-3xs",
				templ.KV("text-emerald-700", b.Kind == "signed"),
				templ.KV("text-blue-700", b.Kind == "yours"),
				templ.KV("text-slate-400", b.Kind == "waiting") }
		>{ b.Label }</div>
	</div>
}

// reviewSignatureBoxStyle positions a box the same way the predecessor marker did: X/Y as the
// box's own centre point, Width as a percentage of the page's own width -- composition.
// signatureBoxes reads all three from the step's own signature_placement: Fields, the same ones
// the placement screen writes.
func reviewSignatureBoxStyle(b ReviewSignatureBox) string {
	return fmt.Sprintf("left:%.2f%%;top:%.2f%%;width:%.2f%%", b.X, b.Y, b.Width)
}

// reviewSignatureKindLabel/reviewSignatureKindIcon/reviewSignatureLegend share one vocabulary --
// signed/yours/waiting -- between a box's own corner badge and the panel's legend, so the two
// cannot silently drift into describing the same three states differently.
func reviewSignatureKindLabel(kind string) string {
	switch kind {
	case "signed":
		return "Signed"
	case "yours":
		return "Yours — not yet"
	default:
		return "Not signed"
	}
}

templ reviewSignatureKindIcon(kind string) {
	switch kind {
		case "signed":
			<svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
		case "yours":
			<svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9a2.5 2.5 0 0 0-3.5-3.5L4.5 16.5z"></path><path d="M14.5 6.5 17.5 9.5"></path></svg>
		default:
			<svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8"></circle><path d="M12 8v4.5l3 1.5"></path></svg>
	}
}

templ reviewSignatureLegend() {
	<div class="flex flex-wrap gap-3.5 text-3xs text-slate-600">
		for _, kind := range []string{"signed", "yours", "waiting"} {
			<span class="flex items-center gap-1.5">
				<span
					aria-hidden="true"
					class={ "flex size-3.5 items-center justify-center rounded-full",
						templ.KV("bg-emerald-500", kind == "signed"),
						templ.KV("bg-blue-600", kind == "yours"),
						templ.KV("bg-slate-400", kind == "waiting") }
				>
					@reviewSignatureKindIcon(kind)
				</span>
				{ reviewSignatureKindLabel(kind) }
			</span>
		}
	</div>
}

// reviewDecisionBar is board 10's footer: the SLA on the left, Approve/Reject on the right.
//
// It replaces decideButtons, which lived in detail.templ and read fld_decision straight off the
// record. That read is why detail.templ sat in the projection ratchet; moving the bar here (where
// the values arrive already resolved) is what lets that entry go.
templ reviewDecisionBar(v ReviewView) {
	<div class="flex flex-col gap-3 rounded-lg border border-slate-200 bg-white p-4 sm:flex-row sm:items-center sm:justify-between">
		<span class="flex items-center gap-2">
			<span class="text-3xs tracking-wide text-slate-400 uppercase">SLA</span>
			if v.SLALabel == "" {
				<span class="text-sm text-slate-400">No due date</span>
			} else {
				<span class={ "text-sm", templ.KV("text-red-600", v.SLAOverdue), templ.KV("text-slate-600", !v.SLAOverdue) }>
					{ v.SLALabel }
				</span>
			}
		</span>
		if v.CanDecide {
			<form hx-post={ fmt.Sprintf("/machines/%s/records/%s/decide", approvalMachineID(ctx, domain.WorkflowRoleStep), v.StepID) } class="flex gap-2">
				<button type="submit" name="decision" value={ action.DecisionRejected } class={ controlDanger }>Reject</button>
				if v.HasSignature {
					<button type="submit" name="decision" value={ action.DecisionApproved } class={ controlPrimary }>Approve</button>
				} else {
					<button type="button" class={ "sig-approve-trigger " + controlPrimary } data-modal={ "sig-modal-" + v.StepID }>Approve</button>
					@signatureModal(v.StepID)
				}
			</form>
		} else if v.Decision != action.DecisionPending {
			<span class="rounded-full bg-slate-100 px-3 py-1 text-2xs text-slate-600">{ v.Decision }</span>
		} else {
			<span class="text-2xs text-slate-400">Awaiting its own assignee's decision</span>
		}
	</div>
}

// signatureModal is the canvas dialog reviewDecisionBar opens when the viewer has no signature on
// file yet (neither a saved mch_signature nor a one-time fld_signature_image already on this
// step) -- owner request, 2026-09-19: "draw it the first time, ask to remember it, don't ask again
// once it's saved." Nested inside the decision bar's own <form> so its own Approve button is just
// one more submit control on the same hx-post -- no second route, no separate page.
//
// Moved here from detail.templ in Fase 6b, and that move had a defect corrected in Fase 6c-3. The
// comment here used to say the .sig-* class names were "behavioural hooks the script selects on,
// not styling, which is why they survive the move to Tailwind untouched." Half true: some of them
// ARE styled, in machine.templ's pageStyles -- which appShell never loads. So this dialog rendered
// with no size, no border and, worse, without `touch-action: none` on its canvas, which is
// behaviour rather than decoration: a touch drag was being taken as a page scroll, so signing on a
// phone did not work. The styling is now carried by utilities on the elements; the class names
// stay purely as script hooks, which is what the original comment claimed they already were.
//
// Freehand drawing has no non-JS equivalent, so this is a second named vanilla-JS exception
// alongside signature-placement's own drag math (same file, same posture, README.md's "Tech
// stack"). Event delegation on document, matching signature-placement's own reasoning for reusing
// one listener rather than one per element -- this dialog is only ever rendered once per page
// (the decision bar itself is), so delegation isn't strictly required for re-binding after a swap
// the way it was there, but it keeps both scripts written the same way.
//
// The submit listener is registered with useCapture=true specifically so it runs before htmx's own
// submit handling (a bubble-phase listener on the form itself fires during the "at target" phase,
// before any bubble-phase document listener) -- without that, htmx would read the hidden
// signature_image input before this had a chance to fill it from the canvas.
templ signatureModal(stepID string) {
	<dialog id={ "sig-modal-" + stepID } class="sig-modal max-w-110 rounded-lg border border-slate-200 p-5 shadow-lg backdrop:bg-slate-900/40">
		<h3 class="m-0 text-sm font-medium">Add your signature</h3>
		<p class="mt-1.5 mb-3 text-2xs text-slate-500">Draw your signature below to approve. It's only used for this document unless you choose to save it.</p>
		<canvas class="sig-modal-canvas block h-40 w-full cursor-crosshair touch-none rounded-md border border-dashed border-slate-300 bg-white" width="400" height="160"></canvas>
		<div class="mt-3 flex items-center justify-between gap-3">
			<button type="button" class="sig-modal-clear cursor-pointer text-xs text-blue-600 hover:text-blue-700">Clear</button>
			<label class="flex cursor-pointer items-center gap-1.5 text-2xs text-slate-600">
				<input type="checkbox" name="save_signature" class="size-4 accent-blue-500"/>
				Save my signature for next time
			</label>
		</div>
		<input type="hidden" name="signature_image" class="sig-modal-image"/>
		<div class="mt-3 flex items-center justify-end gap-2">
			<button type="button" class={ "sig-modal-cancel " + controlSecondary }>Cancel</button>
			<button type="submit" name="decision" value={ action.DecisionApproved } class={ "sig-modal-approve " + controlPrimary }>Approve</button>
		</div>
	</dialog>
	<script>
		(function () {
			document.addEventListener("click", function (e) {
				var trigger = e.target.closest(".sig-approve-trigger");
				if (trigger) {
					var modal = document.getElementById(trigger.dataset.modal);
					if (modal) modal.showModal();
					return;
				}
				var cancel = e.target.closest(".sig-modal-cancel");
				if (cancel) {
					cancel.closest("dialog").close();
					return;
				}
				var clear = e.target.closest(".sig-modal-clear");
				if (clear) {
					var canvas = clear.closest("dialog").querySelector(".sig-modal-canvas");
					canvas.getContext("2d").clearRect(0, 0, canvas.width, canvas.height);
				}
			});

			document.addEventListener("submit", function (e) {
				var submitter = e.submitter;
				if (!submitter || !submitter.classList.contains("sig-modal-approve")) return;
				var dialog = submitter.closest("dialog");
				var canvas = dialog.querySelector(".sig-modal-canvas");
				dialog.querySelector(".sig-modal-image").value = canvas.toDataURL("image/png");
			}, true);

			var drawing = false, lastX = 0, lastY = 0;
			document.addEventListener("pointerdown", function (e) {
				var canvas = e.target.closest(".sig-modal-canvas");
				if (!canvas) return;
				drawing = true;
				var rect = canvas.getBoundingClientRect();
				lastX = e.clientX - rect.left;
				lastY = e.clientY - rect.top;
				canvas.setPointerCapture(e.pointerId);
			});
			document.addEventListener("pointermove", function (e) {
				if (!drawing) return;
				var canvas = e.target.closest(".sig-modal-canvas");
				if (!canvas) return;
				var rect = canvas.getBoundingClientRect();
				var x = e.clientX - rect.left;
				var y = e.clientY - rect.top;
				var ctx = canvas.getContext("2d");
				ctx.strokeStyle = "#1a1a1a";
				ctx.lineWidth = 2;
				ctx.lineCap = "round";
				ctx.beginPath();
				ctx.moveTo(lastX, lastY);
				ctx.lineTo(x, y);
				ctx.stroke();
				lastX = x;
				lastY = y;
			});
			document.addEventListener("pointerup", function () { drawing = false; });
		})();
	</script>
}
