package rendering

import (
	"context"
	"net/url"
	"strings"

	"menata.app/internal/domain"
)

// chipOfFilter is one lowered chip of a FilterChips: what it says, how many records it would list, where it leads and
// whether the request already chose it.
type chipOfFilter struct {
	Label, Count, Href string
	Current            bool
}

// parseFilterChips reads the `chips` lowering produced (ir.lowerFilterChips): one tab-separated line per chip. A line of
// the wrong shape is skipped -- the registry's validator has already refused one.
func parseFilterChips(s string) []chipOfFilter {
	var out []chipOfFilter
	for _, line := range strings.Split(s, "\n") {
		p := strings.Split(line, "\t")
		// A chip leads back to this page and nowhere else: an address that is not a query string is not drawn.
		if len(p) != 4 || !strings.HasPrefix(p[2], "?") {
			continue
		}
		out = append(out, chipOfFilter{Label: p[0], Count: p[1], Href: p[2], Current: p[3] == "1"})
	}
	return out
}

// filterChips is the registered renderer for `domain.ComponentFilterChips`: a row of pill links, each a choice of one
// query parameter with the count of records it lists (mockup K01b), the chosen one filled with the strong ink and marked
// aria-current. Each address is relative ("?kind=crew&q=reza"), built by lowering, so the page's route is never written
// here and the request's other filters ride along.
templ filterChips(label, chips string) {
	<nav aria-label={ label }>
		@rowLayout(domain.GapTight, domain.RowAlignCenter, domain.RowJustifyStart) {
			for _, c := range parseFilterChips(chips) {
				@filterChipLink(c.Label, c.Count, c.Href, c.Current)
			}
		}
	</nav>
}

// filterChipLink is the one look of a filter chip: a pill link with its count, the current one filled with the strong
// ink and marked aria-current, so it is not told by colour alone. The Approval Inbox's SLA chips (gap-plan P3a) and every
// declared FilterChips draw it; `TestNoHandWrittenSegmentedControl` lists it as the one place outside the segmented
// control that writes the marker.
templ filterChipLink(label, count, href string, current bool) {
	<a
		href={ templ.SafeURL(href) }
		if current {
			aria-current="true"
		}
		class={ chipClasses(ctx, current) }
	>
		{ label } <span class={ chipCountClass(ctx, current) }>{ count }</span>
	</a>
}

// chipClasses is the one look of a chip: a bordered pill at the meta size. The Approval Inbox's SLA chips, every FilterChips and a
// `static: link` with `variant: chip` draw it, so a suggestion and a filter cannot drift into two pills.
func chipClasses(ctx context.Context, current bool) string {
	return radiusClass(ctx, domain.RadiusPill) + " border px-3 py-1 " + textClass(ctx, domain.RoleMeta) + " " + chipStateClasses(ctx, current)
}

// chipStateClasses is a chip's state in one Go choice -- two Theme readers as templ.KV keys collide under a remapped
// theme (CLAUDE.md), so the class is chosen here.
func chipStateClasses(ctx context.Context, current bool) string {
	if current {
		return inkEdgeClass(ctx) + " " + inkFillClass(ctx, domain.InkStrong) + " " + onFillClass(ctx)
	}
	return borderClass(ctx, domain.BorderControl) + " " + inkClass(ctx, domain.InkSecondary) + " " + accentEdgeHoverClass(ctx)
}

// chipCountClass quietens a count beside its label on an unselected chip; on the filled one it keeps the fill's ink.
func chipCountClass(ctx context.Context, current bool) string {
	if current {
		return ""
	}
	return inkClass(ctx, domain.InkSecondary)
}

// filterChoice is one option of a FilterSelect.
type filterChoice struct{ Value, Label string }

func parseFilterChoices(s string) []filterChoice {
	var out []filterChoice
	for _, line := range strings.Split(s, "\n") {
		if v, l, ok := strings.Cut(line, "\t"); ok {
			out = append(out, filterChoice{Value: v, Label: l})
		}
	}
	return out
}

// keptParams is the `keep` query string of a filter as sorted name/value pairs, drawn as hidden inputs so that submitting
// one filter's form sends the request's others too.
func keptParams(keep string) [][2]string {
	v, err := url.ParseQuery(keep)
	if err != nil {
		return nil
	}
	var out [][2]string
	for _, k := range sortedKeys(firstValues(v)) {
		out = append(out, [2]string{k, v.Get(k)})
	}
	return out
}

func firstValues(v url.Values) map[string]string {
	out := make(map[string]string, len(v))
	for k := range v {
		out[k] = v.Get(k)
	}
	return out
}

// filterSelect is the registered renderer for `domain.ComponentFilterSelect`: a GET form with one <select> over a
// Dimension's values and the `all` choice that clears it, sent back to this page with the request's other parameters as
// hidden inputs. It submits when the choice changes; a browser without script has the button inside <noscript>.
templ filterSelect(label, query, all, choices, selected, keep string) {
	<form method="get" class={ "flex items-center", layoutGap(ctx, domain.GapTight) }>
		for _, kv := range keptParams(keep) {
			<input type="hidden" name={ kv[0] } value={ kv[1] }/>
		}
		<label for={ "filter-" + query } class="sr-only">{ label }</label>
		<select id={ "filter-" + query } name={ query } onchange="this.form.requestSubmit()" class={ fieldClasses(ctx) + " w-full sm:w-50" }>
			<option value="" selected?={ selected == "" }>{ all }</option>
			for _, c := range parseFilterChoices(choices) {
				<option value={ c.Value } selected?={ selected == c.Value }>{ c.Label }</option>
			}
		</select>
		<noscript>
			@button("Apply", domain.ButtonSecondary, "", "")
		</noscript>
	</form>
}
