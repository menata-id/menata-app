package rendering

import "menata.app/internal/domain"

// RoleMatrixApp is one Application's card: its own role vocabulary, what each role may do grouped
// by the thing being acted on, and a sentence for the status changes nobody performs.
type RoleMatrixApp struct {
	ID          string
	Name        string
	Description string
	// Roles is this Application's declared vocabulary, in declaration order -- the order every
	// row's Who text lists matching roles in. Empty for an Application that declares none, which
	// renders as a sentence instead of an empty section.
	Roles []string
	// RolesSummary is Roles capitalized and joined for display ("Approver, Submitter, Reviewer") --
	// computed once in internal/composition/rolematrix.go so this file only ever renders an
	// already-resolved string, the same rule its own top doc comment states for everything else
	// here.
	RolesSummary string
	Groups       []RoleMatrixGroup
	// Automatic are the status changes the runtime performs itself, one line per Machine. They are
	// prose rather than rows because a reader needs to know the value is not theirs to set, not to
	// audit six ordered pairs -- and as rows they outnumbered everything else on the page.
	Automatic []string
}

// RoleMatrixGroup is one Machine's rows, headed by what a person calls it.
type RoleMatrixGroup struct {
	Label string
	Rows  []RoleMatrixRow
}

// RoleMatrixRow is one thing a person can do.
type RoleMatrixRow struct {
	// Action is the phrase a person reads ("Approve", "Edit or delete"); Actions is what it was
	// built from, kept so folding two rows into one can rebuild the phrase.
	Action  string
	Actions []string
	// Who is the row's own "who can do it" phrase -- "All roles", the matching role names in
	// RoleMatrixApp.Roles' own declared order ("Approver, Reviewer"), or "No one" when two
	// Permissions on this Action leave nothing in common (internal/composition/rolematrix.go's
	// requiredRoles doc comment names this as a real, distinct state from "all roles allowed").
	Who string
	// Qualifier is what the rule says *besides* which roles may -- the record-scoped arm, in the
	// words the screens use. Who answers the role question only, and a page showing it while hiding
	// this would overstate every grant on it. Empty when there is nothing more to say than Who
	// already does.
	Qualifier string
	// Open marks a row no rule governs at all. Rendered in amber rather than hidden: in metadata
	// "ungoverned" and "granted to everyone" look identical (Who reads "All roles" either way), and
	// only one of them is something an administrator would want to know about.
	Open bool
}

// roleMatrixApp is one Application's card: a header naming its role vocabulary, then one
// two-column list per Machine ("What you can do" / "Who can do it") -- a plain responsive list, not
// a grid, matching how Flow 2's RoleMatrix.dc.html/M06-RoleMatrix.dc.html draw both breakpoints.
//
// Its only caller today is appsettings.templ's ApplicationSettingsPage (composition.
// RoleMatrixForApplication feeds it), which is a real second call site -- desktop's content pane
// and mobile's detail view render the same component, not a page-internal shape. It used to have a
// second caller, a Workspace-wide overview page at /authorization-matrix with its own Workspace
// section (RoleMatrixNote) alongside one of these per Application; that page was deleted 2026-09-27
// (Q1 of the Flow 2 canvas re-audit, ROADMAP.md: board-06-new, this one, supersedes board-06-old,
// the deleted one) rather than left an unreachable second implementation of the same fact.
//
// An Application declaring no roles renders a sentence rather than an empty section: it has
// nothing to draw, and an empty list would suggest roles are simply unassigned there when in fact
// none has ever been declared.
templ roleMatrixApp(app RoleMatrixApp) {
	<div class={ "overflow-hidden", surfaceClasses(ctx) }>
		<div class={ "flex flex-col gap-1 border-b", borderClass(ctx, domain.BorderSurface), "px-4 py-4" }>
			<div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
				<span class="text-[15px] font-medium">{ app.Name }</span>
				if len(app.Roles) > 0 {
					<a href={ templ.SafeURL(routeByID(ctx, "nav_workspace_members")) } class="shrink-0 text-xs text-blue-600 hover:text-blue-800">
						{ labelByID(ctx, "nav_workspace_members") } →
					</a>
				}
			</div>
			if app.Description != "" {
				<span class="text-xs text-slate-500">{ app.Description }</span>
			}
			if len(app.Roles) > 0 {
				<p class="m-0 mt-1.5 text-xs leading-5 text-slate-500">
					<span class="font-medium text-slate-700">Roles in this application:</span>
					{ " " }{ app.RolesSummary }.
				</p>
			}
		</div>
		if len(app.Roles) == 0 {
			<p class="m-0 px-4 py-4 text-xs leading-5 text-slate-500">
				This application declares <b>no roles</b>, so there is nothing to assign here yet — everyone
				in the workspace can do everything in it.
			</p>
		} else {
			<div class={ "hidden gap-6 border-b", borderClass(ctx, domain.BorderSurface), "bg-slate-50 px-4 py-2.5 text-3xs tracking-wide text-slate-500 uppercase sm:grid sm:grid-cols-[320px_minmax(0,1fr)]" }>
				<span>What you can do</span>
				<span>Who can do it</span>
			</div>
			for _, group := range app.Groups {
				<div class={ "border-b", borderClass(ctx, domain.BorderDivider), "bg-slate-50/40 px-4 py-2 text-3xs", weightClass(ctx, domain.WeightBody), "tracking-wide text-slate-400 uppercase" }>
					{ group.Label }
				</div>
				for _, row := range group.Rows {
					<div class={ "grid gap-1 border-b", borderClass(ctx, domain.BorderDivider), "px-4 py-3 last:border-b-0 sm:grid-cols-[320px_minmax(0,1fr)] sm:gap-6" }>
						<div class="flex flex-col gap-0.5">
							<span class="text-sm text-slate-900">{ row.Action }</span>
							if row.Qualifier != "" {
								if row.Open {
									<span class="text-3xs leading-4 text-amber-700">{ row.Qualifier }</span>
								} else {
									<span class="text-3xs leading-4 text-slate-500">{ row.Qualifier }</span>
								}
							}
						</div>
						<div class="text-xs leading-5 font-medium text-slate-900">{ row.Who }</div>
					</div>
				}
			}
		}
		if len(app.Automatic) > 0 {
			<div class={ "border-t", borderClass(ctx, domain.BorderSurface), "bg-slate-50/50 px-4 py-3.5" }>
				<div class="mb-1.5 text-3xs tracking-wide text-slate-400 uppercase">Happens on its own</div>
				for _, line := range app.Automatic {
					<p class="m-0 max-w-[760px] text-xs leading-5 text-slate-500">{ line }</p>
				}
			</div>
		}
		// Board 06's closing sentence: two rules no Application's roles can reach. Who manages people is the
		// Workspace's (the Members screen, named by id so its label cannot drift), and the activity history
		// is append-only for everyone -- mch_activity declares append_only.
		<div class={ "border-t", borderClass(ctx, domain.BorderSurface), "px-4 py-3.5" }>
			<p class="m-0 max-w-[760px] text-xs leading-5 text-slate-500">
				Some rules aren’t this application’s to decide: who can manage people is set in
				<a href={ templ.SafeURL(routeByID(ctx, "nav_workspace_members")) } class="text-blue-600 hover:text-blue-800">{ labelByID(ctx, "nav_workspace_members") }</a>,
				and the activity history can’t be changed by anyone.
			</p>
		</div>
	</div>
}
