package rendering

import "menata.app/internal/domain"

// RoleMatrixApp is one Application's card: its own role vocabulary, what each role may do grouped
// by the thing being acted on, and a sentence for the status changes nobody performs.
type RoleMatrixApp struct {
	ID          string
	Name        string
	Description string
	// Roles is this Application's declared vocabulary, in declaration order -- the order every
	// row's Who text lists matching roles in. Empty for an Application that declares none, which
	// renders as a sentence instead of an empty section.
	Roles []string
	// RolesSummary is Roles capitalized and joined for display ("Approver, Submitter, Reviewer") --
	// computed once in internal/composition/rolematrix.go so this file only ever renders an
	// already-resolved string, the same rule its own top doc comment states for everything else
	// here.
	RolesSummary string
	Groups       []RoleMatrixGroup
	// Automatic are the status changes the runtime performs itself, one line per Machine. They are
	// prose rather than rows because a reader needs to know the value is not theirs to set, not to
	// audit six ordered pairs -- and as rows they outnumbered everything else on the page.
	Automatic []string
}

// RoleMatrixGroup is one Machine's rows, headed by what a person calls it.
type RoleMatrixGroup struct {
	Label string
	Rows  []RoleMatrixRow
}

// RoleMatrixRow is one thing a person can do.
type RoleMatrixRow struct {
	// Action is the phrase a person reads ("Approve", "Edit or delete"); Actions is what it was
	// built from, kept so folding two rows into one can rebuild the phrase.
	Action  string
	Actions []string
	// Who is the row's own "who can do it" phrase -- "All roles", the matching role names in
	// RoleMatrixApp.Roles' own declared order ("Approver, Reviewer"), or "No one" when two
	// Permissions on this Action leave nothing in common (internal/composition/rolematrix.go's
	// requiredRoles doc comment names this as a real, distinct state from "all roles allowed").
	Who string
	// Qualifier is what the rule says *besides* which roles may -- the record-scoped arm, in the
	// words the screens use. Who answers the role question only, and a page showing it while hiding
	// this would overstate every grant on it. Empty when there is nothing more to say than Who
	// already does.
	Qualifier string
	// Open marks a row no rule governs at all. Rendered in amber rather than hidden: in metadata
	// "ungoverned" and "granted to everyone" look identical (Who reads "All roles" either way), and
	// only one of them is something an administrator would want to know about.
	Open bool
}

// roleMatrixApp is one Application's Permissions card (boards RoleMatrix, M06-RoleMatrix): a header
// titled "Roles in this application" naming the role vocabulary, then one two-column list per Machine
// ("What you can do" / "Who can do it"), then the band for what happens on its own. membersHref is the
// Application's own Members & roles page, or "" for a viewer who may not open it -- the link is absent,
// not shown-then-403, and the page names no Application. The Application's own name and the sentence
// saying a role means nothing elsewhere belong to the page's heading, not to the card.
//
// Its only caller is appsettings.templ's ApplicationSettingsPage (composition.RoleMatrixForApplication
// feeds it): desktop's content pane and mobile's detail view render the same component.
//
// An Application declaring no roles renders a sentence rather than an empty section: it has
// nothing to draw, and an empty list would suggest roles are simply unassigned there when in fact
// none has ever been declared.
templ roleMatrixApp(app RoleMatrixApp, membersHref string) {
	<div class={ "overflow-hidden", surfaceClasses(ctx) }>
		<div class={ "flex flex-col", layoutGap(ctx, domain.GapMicro), "border-b", borderClass(ctx, domain.BorderSurface), "px-4 py-4" }>
			<div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
				@staticText(domain.StaticPanelHeading, roleMatrixTitle)
				if len(app.Roles) > 0 && membersHref != "" {
					<a href={ templ.SafeURL(membersHref) } class={ "shrink-0", textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkAccent) + " " + accentHoverClass(ctx) }>
						{ membersRolesTitle } →
					</a>
				}
			</div>
			if len(app.Roles) > 0 {
				<p class={ "m-0", textClass(ctx, domain.RoleMeta), "leading-5", inkClass(ctx, domain.InkSecondary) }>
					{ app.RolesSummary }. Given to people and groups in { membersRolesTitle }.
				</p>
			}
		</div>
		if len(app.Roles) == 0 {
			<p class={ "m-0 px-4 py-4", textClass(ctx, domain.RoleMeta), "leading-5", inkClass(ctx, domain.InkSecondary) }>
				This application declares <b>no roles</b>, so there is nothing to assign here yet — everyone
				in the workspace can do everything in it.
			</p>
		} else {
			<div class={ "hidden gap-6 border-b", borderClass(ctx, domain.BorderSurface), backgroundClass(ctx, domain.BackgroundBase), "px-4 py-2.5", textClass(ctx, domain.RoleEyebrow), "tracking-wide", inkClass(ctx, domain.InkSecondary), "uppercase sm:grid sm:grid-cols-[minmax(0,1fr)_220px]" }>
				<span>What you can do</span>
				<span>Who can do it</span>
			</div>
			for _, group := range app.Groups {
				<div class={ "border-b", borderClass(ctx, domain.BorderDivider), baseTintClass(ctx, 40) + " px-4 py-2" }>
					@staticText(domain.StaticOverline, group.Label)
				</div>
				for _, row := range group.Rows {
					<div class={ "grid", layoutGap(ctx, domain.GapMicro), "border-b", borderClass(ctx, domain.BorderDivider), "px-4 py-3 last:border-b-0 sm:grid-cols-[minmax(0,1fr)_220px] sm:gap-6" }>
						<div class={ "flex flex-col", layoutGap(ctx, domain.GapHair) }>
							<span class={ textClass(ctx, domain.RoleBody), inkClass(ctx, domain.InkStrong) }>{ row.Action }</span>
							if row.Qualifier != "" {
								if row.Open {
									<span class={ textClass(ctx, domain.RoleCaption), "leading-4", toneInkClass(ctx, domain.ToneWarn) }>{ row.Qualifier }</span>
								} else {
									<span class={ textClass(ctx, domain.RoleCaption), "leading-4", inkClass(ctx, domain.InkSecondary) }>{ row.Qualifier }</span>
								}
							}
						</div>
						<div class={ textClass(ctx, domain.RoleMeta), "leading-5", weightClass(ctx, domain.WeightEmphasis), inkClass(ctx, domain.InkStrong) }>{ row.Who }</div>
					</div>
				}
			}
		}
		if len(app.Automatic) > 0 {
			<div class={ "border-t", borderClass(ctx, domain.BorderSurface), baseTintClass(ctx, 50) + " px-4 py-3.5" }>
				<div class="mb-1.5">
					@staticText(domain.StaticOverline, "Happens on its own")
				</div>
				for _, line := range app.Automatic {
					<p class={ "m-0 max-w-[760px]", textClass(ctx, domain.RoleMeta), "leading-5", inkClass(ctx, domain.InkSecondary) }>{ line }</p>
				}
			</div>
		}
	</div>
}

// roleMatrixClosingNote is board 06's closing sentence, a muted card of its own beneath the matrix: two
// rules no Application's roles can reach. Who manages people is the Workspace's (the Members screen,
// named by id so its label cannot drift), and the activity history is append-only for everyone --
// mch_activity declares append_only.
templ roleMatrixClosingNote() {
	<div class={ tileClasses(ctx), backgroundClass(ctx, domain.BackgroundBase), "px-4 py-3.5" }>
		<p class={ "m-0 max-w-[760px]", textClass(ctx, domain.RoleMeta), "leading-5", inkClass(ctx, domain.InkSecondary) }>
			Some rules aren’t this application’s to decide: who can manage people is set in
			<a href={ templ.SafeURL(routeByID(ctx, "nav_workspace_members")) } class={ inkClass(ctx, domain.InkAccent), accentHoverClass(ctx) }>{ labelByID(ctx, "nav_workspace_members") }</a>,
			and the activity history can’t be changed by anyone.
		</p>
	</div>
}
