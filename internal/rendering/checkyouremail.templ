package rendering

// CheckYourEmailPage is shown right after registration instead of signing the new admin straight
// in (ROADMAP.md Phase 21 round 2, Step D) -- the account exists but is unusable until its own
// emailed verification link is clicked, which is what actually closes "anyone can register a
// workspace with any email."
//
// The only pre-auth screen with no form: its card holds the address the link went to, so someone
// who mistyped it can see that immediately rather than waiting for an email that will never come.
templ CheckYourEmailPage(email string) {
	@authShell("Check your email", "Check your email", "We've sent a verification link to") {
		@authCard("max-w-96") {
			<div class="flex flex-col items-center gap-3 px-4 py-5 text-center sm:p-6">
				<p class="text-[15px] font-medium break-all text-slate-900">{ email }</p>
				<p class="text-sm text-slate-500">Click it to finish setting up your workspace and sign in.</p>
			</div>
		}
		@authFooterNote() {
			Didn't get it? <a href="/resend-verification" class="text-blue-600 hover:text-blue-700">Resend the link</a>
		}
	}
}
