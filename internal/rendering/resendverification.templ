package rendering

// ResendVerificationPage lets someone request a fresh verification link (ROADMAP.md Phase 21
// round 2, Step D). message, when set, is the same generic confirmation regardless of whether the
// email exists or needs verifying at all -- a different message per case would let this be used to
// enumerate registered emails.
templ ResendVerificationPage(message string) {
	@authShell("Resend verification", "Resend verification email", "We'll send a fresh link to your inbox.") {
		@authCard("max-w-96") {
			<form method="POST" action="/resend-verification" class="flex flex-col gap-4.5 px-4 py-5 sm:p-6">
				@csrfHiddenInput()
				@authField("email", "email", "Email", "email", "username", true)
				@authSubmit("Resend link")
				if message != "" {
					<p class="text-2xs text-slate-600">{ message }</p>
				}
			</form>
		}
		@authFooterNote() {
			<a href="/login" class="text-slate-500 hover:text-slate-700">← Back to sign in</a>
		}
	}
}
