package rendering

import (
	"time"
	"context"
	"encoding/json"
	"fmt"
	"slices"
	"strings"

	"menata.app/internal/action"
	"menata.app/internal/authorization"
	"menata.app/internal/data"
	"menata.app/internal/domain"
	"menata.app/internal/experience"
)

// currentWorkspaceKey carries the installed Workspace, and its display name, for one request.
//
// This was package state until 2026-09-22 -- one `workspace` variable set once at startup by a
// `ConfigureWorkspace` whose own comment conceded it was "not safe to call concurrently with a
// request in flight". That was true while one manifest described the whole process, and it is
// exactly what made every Workspace render the same Applications: a Workspace row scoped records
// and membership, but the Applications came from a file the process had loaded once. An empty,
// freshly created Workspace therefore showed two Applications nobody had installed in it.
//
// Which Workspace a request is in now varies per request, the same way *which Application* already
// did, so it travels the same way: on ctx, set by internal/web.currentWorkspace.
type currentWorkspaceKey struct{}

type currentWorkspace struct {
	Workspace domain.Workspace
	Name      string
	// Archived rides along the same ctx value as Name (Flow 2 gap study Tahap 7) -- both come from
	// the same `workspaces` row read once per request by internal/web.resolveIdentity, not from
	// metadata, which is why this lives beside Name rather than on domain.Workspace itself.
	Archived bool
}

// WithCurrentWorkspace puts the installed Workspace, its display name and its archived state on
// ctx. name and archived come from the `workspaces` row, not from metadata: a manifest names its
// Workspace by slug and deliberately does not restate either (domain.Workspace.Slug).
func WithCurrentWorkspace(ctx context.Context, ws domain.Workspace, name string, archived bool) context.Context {
	return context.WithValue(ctx, currentWorkspaceKey{}, currentWorkspace{Workspace: ws, Name: name, Archived: archived})
}

// CurrentWorkspace returns the installed Workspace for this request. The zero value is a real
// answer, not a failure: a Workspace with no manifest has no Applications and no Machines, which
// is what one looks like the moment it is created and before anything is installed into it.
func CurrentWorkspace(ctx context.Context) domain.Workspace {
	cw, _ := ctx.Value(currentWorkspaceKey{}).(currentWorkspace)
	return cw.Workspace
}

// CurrentWorkspaceName is the Workspace's own display name, for the chrome that shows it.
func CurrentWorkspaceName(ctx context.Context) string {
	cw, _ := ctx.Value(currentWorkspaceKey{}).(currentWorkspace)
	return cw.Name
}

// CurrentWorkspaceArchived reports whether this request's Workspace is archived (Flow 2 gap study
// Tahap 7) -- appShell's own signal to show the read-only banner. The actual enforcement is
// internal/web.blockWritesToArchivedWorkspace; this is the "keep the UI honest" half.
func CurrentWorkspaceArchived(ctx context.Context) bool {
	cw, _ := ctx.Value(currentWorkspaceKey{}).(currentWorkspace)
	return cw.Archived
}

// declaredNavigation is every navigation item declared anywhere in the Workspace: its own list
// plus each Application's *unfiltered* list.
//
// Unfiltered is the load-bearing part. An Application whose menu is suppressed (show_nav: false)
// keeps every route as a valid destination, reachable from contextual in-page links -- so those
// links must still resolve by id. domain.Application.AllNavigation exists for exactly this, and
// both metadata-hardcoding conformance gates depend on the property.
// metadata.validateNavigationIDsAreUnique guarantees an id resolves to one item workspace-wide.
// domain.RuntimeScreens is appended because the Workspace's own screens stopped being metadata on
// 2026-09-21 (see metadata/app.yaml's comment where `navigation:` used to be). They are still
// looked up by id from eight .templ files, and the alternative to resolving them here was retyping
// four routes and four labels as literals across those files -- the exact duplication the two
// hardcoding gates exist to prevent. workspace.Navigation stays in the chain and stays first: it
// is empty today, but an installation that does declare workspace navigation should still win.
func declaredNavigation(ctx context.Context) []domain.NavigationItem {
	ws := CurrentWorkspace(ctx)
	items := append([]domain.NavigationItem(nil), ws.Navigation...)
	for _, app := range ws.Applications {
		items = append(items, app.AllNavigation...)
	}
	return append(items, domain.RuntimeScreens...)
}

// routeByID looks up the declared navigation for the item named id, returning its route -- how a
// page links to a sibling screen (CLAUDE.md "Where a metadata-derived value belongs") instead of
// retyping the route as a literal (internal/conformance's
// TestRenderingHasNoHardcodedApplicationRoute holds every .templ to this). Panics on an unknown
// id: a typo here is a programmer error, and failing loudly the moment the page is first
// rendered is far cheaper to find than a silently broken link -- the same posture
// domain.KnownActions/KnownFieldTypes already take for an unrecognized declared value, just
// caught at first render instead of at metadata load (id isn't validated at load time since it
// names a *caller's own* expectation, not a shape metadata itself declares).
func routeByID(ctx context.Context, id string) string {
	for _, item := range declaredNavigation(ctx) {
		if item.ID == id {
			return item.Route
		}
	}
	panic("rendering: no navigation item with id " + id)
}

// hasNavItem reports whether id is declared in this Workspace's navigation, without routeByID's
// own panic. For the rare caller that cannot assume "this id is my own sibling and therefore
// exists" -- detailBackLink is the one so far: it gates on a Machine's bare id
// (action.DocumentMachineID), which used to be a safe proxy for "this is Document Approval's own
// Document" back when that id was process-wide unique. Workspace isolation (2026-09-27) made a
// different Workspace's own, unrelated Machine sharing that same id legitimate, so the id alone no
// longer implies nav_approval_inbox exists here -- found the same day, a real "Document Tracking"
// Application's detail page panicking on exactly that assumption.
func hasNavItem(ctx context.Context, id string) bool {
	for _, item := range declaredNavigation(ctx) {
		if item.ID == id {
			return true
		}
	}
	return false
}

// approvalMachineID is how a Page building a link into one of the approval engine's own screens
// asks which Machine to name: by the role its Application cast it in, never by retyping
// `action.DocumentMachineID` (2026-09-28, the slice after development-history.md's Stage A).
//
// It is routeByID's sibling in intent. routeByID exists because a *route* declared in metadata must
// not be retyped in a template; this exists because a *Machine id* that appears in a route is the
// same kind of value -- one an installation decides, not the template. A Workspace that renames a
// colliding mch_document on install keeps every screen working only if the ids in these hrefs come
// from the declaration.
//
// Returns "" when this Application casts nobody in the role, and callers render nothing rather than
// a link to /machines//records/... -- a Page for a feature this Workspace did not install.
//
// No panic, unlike routeByID: a missing navigation id is a template naming its own sibling wrongly,
// which is a bug in the template, while an uncast role is a legitimate smaller installation.
func approvalMachineID(ctx context.Context, role string) string {
	app, _ := CurrentApplication(ctx)
	if m := CurrentWorkspace(ctx).MachineInWorkflowRole(domain.WorkflowEngineDocumentApproval, role, app.ID); m != nil {
		return m.ID
	}
	return ""
}

// runtimeScreenByID returns one of domain.RuntimeScreens whole, for the two places that need an
// item rather than one of its fields (pageShell's topbar). Same panic-on-unknown-id posture as
// routeByID.
func runtimeScreenByID(id string) domain.NavigationItem {
	for _, s := range domain.RuntimeScreens {
		if s.ID == id {
			return s
		}
	}
	panic("rendering: no runtime screen with id " + id)
}

// applicationNavEntry was deleted on 2026-09-24 with pageShell, its only caller. It turned an
// Application into a synthetic navigation item so the old topbar could list "Document Approval"
// beside the declared items. appShell's launcher renders Applications as cards from
// Workspace.Applications directly, so there is nothing left to synthesize.

// labelByID is routeByID's label-side counterpart: a page rendering the title of one of its own
// nav siblings (a pageShell title, an <h1>, a card's link text) must read it from here, not retype
// the label string -- internal/conformance's TestRenderingHasNoHardcodedApplicationLabel holds
// every .templ file to this, the same way TestRenderingHasNoHardcodedApplicationRoute already
// holds routeByID's href side. Same panic-on-unknown-id posture as routeByID, for the same reason.
func labelByID(ctx context.Context, id string) string {
	for _, item := range declaredNavigation(ctx) {
		if item.ID == id {
			return item.Label
		}
	}
	panic("rendering: no navigation item with id " + id)
}

// titleByID is the heading a screen renders for *itself* -- its own <h1> -- read from the
// navigation item that names it, falling back to that item's Label when it declares none.
//
// Separate from labelByID because a menu entry and a heading answer different questions, which
// the Flow 2 mockup made concrete: the Approval Inbox is "Inbox" in a tab strip and a 4-column
// bottom bar, and "Pending my approval" at the top of its own page. Until 2026-09-24 a Page had
// only labelByID, so every heading in the app was whatever string also had to fit in a bottom bar.
//
// The fallback is here rather than in domain so an item declaring no title keeps working unchanged
// -- which is most of them, and none of them are wrong for it: a screen whose heading really is
// its menu label should say that by staying silent, not by repeating the string in a second key.
func titleByID(ctx context.Context, id string) string {
	for _, item := range declaredNavigation(ctx) {
		if item.ID == id {
			// No label fallback: metadata.LoadApplication stamps Title from Label when an author declares
			// none (domain.DerivationNavTitle). It lived here until 2026-10-02, which made it an inference
			// happening at render time and explainable by nothing -- 001 #6's second clause names
			// *rendering* exactly, and 005 Phase 4 owns "expand authoring conveniences". A renderer reads
			// a resolved value; it does not resolve one.
			return item.Heading
		}
	}
	panic("rendering: no navigation item with id " + id)
}

// descriptionByID is the sentence under that heading, or "" when the item declares none -- in
// which case the Page renders no subtitle at all rather than inventing one.
//
// No panic-on-empty, unlike the three lookups above: an absent route or label breaks a page, an
// absent subtitle is a page with no subtitle. The id itself is still checked, so a typo fails
// exactly as loudly as it does everywhere else.
func descriptionByID(ctx context.Context, id string) string {
	for _, item := range declaredNavigation(ctx) {
		if item.ID == id {
			return item.Description
		}
	}
	panic("rendering: no navigation item with id " + id)
}

// pwaRegistrationScript is the service-worker registration every page shares (ROADMAP.md's
// "Installable as a PWA") -- registration only, no cache population, since this app's data is
// live/session-scoped and the service worker (serveServiceWorker, internal/web/pwa.go)
// deliberately caches nothing.
templ pwaRegistrationScript() {
	<script>
		if ('serviceWorker' in navigator) {
			window.addEventListener('load', function () {
				navigator.serviceWorker.register('/sw.js')
			})
		}
	</script>
}

// csrfHeadersAttr returns pageShell's page-wide hx-headers value (security audit 2026-09-19, L1)
// -- every HTMX request from anywhere inside pageShell, a <form> or a bare hx-* element alike
// (e.g. this file's own hx-delete buttons with no enclosing <form>), inherits it, which is what
// closes CSRF for every HTMX-driven POST/PUT/DELETE in one place instead of each individually. ctx
// is the ambient context every generated templ component's Render(ctx, w) already carries in
// scope -- ordinary Go code inside a templ block can read it without pageShell needing to declare
// it as an explicit parameter, the same way data.WorkspaceScope is read deep in internal/data's
// own call chains without being threaded through every function signature.
func csrfHeadersAttr(ctx context.Context) string {
	body, err := json.Marshal(map[string]string{"X-CSRF-Token": authorization.CSRFTokenFromContext(ctx)})
	if err != nil {
		// A map[string]string holding one plain token string cannot fail to marshal -- defensive,
		// not a real path; an empty header object simply means no HTMX request from this page
		// carries a token, which csrfProtect already rejects the same as a missing one.
		return "{}"
	}
	return string(body)
}

// csrfHiddenInput is the plain-form counterpart to csrfHeadersAttr -- every native
// <form method="POST"> in the app (login, register, the topbar logout form below, ...) includes
// this once, rather than each one reading authorization.CSRFTokenFromContext(ctx) inline.
templ csrfHiddenInput() {
	<input type="hidden" name="csrf_token" value={ authorization.CSRFTokenFromContext(ctx) }/>
}

// **domain.BadgeTone moved to `domain.BadgeTone` on 2026-10-03, and the tones kept their meanings.** It was a
// closed set whose value is a bare string -- vocabulary, which
// `conformance.TestDomainHoldsVocabularyAndRegistryHoldsDispatch` places in `internal/domain`, while the
// *contract* that uses it is a dispatch seam and went to `internal/registry.Components`. `domain.ToneMuted` ->
// `domain.ToneMuted` keeps the measured reason it exists rather than symmetry: on the inference page 52 of
// 65 rows are "not applicable", all of them right, and drawing them at the same weight as the two that mean
// something would bury the signal in its own correctness.

// statusBadge is the shared pill shape -- 007 §12.3 lists `StatusBadge` as a Component by name, and
// this is it at the level this runtime actually needs.
//
// **The component owns presentation; the caller owns vocabulary.** That split is the whole point of
// extracting it. reviewStatusPill below mapped three fld_status values to colours *and* drew the pill;
// the inference page needs the same pill over a completely different closed set (resolved /
// undeclared / not applicable / input unavailable). Generalising the mapping too would have produced
// a component that has to know every vocabulary in the app, which is the unbounded escape hatch §12.3
// forbids. So each caller maps its own values to a tone, and neither knows the other's words.
//
// Extracted on its second case rather than its first (CLAUDE.md's "Deciding whether a literal is a
// metadata-hardcoding violation", step 3): one pill was a screen's own detail, two is a shape.
// Truncation is what a bounded list tells its reader when the bound actually bit (007 §21.9: a
// composed experience exceeding its budget must "fail clearly or degrade through an explicit runtime
// policy" -- degrading in silence is neither).
//
// Limit is carried so the notice can name the bound rather than say "some rows were dropped", which
// tells a reader nothing actionable. It comes from composition.Selection, which reads it off the
// Dataset's own `limit:` -- never retyped here.
//
// **Only lists that claim completeness pass a filled Truncation.** A Dataset whose bound *is* its
// meaning -- the former `ds_recent_activity` at 10 and `ds_activity_feed` at 50 -- is not truncated in any sense a
// reader cares about, and mch_activity holds 30 records today, so rendering this on the Dashboard's
// activity tail would state something false. See composition.Selection.Limit for why that distinction
// is the screen's to make and not yet a declaration.
type Truncation struct {
	Limit int
	Hit   bool
}

// truncationNotice renders nothing at all when the bound did not bite, so a caller may pass its
// Truncation unconditionally and the common case costs no markup.
templ truncationNotice(t Truncation) {
	if t.Hit && t.Limit > 0 {
		<p class="m-0 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-2xs text-amber-800">
			Showing the first { fmt.Sprint(t.Limit) } only — more match than fit on this page.
		</p>
	}
}

// statusBadge is the registered renderer for `domain.ComponentStatusBadge` --
// `registry.Components`' first member, and the renderer its contract names by the string
// "statusBadge" (`conformance.TestComponentRegistryAndRenderersAgree` binds the two).
//
// **Its signature is the contract's teeth.** Two resolved inputs and nothing else: no `*data.Record`
// to find a label in, no `any` to parse, no `time.Time` to compare against. That is what
// `slaBadgePill` failed -- it took an `any`, parsed `"2006-01-02"` out of it and called
// `experience.EvaluateSLA(due, time.Now())`, which §12.3 forbids ("MUST NOT silently acquire
// additional business data that is not represented by its contract") and §4.6 forbids again
// (`time.Now()` means identical input does not produce identical output). It was deleted and its
// four callers now receive an `experience.SLABadge` resolved where `now` is an argument.
//
// This renamed from `statusBadge` the same day. §12.3 asks that Components be "named for reusable
// semantic or structural identity rather than one business case", and `pill` names the shape of the
// element -- a rename of the element would have been a rename of the vocabulary.
templ statusBadge(label string, tone domain.BadgeTone, size domain.BadgeSize) {
	<span class={ "inline-flex items-center", badgePadding(ctx, size), "whitespace-nowrap", textClass(ctx, domain.RoleLabel), radiusClass(ctx, domain.RadiusPill), toneClass(ctx, tone) }>
		{ label }
	</span>
}

// badgePadding is the one place a badge's room is chosen. An unset or unknown size is the regular one rather
// than no padding at all -- a badge with no padding is a cut-off label, which is a defect that renders instead
// of one that fails.
func badgePadding(ctx context.Context, size domain.BadgeSize) string {
	if size == domain.BadgeCompact {
		return paddingClass(ctx, domain.PaddingBadgeCompactX) + " " + paddingClass(ctx, domain.PaddingBadgeCompactY)
	}
	return paddingClass(ctx, domain.PaddingBadgeX) + " " + paddingClass(ctx, domain.PaddingBadgeY)
}

// avatarClasses maps an avatar's two closed parameters onto the circle it draws. Two switches rather than one
// pair-wise table, because size and presence are genuinely independent here -- unlike `splitTracks`, where
// Tailwind needs the whole track list as one literal.
func avatarClasses(size domain.AvatarSize, presence domain.AvatarPresence) string {
	dim := "size-8 text-2xs"
	switch size {
	case domain.AvatarLead:
		dim = "size-10 text-sm"
	case domain.AvatarCompact:
		dim = "size-6 text-3xs"
	}
	tone := "bg-slate-200 text-slate-700"
	if presence == domain.AvatarPending {
		tone = "border border-dashed border-slate-300 text-slate-400"
	}
	return "flex shrink-0 items-center justify-center rounded-full font-medium " + dim + " " + tone
}

// avatar is the registered renderer for `domain.ComponentAvatar` -- `registry.Components`' second member, and
// the one that turned the contract's `Accessibility` clause from a description into a requirement.
//
// **The four sites it replaced carried no accessible name at all.** Their content is initials, and "AP" is not
// a name: a screen reader announced two letters. The contract declares `label` as a *required input* for that
// reason, and this renderer spends it on `aria-label` plus `title` -- so a sighted reader can hover and an
// assistive one hears the person. That is an added attribute on four screens, a deliberate change rather than
// a port.
//
// `presence` is semantic, not visual (§4.2). The dashed circle means **invited but not yet a member**, which
// is a distinction this repo holds elsewhere too, and keeping it a declared value rather than a colour is what
// stops the next caller reaching for the dash to mean something else.
templ avatar(initials, label string, size domain.AvatarSize, presence domain.AvatarPresence) {
	<span class={ avatarClasses(size, presence) } title={ label } aria-label={ label }>{ initials }</span>
}

// metric is the registered renderer for `domain.ComponentMetric` -- one headline number and the question it
// answers, §12.3's own `Metric`. Value before label in reading order, which is what the four screens already
// rendered and what makes the group its own accessible description.
//
// `hint` (a qualifier under the label) and `tone` (a signal on the value) are optional; "" and the neutral
// tone draw exactly what the two-input form always drew.
templ metric(label, value, hint string, tone domain.BadgeTone) {
	<div class={ surfaceClasses(ctx), "p-3" }>
		<div class={ textClass(ctx, domain.RoleDisplay), weightClass(ctx, domain.WeightEmphasis), metricValueClass(ctx, tone) }>{ value }</div>
		<div class={ textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkSecondary) }>{ label }</div>
		if hint != "" {
			<div class={ "text-2xs", inkClass(ctx, domain.InkFaint) }>{ hint }</div>
		}
	</div>
}

// slaBadge draws a resolved SLA badge, or nothing when no due date was set. It is a thin adapter over
// statusBadge, exactly as reviewStatusPill is -- the Component owns presentation, the caller owns
// vocabulary, and "overdue" is the caller's word.
templ slaBadge(b experience.SLABadge) {
	if b.Present {
		@statusBadge(b.Label, b.Tone, domain.BadgeRegular)
	}
}

// pageShell, pageHead, pageStyles and navLink were deleted on 2026-09-24, with their last two
// callers. They were the app's *other* stylesheet -- a 122-line hand-written <style> block and a
// topbar that projected navigation as plain text links -- and capabilities.md carried a whole
// section, "Styling: two systems, on purpose", explaining the coexistence as a planned transition
// rather than drift. The transition finished here: MachineList, MachinePage and RecordDetailPage
// moved to appShell, and nothing renders from that block any more.
//
// What ended with it is worth naming, because none of it was visible as a missing feature: those
// three screens loaded no app.css at all, so on a phone they had no sticky header, no bottom bar
// and no launcher -- opening one record dropped you out of the chrome entirely, with the browser's
// back button as the only way back. They also rendered in the platform's default font rather than
// Ubuntu, which is why they read as a different application rather than a plainer page.
//
// navSections and CurrentApplicationName went with pageShell, their only caller; the grouped,
// collapsible topbar they fed has no counterpart in appShell, whose launcher lists Applications
// rather than every declared item.

// MachineList is the landing page: every Machine in the Workspace, linking to its own page.
// Adding a third Machine requires no code change here -- it appears because it's in the
// Workspace manifest, per development-history.md Phase 3's exit criterion.
templ MachineList(machines []*domain.Machine, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	@appShell("Machines", workspaceName, viewer, switchWorkspaceHref) {
		@staticText(domain.StaticHeading, "Machines")
		<div class={ "overflow-hidden", surfaceClasses(ctx) }>
			for i, m := range machines {
				<a
					href={ templ.URL("/machines/" + m.ID) }
					class={ "flex items-center gap-3 px-4 py-3 text-sm text-slate-900 hover:bg-slate-50", templ.KV("border-t "+borderClass(ctx, domain.BorderDivider), i > 0) }
				>
					<span class="grow font-medium">{ m.Name }</span>
					<code class="font-mono text-2xs text-slate-400">{ m.ID }</code>
				</a>
			}
			if len(machines) == 0 {
				<div class="px-4 py-8 text-center text-sm text-slate-500">No machines are installed in this workspace.</div>
			}
		</div>
	}
}

// MachinePage is the reference renderer for a single Machine: its field schema, a create form,
// and its persisted records with inline edit/delete. It exists to prove the metadata -> data ->
// render pipeline end to end; it is not yet driven by UI IR or a View Model
// (007-composable-runtime-architecture.md §10, §23).
//
// actor is the viewing identity, threaded down to RecordRow the same reason detail.templ's
// RecordDetailPage already takes it (development-history.md Phase 16) -- so an Edit/Delete the viewer is not
// permitted to perform isn't offered in the first place; the server enforces the same rule
// regardless (allowsRecordEdit/deleteAllowed, internal/web/record.go), this only keeps the UI
// honest about it.
templ MachinePage(m *domain.Machine, v domain.View, records []*data.Record, relations RelationOptions, groups GroupOptions, boardColumns []experience.Column, cards []RecordCard, actor domain.Actor, workspaceName string, viewer Viewer, switchWorkspaceHref string, now time.Time) {
	@appShell(m.Name, workspaceName, viewer, switchWorkspaceHref) {
		<div id="machine-body" class="flex flex-col gap-4">
			@MachineBody(m, v, records, relations, groups, boardColumns, cards, actor, now)
		</div>
	}
}

// MachineBody is the fragment every mutating endpoint returns for HTMX to swap into
// #machine-body, so the full page never needs a hard reload. boardColumns is non-nil only when
// m's board Layout groups by a relation field (development-history.md Phase 10's ordered Lists) -- fetching
// those columns is I/O this package doesn't perform, so the caller supplies them; nil means "use
// the status field's own Options instead" (Phase 5's original behavior, still supported).
//
// v is the View being rendered, carried into the fragment rather than re-derived from m: a swap
// must return to the same arrangement the viewer was looking at, and only the caller knows which
// one that was (the ?view= it resolved). cards is non-nil only for a cards View, for the same
// caller-supplies-I/O reason as boardColumns -- the projection is resolved in
// internal/composition, which this package cannot import.
templ MachineBody(m *domain.Machine, v domain.View, records []*data.Record, relations RelationOptions, groups GroupOptions, boardColumns []experience.Column, cards []RecordCard, actor domain.Actor, now time.Time) {
	if v.EffectiveType() == domain.ViewBoard {
		@boardScreen(m, v, records, relations, groups, boardColumns, cards, actor)
	} else {
		@machineScreen(m, v, records, relations, groups, cards, actor, now)
	}
}

// machineScreen is the generic Machine page: the Machine's own heading, its Field list, and its records
// arranged by the selected View. A board View does not come through here -- it is a screen of its own
// (boardScreen), because a board's header, create affordance and per-column composer are not a Fields
// table with a different Layout under it.
templ machineScreen(m *domain.Machine, v domain.View, records []*data.Record, relations RelationOptions, groups GroupOptions, cards []RecordCard, actor domain.Actor, now time.Time) {
	<div class="flex flex-col gap-1">
		@staticText(domain.StaticHeading, m.Name)
		<code class="font-mono text-2xs text-slate-400">{ m.ID }</code>
	</div>
	@stackLayout(domain.GapTight) {
		@sectionHeaderRow("Fields", "", "")
		<div class={ "overflow-x-auto", surfaceClasses(ctx) }>
			<table class="w-full border-collapse text-sm">
				<thead>
					<tr>
						<th class={ tableHeadCellClasses(ctx) }>Field</th>
						<th class={ tableHeadCellClasses(ctx) }>Type</th>
						<th class={ tableHeadCellClasses(ctx) }>Required</th>
					</tr>
				</thead>
				<tbody>
					for _, f := range m.Fields {
						<tr>
							<td class={ tableCellClasses(ctx) }>{ f.Name }</td>
							<td class={ tableCellClasses(ctx) }>
								@statusBadge(string(f.Type), domain.ToneInfo, domain.BadgeCompact)
							</td>
							<td class={ tableCellClasses(ctx) }>
								if f.Required {
									<span class="text-xs font-medium text-red-600">yes</span>
								} else {
									<span class="text-xs text-slate-400">no</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
	@stackLayout(domain.GapTight) {
		@sectionHeaderRow(fmt.Sprintf("Records (%d)", len(records)), "", "")
		@viewSwitcher(m, v)
		switch v.EffectiveType() {
			case domain.ViewCards:
				@cardsLayout(m, cards)
			default:
				@tableLayout(m, records, relations, groups, actor, now)
		}
	}
}

// tableLayout is the generic flat-list Layout: every Field as a column, every Record as a row,
// plus a create-form row (007 §12.2 "Layout is a generic structural composition primitive").
templ tableLayout(m *domain.Machine, records []*data.Record, relations RelationOptions, groups GroupOptions, actor domain.Actor, now time.Time) {
	<div class={ "overflow-x-auto", surfaceClasses(ctx) }>
		<table class="w-full border-collapse text-sm">
			<thead>
				<tr>
					for _, f := range m.Fields {
						<th class={ tableHeadCellClasses(ctx) }>{ f.Name }</th>
					}
					<th class={ tableHeadCellClasses(ctx) }></th>
				</tr>
			</thead>
			<tbody>
				for _, r := range records {
					@RecordRow(m, r, relations, groups, actor, now)
				}
				@createFormRow(m, relations, groups)
			</tbody>
		</table>
	</div>
}

// viewSwitcher offers the Machine's other declared arrangements, labelled by each View's own
// name: -- never by its type, which is the runtime engine's vocabulary and not a string a viewer
// should be shown. Renders nothing at all below two views, so a Machine declaring one (or none)
// looks exactly as it did before views: existed.
//
// selectableViews below excludes domain.ViewStepper: that type composes a *parent's* children
// (domain.Machine.StepperView, internal/rendering/detail.templ), which is meaningless as an
// alternate arrangement of this Machine's own flat list -- the generic records section a few lines
// down has no case for it either, so offering it here would be a switch option that silently
// renders a plain table instead of what its label promises.
//
// The link is a query parameter on the page's own route, not a route of its own: a View decides
// what renders inside the page, never which shell -- so no path appears here that no navigation
// item declares.
templ viewSwitcher(m *domain.Machine, selected domain.View) {
	{{ views := selectableViews(m) }}
	if len(views) > 1 {
		<nav class={ "inline-flex gap-0.5", tileClasses(ctx), backgroundClass(ctx, domain.BackgroundRaised), "p-0.5" } aria-label="View">
			for _, o := range views {
				if o.ID == selected.ID {
					<span class="rounded bg-slate-100 px-3 py-1 text-xs font-medium text-slate-900" aria-current="true">{ o.Name }</span>
				} else {
					<a class="rounded px-3 py-1 text-xs text-slate-500 hover:text-slate-900" href={ templ.URL(fmt.Sprintf("/machines/%s?view=%s", m.ID, o.ID)) }>{ o.Name }</a>
				}
			}
		</nav>
	}
}

// cardsLayout renders each record through its Machine's own card_fields (Projection, 007 §7.6),
// reusing projectedFieldValue -- the same renderer approvalinbox.templ's pending card already
// uses, so a projected Field looks identical wherever it appears.
//
// This is Projection's first consumer whose output varies per record. Its only previous one
// resolved an empty list for every record because no Machine declared card_fields at all, which
// is why internal/metadata refuses a cards View on a Machine that declares none.
templ cardsLayout(m *domain.Machine, cards []RecordCard) {
	@gridLayout(domain.GapDefault, domain.GridCols1, domain.GridCols2) {
		for _, c := range cards {
			<a href={ templ.URL("/machines/" + m.ID + "/records/" + c.Record.ID) } class={ "flex flex-col gap-1.5", surfaceClasses(ctx), "p-4 text-slate-900 hover:border-blue-300" }>
				<span class="text-sm font-medium">{ recordTitle(m, c.Record) }</span>
				<span class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-xs">
					for _, f := range c.Fields {
						@projectedFieldValue(f)
					}
				</span>
			</a>
		}
	}
}

// RecordCard is one record already projected for a cards View: internal/composition resolves the
// Fields (ProjectCardFields), this package only renders them. The same "composition resolves,
// rendering displays" split PendingApprovalCard already follows -- and the one this package has
// no choice about, since composition imports rendering and the reverse would be circular.
type RecordCard struct {
	Record *data.Record
	Fields []ProjectedField
	// Date is the resolved due-date pill (experience.ResolveCardDate); the zero value draws none.
	Date experience.CardDate
	// Tags are the chips drawn above the title (composition.Loader.CardTags), already named and coloured.
	Tags []CardTag
	// Complete is the completion toggle the card offers, nil when its Machine declares no completion.
	Complete *CardComplete
}

// CardComplete is a card's completion toggle already resolved: the Field a click writes, the value it
// writes (the opposite of what the record holds now) and whether the record is finished.
type CardComplete struct {
	Field string
	Next  string
	Done  bool
}

// CardTag is one resolved chip: a name and an entry of the closed palette.
type CardTag struct {
	Label string
	Color domain.TagColor
}

// boardScreen is Case 19's Board page (PM01): a heading and a one-line summary, the View switcher beside a
// "New <machine>" affordance, then the columns. It replaced a Fields table, a record count and an "Add
// Record" row, none of which belong on a board.
//
// The heading is the navigation item that routes to this Machine (machineHeading), not the Machine's
// name -- a Workspace's `nav_board` says "Board" and the Machine says "Task", and a screen titles itself
// with what its own navigation calls it (the same rule pageHeader follows). The summary is computed from the
// records and the View's own `group_by`: no count or Field name is typed here.
templ boardScreen(m *domain.Machine, v domain.View, records []*data.Record, relations RelationOptions, groups GroupOptions, boardColumns []experience.Column, cards []RecordCard, actor domain.Actor) {
	@columnsLayout(domain.GapDefault, domain.ColumnsAlignCenter) {
		<div class="flex flex-col gap-1">
			<h1 class="m-0 text-2xl font-medium">{ machineHeading(ctx, m) }</h1>
			@staticText(domain.StaticMessage, boardSummary(m, v, len(records)))
		</div>
		@rowLayout(domain.GapDefault, domain.RowAlignCenter, domain.RowJustifyStart) {
			@viewSwitcher(m, v)
			@newCardPopover(m, relations, groups)
		}
	}
	@boardLayout(m, v, records, boardColumns, cards, actor)
	@boardDragScript()
}

// boardDragScript lets a card be dragged to another list or another place in its own: the same PATCH the
// Move panel sends (the group Field and `position`), so a drop and the panel are one contract and the server
// decides nothing differently for either. One delegated listener per page -- the board is swapped by HTMX
// and a listener on the cards would be lost with them. Nothing here is moved in the DOM: the board that comes
// back is the proof it saved, and a refused write (the shared htmx:responseError notice) leaves the card
// where it was. This is the second named vanilla-JS exception beside signature placement: drag geometry
// has no declarative form (007 §12.3's `actions` carries a click, not a gesture).
templ boardDragScript() {
	<script>
		(function () {
			if (window.menataBoardDrag) return;
			window.menataBoardDrag = true;
			var dragged = null, slot = null;
			function clear() {
				document.querySelectorAll("[data-board-column].ring-2").forEach(function (c) {
					c.classList.remove("ring-2", "ring-emerald-500");
				});
				if (slot) { slot.remove(); slot = null; }
			}
			function placeIn(col, y) {
				var cards = Array.prototype.filter.call(col.querySelectorAll("[data-card]"), function (c) { return c !== dragged; });
				var idx = cards.length;
				for (var i = 0; i < cards.length; i++) {
					var r = cards[i].getBoundingClientRect();
					if (y < r.top + r.height / 2) { idx = i; break; }
				}
				return { cards: cards, idx: idx };
			}
			// A text field inside a draggable card cannot have its text selected with the mouse (the card
			// takes the gesture), so the card stops being draggable while the pointer is in its edit panel.
			document.addEventListener("pointerdown", function (e) {
				var c = e.target.closest && e.target.closest("[data-card]");
				if (c && c.getAttribute("draggable") !== null) c.draggable = !e.target.closest("details");
			});
			document.addEventListener("dragstart", function (e) {
				var c = e.target.closest && e.target.closest("[data-card]");
				if (!c) return;
				dragged = c;
				e.dataTransfer.effectAllowed = "move";
				e.dataTransfer.setData("text/plain", c.dataset.url);
				setTimeout(function () { c.classList.add("opacity-40"); }, 0);
			});
			document.addEventListener("dragover", function (e) {
				if (!dragged) return;
				var col = e.target.closest("[data-board-column]");
				if (!col) return;
				e.preventDefault();
				e.dataTransfer.dropEffect = "move";
				clear();
				col.classList.add("ring-2", "ring-emerald-500");
				var p = placeIn(col, e.clientY);
				slot = document.createElement("div");
				slot.className = "h-1 rounded-full bg-emerald-500";
				col.querySelector("[data-cards]").insertBefore(slot, p.cards[p.idx] || null);
			});
			document.addEventListener("drop", function (e) {
				if (!dragged) return;
				var col = e.target.closest("[data-board-column]");
				if (!col || !col.dataset.value) return;
				e.preventDefault();
				var card = dragged, values = { position: placeIn(col, e.clientY).idx + 1 };
				values[col.dataset.field] = col.dataset.value;
				clear();
				htmx.ajax("PATCH", card.dataset.url, { source: card, target: "#machine-body", swap: "innerHTML", values: values });
			});
			document.addEventListener("dragend", function () {
				if (dragged) dragged.classList.remove("opacity-40");
				dragged = null;
				clear();
			});
		})();
	</script>
}

// boardSummary is "11 cards · grouped by List".
func boardSummary(m *domain.Machine, v domain.View, count int) string {
	s := fmt.Sprintf("%d cards", count)
	if f, ok := m.FieldByID(v.GroupBy); ok {
		s += " · grouped by " + f.Name
	}
	return s
}

// machineHeading is what the navigation item routing to this Machine calls itself, falling back to the
// Machine's own name when none does. Resolved by route rather than by the request's path, because the
// HTMX fragment a create returns is served from a POST URL and would otherwise lose its heading.
func machineHeading(ctx context.Context, m *domain.Machine) string {
	want := "/machines/" + m.ID
	for _, item := range declaredNavigation(ctx) {
		if path, _, _ := strings.Cut(item.Route, "?"); path == want && item.Heading != "" {
			return item.Heading
		}
	}
	return m.Name
}

// boardLayout groups records into columns by the selected View's own group_by and draws each as a
// fixed-width column of cards (007 §12.2 -- Collection + Group Dimension, one column per group). Each
// column ends in a composer that creates a record already placed in that group.
templ boardLayout(m *domain.Machine, v domain.View, records []*data.Record, boardColumns []experience.Column, cards []RecordCard, actor domain.Actor) {
	{{ byRecord := cardsByRecord(cards) }}
	{{ columns := experience.GroupRecords(m, v, records, boardColumns) }}
	{{ targets := MoveTargets(m, v, columns) }}
	<div class="flex items-start gap-2.5 overflow-x-auto pb-2">
		for _, col := range columns {
			<div role="group" aria-label={ col.Label } data-board-column data-field={ v.GroupBy } data-value={ columnValue(m, v, col) } class={ "flex w-46 shrink-0 flex-col gap-2.5 rounded-xl border border-slate-200", backgroundClass(ctx, domain.BackgroundSunken), "p-2" }>
				<header class="flex items-center gap-1.5 px-1">
					<h3 class="m-0 text-xs font-medium text-slate-700">{ col.Label }</h3>
					<span class="rounded-full bg-white px-1.5 text-2xs text-slate-500">{ fmt.Sprint(len(col.Records)) }</span>
				</header>
				<div data-cards class="flex flex-col gap-2">
					for i, r := range col.Records {
						@boardCard(m, byRecord[r.ID], actor, CardMove{Field: v.GroupBy, Targets: targets, Current: columnValue(m, v, col), Position: i + 1})
					}
				</div>
				@cardComposer(m, v, col)
			</div>
		}
	</div>
}

// CardMove is what a card needs to offer moving itself: the Field a move writes (the View's group_by), where
// it can go, where it is, and its place there. A zero value offers no move.
type CardMove struct {
	Field    string
	Targets  []MoveTarget
	Current  string
	Position int
}

// MoveTarget is one list a card can move to: the value written into the group Field, and what to call it.
type MoveTarget struct {
	Value, Label string
}

// columnValue is what a record must hold in the View's group Field to belong to col: the related record's
// id for a relation-grouped board, the option itself for a status-grouped one, and "" for the synthetic
// "Other" column, which no value produces and so nothing can be moved into.
func columnValue(m *domain.Machine, v domain.View, col experience.Column) string {
	if col.ID != "" {
		return col.ID
	}
	if f, ok := m.FieldByID(v.GroupBy); ok && slices.Contains(f.Options, col.Label) {
		return col.Label
	}
	return ""
}

// MoveTargets is the lists a card of m can move to under v: one per column that a value produces. Exported
// because a record's own detail page offers the same move as its board card and must not derive it twice.
func MoveTargets(m *domain.Machine, v domain.View, cols []experience.Column) []MoveTarget {
	var out []MoveTarget
	for _, c := range cols {
		if val := columnValue(m, v, c); val != "" {
			out = append(out, MoveTarget{Value: val, Label: c.Label})
		}
	}
	return out
}

func cardsByRecord(cards []RecordCard) map[string]RecordCard {
	out := make(map[string]RecordCard, len(cards))
	for _, c := range cards {
		out[c.Record.ID] = c
	}
	return out
}

// cardRole is the display of a card's Field in one role, "" when its Machine declares none.
func cardRole(c RecordCard, role domain.CardFieldRole) string {
	for _, f := range c.Fields {
		if f.Role == string(role) {
			return f.Display
		}
	}
	return ""
}

// tagClasses maps a palette entry onto the chip it draws and the dot inside it. Two literals per entry
// because Tailwind reads class strings out of this file as text and cannot see one assembled at run time.
// An unknown entry takes the neutral one, the same fallback composition applies before it gets here.
func tagClasses(c domain.TagColor) (chip, dot string) {
	switch c {
	case domain.TagBlue:
		return "border-blue-600/20 bg-blue-600/10 text-blue-600", "bg-blue-600"
	case domain.TagPurple:
		return "border-violet-600/20 bg-violet-600/10 text-violet-600", "bg-violet-600"
	case domain.TagAmber:
		return "border-amber-700/20 bg-amber-700/10 text-amber-700", "bg-amber-700"
	case domain.TagEmerald:
		return "border-green-700/20 bg-green-700/10 text-green-700", "bg-green-700"
	case domain.TagCyan:
		return "border-cyan-700/20 bg-cyan-700/10 text-cyan-700", "bg-cyan-700"
	case domain.TagRose:
		return "border-rose-700/20 bg-rose-700/10 text-rose-700", "bg-rose-700"
	default:
		return "border-slate-600/20 bg-slate-600/10 text-slate-600", "bg-slate-600"
	}
}

// tagChip is a tag drawn as a pill with a colour dot. Its colour is a palette name, never a value, so the
// same label reads the same on every board.
templ tagChip(t CardTag) {
	{{ chip, dot := tagClasses(t.Color) }}
	<span class={ "inline-flex items-center gap-1 whitespace-nowrap rounded-full border px-2 py-0.5 text-2xs", chip }>
		<span class={ "size-1.5 rounded-full", dot } aria-hidden="true"></span>
		{ t.Label }
	</span>
}

// boardCard is one record on a board: its title, its date and its person -- the three roles the
// Machine's own card_fields declared, which is why this reads RecordCard and never a Field by id.
//
// The whole card is one link: the title's anchor stretches over it (`after:absolute after:inset-0`), which
// is what lets the completion circle and the quick-edit pencil be real buttons -- a button inside an <a>
// is invalid HTML. Both come before the link in the source so that their static position is the title's
// row, and they only show on hover
// or focus (a finished card keeps its circle). Both write through PATCH, which changes the Field named and
// nothing else, and both answer with the board.
templ boardCard(m *domain.Machine, c RecordCard, actor domain.Actor, mv CardMove) {
	{{ title := cardRole(c, domain.CardFieldRoleTitle) }}
	{{ done := c.Complete != nil && c.Complete.Done }}
	{{ canEdit := authorization.AllowsAction(m, domain.ActionEdit, c.Record.Values, actor) }}
	<div
		data-card
		data-url={ cardPatchURL(m, c) }
		if canEdit && mv.Field != "" {
			draggable="true"
		}
		class={ "group/card relative flex flex-col gap-2", tileClasses(ctx), backgroundClass(ctx, domain.BackgroundRaised), "px-2.5 py-2 text-slate-900 hover:shadow-sm" }
	>
		if len(c.Tags) > 0 {
			@rowLayout(domain.GapTight, domain.RowAlignStretch, domain.RowJustifyStart) {
				for _, t := range c.Tags {
					@tagChip(t)
				}
			}
		}
		<span class="block">
			if c.Complete != nil && canEdit {
				<form
					class={ "absolute left-2.5 z-10 opacity-0 group-hover/card:opacity-100 group-focus-within/card:opacity-100", templ.KV("opacity-100", done) }
					hx-patch={ cardPatchURL(m, c) }
					hx-target="#machine-body"
					hx-swap="innerHTML"
				>
					<input type="hidden" name={ c.Complete.Field } value={ c.Complete.Next }/>
					<button
						type="submit"
						aria-pressed={ fmt.Sprint(done) }
						aria-label={ completeLabel(done, title) }
						class={ "grid size-5 place-items-center rounded-full border-2 text-white", templ.KV("border-emerald-600 bg-emerald-600", done), templ.KV("border-slate-300 hover:border-emerald-600", !done) }
					>
						if done {
							@icon("check", "size-3")
						}
					</button>
				</form>
			}
			if canEdit {
				<details class="group/edit absolute right-2 z-10 rounded-md opacity-0 group-hover/card:opacity-100 group-focus-within/card:opacity-100 open:inset-x-0 open:top-0 open:rounded-md open:border open:border-slate-200 open:bg-white open:p-2 open:opacity-100 open:shadow-md">
					<summary aria-label={ "Edit " + title } class="grid size-5 cursor-pointer list-none place-items-center rounded text-slate-400 hover:bg-slate-100 hover:text-slate-700 group-open/edit:hidden">
						@icon("pencil", "size-3.5")
					</summary>
					<form class="flex flex-col gap-1.5" hx-patch={ cardPatchURL(m, c) } hx-target="#machine-body" hx-swap="innerHTML">
						<input type="text" name={ cardTitleFieldID(m) } value={ title } required aria-label="Card title" class={ fieldClasses(ctx) + " w-full" }/>
						<span class="flex gap-1.5">
							@button("Save", domain.ButtonPrimary, "", "")
							<button type="button" class={ buttonClasses(ctx, domain.ButtonSecondary) } onclick="this.closest('details').open=false">Cancel</button>
						</span>
					</form>
					if mv.Field != "" && len(mv.Targets) > 0 {
						<form class={ "mt-2 flex flex-col gap-1.5 border-t", borderClass(ctx, domain.BorderSurface), "pt-2" } hx-patch={ cardPatchURL(m, c) } hx-target="#machine-body" hx-swap="innerHTML">
							<label class="flex flex-col gap-1 text-2xs text-slate-500">
								Move to list
								<select name={ mv.Field } class={ fieldClasses(ctx) + " w-full" }>
									for _, t := range mv.Targets {
										<option value={ t.Value } selected?={ t.Value == mv.Current }>{ t.Label }</option>
									}
								</select>
							</label>
							<label class="flex flex-col gap-1 text-2xs text-slate-500">
								Position
								<input type="number" name="position" min="1" value={ fmt.Sprint(mv.Position) } class={ fieldClasses(ctx) + " w-full" }/>
							</label>
							@button("Move", domain.ButtonSecondary, "", "")
						</form>
					}
				</details>
			}
			<a
				href={ templ.URL("/machines/" + m.ID + "/records/" + c.Record.ID) }
				draggable="false"
				class={ "block text-sm leading-snug after:absolute after:inset-0", templ.KV("text-slate-500", done), templ.KV("group-hover/card:pl-7 group-hover/card:pr-6 group-focus-within/card:pl-7 group-focus-within/card:pr-6", canEdit && c.Complete != nil), templ.KV("pl-7 pr-6", done && canEdit) }
			>{ title }</a>
		</span>
		{{ person := cardRole(c, domain.CardFieldRolePerson) }}
		if c.Date.Present || person != "" {
			<span class="flex items-center justify-between gap-2">
				if c.Date.Present {
					<span class={ "inline-flex items-center gap-1 rounded px-1.5 py-0.5 text-2xs", toneClass(ctx, c.Date.Tone) }>
						if c.Date.Done {
							@icon("check", "size-3")
						} else {
							@icon("calendar", "size-3")
						}
						{ c.Date.Label }
					</span>
				}
				if person != "" {
					<span class="ml-auto">
						@avatar(personInitials(person, ""), person, domain.AvatarCompact, domain.AvatarPresent)
					</span>
				}
			</span>
		}
	</div>
}

// cardPatchURL is the route a card's own writes go through.
func cardPatchURL(m *domain.Machine, c RecordCard) string {
	return "/machines/" + m.ID + "/records/" + c.Record.ID
}

// completeLabel is the circle's accessible name: what pressing it does, naming the card.
func completeLabel(done bool, title string) string {
	if done {
		return "Mark \u201c" + title + "\u201d not complete"
	}
	return "Mark \u201c" + title + "\u201d complete"
}

// cardTitleFieldID is the Field a composer's input fills: the Machine's `title` card role, or its first
// Field when it declares no projection.
func cardTitleFieldID(m *domain.Machine) string {
	for _, cf := range m.CardFields {
		if cf.Role == domain.CardFieldRoleTitle {
			return cf.Field
		}
	}
	if len(m.Fields) > 0 {
		return m.Fields[0].ID
	}
	return ""
}

// cardComposer is a column's "Add a card": a title and, hidden, the group value that places the new record
// in this column. It posts to the same create route the generic form does, so every default, permission and
// validation that route applies applies here -- a composer is a smaller form, not a second way to write.
templ cardComposer(m *domain.Machine, v domain.View, col experience.Column) {
	<details class="group">
		<summary class="cursor-pointer list-none rounded-md px-1 py-1.5 text-xs text-slate-500 hover:text-slate-900 group-open:hidden">Add a card</summary>
		<form
			class="flex flex-col gap-2"
			hx-post={ fmt.Sprintf("/machines/%s/records", m.ID) }
			hx-target="#machine-body"
			hx-swap="innerHTML"
			hx-encoding="multipart/form-data"
		>
			<input type="hidden" name={ v.GroupBy } value={ col.ID }/>
			<input type="text" name={ cardTitleFieldID(m) } required placeholder="Card title" aria-label="Card title" class={ fieldClasses(ctx) + " w-full" }/>
			@button("Add", domain.ButtonPrimary, "", "")
		</form>
	</details>
}

// newCardPopover is the header's "New <machine>" button: every editable Field of the Machine in one form.
templ newCardPopover(m *domain.Machine, relations RelationOptions, groups GroupOptions) {
	<details class="relative">
		<summary class="cursor-pointer list-none rounded-md bg-slate-900 px-3 py-1.5 text-xs font-medium text-white hover:bg-slate-800">{ "New " + strings.ToLower(m.Name) }</summary>
		<form
			class={ "absolute right-0 z-10 mt-2 flex w-72 flex-col gap-3", surfaceClasses(ctx), "p-4 shadow-lg" }
			hx-post={ fmt.Sprintf("/machines/%s/records", m.ID) }
			hx-target="#machine-body"
			hx-swap="innerHTML"
			hx-encoding="multipart/form-data"
		>
			for _, f := range m.Fields {
				if f.Compute == nil && f.Type != domain.FieldTypeFile {
					<label class="flex flex-col gap-1 text-xs text-slate-500">
						{ f.Name }
						@fieldInput(f, nil, relations, groups)
					</label>
				}
			}
			@button("Create", domain.ButtonPrimary, "", "")
		</form>
	</details>
}

// createFormRow is the record-creation form, shared by every Layout so a create form isn't
// duplicated per Layout kind.
templ createFormRow(m *domain.Machine, relations RelationOptions, groups GroupOptions) {
	<tr>
		<form
			hx-post={ fmt.Sprintf("/machines/%s/records", m.ID) }
			hx-target="#machine-body"
			hx-swap="innerHTML"
			hx-encoding="multipart/form-data"
		>
			for _, f := range m.Fields {
				<td class={ "border-b", borderClass(ctx, domain.BorderDivider), "px-3 pt-3 pb-2 align-middle" }>
					@fieldInput(f, nil, relations, groups)
				</td>
			}
			<td class={ "border-b", borderClass(ctx, domain.BorderDivider), "px-3 pt-3 pb-2 align-middle whitespace-nowrap" }>
				@button("Add", domain.ButtonPrimary, "", "")
			</td>
		</form>
	</tr>
}

// RecordRow is one Record in display mode. A relation field shows its target's label, not the
// raw record id; the first field links to the record's own detail page (Phase 8). Edit is offered
// only when authorization.AllowsAction says actor may perform ActionEdit on r
// (MachinePage/MachineBody's own doc comment explains why, development-history.md Phase 16, decideButtons'
// pattern); a Machine with no declared Permission for edit stays open to any actor, same as
// before this existed. Delete additionally requires action.CanDelete's own business-state check
// (Approval Step already decided, Document already approved) -- the same AND detail.templ's
// canDeleteInView already applies, added here 2026-09-19 (code-review finding: this generic list/
// board row had no business-state check at all, offering Delete for a record deleteAllowed would
// then reject server-side). Called with nil steps -- unlike canDeleteInView, this generic row has
// no Document's own child-collection steps in hand, so a Document row's own check degrades to
// status-only, the same fallback canDeleteInView already uses when it can't find them either.
templ RecordRow(m *domain.Machine, r *data.Record, relations RelationOptions, groups GroupOptions, actor domain.Actor, now time.Time) {
	<tr id={ "record-" + r.ID }>
		for i, f := range m.Fields {
			<td class={ tableCellClasses(ctx) }>
				if i == 0 {
					<a class="font-medium text-blue-600 hover:text-blue-700" href={ templ.URL(fmt.Sprintf("/machines/%s/records/%s", m.ID, r.ID)) }>{ fmt.Sprint(r.Values[f.ID]) }</a>
				} else if f.ID == m.SLAField {
					@slaBadge(experience.ResolveSLABadge(r.Values[f.ID], now))
				} else if f.Type == domain.FieldTypeFile {
					@fileLink(r.Values[f.ID])
				} else if f.IsReference() {
					{ RelationLabel(relations, f.RelatedMachine, toString(r.Values[f.ID])) }
				} else if f.Type == domain.FieldTypeGroup {
					{ GroupLabel(groups, toString(r.Values[f.ID])) }
				} else {
					{ fmt.Sprint(r.Values[f.ID]) }
				}
			</td>
		}
		<td class={ "border-b", borderClass(ctx, domain.BorderDivider), "px-3 py-2 align-middle whitespace-nowrap" }>
			if authorization.AllowsAction(m, domain.ActionEdit, r.Values, actor) {
				<button
					class={ buttonClasses(ctx, domain.ButtonSecondary) + " mr-1" }
					hx-get={ fmt.Sprintf("/machines/%s/records/%s/edit", m.ID, r.ID) }
					hx-target={ "#record-" + r.ID }
					hx-swap="outerHTML"
				>Edit</button>
			}
			{{ deletable, _ := action.CanDelete(m, r.Values, nil) }}
			if deletable && authorization.AllowsAction(m, domain.ActionDelete, r.Values, actor) {
				<button
					class={ buttonClasses(ctx, domain.ButtonSecondary) }
					hx-delete={ fmt.Sprintf("/machines/%s/records/%s", m.ID, r.ID) }
					hx-target={ "#record-" + r.ID }
					hx-swap="outerHTML"
					hx-confirm="Delete this record?"
				>Delete</button>
			}
		</td>
	</tr>
}

// RecordEditRow is one Record in edit mode: an inline form pre-filled with its current values.
// RecordRow already hid the Edit button that reaches this for anyone AllowsAction(ActionEdit)
// refuses; Save needs no gate of its own here for the same reason decideButtons' Approve/Reject
// doesn't re-check either -- allowsRecordEdit (internal/web/record.go's updateRecordForm) is what
// actually enforces it, on the PUT this form submits, regardless of how the request got here.
templ RecordEditRow(m *domain.Machine, r *data.Record, relations RelationOptions, groups GroupOptions) {
	<tr id={ "record-" + r.ID }>
		<form
			hx-put={ fmt.Sprintf("/machines/%s/records/%s", m.ID, r.ID) }
			hx-target={ "#record-" + r.ID }
			hx-swap="outerHTML"
			hx-encoding="multipart/form-data"
		>
			for _, f := range m.Fields {
				<td class={ tableCellClasses(ctx) }>
					@fieldInput(f, r.Values[f.ID], relations, groups)
				</td>
			}
			<td class={ "border-b", borderClass(ctx, domain.BorderDivider), "px-3 py-2 align-middle whitespace-nowrap" }>
				<button type="submit" class={ buttonClasses(ctx, domain.ButtonPrimary) + " mr-1" }>Save</button>
				<button
					type="button"
					class={ buttonClasses(ctx, domain.ButtonSecondary) }
					hx-get={ fmt.Sprintf("/machines/%s/records/%s", m.ID, r.ID) }
					hx-target={ "#record-" + r.ID }
					hx-swap="outerHTML"
				>Cancel</button>
			</td>
		</form>
	</tr>
}

func toString(v any) string {
	if v == nil {
		return ""
	}
	return fmt.Sprint(v)
}

// selectableViews is m.Views minus any domain.ViewStepper entries -- see viewSwitcher's own doc
// comment for why that type is not a valid alternate arrangement of a Machine's own flat list.
func selectableViews(m *domain.Machine) []domain.View {
	views := make([]domain.View, 0, len(m.Views))
	for _, v := range m.Views {
		if v.EffectiveType() != domain.ViewStepper {
			views = append(views, v)
		}
	}
	return views
}

func toBool(v any) bool {
	b, _ := v.(bool)
	return b
}

// RelationLabel resolves a relation field's stored record id to its target's display label, or
// the raw id if the target isn't in relations (e.g. deleted after the reference was made).
// Exported so internal/composition can resolve a person/relation CardField's display string
// itself (007 §7.6 Projection pilot) rather than re-implementing this lookup a second time --
// composition resolves values, rendering only picks markup by role (CLAUDE.md "Reference over
// Duplication").
func RelationLabel(relations RelationOptions, machineID, id string) string {
	if id == "" {
		return ""
	}
	for _, opt := range relations[machineID] {
		if opt.ID == id {
			return opt.Label
		}
	}
	return id
}

// slaBadge and sectionHeader were deleted on 2026-09-24, with the stylesheet that was their whole
// reason for existing. Each had a Tailwind twin (slaBadgePill, sectionHeaderRow -- appshell.templ)
// drawing the identical thing in the other system, which was a deliberate, documented cost of the
// two-stylesheet transition; once the last pageStyles screen ported, the pair was simply the same
// component written twice. Callers use the appshell.templ ones.

// ProjectedField is one Field a Machine's card_fields (domain.CardField, 007 §7.6
// Projection) projected onto a composed card, already resolved to a display string by
// internal/composition -- this package never re-resolves a relation or re-reads a record for it,
// the same "composition resolves, rendering only decides markup" split PendingApprovalCard's other
// fields already follow.
type ProjectedField struct {
	Label   string
	Role    string
	Display string
}

// projectedFieldValue picks markup by ProjectedField.Role, the generic role-registry seam (007
// §14) this repo's composed cards can grow into instead of each hardcoding its own field list --
// Fase 1 of the composable-runtime kajian. Closed set, mirrors domain.KnownCardFieldRoles: `status`
// reuses the `badge` class every composed card already uses (Approval Inbox's own Mode/ratio
// badge), so no new CSS is introduced for the pilot. Every other role renders as plain text today
// -- no currency/date-reformatting logic invented beyond what internal/composition already does
// for values like SubmittedAt.
templ projectedFieldValue(p ProjectedField) {
	<span class="text-slate-400">{ p.Label }</span>
	if p.Role == string(domain.CardFieldRoleStatus) {
		@statusBadge(p.Display, domain.ToneInfo, domain.BadgeCompact)
	} else {
		<span class="text-slate-500">{ p.Display }</span>
	}
}

// SummaryItem is one label/value pair on a summary-counts strip. Promoted to a shared component
// (development-history.md Phase 15 Step 0) after the same shape was found hand-rendered independently across
// the Dashboard, My Tasks, Sprint Dashboard, and Team Capacity pages -- real cross-domain
// recurrence (four different business questions), the same admission bar `slaBadge` itself already
// cleared in Phase 13. summaryCounts, the `pageStyles` templ that rendered it, and activityFeedList
// beside it, were both deleted 2026-09-22 with their last callers: all four pages ported from
// `pageShell` to `appShell` the same day, onto summaryCountTiles/activityFeedListRow
// (appshell.templ) instead -- the type stays, the two pageStyles-era renderers of it did not
// (capabilities.md, "component with zero callers is a claim capabilities.md would be making on the
// code's behalf, and this repo gates exactly that kind of drift").
type SummaryItem struct {
	Label string
	Value string
	// Hint is the qualifier under the label ("Past its due date"); Tone is the signal on the value. Both are
	// optional and both are Metric's own optional inputs, passed through unchanged.
	Hint string
	Tone domain.BadgeTone
}

// SummaryCard / recordSummaryCard / summaryCardList were deleted on 2026-09-21, with their last
// caller. They drew the Approval Inbox's My Documents list as plain rows -- avatar, title,
// subtitle, status badge -- which is what board 11 specified before that board was retired; the
// owner asked for one card face across both of that screen's lists, so My Documents now renders
// approvalinbox.templ's own pendingApprovalCard and nothing referenced these three any more.
//
// Not kept "in case": 007 §12.3 names RecordSummaryCard as a Component example, so the concept is
// still in the target vocabulary and comes back the moment a screen needs it -- but a component
// with zero callers is a claim capabilities.md would be making on the code's behalf, and this repo
// gates exactly that kind of drift.
