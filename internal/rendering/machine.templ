package rendering

import (
	"fmt"
	"time"

	"menata.app/internal/data"
	"menata.app/internal/domain"
	"menata.app/internal/experience"
	"menata.app/internal/storage"
)

// pageShell is the shared HTML document, styles, and topbar every page uses. It exists so
// generalizing from one Machine to several (ROADMAP.md Phase 3) doesn't duplicate boilerplate
// per page.
templ pageShell(title string, appName string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Menata App</title>
			<script src="https://unpkg.com/htmx.org@2.0.4" defer></script>
			<script src="https://unpkg.com/hyperscript.org@0.9.93" defer></script>
			<style>
				body { font-family: system-ui, -apple-system, sans-serif; max-width: 760px; margin: 3rem auto; padding: 0 1rem; color: #1a1a1a; }
				header.topbar { display: flex; justify-content: space-between; align-items: center; padding-bottom: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid #e5e5e5; }
				header.topbar .left { display: flex; align-items: center; gap: 1rem; }
				header.topbar span { color: #666; font-size: 0.85rem; }
				header.topbar a { color: #3949ab; font-size: 0.85rem; text-decoration: none; }
				header.topbar button { padding: 0.3rem 0.75rem; border: 1px solid #ccc; border-radius: 4px; background: #fff; cursor: pointer; font-size: 0.8rem; }
				h1 { margin-bottom: 0.25rem; }
				code { color: #666; font-size: 0.9rem; }
				table { border-collapse: collapse; width: 100%; margin-top: 1rem; }
				th, td { text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid #e5e5e5; vertical-align: middle; }
				th { color: #666; font-weight: 600; font-size: 0.85rem; text-transform: uppercase; }
				.badge { display: inline-block; padding: 0.1rem 0.6rem; border-radius: 999px; background: #eef1fb; color: #3949ab; font-size: 0.8rem; }
				.yes { color: #b00020; }
				.no { color: #999; }
				input, select { padding: 0.35rem 0.5rem; border: 1px solid #ccc; border-radius: 4px; font-size: 0.9rem; width: 100%; box-sizing: border-box; }
				button { padding: 0.35rem 0.75rem; border: 1px solid #ccc; border-radius: 4px; background: #fff; cursor: pointer; font-size: 0.85rem; }
				button.primary { background: #3949ab; color: #fff; border-color: #3949ab; }
				.actions { white-space: nowrap; }
				.actions button { margin-right: 0.25rem; }
				form.create-form td { padding-top: 0.75rem; }
				dl.detail-fields { display: grid; grid-template-columns: 10rem 1fr; row-gap: 0.75rem; column-gap: 1rem; margin: 1.5rem 0; }
				dl.detail-fields dt { color: #666; font-size: 0.85rem; font-weight: 600; text-transform: uppercase; align-self: center; }
				dl.detail-fields dd { margin: 0; }
				ul.machine-list { list-style: none; padding: 0; }
				ul.machine-list li { padding: 0.75rem; border-bottom: 1px solid #e5e5e5; }
				ul.machine-list a { color: #1a1a1a; text-decoration: none; font-weight: 500; }
				.board { display: flex; gap: 1rem; margin-top: 1rem; overflow-x: auto; padding-bottom: 0.5rem; }
				.board-column { flex: 0 0 260px; background: #f7f8fc; border-radius: 6px; padding: 0.75rem; }
				.board-column h3 { margin: 0 0 0.5rem 0; font-size: 0.8rem; color: #444; text-transform: uppercase; }
				.board-column table { margin-top: 0; font-size: 0.85rem; }
				.board-column th { display: none; }
				.board-column td { padding: 0.35rem 0.4rem; }
				h2 { margin-top: 2rem; }
				h3 { margin-top: 1.5rem; font-size: 1rem; color: #444; }
				ul.summary-counts { list-style: none; padding: 0; display: flex; gap: 1.5rem; }
				ul.summary-counts li { color: #444; font-size: 0.9rem; }
				ul.activity-feed { list-style: none; padding: 0; }
				ul.activity-feed li { padding: 0.5rem 0; border-bottom: 1px solid #e5e5e5; display: flex; gap: 0.6rem; align-items: baseline; }
				.muted { color: #999; font-size: 0.8rem; margin-left: auto; }
			</style>
		</head>
		<body>
			<header class="topbar">
				<span class="left">
					<a href="/">Machines</a>
					<a href="/dashboard">Dashboard</a>
					<a href="/my-tasks">My Tasks</a>
					<a href="/activity">Activity</a>
					<a href="/team-capacity">Team Capacity</a>
					<a href="/automation">Automation</a>
					<a href="/calendar">Calendar</a>
					<a href="/sprint">Sprint Dashboard</a>
					<a href="/board-settings">Board Settings</a>
					<span>{ appName }</span>
				</span>
				<form method="POST" action="/logout">
					<button type="submit">Log out</button>
				</form>
			</header>
			{ children... }
		</body>
	</html>
}

// MachineList is the landing page: every Machine in the Application, linking to its own page.
// Adding a third Machine requires no code change here -- it appears because it's in the
// Application manifest, per ROADMAP.md Phase 3's exit criterion.
templ MachineList(machines []*domain.Machine, appName string) {
	@pageShell("Machines", appName) {
		<h1>Machines</h1>
		<ul class="machine-list">
			for _, m := range machines {
				<li>
					<a href={ templ.URL("/machines/" + m.ID) }>{ m.Name }</a>
					<code>{ m.ID }</code>
				</li>
			}
		</ul>
	}
}

// MachinePage is the reference renderer for a single Machine: its field schema, a create form,
// and its persisted records with inline edit/delete. It exists to prove the metadata -> data ->
// render pipeline end to end; it is not yet driven by UI IR or a View Model
// (007-composable-runtime-architecture.md §10, §23).
templ MachinePage(m *domain.Machine, records []*data.Record, appName string, relations RelationOptions, boardColumns []experience.Column) {
	@pageShell(m.Name, appName) {
		<div id="machine-body">
			@MachineBody(m, records, relations, boardColumns)
		</div>
	}
}

// MachineBody is the fragment every mutating endpoint returns for HTMX to swap into
// #machine-body, so the full page never needs a hard reload. boardColumns is non-nil only when
// m's board Layout groups by a relation field (ROADMAP.md Phase 10's ordered Lists) -- fetching
// those columns is I/O this package doesn't perform, so the caller supplies them; nil means "use
// the status field's own Options instead" (Phase 5's original behavior, still supported).
templ MachineBody(m *domain.Machine, records []*data.Record, relations RelationOptions, boardColumns []experience.Column) {
	<h1>{ m.Name }</h1>
	<code>{ m.ID }</code>

	<h2>Fields</h2>
	<table>
		<thead>
			<tr>
				<th>Field</th>
				<th>Type</th>
				<th>Required</th>
			</tr>
		</thead>
		<tbody>
			for _, f := range m.Fields {
				<tr>
					<td>{ f.Name }</td>
					<td><span class="badge">{ string(f.Type) }</span></td>
					<td>
						if f.Required {
							<span class="yes">yes</span>
						} else {
							<span class="no">no</span>
						}
					</td>
				</tr>
			}
		</tbody>
	</table>

	<h2>Records ({ fmt.Sprint(len(records)) })</h2>
	switch m.View.EffectiveLayout() {
		case domain.LayoutBoard:
			@boardLayout(m, records, relations, boardColumns)
		default:
			@tableLayout(m, records, relations)
	}
}

// tableLayout is the generic flat-list Layout: every Field as a column, every Record as a row,
// plus a create-form row (007 §12.2 "Layout is a generic structural composition primitive").
templ tableLayout(m *domain.Machine, records []*data.Record, relations RelationOptions) {
	<table>
		<thead>
			<tr>
				for _, f := range m.Fields {
					<th>{ f.Name }</th>
				}
				<th></th>
			</tr>
		</thead>
		<tbody>
			for _, r := range records {
				@RecordRow(m, r, relations)
			}
			@createFormRow(m, relations)
		</tbody>
	</table>
}

// boardLayout groups records into columns by m.View.GroupBy and renders each column as the same
// generic table primitive tableLayout already uses -- a board is not a new renderer, it is
// Collection + Group Dimension + the existing Table renderer, reused per column
// (006-runtime-model.md "View" lowering formula).
templ boardLayout(m *domain.Machine, records []*data.Record, relations RelationOptions, boardColumns []experience.Column) {
	<div class="board">
		for _, col := range experience.GroupRecords(m, records, boardColumns) {
			<div class="board-column">
				<h3>{ col.Label } ({ fmt.Sprint(len(col.Records)) })</h3>
				<table>
					<tbody>
						for _, r := range col.Records {
							@RecordRow(m, r, relations)
						}
					</tbody>
				</table>
			</div>
		}
	</div>
	<h3>Add Record</h3>
	<table>
		<tbody>
			@createFormRow(m, relations)
		</tbody>
	</table>
}

// createFormRow is the record-creation form, shared by every Layout so a create form isn't
// duplicated per Layout kind.
templ createFormRow(m *domain.Machine, relations RelationOptions) {
	<tr>
		<form
			class="create-form"
			hx-post={ fmt.Sprintf("/machines/%s/records", m.ID) }
			hx-target="#machine-body"
			hx-swap="innerHTML"
			hx-encoding="multipart/form-data"
		>
			for _, f := range m.Fields {
				<td>
					@fieldInput(f, nil, relations)
				</td>
			}
			<td>
				<button type="submit" class="primary">Add</button>
			</td>
		</form>
	</tr>
}

// RecordRow is one Record in display mode. A relation field shows its target's label, not the
// raw record id; the first field links to the record's own detail page (Phase 8).
templ RecordRow(m *domain.Machine, r *data.Record, relations RelationOptions) {
	<tr id={ "record-" + r.ID }>
		for i, f := range m.Fields {
			<td>
				if i == 0 {
					<a href={ templ.URL(fmt.Sprintf("/machines/%s/records/%s", m.ID, r.ID)) }>{ fmt.Sprint(r.Values[f.ID]) }</a>
				} else if f.ID == m.View.SLAField {
					@slaBadge(r.Values[f.ID])
				} else if f.Type == domain.FieldTypeFile {
					@fileLink(r.Values[f.ID])
				} else if f.IsReference() {
					{ relationLabel(relations, f.RelatedMachine, toString(r.Values[f.ID])) }
				} else {
					{ fmt.Sprint(r.Values[f.ID]) }
				}
			</td>
		}
		<td class="actions">
			<button
				hx-get={ fmt.Sprintf("/machines/%s/records/%s/edit", m.ID, r.ID) }
				hx-target={ "#record-" + r.ID }
				hx-swap="outerHTML"
			>Edit</button>
			<button
				hx-delete={ fmt.Sprintf("/machines/%s/records/%s", m.ID, r.ID) }
				hx-target={ "#record-" + r.ID }
				hx-swap="outerHTML"
				hx-confirm="Delete this record?"
			>Delete</button>
		</td>
	</tr>
}

// RecordEditRow is one Record in edit mode: an inline form pre-filled with its current values.
templ RecordEditRow(m *domain.Machine, r *data.Record, relations RelationOptions) {
	<tr id={ "record-" + r.ID }>
		<form
			hx-put={ fmt.Sprintf("/machines/%s/records/%s", m.ID, r.ID) }
			hx-target={ "#record-" + r.ID }
			hx-swap="outerHTML"
			hx-encoding="multipart/form-data"
		>
			for _, f := range m.Fields {
				<td>
					@fieldInput(f, r.Values[f.ID], relations)
				</td>
			}
			<td class="actions">
				<button type="submit" class="primary">Save</button>
				<button
					type="button"
					hx-get={ fmt.Sprintf("/machines/%s/records/%s", m.ID, r.ID) }
					hx-target={ "#record-" + r.ID }
					hx-swap="outerHTML"
				>Cancel</button>
			</td>
		</form>
	</tr>
}

// fieldInput renders the input control appropriate to a Field's semantic type, pre-filled with
// current (nil for a blank create-form field). relations supplies <select> options for any
// reference field (Relation or Person, per domain.Field.IsReference); unused for every other
// type.
templ fieldInput(f domain.Field, current any, relations RelationOptions) {
	switch {
		case f.Type == domain.FieldTypeStatus:
			<select name={ f.ID }>
				<option value=""></option>
				for _, opt := range f.Options {
					<option value={ opt } selected?={ toString(current) == opt }>{ opt }</option>
				}
			</select>
		case f.IsReference():
			<select name={ f.ID }>
				<option value=""></option>
				for _, opt := range relations[f.RelatedMachine] {
					<option value={ opt.ID } selected?={ toString(current) == opt.ID }>{ opt.Label }</option>
				}
			</select>
		case f.Type == domain.FieldTypeBoolean:
			<input type="checkbox" name={ f.ID } checked?={ toBool(current) }/>
		case f.Type == domain.FieldTypeDate:
			<input type="date" name={ f.ID } value={ toString(current) }/>
		case f.Type == domain.FieldTypeNumber:
			<input type="number" step="any" name={ f.ID } value={ toString(current) }/>
		case f.Type == domain.FieldTypeFile:
			if key := toString(current); key != "" {
				<div>
					<a href={ templ.URL("/uploads/" + key) } target="_blank">{ storage.DisplayName(key) }</a>
					<input type="file" name={ f.ID }/>
				</div>
			} else {
				<input type="file" name={ f.ID }/>
			}
		default:
			<input type="text" name={ f.ID } value={ toString(current) }/>
	}
}

func toString(v any) string {
	if v == nil {
		return ""
	}
	return fmt.Sprint(v)
}

func toBool(v any) bool {
	b, _ := v.(bool)
	return b
}

// relationLabel resolves a relation field's stored record id to its target's display label, or
// the raw id if the target isn't in relations (e.g. deleted after the reference was made).
func relationLabel(relations RelationOptions, machineID, id string) string {
	if id == "" {
		return ""
	}
	for _, opt := range relations[machineID] {
		if opt.ID == id {
			return opt.Label
		}
	}
	return id
}

// fileLink renders a FieldTypeFile value as a download link, or nothing if unset.
templ fileLink(v any) {
	if key := toString(v); key != "" {
		<a href={ templ.URL("/uploads/" + key) } target="_blank">{ storage.DisplayName(key) }</a>
	}
}

// slaBadge renders a date value as an OVERDUE / "N day(s) left" badge (ROADMAP.md Phase 13,
// matching document-approval.html's own real markup), or nothing if the date can't be parsed
// (empty/unset).
templ slaBadge(v any) {
	if due, err := time.Parse("2006-01-02", toString(v)); err == nil {
		{{ status, label := experience.EvaluateSLA(due, time.Now()) }}
		if status == experience.SLAOverdue {
			<span class="yes">{ label }</span>
		} else {
			<span class="badge">{ label }</span>
		}
	}
}
