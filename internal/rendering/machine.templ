package rendering

import (
	"fmt"

	"menata.app/internal/data"
	"menata.app/internal/domain"
)

// MachinePage is a minimal reference renderer for a single Machine: a plain HTML table of its
// fields, plus its persisted records. It exists to prove the metadata -> data -> render pipeline
// end to end; it is not yet driven by UI IR or a View Model
// (007-composable-runtime-architecture.md §10, §23).
templ MachinePage(m *domain.Machine, records []*data.Record) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ m.Name } · Menata App</title>
			<style>
				body { font-family: system-ui, -apple-system, sans-serif; max-width: 640px; margin: 3rem auto; padding: 0 1rem; color: #1a1a1a; }
				h1 { margin-bottom: 0.25rem; }
				code { color: #666; font-size: 0.9rem; }
				table { border-collapse: collapse; width: 100%; margin-top: 1.5rem; }
				th, td { text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid #e5e5e5; }
				th { color: #666; font-weight: 600; font-size: 0.85rem; text-transform: uppercase; }
				.badge { display: inline-block; padding: 0.1rem 0.6rem; border-radius: 999px; background: #eef1fb; color: #3949ab; font-size: 0.8rem; }
				.yes { color: #b00020; }
				.no { color: #999; }
			</style>
		</head>
		<body>
			<h1>{ m.Name }</h1>
			<code>{ m.ID }</code>
			<table>
				<thead>
					<tr>
						<th>Field</th>
						<th>Type</th>
						<th>Required</th>
					</tr>
				</thead>
				<tbody>
					for _, f := range m.Fields {
						<tr>
							<td>{ f.Name }</td>
							<td><span class="badge">{ string(f.Type) }</span></td>
							<td>
								if f.Required {
									<span class="yes">yes</span>
								} else {
									<span class="no">no</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>

			<h2>Records ({ fmt.Sprint(len(records)) })</h2>
			if len(records) == 0 {
				<p class="no">No records yet.</p>
			} else {
				<table>
					<thead>
						<tr>
							for _, f := range m.Fields {
								<th>{ f.Name }</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, rec := range records {
							<tr>
								for _, f := range m.Fields {
									<td>{ fmt.Sprint(rec.Values[f.ID]) }</td>
								}
							</tr>
						}
					</tbody>
				</table>
			}
		</body>
	</html>
}
