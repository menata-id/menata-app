package rendering

import (
	"fmt"

	"menata.app/internal/action"
	"menata.app/internal/data"
)

// SignaturePlacementPage is Case 3's signature-coordinate placement screen (ROADMAP.md Phase 15
// Step 4): one draggable marker per Approval Step, over a real rendered page of the Document's
// own PDF (Step 3's internal/pdf). Hardcoded to mch_document/mch_approval_step, same posture as
// internal/action -- Case 3's own screen, not a generic per-Machine mechanism.
//
// Dragging a marker is the one named vanilla-JS exception (README.md's "Tech stack"): HTMX's
// request/response model has no way to express continuous pointer movement. Everything else here
// -- placing a marker on the current page, saving a drag's final position -- is an ordinary HTMX
// form post to the ROADMAP.md Phase 3/11 generic PUT route, exactly like every other edit in this
// app.
templ SignaturePlacementPage(document *data.Record, steps []*data.Record, relations RelationOptions, page, totalPages int, appName string) {
	@pageShell("Signature Placement", appName) {
		<p><a href={ templ.URL("/machines/" + action.DocumentMachineID + "/records/" + document.ID) }>← { toString(document.Values["fld_title"]) }</a></p>
		<h1>Signature positions</h1>
		<p class="step-status">Place one marker per approval step. Drag a placed marker to reposition it.</p>
		<div class="sig-layout">
			<section>
				<div class="sig-pager">
					<strong>Page { fmt.Sprint(page) } of { fmt.Sprint(totalPages) }</strong>
					<span>
						if page > 1 {
							<a href={ templ.URL(placementURL(document.ID, page-1)) }>← Prev</a>
						}
						if page < totalPages {
							<a href={ templ.URL(placementURL(document.ID, page+1)) }>Next →</a>
						}
					</span>
				</div>
				<div class="sig-canvas">
					<img src={ previewURL(document.ID, page) } alt="Document page preview"/>
					for i, s := range steps {
						if signaturePage(s) == page {
							@sigMarker(s, i+1)
						}
					}
				</div>
			</section>
			<aside>
				<h2>Approval steps</h2>
				for i, s := range steps {
					<div class="sig-step-card">
						<strong>{ fmt.Sprintf("%d. %s", i+1, relationLabel(relations, "mch_user", toString(s.Values[action.FieldStepAssignee]))) }</strong>
						if signaturePlaced(s) {
							<p class="step-status">{ fmt.Sprintf("Page %d · %.0f%% · %.0f%%", signaturePage(s), signatureCoord(s, action.FieldStepSignatureX), signatureCoord(s, action.FieldStepSignatureY)) }</p>
						} else {
							<p class="step-status">Not placed yet</p>
						}
						@placeStepForm(s, page)
					</div>
				}
			</aside>
		</div>
		<script>
			(function () {
				var dragging = null;
				document.querySelectorAll(".sig-marker").forEach(function (marker) {
					marker.addEventListener("pointerdown", function (e) {
						dragging = marker;
						marker.setPointerCapture(e.pointerId);
					});
				});
				document.addEventListener("pointermove", function (e) {
					if (!dragging) return;
					var rect = dragging.closest(".sig-canvas").getBoundingClientRect();
					var x = Math.min(100, Math.max(0, ((e.clientX - rect.left) / rect.width) * 100));
					var y = Math.min(100, Math.max(0, ((e.clientY - rect.top) / rect.height) * 100));
					dragging.style.left = x + "%";
					dragging.style.top = y + "%";
					var form = dragging.closest("form");
					form.querySelector(".sig-x-input").value = x.toFixed(1);
					form.querySelector(".sig-y-input").value = y.toFixed(1);
				});
				document.addEventListener("pointerup", function () {
					if (!dragging) return;
					dragging.closest("form").requestSubmit();
					dragging = null;
				});
			})();
		</script>
	}
}

// sigMarker is one already-placed Approval Step's draggable marker, positioned by inline style
// from its own stored percentage coordinates. Its form carries every field the generic PUT route
// requires (ROADMAP.md Phase 3/11) so a drag-triggered submit is a normal record update, not a
// partial one -- fld_decision is included unchanged, never edited here, so updateRecordForm's own
// Phase 12 guard never fires.
templ sigMarker(s *data.Record, index int) {
	<form
		hx-put={ fmt.Sprintf("/machines/%s/records/%s", action.StepMachineID, s.ID) }
		hx-swap="none"
		hx-on::after-request="if(event.detail.successful) window.location.reload()"
	>
		@stepHiddenFields(s)
		<input type="hidden" name={ action.FieldStepSignaturePage } value={ fmt.Sprint(signaturePage(s)) }/>
		<input type="hidden" class="sig-x-input" name={ action.FieldStepSignatureX } value={ fmt.Sprint(signatureCoord(s, action.FieldStepSignatureX)) }/>
		<input type="hidden" class="sig-y-input" name={ action.FieldStepSignatureY } value={ fmt.Sprint(signatureCoord(s, action.FieldStepSignatureY)) }/>
		<button
			type="submit"
			class="sig-marker"
			style={ fmt.Sprintf("left:%.1f%%;top:%.1f%%", signatureCoord(s, action.FieldStepSignatureX), signatureCoord(s, action.FieldStepSignatureY)) }
		>{ fmt.Sprint(index) }</button>
	</form>
}

// placeStepForm is the sidebar's own no-JS control: place (or move) a step's marker onto the
// currently viewed page, centered, as a starting point a drag can then adjust. Ordinary HTMX,
// same generic PUT route as sigMarker's own form.
templ placeStepForm(s *data.Record, page int) {
	<form
		hx-put={ fmt.Sprintf("/machines/%s/records/%s", action.StepMachineID, s.ID) }
		hx-swap="none"
		hx-on::after-request="if(event.detail.successful) window.location.reload()"
	>
		@stepHiddenFields(s)
		<input type="hidden" name={ action.FieldStepSignaturePage } value={ fmt.Sprint(page) }/>
		<input type="hidden" name={ action.FieldStepSignatureX } value="50"/>
		<input type="hidden" name={ action.FieldStepSignatureY } value="50"/>
		<button type="submit">
			if signaturePage(s) == page {
				Re-center on this page
			} else {
				Place on this page
			}
		</button>
	</form>
}

// stepHiddenFields carries every field the generic PUT route requires (ROADMAP.md Phase 3/11's
// data.ValidateRecord enforces every required Field is present) forward unchanged, the same
// "carry forward what isn't being edited" posture Phase 11's file-upload fix already established.
templ stepHiddenFields(s *data.Record) {
	<input type="hidden" name={ action.FieldStepDocument } value={ toString(s.Values[action.FieldStepDocument]) }/>
	<input type="hidden" name={ action.FieldStepSequence } value={ toString(s.Values[action.FieldStepSequence]) }/>
	<input type="hidden" name={ action.FieldStepAssignee } value={ toString(s.Values[action.FieldStepAssignee]) }/>
	<input type="hidden" name={ action.FieldStepDecision } value={ toString(s.Values[action.FieldStepDecision]) }/>
}

func signaturePlaced(s *data.Record) bool {
	_, ok := s.Values[action.FieldStepSignaturePage]
	return ok
}

func signaturePage(s *data.Record) int {
	v, _ := s.Values[action.FieldStepSignaturePage].(float64)
	return int(v)
}

func signatureCoord(s *data.Record, fieldID string) float64 {
	v, _ := s.Values[fieldID].(float64)
	return v
}

func placementURL(documentID string, page int) string {
	return fmt.Sprintf("/machines/%s/records/%s/signature-placement?page=%d", action.DocumentMachineID, documentID, page)
}

func previewURL(documentID string, page int) string {
	return fmt.Sprintf("/machines/%s/records/%s/pdf-preview?page=%d", action.DocumentMachineID, documentID, page)
}
