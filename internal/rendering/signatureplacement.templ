package rendering

import (
	"context"

	"fmt"

	"menata.app/internal/domain"
)

// PlacementView is board 09's whole content, resolved by composition.SignaturePlacement before
// this file is reached.
//
// No *data.Record and no Values[...] anywhere in this file -- the same hard constraint
// rendering.ReviewView states, and the reason this file could leave internal/conformance's
// projection ratchet in Fase 6c-3.
type PlacementView struct {
	DocumentID    string
	DocumentTitle string
	Page          int
	TotalPages    int
	Steps         []PlacementStep
}

// PlacementStep is one Approval Step's marker and sidebar card.
type PlacementStep struct {
	StepID string
	Index  int
	// Approver is whoever holds the step, and ApproverKind says which sort they are --
	// domain.ActorKindUser or ActorKindGroup. The kind is carried rather than inferred from which
	// name is non-empty, because board 09 badges them differently and a person whose record has
	// gone missing must not silently read as a Group.
	Approver     string
	ApproverKind string
	// Placed distinguishes "no marker yet" from "a marker at 50/50": X, Y and Width always hold
	// renderable numbers, defaulted by Composition, so the page never decides one itself.
	Placed bool
	Page   int
	X      float64
	Y      float64
	Width  float64
	// Editable is composition.MayPlaceSignature for this step: the Document's own submitter, or
	// this step's own approver. It is deliberately not the edit Permission alone -- board 09 is
	// STEP 2 OF 3 of the submit wizard, so the person laying the boxes out is the one submitting,
	// and gating on "may edit this step" sent them to a screen where every marker was static.
	Editable bool
	// Fields are the form-input names this step's three forms submit under, resolved by Composition
	// from the Machine's own signature_placement: declaration (Stage D, 2026-09-28) instead of typed
	// here as action.FieldStepSignatureX and friends.
	//
	// They are the same for every step in a view, and carried per step anyway: placementMarker,
	// placeStepForm and widthControl each receive a PlacementStep and nothing else, so putting them
	// on PlacementView would mean threading a second parameter through three components and six call
	// sites to avoid repeating four strings.
	Fields PlacementFields
}

// PlacementFields are the four Field ids the placement screen writes -- the *write* side of 007
// §11.3 Binding, which had no primitive when this screen was built and still has no general one.
// What changed is narrower and worth stating exactly: these particular names now come from a
// declaration rather than from Go. A form Field declared in metadata (the general primitive) is
// still unbuilt, and its trigger is still a third bespoke write screen (ROADMAP.md's deferral table).
type PlacementFields struct {
	Page  string
	X     string
	Y     string
	Width string
}

// SignaturePlacementPage is board 09 (ui-sample/case-03-flow1/09-signature-positions.html,
// Fase 6c-3): place one signature box per approval step on the Document's own rendered page.
//
// FOUR BOARD ELEMENTS ARE DELIBERATELY NOT RENDERED, each for a reason in ROADMAP.md's deferral
// table rather than an oversight: the zoom controls (nothing stores or needs a zoom level -- the
// app serves one rendered size), the selected-step highlight (no selection model exists, and the
// screen works without one), the approver's department sub-line ("Finance" -- mch_user has no such
// Field; fld_step_name is the honest substitute and is what this renders), and the board's own
// "Save positions →" wording specifically -- every drag, place and width change is already
// persisted by its own request, so a button claiming to *save* would claim a staging step that
// does not exist. The board's own "STEP 2 OF 3" is likewise "Step 2 of 2" here, because two
// screens exist.
//
// What this DOES have that the board's footer does not spell out: a "Done" link (owner report,
// 2026-09-21 -- landing here after submitting a Document left no way back to My Documents short of
// the browser's own back button). It says "Done", not "Save", for the reason above, and its
// destination is routeByID(ctx, "nav_my_documents") rather than a retyped "/approval-inbox?tab=mine" --
// metadata/applications/document-approval.yaml already declares that route under nav_my_documents.
//
// What this has that the board does not: page navigation (the board shows only "Page 6 of 6"), a
// numeric width control beside the box's own resize corner, and an honest "Not placed yet" state --
// every step on the board is pre-placed.
templ SignaturePlacementPage(v PlacementView, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	@appShell("Signature positions", workspaceName, viewer, switchWorkspaceHref) {
		<a href={ templ.URL("/machines/" + approvalMachineID(ctx, domain.WorkflowRoleDocument) + "/records/" + v.DocumentID) } class="text-xs text-blue-600 hover:text-blue-700">
			← { v.DocumentTitle }
		</a>
		<div class="flex flex-col gap-2">
			<span class="text-3xs tracking-wide text-blue-600 uppercase">Step 2 of 2</span>
			<h1 class="m-0 text-xl font-medium">Signature positions</h1>
			<div class="text-sm text-slate-500">
				Place one signature box for each approval step. Positions are saved per step, as you
				make them.
			</div>
		</div>
		@placementBody(v)
		<div class="flex justify-end">
			<a
				href={ templ.SafeURL(routeByID(ctx, "nav_my_documents")) }
				class={ controlPrimary }
			>
				Done →
			</a>
		</div>
		@placementDragScript()
	}
}

// placementBody is the pager, canvas and step sidebar -- everything inside #sig-body, shared by
// SignaturePlacementPage and signaturePlacementBlock. Sharing it is not only tidiness: both
// wrappers re-fetch *this page* and hx-select its #sig-body after every successful request, so the
// detail page's embed was already being replaced by this markup on the first drag. Before
// 2026-10-05 it rendered its own first, built for the deleted pageStyles stylesheet, so until that
// first drag the embed showed unstyled class names and markers with no positioning at all.
//
// The htmx wiring stays on a wrapper and `splitLayout` sits inside it, rather than the primitive
// taking an id and four hx-* attributes. A Layout primitive that accepts arbitrary HTML attributes is
// what 007 §12.3 forbids by name -- "MUST NOT become 'generic' merely by accepting arbitrary
// properties" -- and this screen's self-refresh is behaviour, not layout.
//
// **The cost is one extra DOM node, and this is the only one of the five split sites that is not
// byte-identical after migration.** `hx-select="#sig-body"` plus `outerHTML` still replaces this
// wrapper, so the refresh is unchanged. Declaring the pair properly needs a Page tree where a node
// can carry an id and a behaviour binding separately, which is 007 §11.3 Binding plus Stage 3 of the
// Experience Plane plan (`menata-app-document`'s
// `audits/2026-09-30-kajian-ui-ir-untuk-apa-dan-bagaimana-merealisasikannya.md`).
templ placementBody(v PlacementView) {
	<div
		id="sig-body"
		hx-trigger="htmx:afterRequest[detail.successful]"
		hx-get={ placementPageHref(ctx, v.DocumentID, v.Page) }
		hx-select="#sig-body"
		hx-swap="outerHTML"
	>
		@splitLayout(domain.GapComfortable, domain.SplitAsideEnd, domain.AsideNarrow) {
			@sectionLayout(domain.GapDefault) {
				@rowLayout(domain.GapDefault, domain.RowAlignCenter, domain.RowJustifySpread) {
					<h2 class="m-0 text-sm font-medium">{ fmt.Sprintf("Page %d of %d", v.Page, v.TotalPages) }</h2>
					<span class="flex items-center gap-3 text-xs">
						if v.Page > 1 {
							@staticLink(placementPageHref(ctx, v.DocumentID, v.Page-1), "← Prev")
						}
						if v.Page < v.TotalPages {
							@staticLink(placementPageHref(ctx, v.DocumentID, v.Page+1), "Next →")
						}
					</span>
				}
				<p class="m-0 text-2xs text-slate-500">
					Drag each box to its signature block, and its corner to resize it. Box size matches the
					signature image.
				</p>
				@placementCanvas(v)
			}
			<aside class="flex h-fit flex-col gap-3 rounded-lg border border-slate-200 bg-white p-5">
				<h2 class="m-0 text-sm font-medium">Approval steps</h2>
				for _, s := range v.Steps {
					@placementStepCard(s, v.Page)
				}
				<p class="m-0 rounded-md bg-slate-50 p-3 text-2xs leading-5 text-slate-500">
					Approvers are supplied by Groups. Changing group membership is managed separately.
				</p>
			</aside>
		}
	</div>
}

// signatureCanvasWidth/Height are the width-to-height ratio every signature image has, and so the
// ratio of every placement box: compositeOne (internal/action/composite.go) scales an image to the
// placed width and derives its height from the image's own aspect ratio, and every image is the
// toDataURL of signatureModal's canvas, whose pixel size is these two constants. A box drawn at any
// other ratio would show the user a height the stamp does not have -- which is exactly the complaint
// that produced the box (owner, 2026-10-05: a width in percent, with nothing on screen showing what
// it means). Change the canvas and the boxes follow; the two cannot disagree.
const (
	signatureCanvasWidth  = 400
	signatureCanvasHeight = 160
)

// placementCanvas is the rendered page with one box per placed step on it.
//
// It used to take a `tailwind` flag, because the Document detail page's embed rendered under
// pageStyles. That stylesheet is gone (3ca57ac), and the flag's false branch was left rendering
// markers with no positioning utilities at all -- every one of them stacked in the canvas's corner.
templ placementCanvas(v PlacementView) {
	<div class="sig-canvas relative inline-block w-full max-w-[480px]">
		<img
			src={ placementPreviewHref(ctx, v.DocumentID, v.Page) }
			alt={ fmt.Sprintf("Page %d of the document", v.Page) }
			class="block w-full rounded-md border border-slate-200"
		/>
		for _, s := range v.Steps {
			if s.Placed && s.Page == v.Page {
				@placementMarker(s)
			}
		}
	</div>
}

// placementMarker is one placed step's box: board 09's labelled, dashed rectangle, drawn at the
// size the signature will actually be stamped -- its width is the step's own Width percentage of the
// canvas, the same percentage of the page compositeOne scales the image to, and its height follows
// signatureCanvasWidth/Height. Before 2026-10-05 it was a fixed 28px circle, so the width was a number in a
// sidebar that nothing on the page illustrated (owner report: "tidak nampak di layar, sehingga user
// tidak tahu apakah ukurannya segitu atau tidak").
//
// THE POSITIONAL CSS IS NOT DECORATION. The drag script writes the pointer's percentage straight
// into left/top and relies on `transform: translate(-50%,-50%)` to centre the box under the
// cursor; `position:absolute` against the canvas's `position:relative` is what makes those
// percentages mean anything; and `touch-action:none` is what stops a touch drag from being taken
// as a page scroll. They are utilities on the element rather than a `.sig-marker` rule, because a
// class carrying behaviour across a shell boundary is exactly how board 10 ended up with a signature
// canvas that silently lost `touch-action:none` when it moved to appShell in Fase 6b.
//
// Changing the anchor would silently move every stored placement: internal/action's compositing
// reads X/Y as the *centre* of the stamp. That is why the box grows around the centre and why the
// resize corner changes width symmetrically rather than pinning the opposite edge.
//
// The `sig-resize` corner is a child of the button, so the drag script must test for it before it
// tests for the box -- see placementDragScript.
templ placementMarker(s PlacementStep) {
	if s.Editable {
		<form hx-put={ fmt.Sprintf("/machines/%s/records/%s/signature-placement", approvalMachineID(ctx, domain.WorkflowRoleStep), s.StepID) } hx-swap="none">
			@csrfHiddenInput()
			<input type="hidden" name={ s.Fields.Page } value={ fmt.Sprint(s.Page) }/>
			<input type="hidden" class="sig-x-input" name={ s.Fields.X } value={ fmt.Sprintf("%.1f", s.X) }/>
			<input type="hidden" class="sig-y-input" name={ s.Fields.Y } value={ fmt.Sprintf("%.1f", s.Y) }/>
			<input type="hidden" class="sig-w-input" name={ s.Fields.Width } value={ fmt.Sprintf("%.0f", s.Width) }/>
			<button
				type="button"
				class="sig-marker absolute flex -translate-x-1/2 -translate-y-1/2 cursor-grab touch-none items-center gap-1.5 overflow-hidden rounded border-2 border-dashed border-blue-600 bg-blue-50/80 px-1.5 text-left"
				style={ placementBoxStyle(s) }
				aria-label={ fmt.Sprintf("Signature box step %d, %s, drag to move, drag the corner to resize", s.Index, s.Approver) }
			>
				@placementBoxLabel(s, true)
				<span aria-hidden="true" class="sig-resize absolute right-0 bottom-0 size-3 cursor-nwse-resize rounded-tl-sm bg-blue-600"></span>
			</button>
		</form>
	} else {
		<span
			class="sig-marker absolute flex -translate-x-1/2 -translate-y-1/2 items-center gap-1.5 overflow-hidden rounded border-2 border-dashed border-slate-400 bg-slate-50/80 px-1.5"
			style={ placementBoxStyle(s) }
			aria-label={ fmt.Sprintf("Signature box step %d, %s", s.Index, s.Approver) }
		>
			@placementBoxLabel(s, false)
		</span>
	}
}

// placementBoxLabel is the box's own content: the step number, and who signs there. It truncates
// rather than wraps, so a narrow box stays the size of the signature instead of growing to fit text.
templ placementBoxLabel(s PlacementStep, editable bool) {
	<span
		aria-hidden="true"
		class={ "flex size-4 shrink-0 items-center justify-center rounded-full text-3xs font-medium text-white",
			templ.KV("bg-blue-600", editable), templ.KV("bg-slate-400", !editable) }
	>{ fmt.Sprint(s.Index) }</span>
	<span class="flex min-w-0 flex-col">
		<span class="truncate text-3xs font-medium text-slate-700">
			if s.Approver != "" {
				{ s.Approver }
			} else {
				Unassigned
			}
		</span>
		if s.ApproverKind != "" {
			<span class="truncate text-3xs text-slate-500">{ s.ApproverKind }</span>
		}
	</span>
}

// placementBoxStyle is the per-record half of a box's geometry -- centre, width, and the ratio its
// height follows. Inline because the numbers are per-record: a built class name would never reach
// app.css.
func placementBoxStyle(s PlacementStep) string {
	return fmt.Sprintf("left:%.1f%%;top:%.1f%%;width:%.1f%%;aspect-ratio:%d/%d", s.X, s.Y, s.Width, signatureCanvasWidth, signatureCanvasHeight)
}

// placementStepCard is one step in the sidebar: who holds it, of which kind, and where its marker
// currently sits.
templ placementStepCard(s PlacementStep, page int) {
	<div class="flex flex-col gap-2 rounded-md border border-slate-200 p-3">
		@rowLayout(domain.GapTight, domain.RowAlignCenter, domain.RowJustifyStart) {
			<span aria-hidden="true" class="flex size-6 shrink-0 items-center justify-center rounded-full bg-slate-200 text-3xs font-medium text-slate-700">{ fmt.Sprint(s.Index) }</span>
			<span class="truncate text-sm">
				if s.Approver != "" {
					{ s.Approver }
				} else {
					Unassigned
				}
			</span>
			@approverKindBadge(s.ApproverKind)
		}
		<span class="text-2xs text-slate-400">{ placementSubline(s) }</span>
		if s.Editable {
			@widthControl(s, page)
			@placeStepForm(s, page)
		}
	</div>
}

// approverKindBadge is board 09's own User/Group pill. An empty kind renders nothing rather than
// guessing: the wizard deliberately stores no approver type on a User row, and Composition already
// resolves that absence to ActorKindUser, so an empty value here means something genuinely unknown.
templ approverKindBadge(kind string) {
	if kind != "" {
		if kind == domain.ActorKindUser {
			@statusBadge(kind, domain.ToneInfo, domain.BadgeCompact)
		} else {
			@statusBadge(kind, domain.ToneNeutral, domain.BadgeCompact)
		}
	}
}

// placementSubline is the card's second line: where this step's marker is.
//
// **Board 09 puts a department here** ("Finance · Page 6", "Director · Page 6", "4 members · Page 6")
// -- the approver's own job title, or a Group's size. Until 2026-09-29 this substituted
// mch_approval_step's fld_step_name for it, a free-text field the wizard offered as "(optional)" and
// which nobody ever filled: 0 of 23 records carried the key. That field is deleted; the substitution
// went with it, and the line now renders only what it can actually answer.
//
// What board 09 wants is still unmet, and naming it is the point: a person's title is identity data
// (mch_user), and a Group's size is a membership count. Neither is a Field on a step, which is why
// inventing one there produced a field nobody filled.
func placementSubline(s PlacementStep) string {
	where := "Not placed yet"
	if s.Placed {
		where = fmt.Sprintf("Page %d · %.0f%% · %.0f%% · %.0f%% wide", s.Page, s.X, s.Y, s.Width)
	}
	return where
}

// placeStepForm puts an unplaced step's marker on the page being viewed, or re-centres a placed
// one -- the no-JavaScript path to the same result the drag gives.
templ placeStepForm(s PlacementStep, page int) {
	<form hx-put={ fmt.Sprintf("/machines/%s/records/%s/signature-placement", approvalMachineID(ctx, domain.WorkflowRoleStep), s.StepID) } hx-swap="none">
		@csrfHiddenInput()
		<input type="hidden" name={ s.Fields.Page } value={ fmt.Sprint(page) }/>
		<input type="hidden" name={ s.Fields.X } value="50"/>
		<input type="hidden" name={ s.Fields.Y } value="50"/>
		<input type="hidden" name={ s.Fields.Width } value={ fmt.Sprintf("%.0f", s.Width) }/>
		<button type="submit" class="cursor-pointer text-xs text-blue-600 hover:text-blue-700">
			if s.Placed && s.Page == page {
				Re-centre on this page
			} else {
				Place on this page
			}
		</button>
	</form>
}

// widthControl resizes a marker without moving it: the placement's own page and coordinates are
// carried forward unchanged, so a width-only edit never relocates the signature.
templ widthControl(s PlacementStep, page int) {
	<form hx-put={ fmt.Sprintf("/machines/%s/records/%s/signature-placement", approvalMachineID(ctx, domain.WorkflowRoleStep), s.StepID) } hx-trigger="change" hx-swap="none">
		@csrfHiddenInput()
		<input type="hidden" name={ s.Fields.Page } value={ fmt.Sprint(placementPageOrCurrent(s, page)) }/>
		<input type="hidden" name={ s.Fields.X } value={ fmt.Sprintf("%.1f", s.X) }/>
		<input type="hidden" name={ s.Fields.Y } value={ fmt.Sprintf("%.1f", s.Y) }/>
		<label class="sig-width-label flex items-center gap-1.5 text-2xs text-slate-500">
			Width
			<input type="number" name={ s.Fields.Width } value={ fmt.Sprintf("%.0f", s.Width) } min="5" max="100" step="1" class="w-16 rounded border border-slate-300 px-1.5 py-0.5 text-2xs"/>
			%
		</label>
	</form>
}

// The carry-forward block that used to live here is gone, and its absence is the point.
//
// These three forms PUT to the generic record route, which rewrites a whole record from whatever
// is submitted -- so every Field they did not submit had to be echoed back as a hidden input or be
// erased. That list was hand-written first and silently forgot three Fields for two phases, then a
// fourth (fld_signature_image) even after being corrected; deriving it from the Machine's declared
// Fields fixed the forgetting but not the shape. They now PUT to a route that writes four named
// Fields and touches nothing else (internal/web.updateSignaturePlacement), so there is nothing to
// carry and no list to keep right.

// placementDragScript is the drag and resize behaviour, and it travels with whichever page renders
// a canvas.
//
// Event delegation rather than per-marker listeners, so a box replaced by an HTMX swap still
// drags without re-running any setup.
//
// The `!marker.closest("form")` guard fixes a real latent crash (Fase 6c-3): a box the viewer may
// not edit renders as a bare <span> with no surrounding form, yet pointerdown matched it by class,
// so the first pointermove threw a TypeError on form.querySelector and left the page half-broken
// with nothing in the UI to say why.
//
// Two things changed when the circle became a box (2026-10-05). A move now keeps the pointer's
// offset from the box's centre: a 28px circle could snap its centre under the pointer unnoticed, a
// box a quarter of the page wide jumps visibly if grabbed near its edge. And a pointerdown on the
// `.sig-resize` corner resizes instead of moving -- symmetrically about the centre, since X/Y are
// the stamp's centre (see placementMarker) -- writing a whole-number width into the same Width
// input the sidebar's number field submits, clamped to that field's own 5..100. The box's height
// follows from its CSS aspect-ratio, so a vertical drag is converted back to the width it implies,
// using the ratio measured off the rendered box rather than a second copy of signatureCanvasWidth/Height.
templ placementDragScript() {
	<script>
		(function () {
			var dragging = null, mode = "", offX = 0, offY = 0, sigAspect = 1;
			document.addEventListener("pointerdown", function (e) {
				var marker = e.target.closest(".sig-marker");
				if (!marker || !marker.closest("form")) return;
				var box = marker.getBoundingClientRect();
				mode = e.target.closest(".sig-resize") ? "resize" : "move";
				offX = e.clientX - (box.left + box.width / 2);
				offY = e.clientY - (box.top + box.height / 2);
				sigAspect = box.width / box.height;
				dragging = marker;
				marker.setPointerCapture(e.pointerId);
				e.preventDefault();
			});
			document.addEventListener("pointermove", function (e) {
				if (!dragging) return;
				var canvas = dragging.closest(".sig-canvas");
				var form = dragging.closest("form");
				if (!canvas || !form) return;
				var rect = canvas.getBoundingClientRect();
				if (mode === "resize") {
					var box = dragging.getBoundingClientRect();
					var halfW = Math.abs(e.clientX - (box.left + box.width / 2));
					var halfH = Math.abs(e.clientY - (box.top + box.height / 2));
					var px = 2 * Math.max(halfW, halfH * sigAspect);
					var w = Math.round(Math.min(100, Math.max(5, (px / rect.width) * 100)));
					dragging.style.width = w + "%";
					form.querySelector(".sig-w-input").value = w;
					return;
				}
				var x = Math.min(100, Math.max(0, ((e.clientX - offX - rect.left) / rect.width) * 100));
				var y = Math.min(100, Math.max(0, ((e.clientY - offY - rect.top) / rect.height) * 100));
				dragging.style.left = x + "%";
				dragging.style.top = y + "%";
				form.querySelector(".sig-x-input").value = x.toFixed(1);
				form.querySelector(".sig-y-input").value = y.toFixed(1);
			});
			document.addEventListener("pointerup", function () {
				if (!dragging) return;
				var form = dragging.closest("form");
				if (form) form.requestSubmit();
				dragging = null;
			});
		})();
	</script>
}

// signaturePlacementBlock is the same placement UI embedded in the Document's own generic detail
// page (detail.templ). It renders placementBody -- the same markup, not a twin of it -- because
// that markup is what its own self-refresh swaps in anyway; see placementBody.
//
// The #sig-body wrapper re-fetches itself after any successful descendant request, which is what
// keeps every box and card current after a drag without a full page reload. The script sits
// outside it so a swap does not re-insert it.
templ signaturePlacementBlock(v PlacementView) {
	@placementBody(v)
	@placementDragScript()
}

// placementPageOrCurrent keeps a width-only edit from relocating an unplaced marker: it lands on
// the page being viewed, exactly where placeStepForm would have put it.
func placementPageOrCurrent(s PlacementStep, currentPage int) int {
	if s.Placed {
		return s.Page
	}
	return currentPage
}

// placementPageHref and placementPreviewHref mirror composition's own helpers of the same name.
// They are duplicated rather than imported because internal/rendering must not import
// internal/composition -- the dependency runs the other way (007 §5).
func placementPageHref(ctx context.Context, documentID string, page int) string {
	return fmt.Sprintf("/machines/%s/records/%s/signature-placement?page=%d", approvalMachineID(ctx, domain.WorkflowRoleDocument), documentID, page)
}

func placementPreviewHref(ctx context.Context, documentID string, page int) string {
	return fmt.Sprintf("/machines/%s/records/%s/pdf-preview?page=%d", approvalMachineID(ctx, domain.WorkflowRoleDocument), documentID, page)
}
