package rendering

// ActivityPage is Case 19's cross-project event feed (development-history.md Phase 14,
// project-activity.html): the same mch_activity data as the Dashboard's Recent Activity section
// (Phase 13), grouped by day instead of a flat ten-item list -- a different shape over the same
// already-built data, not a new event mechanism.
templ ActivityPage(today, yesterday, older []ActivityEntry, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	@appShell(titleByID(ctx, "nav_activity"), workspaceName, viewer, switchWorkspaceHref) {
		@pageHeader("nav_activity")
		@activityGroup("Today", today)
		@activityGroup("Yesterday", yesterday)
		@activityGroup("Earlier", older)
		if len(today) == 0 && len(yesterday) == 0 && len(older) == 0 {
			<p class="text-sm text-slate-500">No activity yet.</p>
		}
	}
}

templ activityGroup(label string, entries []ActivityEntry) {
	if len(entries) > 0 {
		@panelLayout() {
			<h2 class="m-0 mb-3 text-base font-medium">{ label }</h2>
			@activityFeedListRow(entries)
		}
	}
}
