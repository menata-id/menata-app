package rendering

// ActivityPage is Case 19's cross-project event feed (ROADMAP.md Phase 14,
// project-activity.html): the same mch_activity data as the Dashboard's Recent Activity section
// (Phase 13), grouped by day instead of a flat top-10 list -- a different shape over the same
// already-built data, not a new event mechanism.
templ ActivityPage(today, yesterday, older []ActivityEntry) {
	@pageShell(labelByID("nav_activity")) {
		<h1>{ labelByID("nav_activity") }</h1>
		<p>A cross-project feed of business events.</p>
		@activityGroup("Today", today)
		@activityGroup("Yesterday", yesterday)
		@activityGroup("Earlier", older)
		if len(today) == 0 && len(yesterday) == 0 && len(older) == 0 {
			<p>No activity yet.</p>
		}
	}
}

templ activityGroup(label string, entries []ActivityEntry) {
	if len(entries) > 0 {
		<h2>{ label }</h2>
		@activityFeedList(entries)
	}
}
