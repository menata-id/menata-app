package rendering

import "fmt"

// SprintSummary is the real, derivable Task-status breakdown this app can show honestly
// (ROADMAP.md Phase 14, project-dashboard.html) -- open/in-progress/done counts and a completion
// percentage. The mockup's own points/burndown/blocked content is deliberately not reproduced:
// this app has no story-points Field and no historical snapshot data a real burndown needs, and
// mch_task's fld_status has no "blocked" option -- fabricating any of those would misrepresent
// real data, which this app avoids everywhere else too.
type SprintSummary struct {
	Open       int
	InProgress int
	Done       int
	Total      int
}

// CompletionPercent is Done/Total as a whole-number percentage, 0 when there are no Tasks yet.
func (s SprintSummary) CompletionPercent() int {
	if s.Total == 0 {
		return 0
	}
	return s.Done * 100 / s.Total
}

// SprintDashboardPage composes the same Task/Activity data as the Dashboard and My Tasks, shaped
// as Case 19's own analytics view: a status summary, a compact workload preview (linking to the
// full Team Capacity page rather than duplicating it), and an Attention Needed list of
// overdue/due-today Tasks (reusing My Tasks' own bucketing and its taskRowList rendering, not a
// new SLA mechanism or a re-typed markup -- menata-app-document's 2026-09-19 rendering
// composability audit found this list re-implementing taskRowList's markup by hand and silently
// dropping its status badge).
templ SprintDashboardPage(summary SprintSummary, workload []MemberCapacity, attention []TaskRow, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	@appShell(labelByID("nav_sprint"), workspaceName, viewer, switchWorkspaceHref) {
		<div class="flex flex-col gap-2">
			<span class="text-3xs tracking-wide text-blue-600 uppercase">Project Management</span>
			<h1 class="m-0 text-xl font-medium">{ labelByID("nav_sprint") }</h1>
			<div class="text-sm text-slate-500">A composed analytics view over real Task data -- no fabricated points or burndown.</div>
		</div>

		@summaryCountTiles([]SummaryItem{
			{Label: "Open", Value: fmt.Sprint(summary.Open)},
			{Label: "In progress", Value: fmt.Sprint(summary.InProgress)},
			{Label: "Done", Value: fmt.Sprint(summary.Done)},
			{Label: "Completion", Value: fmt.Sprint(summary.CompletionPercent()) + "%"},
		})

		<section class="rounded-lg border border-slate-200 bg-white p-4">
			@sectionHeaderRow("Workload", routeByID("nav_team_capacity"), "Full team capacity →")
			if len(workload) == 0 {
				<p class="m-0 text-sm text-slate-500">No members yet.</p>
			} else {
				<ul class="mt-3 flex flex-col gap-2">
					for _, m := range workload {
						<li class="flex items-center gap-2 text-sm">
							<span>{ m.Name }</span>
							<span class="ml-auto text-xs text-slate-400">{ fmt.Sprint(m.ActiveCards) } active cards</span>
						</li>
					}
				</ul>
			}
		</section>

		<section class="rounded-lg border border-slate-200 bg-white p-4">
			<h2 class="m-0 mb-3 text-base font-medium">Attention Needed</h2>
			if len(attention) == 0 {
				<p class="m-0 text-sm text-slate-500">Nothing overdue or due today.</p>
			} else {
				@taskRowList(attention, true)
			}
		</section>
	}
}
