package rendering

// ResetPasswordPage is a token-carrying "set a password" form, shared by two callers that
// otherwise only differ in copy and where the form posts: the emailed reset link (ROADMAP.md
// Phase 21 round 2, Step E) at action="/reset-password", and accepting a Workspace invite
// (security audit 2026-09-19, H1) at action="/accept-invite" -- an invited member never had a
// password to reset, but the form itself (token, new password, submit) is identical, so this is
// one shared page parameterized by heading/action/buttonLabel rather than two near-duplicate
// templates, the same reuse ChooseWorkspacePage already applies to its own two callers. token is
// carried as a hidden field and re-verified server-side on submit -- this page never trusts that
// rendering it once means the token is still valid. errorMsg is shown when a prior attempt on this
// same link failed (e.g. too-short password); empty renders no message.
templ ResetPasswordPage(token, errorMsg, heading, action, buttonLabel string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Set password · Menata App</title>
			<link rel="manifest" href="/manifest.json"/>
			<link rel="icon" href="/icons/favicon-32.png"/>
			<link rel="apple-touch-icon" href="/icons/icon-180.png"/>
			<meta name="theme-color" content="#2563EB"/>
			<style>
				body { font-family: system-ui, -apple-system, sans-serif; max-width: 320px; margin: 6rem auto; padding: 0 1rem; color: #1a1a1a; }
				h1 { font-size: 1.25rem; }
				label { display: block; margin-top: 1rem; font-size: 0.85rem; color: #444; }
				input { width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; font-size: 0.95rem; margin-top: 0.25rem; }
				button { margin-top: 1.5rem; width: 100%; padding: 0.6rem; border: none; border-radius: 4px; background: #3949ab; color: #fff; font-size: 0.95rem; cursor: pointer; }
				.error { color: #b00020; font-size: 0.85rem; margin-top: 1rem; }
			</style>
		</head>
		<body>
			<h1>{ heading }</h1>
			<form method="POST" action={ templ.SafeURL(action) }>
				<input type="hidden" name="token" value={ token }/>
				<label>
					New password
					<input type="password" name="password" autocomplete="new-password" minlength="8" required autofocus/>
				</label>
				if errorMsg != "" {
					<p class="error">{ errorMsg }</p>
				}
				<button type="submit">{ buttonLabel }</button>
			</form>
		</body>
	</html>
}
