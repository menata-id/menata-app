package rendering

import (
	"fmt"

	"menata.app/internal/data"
	"menata.app/internal/domain"
	"menata.app/internal/experience"
)

// ProjectSummary is one Project's row on the Dashboard: how many Tasks reference it and how many of those
// are still open. Unlike MachinePage, a Dashboard composes specific Machines for a specific business
// question ("which projects have open work") -- it is not a generic per-Machine renderer, matching 007's own
// example ("Dashboard = Page + Layout + Metric/Collection components").
type ProjectSummary struct {
	OpenTasks  int
	TotalTasks int
	// Name and Status are this Project's own declared display shape (mch_project's card_fields,
	// 007 §7.6), resolved by Composition -- the Page renders them in its own table and never picks a
	// Field off the record (007 §4.4).
	Name   string
	Status string
}

// PendingDocument is one row of the Dashboard's "Pending Approval" table: a Document's declared title and
// its **resolved** SLA badge.
//
// `Due any` became `SLA experience.SLABadge` on 2026-10-03. The raw value was here so the Page could parse
// it and evaluate the rule itself, which 007 §4.4 assigns to Composition and §4.6 forbids outright once the
// evaluation reads the clock.
type PendingDocument struct {
	Record *data.Record
	Title  string
	SLA    experience.SLABadge
}

// PersonLoad is one person's row in "Open cards per person": their name and how many of their cards are
// still open out of everything assigned to them.
type PersonLoad struct {
	Name  string
	Open  int
	Total int
}

// DashboardContent is everything the Dashboard draws, already resolved by Composition (007 §4.4). It is a
// single value rather than a parameter per section because the page grew from four sections to six and a
// ten-parameter signature is where a call site starts passing the wrong slice.
type DashboardContent struct {
	Tiles    []SummaryItem
	Projects []ProjectSummary
	People   []PersonLoad
	// TasksTruncation is set when the Task selection hit its declared bound, in which case every figure
	// above it understates -- so the page says so rather than showing a smaller number that looks complete.
	TasksTruncation Truncation
	Documents       DocumentSummary
	Pending         []PendingDocument
	Activity        []ActivityEntry
}

// DocumentSummary counts Case 3's Documents by status, for the Dashboard's Summary section
// (development-history.md Phase 13).
type DocumentSummary struct {
	InReview, Approved, Rejected int
}

// ActivityEntry is one already-resolved row of the Dashboard's Recent Activity feed: the actor's
// display name is resolved ahead of render time (main.go's showDashboard), the same way relation
// ids are resolved to labels elsewhere, so this templ stays a pure renderer.
type ActivityEntry struct {
	Summary string
	Actor   string
	When    string
}

// DashboardPage is Case 19 PM04: four headline tiles, Tasks by project beside Open cards per person, then the
// Documents and Recent Activity panels the mockup does not have but this runtime already composed. Every
// figure comes from one bounded selection of Task records, so "finished" means what the board's circle means.
templ DashboardPage(c DashboardContent, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	@appShell(titleByID(ctx, "nav_dashboard"), workspaceName, viewer, switchWorkspaceHref) {
		@pageHeader("nav_dashboard")

		@truncationNotice(c.TasksTruncation)
		@summaryCountTiles(c.Tiles)

		@splitLayout(domain.GapComfortable, domain.SplitAsideEnd, domain.AsideWide) {
			@stackLayout(domain.GapTight) {
				<h2 class="m-0 text-sm font-medium">Tasks by project</h2>
				<div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
					<table class="w-full min-w-[360px] border-collapse text-left">
						<thead>
							<tr class="border-b border-slate-200 bg-slate-50">
								<th scope="col" class="px-4 py-2 text-3xs font-normal tracking-wide text-slate-500 uppercase">Project</th>
								<th scope="col" class="w-20 px-4 py-2 text-right text-3xs font-normal tracking-wide text-slate-500 uppercase">Total</th>
								<th scope="col" class="w-20 px-4 py-2 text-right text-3xs font-normal tracking-wide text-slate-500 uppercase">Open</th>
							</tr>
						</thead>
						<tbody>
							for _, s := range c.Projects {
								<tr class="border-b border-slate-100 text-sm last:border-b-0">
									<td class="px-4 py-2.5">
										@rowLayout(domain.GapDefault, domain.RowAlignCenter, domain.RowJustifyStart) {
											<span>{ s.Name }</span>
											if s.Status != "" {
												@statusBadge(s.Status, domain.ToneMuted)
											}
										}
									</td>
									<td class="px-4 py-2.5 text-right">{ fmt.Sprint(s.TotalTasks) }</td>
									<td class="px-4 py-2.5 text-right">{ fmt.Sprint(s.OpenTasks) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}

			@stackLayout(domain.GapTight) {
				<div class="flex flex-col gap-0.5">
					<h2 class="m-0 text-sm font-medium">Open cards per person</h2>
					<span class="text-xs text-slate-500">Bar shows cards still open out of everything assigned.</span>
				</div>
				<div class="rounded-lg border border-slate-200 bg-white px-4">
					if len(c.People) == 0 {
						<p class="m-0 py-3 text-sm text-slate-500">No cards are assigned yet.</p>
					}
					for _, p := range c.People {
						<div class="border-b border-slate-100 py-2.5 last:border-b-0">
							@personLoadRow(p)
						</div>
					}
				</div>
			}
		}

		@panelLayout() {
			// No "View all" link -- same reasoning as approvalinbox.templ's "My Documents" section:
			// /machines/mch_document is POC scaffolding, not a real destination (owner request,
			// 2026-09-19).
			@sectionHeaderRow("Documents", "", "")
			<div class="mt-3">
				@summaryCountTiles([]SummaryItem{
					{Label: "In Review", Value: fmt.Sprint(c.Documents.InReview)},
					{Label: "Approved", Value: fmt.Sprint(c.Documents.Approved)},
					{Label: "Rejected", Value: fmt.Sprint(c.Documents.Rejected)},
				})
			</div>

			<h3 class="m-0 mt-4 mb-2 text-sm font-medium">Pending Approval</h3>
			if len(c.Pending) == 0 {
				<p class="m-0 text-sm text-slate-500">Nothing pending.</p>
			} else {
				<div class="overflow-x-auto">
					<table class="w-full min-w-[320px] border-collapse text-left">
						<thead>
							<tr class="border-b border-slate-200 bg-slate-50">
								<th scope="col" class="px-3 py-2 text-3xs font-normal tracking-wide text-slate-500 uppercase">Title</th>
								<th scope="col" class="px-3 py-2 text-3xs font-normal tracking-wide text-slate-500 uppercase">Due</th>
							</tr>
						</thead>
						<tbody>
							for _, r := range c.Pending {
								<tr class="border-b border-slate-100 text-sm last:border-b-0">
									<td class="px-3 py-2.5">{ r.Title }</td>
									<td class="px-3 py-2.5">@slaBadge(r.SLA)</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}

		@panelLayout() {
			@sectionHeaderRow("Recent activity", routeByID(ctx, "nav_activity"), "Open activity feed →")
			if len(c.Activity) == 0 {
				<p class="m-0 mt-3 text-sm text-slate-500">No activity yet.</p>
			} else {
				<div class="mt-3">
					@activityFeedListRow(c.Activity)
				</div>
			}
		}
	}
}

// personLoadRow is one person's bar: the fill is how many of their cards are still open out of everything
// assigned to them, and the words beside it say the same thing -- a percentage-only bar tells a screen-reader
// user nothing about how many cards that is.
templ personLoadRow(p PersonLoad) {
	@rowLayout(domain.GapComfortable, domain.RowAlignCenter, domain.RowJustifyStart) {
		<span class="w-24 shrink-0 truncate text-sm" title={ p.Name }>{ p.Name }</span>
		<div
			role="progressbar"
			aria-label={ p.Name + " open cards" }
			aria-valuenow={ fmt.Sprint(progressPercent(p.Open, p.Total)) }
			aria-valuemin="0"
			aria-valuemax="100"
			aria-valuetext={ fmt.Sprintf("%d of %d open", p.Open, p.Total) }
			class="h-2 grow overflow-hidden rounded-full bg-slate-100"
		>
			<div class="h-full rounded-full bg-emerald-600" style={ progressWidth(p.Open, p.Total) }></div>
		</div>
		<span class="w-16 shrink-0 text-right text-xs whitespace-nowrap text-slate-600">{ fmt.Sprintf("%d of %d", p.Open, p.Total) }</span>
	}
}
