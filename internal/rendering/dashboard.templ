package rendering

import (
	"fmt"

	"menata.app/internal/data"
)

// ProjectSummary is one Project's row on the Dashboard: itself, plus how many Tasks reference
// it and how many of those are still open. Unlike MachinePage, a Dashboard composes specific
// Machines for a specific business question ("which projects have open work") -- it is not a
// generic per-Machine renderer, matching 007's own example ("Dashboard = Page + Layout + Metric/
// Collection components").
type ProjectSummary struct {
	Project    *data.Record
	OpenTasks  int
	TotalTasks int
}

// DocumentSummary counts Case 3's Documents by status, for the Dashboard's Summary section
// (ROADMAP.md Phase 13).
type DocumentSummary struct {
	InReview, Approved, Rejected int
}

// ActivityEntry is one already-resolved row of the Dashboard's Recent Activity feed: the actor's
// display name is resolved ahead of render time (main.go's showDashboard), the same way relation
// ids are resolved to labels elsewhere, so this templ stays a pure renderer.
type ActivityEntry struct {
	Summary string
	Actor   string
	When    string
}

// DashboardPage combines Project, Task, Document, and Activity data on one page (ROADMAP.md
// Phase 6's own forcing case, re-tested here with a fourth section). It fetches each Machine's
// full record set once and joins/filters/sorts in Go -- deliberately not a per-section query
// loop, which is exactly the naive N+1 pattern that would need a planner. A handful of
// whole-machine queries stay correct and cheap regardless of record counts, so this page does
// not, on its own, force Phase 6 even with four sections composed.
templ DashboardPage(summaries []ProjectSummary, docs DocumentSummary, pending []*data.Record, activity []ActivityEntry, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	@appShell(labelByID("nav_dashboard"), workspaceName, viewer, switchWorkspaceHref) {
		<div class="flex flex-col gap-2">
			<span class="text-3xs tracking-wide text-blue-600 uppercase">Project Management</span>
			<h1 class="m-0 text-xl font-medium">{ labelByID("nav_dashboard") }</h1>
		</div>

		<section class="rounded-lg border border-slate-200 bg-white p-4">
			@sectionHeaderRow("Projects", "/machines/mch_project", "View all →")
			<div class="mt-3 overflow-x-auto">
				<table class="w-full min-w-[480px] border-collapse text-left">
					<thead>
						<tr class="border-b border-slate-200 bg-slate-50">
							<th scope="col" class="px-3 py-2 text-3xs font-normal tracking-wide text-slate-500 uppercase">Project</th>
							<th scope="col" class="px-3 py-2 text-3xs font-normal tracking-wide text-slate-500 uppercase">Status</th>
							<th scope="col" class="px-3 py-2 text-3xs font-normal tracking-wide text-slate-500 uppercase">Open Tasks</th>
							<th scope="col" class="px-3 py-2 text-3xs font-normal tracking-wide text-slate-500 uppercase">Total Tasks</th>
						</tr>
					</thead>
					<tbody>
						for _, s := range summaries {
							<tr class="border-b border-slate-100 text-sm last:border-b-0">
								<td class="px-3 py-2.5">{ toString(s.Project.Values["fld_name"]) }</td>
								<td class="px-3 py-2.5"><span class="rounded-full bg-slate-100 px-2 py-0.5 text-2xs text-slate-600">{ toString(s.Project.Values["fld_status"]) }</span></td>
								<td class="px-3 py-2.5">{ fmt.Sprint(s.OpenTasks) }</td>
								<td class="px-3 py-2.5">{ fmt.Sprint(s.TotalTasks) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>

		<section class="rounded-lg border border-slate-200 bg-white p-4">
			// No "View all" link -- same reasoning as approvalinbox.templ's "My Documents" section:
			// /machines/mch_document is POC scaffolding, not a real destination (owner request,
			// 2026-09-19).
			@sectionHeaderRow("Documents", "", "")
			<div class="mt-3">
				@summaryCountTiles([]SummaryItem{
					{Label: "In Review", Value: fmt.Sprint(docs.InReview)},
					{Label: "Approved", Value: fmt.Sprint(docs.Approved)},
					{Label: "Rejected", Value: fmt.Sprint(docs.Rejected)},
				})
			</div>

			<h3 class="m-0 mt-4 mb-2 text-sm font-medium">Pending Approval</h3>
			if len(pending) == 0 {
				<p class="m-0 text-sm text-slate-500">Nothing pending.</p>
			} else {
				<div class="overflow-x-auto">
					<table class="w-full min-w-[320px] border-collapse text-left">
						<thead>
							<tr class="border-b border-slate-200 bg-slate-50">
								<th scope="col" class="px-3 py-2 text-3xs font-normal tracking-wide text-slate-500 uppercase">Title</th>
								<th scope="col" class="px-3 py-2 text-3xs font-normal tracking-wide text-slate-500 uppercase">Due</th>
							</tr>
						</thead>
						<tbody>
							for _, r := range pending {
								<tr class="border-b border-slate-100 text-sm last:border-b-0">
									<td class="px-3 py-2.5">{ toString(r.Values["fld_title"]) }</td>
									<td class="px-3 py-2.5">@slaBadgePill(r.Values["fld_due_date"])</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>

		<section class="rounded-lg border border-slate-200 bg-white p-4">
			@sectionHeaderRow("Recent Activity", routeByID("nav_activity"), "View all →")
			if len(activity) == 0 {
				<p class="m-0 mt-3 text-sm text-slate-500">No activity yet.</p>
			} else {
				<div class="mt-3">
					@activityFeedListRow(activity)
				</div>
			}
		</section>
	}
}
