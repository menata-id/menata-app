package rendering

import (
	"fmt"

	"menata.app/internal/data"
)

// ProjectSummary is one Project's row on the Dashboard: itself, plus how many Tasks reference
// it and how many of those are still open. Unlike MachinePage, a Dashboard composes specific
// Machines for a specific business question ("which projects have open work") -- it is not a
// generic per-Machine renderer, matching 007's own example ("Dashboard = Page + Layout + Metric/
// Collection components").
type ProjectSummary struct {
	Project    *data.Record
	OpenTasks  int
	TotalTasks int
}

// DocumentSummary counts Case 3's Documents by status, for the Dashboard's Summary section
// (ROADMAP.md Phase 13).
type DocumentSummary struct {
	InReview, Approved, Rejected int
}

// ActivityEntry is one already-resolved row of the Dashboard's Recent Activity feed: the actor's
// display name is resolved ahead of render time (main.go's showDashboard), the same way relation
// ids are resolved to labels elsewhere, so this templ stays a pure renderer.
type ActivityEntry struct {
	Summary string
	Actor   string
	When    string
}

// DashboardPage combines Project, Task, Document, and Activity data on one page (ROADMAP.md
// Phase 6's own forcing case, re-tested here with a fourth section). It fetches each Machine's
// full record set once and joins/filters/sorts in Go -- deliberately not a per-section query
// loop, which is exactly the naive N+1 pattern that would need a planner. A handful of
// whole-machine queries stay correct and cheap regardless of record counts, so this page does
// not, on its own, force Phase 6 even with four sections composed.
templ DashboardPage(summaries []ProjectSummary, docs DocumentSummary, pending []*data.Record, activity []ActivityEntry, appName string) {
	@pageShell("Dashboard", appName) {
		<h1>Dashboard</h1>

		@sectionHeader("Projects", "/machines/mch_project", "View all →")
		<table>
			<thead>
				<tr>
					<th>Project</th>
					<th>Status</th>
					<th>Open Tasks</th>
					<th>Total Tasks</th>
				</tr>
			</thead>
			<tbody>
				for _, s := range summaries {
					<tr>
						<td>{ toString(s.Project.Values["fld_name"]) }</td>
						<td><span class="badge">{ toString(s.Project.Values["fld_status"]) }</span></td>
						<td>{ fmt.Sprint(s.OpenTasks) }</td>
						<td>{ fmt.Sprint(s.TotalTasks) }</td>
					</tr>
				}
			</tbody>
		</table>

		// No "View all" link -- same reasoning as approvalinbox.templ's "My Documents" section:
		// /machines/mch_document is POC scaffolding, not a real destination (owner request,
		// 2026-09-19).
		@sectionHeader("Documents", "", "")
		@summaryCounts([]SummaryItem{
			{Label: "In Review", Value: fmt.Sprint(docs.InReview)},
			{Label: "Approved", Value: fmt.Sprint(docs.Approved)},
			{Label: "Rejected", Value: fmt.Sprint(docs.Rejected)},
		})

		<h3>Pending Approval</h3>
		if len(pending) == 0 {
			<p>Nothing pending.</p>
		} else {
			<table>
				<thead>
					<tr>
						<th>Title</th>
						<th>Due</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range pending {
						<tr>
							<td>{ toString(r.Values["fld_title"]) }</td>
							<td>@slaBadge(r.Values["fld_due_date"])</td>
						</tr>
					}
				</tbody>
			</table>
		}

		@sectionHeader("Recent Activity", "/activity", "View all →")
		if len(activity) == 0 {
			<p>No activity yet.</p>
		} else {
			@activityFeedList(activity)
		}
	}
}
