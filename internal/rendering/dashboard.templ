package rendering

import (
	"fmt"
	"strconv"

	"menata.app/internal/domain"
)

// ProjectSummary is one Project's row on the Dashboard: how many Tasks reference it and how many of those
// are still open. Unlike MachinePage, a Dashboard composes specific Machines for a specific business
// question ("which projects have open work") -- it is not a generic per-Machine renderer, matching 007's own
// example ("Dashboard = Page + Layout + Metric/Collection components").
type ProjectSummary struct {
	OpenTasks  int
	TotalTasks int
	// Name and Status are this Project's own declared display shape (mch_project's card_fields,
	// 007 §7.6), resolved by Composition -- the Page renders them in its own table and never picks a
	// Field off the record (007 §4.4).
	Name   string
	Status string
}

// PersonLoad is one person's row in "Open cards per person": their name and how many of their cards are
// still open out of everything assigned to them.
type PersonLoad struct {
	Name  string
	Open  int
	Total int
}

// DashboardContent is everything the Dashboard draws, already resolved by Composition (007 §4.4). It is a
// single value rather than a parameter per section because the page grew from four sections to six and a
// ten-parameter signature is where a call site starts passing the wrong slice.
type DashboardContent struct {
	Tiles    []SummaryItem
	Projects []ProjectSummary
	People   []PersonLoad
	// TasksTruncation is set when the Task selection hit its declared bound, in which case every figure
	// above it understates -- so the page says so rather than showing a smaller number that looks complete.
	TasksTruncation Truncation
}

// ActivityEntry is one already-resolved row of a record's own History on its detail page: the actor's
// display name is resolved ahead of render time, the same way relation ids are resolved to labels
// elsewhere, so this templ stays a pure renderer.
type ActivityEntry struct {
	Summary string
	Actor   string
	When    string
	// Comment marks an entry someone wrote, as against one the runtime recorded: Summary is then what they
	// said, and the feed draws it with the author named first.
	Comment bool
}

// DashboardPage is Case 19 PM04: four headline tiles, then Tasks by project beside Open cards per person.
// The canvas's P04 now also draws a Recent activity panel, which this screen does not have yet: it arrives
// as a windowed Dataset over the activity log in a `page:` Collection (canvas work plan S2.7, ROADMAP.md
// "Mockup canvas"). Every figure comes from one bounded selection of Task records, so "finished" means what
// the board's circle means.
templ DashboardPage(c DashboardContent, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	@appShell(titleByID(ctx, "nav_dashboard"), workspaceName, viewer, switchWorkspaceHref) {
		@pageHeader("nav_dashboard")

		@truncationNotice(c.TasksTruncation)
		@summaryCountTiles(c.Tiles)

		@splitLayout(domain.GapComfortable, domain.SplitAsideEnd, domain.AsideWide) {
			@stackLayout(domain.GapTight) {
				@staticText(domain.StaticPanelHeading, "Tasks by project")
				<div class={ surfaceClasses(ctx) }>
					@dataTable("Tasks by project", []TableColumn{{Header: "Project"}, {Header: "Total", Align: domain.TableAlignEnd}, {Header: "Open", Align: domain.TableAlignEnd}}) {
						for _, s := range c.Projects {
							<tr>
								<td class={ tableCellClasses(ctx) }>
									@rowLayout(domain.GapDefault, domain.RowAlignCenter, domain.RowJustifyStart) {
										<span>{ s.Name }</span>
										if s.Status != "" {
											@statusBadge(s.Status, domain.ToneMuted, domain.BadgeRegular)
										}
									}
								</td>
								<td class={ tableCellClasses(ctx), tableAlignClass(domain.TableAlignEnd) }>{ fmt.Sprint(s.TotalTasks) }</td>
								<td class={ tableCellClasses(ctx), tableAlignClass(domain.TableAlignEnd) }>{ fmt.Sprint(s.OpenTasks) }</td>
							</tr>
						}
					}
				</div>
			}

			@stackLayout(domain.GapTight) {
				<div class="flex flex-col gap-0.5">
					@staticText(domain.StaticPanelHeading, "Open cards per person")
					<span class="text-xs text-slate-500">Bar shows cards still open out of everything assigned.</span>
				</div>
				<div class={ surfaceClasses(ctx), "px-4" }>
					if len(c.People) == 0 {
						<p class="m-0 py-3 text-sm text-slate-500">No cards are assigned yet.</p>
					}
					for _, p := range c.People {
						<div class={ "border-b", borderClass(ctx, domain.BorderDivider), "py-2.5 last:border-b-0" }>
							@personLoadRow(p)
						</div>
					}
				</div>
			}
		}
	}
}

// personLoadRow is one person's bar on the bespoke Dashboard, drawn by the registered Progress renderer.
templ personLoadRow(p PersonLoad) {
	@progressRow(p.Name, fmt.Sprint(p.Open), fmt.Sprint(p.Total))
}

// progressRow is the registered renderer for `domain.ComponentProgress`: a label, a bar filled to value out of
// max, and the same two numbers in words beside it -- a percentage-only bar tells a screen-reader user nothing
// about how many. The numbers arrive resolved; this computes only the fill, and a max of zero is an empty bar.
templ progressRow(label, value, max string) {
	{{ pct := progressShare(value, max) }}
	@rowLayout(domain.GapComfortable, domain.RowAlignCenter, domain.RowJustifyStart) {
		<span class="w-24 shrink-0 truncate text-sm" title={ label }>{ label }</span>
		<div
			role="progressbar"
			aria-label={ label }
			aria-valuenow={ fmt.Sprint(pct) }
			aria-valuemin="0"
			aria-valuemax="100"
			aria-valuetext={ value + " of " + max }
			class="h-2 grow overflow-hidden rounded-full bg-slate-100"
		>
			<div class="h-full rounded-full bg-emerald-600" style={ fmt.Sprintf("width:%d%%", pct) }></div>
		</div>
		<span class="w-16 shrink-0 text-right text-xs whitespace-nowrap text-slate-500">{ value + " of " + max }</span>
	}
}

// progressShare is value as a whole percentage of max, clamped to 0..100; anything unparseable, or a max of zero,
// is 0 -- an empty bar is the honest picture of "nothing out of nothing".
func progressShare(value, max string) int {
	v, errV := strconv.ParseFloat(value, 64)
	m, errM := strconv.ParseFloat(max, 64)
	if errV != nil || errM != nil || m <= 0 || v <= 0 {
		return 0
	}
	if v >= m {
		return 100
	}
	return int(v * 100 / m)
}
