package rendering

import (
	"fmt"

	"menata.app/internal/domain"
)

// WorkspaceHomePage is the landing page after login (ROADMAP.md Phase 21 Step 5). switchHref is
// the mid-session Choose Workspace link (showSwitchWorkspace) when the signed-in identity belongs
// to more than one Workspace, or "" to hide the switcher -- there is nothing to switch to
// otherwise. homeRoute is domain.HomeCardRoute's result (internal/web/workspacehome.go), never a
// literal here -- see internal/conformance's TestWorkspaceHomeHasNoHardcodedApplicationRoute.
//
// Ported to ui-sample/case-03-flow1/03-workspace-home.html (Fase 2, 2026-09-20), which is also
// where the launcher moved to: workspaceHomeShell's own Members link and avatar are now
// appShell's, so this page renders content only.
//
// The board shows a three-card Application grid; this renders one, because app.yaml declares one
// `application:` and `capabilities.md` still records Application plurality as unbuilt. The other
// two cards, and the per-Application rows in "Your access" below, arrive in Fase 3 -- see
// ROADMAP.md's Case 03 deferral table, which lists every board element this port leaves out and
// the phase that fills it. Inventing a second card here would be exactly the hardcoding
// CLAUDE.md's decision path rules out.
//
// The viewer's Workspace role arrives on Viewer, not as a parameter of its own -- it was both
// until 2026-09-24, and appShell's new Workspace menu is what exposed the cost: two sources for one
// fact, which disagreed the moment the second reader appeared (this page's own test caught it, on
// the very first build). Viewer is "who is looking"; their role in this Workspace is that.
//
// viewer.WorkspaceRole != "member" (not == "admin") decides whether the "Manage members"
// link renders -- requireWorkspaceAdmin (internal/web/middleware.go) fails *open* for an identity
// with no real membership row at all (the shared admin credential predating per-user accounts),
// letting it reach /workspace-members regardless of role; showWorkspaceHome degrades that same
// missing-membership case to workspaceRole == "" (data.Membership{}), so gating on == "admin"
// would hide a link that identity can still open directly (code-review finding, 2026-09-19).
// != "member" shows it for both a real admin and a missing membership row, hiding it only for a
// real member -- the same three-way split requireWorkspaceAdmin already makes.
// ApplicationCard is one Application's card face on Workspace Home. Built by
// internal/web.applicationCards, which resolves each field from that Application's own declared
// metadata -- see its doc comment for why PendingCount is shown on only one card.
type ApplicationCard struct {
	Name        string
	Initials    string
	Description string
	// Icon is a single character (ui-sample/nav-metadata.js's own convention, where the glyphs
	// explicitly stand in for a not-yet-scoped SVG set). Empty falls back to Initials.
	Icon string
	// Color is a domain.KnownApplicationColors token, mapped to whole literal classes by
	// appIconClasses below -- never concatenated into a class name.
	Color     string
	Role      string
	HomeRoute string
	// PendingCount is meaningful only when ShowPending is set: it is the pending-approval count,
	// which belongs to whichever Application declares that badge, not to Applications generally.
	PendingCount int
	ShowPending  bool
	// Count/CountLabel are the declared summary_machine count and that Machine's own Name, shown
	// only when ShowCount is set and the Application has no pending badge -- the badge is the more
	// specific statement where an Application declares both.
	Count      int
	CountLabel string
	ShowCount  bool
}

// appIconClasses maps a declared colour token to the icon tile's classes.
//
// TWO THINGS ABOUT THIS FUNCTION ARE LOAD-BEARING, and neither is style preference.
//
// It lives in a .templ file because static/css/input.css scans `internal/rendering/*.templ` and
// nothing else -- a Tailwind class string in a .go file, *including a .go file in this very
// package*, is invisible to the scanner and silently never reaches app.css.
//
// It returns whole literal strings rather than building "bg-" + color + "-50", for the same
// reason: the scanner reads source text, so a name assembled at runtime is never emitted. Both
// failures show up as missing styling in a browser, never as a build error -- which is why
// domain.KnownApplicationColors is a closed set that must be extended here in step.
func appIconClasses(color string) string {
	switch color {
	case "blue":
		return "bg-blue-50 text-blue-700"
	case "emerald":
		return "bg-emerald-50 text-emerald-700"
	case "amber":
		return "bg-amber-50 text-amber-700"
	default:
		return "bg-slate-100 text-slate-600"
	}
}

templ WorkspaceHomePage(workspaceName string, viewer Viewer, switchHref string, apps []ApplicationCard) {
	@appShell(labelByID(ctx, "nav_home"), workspaceName, viewer, switchHref) {
		<div class="flex flex-col gap-1.5">
			<h1 class="m-0 text-2xl font-medium">{ titleByID(ctx, "nav_home") }</h1>
			if len(apps) == 0 {
				<div class="text-sm text-slate-500">No applications are installed in this workspace yet.</div>
			} else {
				<div class="text-sm text-slate-500">{ descriptionByID(ctx, "nav_home") }</div>
			}
		</div>
		if len(apps) == 0 {
			<div class="flex flex-col items-center gap-2 rounded-lg border border-dashed border-slate-300 bg-white px-6 py-12 text-center">
				<span class="text-sm font-medium text-slate-700">Nothing installed here yet</span>
				<span class="max-w-md text-2xs text-slate-500">
					An application appears here once it is installed into this workspace. Until then this
					workspace holds only its members and their records.
				</span>
			</div>
		} else {
			<section aria-label={ titleByID(ctx, "nav_home") } class="overflow-hidden rounded-lg border border-slate-200 bg-white">
				for i, app := range apps {
					<a
						href={ templ.SafeURL(app.HomeRoute) }
						class={ "flex items-center gap-3 px-4 py-3.5 text-slate-900 hover:bg-slate-50 sm:gap-4 sm:px-5", templ.KV("border-t border-slate-100", i > 0) }
					>
						<span class={ "flex size-10 shrink-0 items-center justify-center rounded-lg text-base font-medium", appIconClasses(app.Color) }>
							if app.Icon != "" {
								@icon(app.Icon, "size-5.5")
							} else {
								{ app.Initials }
							}
						</span>
						<span class="flex min-w-0 grow flex-col gap-0.5">
							<span class="text-[15px] font-medium">{ app.Name }</span>
							if app.Description != "" {
								<span class="text-xs leading-4.5 text-slate-500">{ app.Description }</span>
							}
							// The role reads under the name below `sm` and in its own column above it:
							// the mockup's desktop row has four columns of its own, and a phone has room
							// for one.
							<span class="text-xs text-slate-400 sm:hidden">Your role: { displayRole(app.Role) }</span>
						</span>
						<span class="hidden w-42 shrink-0 text-xs text-slate-500 sm:block">
							Your role: <span class="text-slate-900">{ displayRole(app.Role) }</span>
						</span>
						// No fixed width below `sm`: a phone has ~100px of slack on this row, and
						// reserving a column for a count that may not exist was enough to wrap every
						// Application's name onto two lines. The declared summary count is the part
						// that gives way -- board M03 shows the pending badge and nothing else.
						<span class="flex shrink-0 justify-end text-xs sm:w-30">
							if app.ShowPending && app.PendingCount > 0 {
								<span class="rounded-full bg-blue-50 px-2.5 py-1 whitespace-nowrap text-blue-700">
									{ fmt.Sprintf("%d pending", app.PendingCount) }
								</span>
							} else if app.ShowCount {
								<span class="hidden whitespace-nowrap text-slate-400 sm:inline">
									{ fmt.Sprintf("%d %s", app.Count, app.CountLabel) }{ pluralS(app.Count) }
								</span>
							}
						</span>
						<span class="shrink-0 text-slate-300">
							@icon("chevron-right", "size-4")
						</span>
					</a>
				}
			</section>
		}
		// Board 03's own closing row. The mockup reads "You manage Dokter Kecil · 24 members"; the
		// member count is dropped for the reason recorded three times now -- it is not a field on
		// domain.Workspace -- so the row states the role and the destination, which are both real.
		if viewer.WorkspaceRole != domain.WorkspaceRoleMember {
			<div class="mt-2 flex items-center gap-3 border-t border-slate-200 pt-4 text-sm text-slate-500">
				// Only when there is a role to name. displayRole renders "—" for an empty one, which
				// reads fine in a table cell and reads broken inside a pill -- and empty is exactly
				// the shared admin credential's case, which still sees this row because it can open
				// the destination (the != member split above).
				if viewer.WorkspaceRole != "" {
					<span class="rounded-full bg-slate-100 px-2 py-0.5 text-2xs font-medium text-slate-600">{ viewer.WorkspaceRole }</span>
				}
				<span class="grow">You manage { workspaceName }</span>
				<a href={ templ.SafeURL(routeByID(ctx, "nav_workspace_members")) } class="flex shrink-0 items-center gap-1.5 text-blue-600 hover:text-blue-700">
					@icon("settings", "size-3.5")
					{ labelByID(ctx, "nav_workspace_members") }
				</a>
			</div>
		}
	}
}

// membersHiddenFor was deleted on 2026-09-21, with appShell's hiddenNavIDs parameter (see
// appshell.templ). It named the three Workspace-administration destinations a plain member must
// not be offered. The launcher offers those to nobody now -- it lists Applications, not
// destinations -- so the filter had nothing left to filter, and keeping it would have read as a
// protection that no longer protects anything. requireWorkspaceAdmin was always the real gate.
//
// The "Manage members" link on this page keeps its own inline `workspaceRole != "member"` check,
// which is the half of the 2026-09-19 code-review finding that can still leak.

// accessTile was deleted on 2026-09-24 with the "Your access" section it existed for. That
// section answered "which role do I hold where" in a separate grid at the bottom of the page;
// board 03 answers it on each Application's own row instead, where the question is actually being
// asked. Its own doc comment had predicted the opposite -- that Fase 3 would turn two tiles into
// one per Application -- which is what happened, and then the rows absorbed them.

func pluralS(n int) string {
	if n == 1 {
		return ""
	}
	return "s"
}

func displayRole(role string) string {
	if role == "" {
		return "—"
	}
	return role
}
