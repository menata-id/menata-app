package rendering

import (
	"menata.app/internal/domain"
	"menata.app/internal/experience"
	"fmt"

	"menata.app/internal/data"
)

// TaskRow is one Task ready to render on My Tasks: the record itself plus its Project's display
// name, resolved ahead of render time the same way ActivityEntry resolves its actor.
type TaskRow struct {
	Task        *data.Record
	ProjectName string
	// Title and Status are this Task's own declared display shape (mch_task's card_fields, 007 §7.6),
	// resolved by composition.ProjectedByRole -- the Page renders them in its own markup and never
	// picks a Field off the record itself (007 §4.4).
	Title  string
	Status string
	// SLA and DueText are the date Field in the `date` role, **already resolved** -- a badge with its
	// label and tone, and the stored value as text for the lists that show a plain date instead.
	//
	// They replaced `Due any` on 2026-10-03. That field's own comment said "slaBadgePill parses it",
	// which named the defect accurately: a Page was parsing a date and evaluating a business rule
	// against `time.Now()`. Composition resolves both now, with the `now` it already takes. Which
	// Field they come from is still the declaration's answer (composition.FieldForRole).
	SLA     experience.SLABadge
	DueText string
	// Complete, Date, ListName and Tags are what My Tasks' own row draws beyond the shared shape above:
	// the completion circle (nil when the Machine declares no `completion:`), the date pill resolved
	// exactly as a board card's, the name of the list the Task sits in, and its tag chips.
	Complete *CardComplete
	Date     experience.CardDate
	ListName string
	Tags     []CardTag
	// Assignee is the display name of the Field in the `person` role, "" when nobody is assigned. Only the
	// Calendar draws it (as an avatar); My Tasks lists the viewer's own Tasks, where it would say the same
	// name on every row.
	Assignee string
}

// MyTasksPage is Case 19's personal work queue (Case 19 PM03): every mch_task assigned to the current user,
// across every board, in four sections -- Overdue, Next 7 days, Later, Completed. A row's circle completes
// the task without opening it. A section with nothing in it is not drawn, so a quiet day is a short page.
templ MyTasksPage(overdue, next7, later, completed []TaskRow, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	@appShell(titleByID(ctx, "nav_my_tasks"), workspaceName, viewer, switchWorkspaceHref) {
		@pageHeader("nav_my_tasks")
		@taskSection("Overdue", "needs a new date or a tick", overdue)
		@taskSection("Next 7 days", "", next7)
		@taskSection("Later", "", later)
		@taskSection("Completed", "", completed)
		if len(overdue)+len(next7)+len(later)+len(completed) == 0 {
			@staticText(domain.StaticMessage, "Nothing is assigned to you.")
		}
	}
}

templ taskSection(heading, hint string, rows []TaskRow) {
	if len(rows) > 0 {
		@stackLayout(domain.GapTight) {
			@rowLayout(domain.GapTight, domain.RowAlignCenter, domain.RowJustifyStart) {
				<h2 class="m-0 text-sm font-medium">{ heading }</h2>
				@statusBadge(fmt.Sprint(len(rows)), domain.ToneNeutral, domain.BadgeCompact)
				if hint != "" {
					<span class="text-xs text-slate-400">{ hint }</span>
				}
			}
			<ul class="m-0 flex list-none flex-col divide-y divide-slate-100 overflow-hidden rounded-lg border border-slate-200 bg-white p-0">
				for _, t := range rows {
					<li>
						@myTaskRow(t)
					</li>
				}
			</ul>
		}
	}
}

// myTaskRow is one Task: the circle, the title with its board and tags beneath, the list it sits in, and the
// date. The circle PATCHes the Task's own record route and answers with a page refresh (patchRecordForm
// sends HX-Refresh when the request did not come from the Machine's own page), since this screen has no
// fragment of its own to swap.
templ myTaskRow(t TaskRow) {
	{{ done := t.Complete != nil && t.Complete.Done }}
	<div class="px-4 py-3">
		@rowLayout(domain.GapDefault, domain.RowAlignCenter, domain.RowJustifyStart) {
		if t.Complete != nil {
			<form class="m-0 shrink-0" hx-patch={ taskPatchURL(t) } hx-swap="none">
				<input type="hidden" name={ t.Complete.Field } value={ t.Complete.Next }/>
				<button
					type="submit"
					aria-pressed={ fmt.Sprint(done) }
					aria-label={ completeLabel(done, t.Title) }
					class={ "grid size-5 place-items-center rounded-full border-2 text-white", templ.KV("border-emerald-600 bg-emerald-600", done), templ.KV("border-slate-300 hover:border-emerald-600", !done) }
				>
					if done {
						@icon("check", "size-3")
					}
				</button>
			</form>
		}
		<a href={ templ.URL(taskPatchURL(t)) } class="flex min-w-0 grow flex-col gap-1 text-slate-900">
			<span class={ "text-sm", templ.KV("text-slate-500", done) }>{ t.Title }</span>
			if t.ProjectName != "" || len(t.Tags) > 0 {
				@rowLayout(domain.GapTight, domain.RowAlignCenter, domain.RowJustifyStart) {
					<span class="text-2xs text-slate-400">{ t.ProjectName }</span>
					for _, tag := range t.Tags {
						@tagChip(tag)
					}
				}
			}
		</a>
		if t.ListName != "" {
			@statusBadge(t.ListName, domain.ToneNeutral, domain.BadgeCompact)
		}
		if t.Date.Present {
			<span class={ "inline-flex items-center gap-1 whitespace-nowrap rounded px-1.5 py-0.5 text-xs", toneClass(ctx, t.Date.Tone) }>
				if t.Date.Done {
					@icon("check", "size-3")
				} else {
					@icon("calendar", "size-3")
				}
				{ t.Date.Label }
			</span>
		}
		}
	</div>
}

// taskPatchURL is the Task's own record route: where its title links and where its circle writes.
func taskPatchURL(t TaskRow) string {
	return "/machines/" + t.Task.MachineID + "/records/" + t.Task.ID
}

templ taskRowList(rows []TaskRow, sla bool) {
	@collection(domain.GapTight, taskItems(rows, sla))
}

// taskItems fills the Collection's item slot. `sla` stays a parameter of the *item*, not of the list: it
// decides what a row shows, which is the row's business and not the collection's.
func taskItems(rows []TaskRow, sla bool) []templ.Component {
	out := make([]templ.Component, 0, len(rows))
	for _, t := range rows {
		out = append(out, taskRowItem(t, sla))
	}
	return out
}

templ taskRowItem(t TaskRow, sla bool) {
	<span>{ t.Title }</span>
	@statusBadge(t.Status, domain.ToneNeutral, domain.BadgeCompact)
	<span class="text-xs text-slate-400">{ t.ProjectName }</span>
	if sla {
		<span class="ml-auto">
			@slaBadge(t.SLA)
		</span>
	} else if t.DueText != "" {
		<span class="ml-auto text-xs text-slate-400">{ t.DueText }</span>
	}
}
