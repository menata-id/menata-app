package rendering

import (
	"fmt"

	"menata.app/internal/data"
)

// MyTasksSummary is the three headline counts on the My Tasks page (ROADMAP.md Phase 14):
// Open (not done), Due today, and Overdue -- all computed from the same already-fetched Task
// set as the buckets below, not a separate query.
type MyTasksSummary struct {
	Open     int
	DueToday int
	Overdue  int
}

// TaskRow is one Task ready to render on My Tasks: the record itself plus its Project's display
// name, resolved ahead of render time the same way ActivityEntry resolves its actor.
type TaskRow struct {
	Task        *data.Record
	ProjectName string
}

// MyTasksPage is Case 19's personal work queue (ROADMAP.md Phase 14, project-my-tasks.html):
// every mch_task assigned to the current user, projected across all Projects and bucketed by
// due date -- Today (due today or overdue, SLA-badged), Upcoming (due later or undated),
// Completed (status done). This is a filtered/bucketed view over one whole-machine Task query,
// not a new query mechanism.
templ MyTasksPage(summary MyTasksSummary, today, upcoming, completed []TaskRow, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	@appShell(labelByID(ctx, "nav_my_tasks"), workspaceName, viewer, switchWorkspaceHref) {
		<div class="flex flex-col gap-2">
			<span class="text-3xs tracking-wide text-blue-600 uppercase">Project Management</span>
			<h1 class="m-0 text-xl font-medium">{ labelByID(ctx, "nav_my_tasks") }</h1>
			<div class="text-sm text-slate-500">Tasks assigned to you, projected across all projects.</div>
		</div>

		@summaryCountTiles([]SummaryItem{
			{Label: "Open", Value: fmt.Sprint(summary.Open)},
			{Label: "Due today", Value: fmt.Sprint(summary.DueToday)},
			{Label: "Overdue", Value: fmt.Sprint(summary.Overdue)},
		})

		<section class="rounded-lg border border-slate-200 bg-white p-4">
			<h2 class="m-0 mb-3 text-base font-medium">Today</h2>
			if len(today) == 0 {
				<p class="m-0 text-sm text-slate-500">Nothing due today or overdue.</p>
			} else {
				@taskRowList(today, true)
			}
		</section>

		<section class="rounded-lg border border-slate-200 bg-white p-4">
			<h2 class="m-0 mb-3 text-base font-medium">Upcoming</h2>
			if len(upcoming) == 0 {
				<p class="m-0 text-sm text-slate-500">Nothing upcoming.</p>
			} else {
				@taskRowList(upcoming, false)
			}
		</section>

		<section class="rounded-lg border border-slate-200 bg-white p-4">
			<h2 class="m-0 mb-3 text-base font-medium">Completed</h2>
			if len(completed) == 0 {
				<p class="m-0 text-sm text-slate-500">No completed tasks yet.</p>
			} else {
				<ul class="flex flex-col gap-2">
					for _, t := range completed {
						<li class="flex items-center gap-2 text-sm">
							<span class="text-slate-400 line-through">{ toString(t.Task.Values["fld_title"]) }</span>
							<span class="ml-auto text-xs text-slate-400">{ t.ProjectName }</span>
						</li>
					}
				</ul>
			}
		</section>
	}
}

templ taskRowList(rows []TaskRow, sla bool) {
	<ul class="flex flex-col gap-2">
		for _, t := range rows {
			<li class="flex flex-wrap items-center gap-2 text-sm">
				<span>{ toString(t.Task.Values["fld_title"]) }</span>
				<span class="rounded-full bg-slate-100 px-2 py-0.5 text-2xs text-slate-600">{ toString(t.Task.Values["fld_status"]) }</span>
				<span class="text-xs text-slate-400">{ t.ProjectName }</span>
				if sla {
					<span class="ml-auto">
						@slaBadgePill(t.Task.Values["fld_due_date"])
					</span>
				} else if due := toString(t.Task.Values["fld_due_date"]); due != "" {
					<span class="ml-auto text-xs text-slate-400">{ due }</span>
				}
			</li>
		}
	</ul>
}
