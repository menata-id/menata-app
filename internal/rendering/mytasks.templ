package rendering

import (
	"menata.app/internal/experience"
	"fmt"

	"menata.app/internal/data"
)

// MyTasksSummary is the three headline counts on the My Tasks page (development-history.md Phase 14):
// Open (not done), Due today, and Overdue -- all computed from the same already-fetched Task
// set as the buckets below, not a separate query.
type MyTasksSummary struct {
	Open     int
	DueToday int
	Overdue  int
}

// TaskRow is one Task ready to render on My Tasks: the record itself plus its Project's display
// name, resolved ahead of render time the same way ActivityEntry resolves its actor.
type TaskRow struct {
	Task        *data.Record
	ProjectName string
	// Title and Status are this Task's own declared display shape (mch_task's card_fields, 007 §7.6),
	// resolved by composition.ProjectedByRole -- the Page renders them in its own markup and never
	// picks a Field off the record itself (007 §4.4).
	Title  string
	Status string
	// SLA and DueText are the date Field in the `date` role, **already resolved** -- a badge with its
	// label and tone, and the stored value as text for the lists that show a plain date instead.
	//
	// They replaced `Due any` on 2026-10-03. That field's own comment said "slaBadgePill parses it",
	// which named the defect accurately: a Page was parsing a date and evaluating a business rule
	// against `time.Now()`. Composition resolves both now, with the `now` it already takes. Which
	// Field they come from is still the declaration's answer (composition.FieldForRole).
	SLA     experience.SLABadge
	DueText string
}

// MyTasksPage is Case 19's personal work queue (development-history.md Phase 14, project-my-tasks.html):
// every mch_task assigned to the current user, projected across all Projects and bucketed by
// due date -- Today (due today or overdue, SLA-badged), Upcoming (due later or undated),
// Completed (status done). This is a filtered/bucketed view over one whole-machine Task query,
// not a new query mechanism.
templ MyTasksPage(summary MyTasksSummary, today, upcoming, completed []TaskRow, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	@appShell(titleByID(ctx, "nav_my_tasks"), workspaceName, viewer, switchWorkspaceHref) {
		@pageHeader("nav_my_tasks")

		@summaryCountTiles([]SummaryItem{
			{Label: "Open", Value: fmt.Sprint(summary.Open)},
			{Label: "Due today", Value: fmt.Sprint(summary.DueToday)},
			{Label: "Overdue", Value: fmt.Sprint(summary.Overdue)},
		})

		@panelLayout() {
			<h2 class="m-0 mb-3 text-base font-medium">Today</h2>
			if len(today) == 0 {
				<p class="m-0 text-sm text-slate-500">Nothing due today or overdue.</p>
			} else {
				@taskRowList(today, true)
			}
		}

		@panelLayout() {
			<h2 class="m-0 mb-3 text-base font-medium">Upcoming</h2>
			if len(upcoming) == 0 {
				<p class="m-0 text-sm text-slate-500">Nothing upcoming.</p>
			} else {
				@taskRowList(upcoming, false)
			}
		}

		@panelLayout() {
			<h2 class="m-0 mb-3 text-base font-medium">Completed</h2>
			if len(completed) == 0 {
				<p class="m-0 text-sm text-slate-500">No completed tasks yet.</p>
			} else {
				<ul class="flex flex-col gap-2">
					for _, t := range completed {
						<li class="flex items-center gap-2 text-sm">
							<span class="text-slate-400 line-through">{ t.Title }</span>
							<span class="ml-auto text-xs text-slate-400">{ t.ProjectName }</span>
						</li>
					}
				</ul>
			}
		}
	}
}

templ taskRowList(rows []TaskRow, sla bool) {
	<ul class="flex flex-col gap-2">
		for _, t := range rows {
			<li class="flex flex-wrap items-center gap-2 text-sm">
				<span>{ t.Title }</span>
				<span class="rounded-full bg-slate-100 px-2 py-0.5 text-2xs text-slate-600">{ t.Status }</span>
				<span class="text-xs text-slate-400">{ t.ProjectName }</span>
				if sla {
					<span class="ml-auto">
						@slaBadge(t.SLA)
					</span>
				} else if t.DueText != "" {
					<span class="ml-auto text-xs text-slate-400">{ t.DueText }</span>
				}
			</li>
		}
	</ul>
}
