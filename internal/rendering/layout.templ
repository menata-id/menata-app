package rendering

import (
	"context"
	"maps"
	"slices"
	"strconv"
	"strings"

	"menata.app/internal/domain"
	"menata.app/internal/ir"
)

// The generic renderers for domain's Layout and Static Content primitives (007 §12.2, §12.6).
//
// **This file is the only place a kind becomes CSS.** §15.2 forbids an intermediate representation
// embedding "HTML, CSS framework classes", so `domain` carries the vocabulary and the mapping lives here,
// in the plane entitled to know Tailwind exists. §14 permits exactly this shape -- "Existing templ
// functions may remain behind registered components during migration".
//
// **The gate that matters for these is not "is anything using them".** It is
// `conformance.TestLayoutRenderersHaveNoPerScreenBranch`: a generic renderer that needs to know *which
// screen* is calling it is not a primitive, it is one screen's shape with a new name. That is the only
// test of genericity these have, and it is why the four unmeasured §12.2 kinds were not built -- a
// primitive with no second caller cannot fail it.

// radiusClass maps a radius role through **this request's Workspace theme** — the first token category that a
// Workspace can redeclare without a recompile, which is what distinguishes a Theme from the Go vocabularies
// (`Gap`, `BadgeTone`) that already existed.
//
// Reads the theme off ctx rather than taking it as a parameter, because every primitive below would otherwise
// grow one, and the zero Theme is a working answer: a pre-auth screen has no Workspace on ctx and
// `Theme.RadiusFor` falls back to `DefaultTheme`, so it renders exactly what it rendered before.
func radiusClass(ctx context.Context, role domain.RadiusRole) string {
	switch CurrentWorkspace(ctx).Theme.RadiusFor(role) {
	case domain.RadiusStepSmall:
		return "rounded-md"
	case domain.RadiusStepLarge:
		return "rounded-lg"
	case domain.RadiusStepFull:
		return "rounded-full"
	default:
		return "rounded-lg"
	}
}

// weightClass maps a weight role through this request's Workspace theme, on the same terms as radiusClass.
func weightClass(ctx context.Context, role domain.WeightRole) string {
	switch CurrentWorkspace(ctx).Theme.WeightFor(role) {
	case domain.WeightStepNormal:
		return "font-normal"
	case domain.WeightStepMedium:
		return "font-medium"
	default:
		return "font-medium"
	}
}

// textClass maps a text role through this request's Workspace theme, on the same terms as radiusClass.
func textClass(ctx context.Context, role domain.TextRole) string {
	switch CurrentWorkspace(ctx).Theme.TextFor(role) {
	case domain.TextMicro:
		return "text-3xs"
	case domain.TextTiny:
		return "text-2xs"
	case domain.TextSmall:
		return "text-xs"
	case domain.TextNormal:
		return "text-sm"
	case domain.TextNormalPlus:
		return "text-item"
	case domain.TextMedium:
		return "text-base"
	case domain.TextLarge:
		return "text-xl"
	case domain.TextHuge:
		return "text-2xl"
	default:
		return "text-sm"
	}
}

// borderClass is a border role's class, one per role (DS-D15 stage 2): `--color-border-<role>` holds the shade, its
// default in input.css's `@theme`, a Workspace's override in themeCSS. The step each shade draws is borderShadeVar.
func borderClass(ctx context.Context, role domain.BorderRole) string {
	switch role {
	case domain.BorderControl:
		return "border-border-control"
	case domain.BorderDivider:
		return "border-border-divider"
	default:
		return "border-border-surface"
	}
}

// borderShadeVar is the palette step each closed border shade draws.
func borderShadeVar(shade domain.BorderShade) string {
	switch shade {
	case domain.BorderFaint:
		return "--color-slate-100"
	case domain.BorderDefined:
		return "--color-slate-300"
	default:
		return "--color-slate-200"
	}
}

// inkClass is a text-colour role's class (owner decision DS-D15 stage 2, 2026-10-12). It no longer switches on the
// Workspace's shade: each role is one CSS custom property, `--color-ink-<role>` (the Design System's own token names,
// declared in input.css's `@theme` with the default shade), and a Workspace that moves a role overrides the property
// in its page's `<head>` (themeStyle). So the class is the same under every theme, a Workspace may give a role a
// colour value as well as a closed shade, and a page with no Workspace (the pre-auth screens) still draws the default.
//
// ctx stays in the signature because 120-odd call sites pass it and a reader that ignores it today may read it again
// tomorrow; what it no longer does is choose the class. The accent is a role of this reader, not a separate one, so
// no caller (a gate included) can ask inkClass for the accent and silently get the grey default.
func inkClass(ctx context.Context, role domain.InkRole) string {
	switch role {
	case domain.InkStrong:
		return "text-ink-strong"
	case domain.InkBody:
		return "text-ink-body"
	case domain.InkSecondary:
		return "text-ink-secondary"
	case domain.InkFaint:
		return "text-ink-faint"
	case domain.InkAccent:
		return "text-accent"
	default:
		return "text-ink-strong"
	}
}

// accentHoverClass is the accent's hover, the Design System's `accent-hover`: one step darker than the accent, in the
// same hue. Hover is a state of the accent, not a role of its own (DS-D11), so `ink.accent` moves both (themeStyle).
func accentHoverClass(ctx context.Context) string {
	return "hover:text-accent-hover"
}

// inkShadeVar is the palette variable each closed ink shade renders as -- the step→colour map the Theme's ink roles
// choose from, written once here and read by themeStyle (a Workspace's override) and by the conformance gates that
// need a role's default palette class. Each hue is the step that reads at 4.5:1 or better on white and on the page
// background (TestThemeColourPairsMeetContrast measures every one), which is why emerald, rose and cyan sit one step
// darker than blue, indigo and violet.
func inkShadeVar(shade domain.InkShade) string {
	switch shade {
	case domain.InkShadeDarkest:
		return "--color-slate-900"
	case domain.InkShadeDark:
		return "--color-slate-700"
	case domain.InkShadeMedium:
		return "--color-slate-500"
	case domain.InkShadeLight:
		return "--color-slate-400"
	case domain.InkHueBlue:
		return "--color-blue-600"
	case domain.InkHueIndigo:
		return "--color-indigo-600"
	case domain.InkHueViolet:
		return "--color-violet-600"
	case domain.InkHueEmerald:
		return "--color-emerald-700"
	case domain.InkHueRose:
		return "--color-rose-700"
	case domain.InkHueCyan:
		return "--color-cyan-700"
	default:
		return "--color-slate-900"
	}
}

// accentHoverShadeVar is the hover step beside each accent hue: one step darker, in the same hue.
func accentHoverShadeVar(shade domain.InkShade) string {
	switch shade {
	case domain.InkHueIndigo:
		return "--color-indigo-700"
	case domain.InkHueViolet:
		return "--color-violet-700"
	case domain.InkHueEmerald:
		return "--color-emerald-800"
	case domain.InkHueRose:
		return "--color-rose-800"
	case domain.InkHueCyan:
		return "--color-cyan-800"
	default:
		return "--color-blue-700"
	}
}

// accentHoverMix darkens a free accent value for its hover. A colour value has no "next step", so the hover is the
// value mixed with black, which is darker and so never less readable on a light surface than the accent itself.
const accentHoverMix = "black 15%"

// inkRoleVar is the custom property each ink role is drawn through (input.css's `@theme`).
func inkRoleVar(role domain.InkRole) string {
	if role == domain.InkAccent {
		return "--color-accent"
	}
	return "--color-ink-" + string(role)
}

// themeCSS is the override for this request's Workspace (ink, border, background and tone): one declaration per colour
// role whose value differs from the default Theme, and nothing at all for a Workspace that declares no colour (so the
// default theme adds no bytes). A closed shade becomes `var(--color-…)`, a colour value is written as itself; the loader
// accepts only `#rrggbb` (domain.IsColourValue), and this checks again before writing, because the result goes into a
// `<style>`.
//
// **Two blocks since dark mode (owner decision DK11, 2026-10-13).** Every declaration goes in a light block,
// `@media (prefers-color-scheme:light){:root{…}}`, so in dark mode the page keeps input.css's dark defaults. A Workspace's
// *hue* choices -- an accent hue, a tone remap -- also go in a dark block, at that hue's dark steps (accentDarkVar,
// toneFillDarkVar and its pair), so a Workspace that picked violet links keeps violet links in the dark. Its shade and
// value choices for ink, background and border do not: they were measured on light surfaces, and a free accent value
// has no dark step to take.
//
// Every list is ranged from the domain's closed sets (sorted, for 007 §4.6 determinism), so a role or tone added there
// is written here without anyone remembering to; the 2026-10-13 review dropped `neutral` and `muted` from a
// hand-written list and nothing failed.
func themeCSS(ctx context.Context) string {
	th, def := CurrentWorkspace(ctx).Theme, domain.DefaultTheme()
	var decl, dark []string
	for _, role := range slices.Sorted(maps.Keys(domain.KnownInkRoles)) {
		shade := th.InkFor(role)
		if shade == def.InkFor(role) {
			continue
		}
		if v := string(shade); domain.IsColourValue(v) {
			decl = append(decl, inkRoleVar(role)+":"+v)
			if role == domain.InkAccent {
				decl = append(decl, "--color-accent-hover:color-mix(in oklab,"+v+","+accentHoverMix+")")
			}
			continue
		}
		decl = append(decl, inkRoleVar(role)+":var("+inkShadeVar(shade)+")")
		if role == domain.InkAccent {
			decl = append(decl, "--color-accent-hover:var("+accentHoverShadeVar(shade)+")")
			if domain.IsInkHue(shade) {
				dark = append(dark, "--color-accent:var("+accentDarkVar(shade)+")", "--color-accent-hover:var("+accentHoverDarkVar(shade)+")")
			}
		}
	}
	for _, role := range slices.Sorted(maps.Keys(domain.KnownBorderRoles)) {
		if shade := th.BorderFor(role); shade != def.BorderFor(role) {
			decl = append(decl, "--color-border-"+string(role)+":var("+borderShadeVar(shade)+")")
		}
	}
	for _, role := range slices.Sorted(maps.Keys(domain.KnownBackgroundRoles)) {
		if shade := th.BackgroundFor(role); shade != def.BackgroundFor(role) {
			if v := string(shade); domain.IsColourValue(v) {
				decl = append(decl, "--color-bg-"+string(role)+":"+v)
				continue
			}
			decl = append(decl, "--color-bg-"+string(role)+":var("+backgroundShadeVar(shade)+")")
		}
	}
	for _, tone := range slices.Sorted(maps.Keys(domain.KnownBadgeTones)) {
		if p := th.ToneFor(tone); p != def.ToneFor(tone) {
			n := "--color-tone-" + string(tone)
			decl = append(decl, n+"-bg:var("+toneFillVar(p)+")", n+"-ink:var("+toneInkVar(p)+")", n+"-border:var("+toneEdgeVar(p)+")")
			dark = append(dark, n+"-bg:var("+toneFillDarkVar(p)+")", n+"-ink:var("+toneInkDarkVar(p)+")", n+"-border:var("+toneEdgeDarkVar(p)+")")
		}
	}
	var out string
	if len(decl) > 0 {
		out = themeCSSLight + "{:root{" + strings.Join(decl, ";") + "}}"
	}
	if len(dark) > 0 {
		out += themeCSSDark + "{:root{" + strings.Join(dark, ";") + "}}"
	}
	return out
}

// themeCSSLight and themeCSSDark are the two media blocks themeCSS writes.
const (
	themeCSSLight = "@media (prefers-color-scheme:light)"
	themeCSSDark  = "@media (prefers-color-scheme:dark)"
)

// accentDarkVar and accentHoverDarkVar are each accent hue's dark-mode steps (DK3): the 400 step as the accent and the
// 300 step as its hover, which lightens in the dark. GS3 measures every hue on the dark surfaces.
func accentDarkVar(shade domain.InkShade) string {
	switch shade {
	case domain.InkHueIndigo:
		return "--color-indigo-400"
	case domain.InkHueViolet:
		return "--color-violet-400"
	case domain.InkHueEmerald:
		return "--color-emerald-400"
	case domain.InkHueRose:
		return "--color-rose-400"
	case domain.InkHueCyan:
		return "--color-cyan-400"
	default:
		return "--color-blue-400"
	}
}

func accentHoverDarkVar(shade domain.InkShade) string {
	switch shade {
	case domain.InkHueIndigo:
		return "--color-indigo-300"
	case domain.InkHueViolet:
		return "--color-violet-300"
	case domain.InkHueEmerald:
		return "--color-emerald-300"
	case domain.InkHueRose:
		return "--color-rose-300"
	case domain.InkHueCyan:
		return "--color-cyan-300"
	default:
		return "--color-blue-300"
	}
}

// toneFillDarkVar, toneInkDarkVar and toneEdgeDarkVar are each tone palette's dark-mode triple (DK5): the hue's 950 step
// as fill, 300 as ink, 800 as edge; `grey` lifts to slate-800 so a neutral badge still shows on a card, and
// `grey-faint` keeps muted's meaning (the page canvas, the faint ink, the divider).
func toneFillDarkVar(p domain.TonePalette) string {
	switch p {
	case domain.PaletteGreyFaint:
		return "--color-slate-950"
	case domain.PaletteBlue:
		return "--color-blue-950"
	case domain.PaletteGreen:
		return "--color-emerald-950"
	case domain.PaletteRed:
		return "--color-red-950"
	case domain.PaletteAmber:
		return "--color-amber-950"
	default:
		return "--color-slate-800"
	}
}

func toneInkDarkVar(p domain.TonePalette) string {
	switch p {
	case domain.PaletteGreyFaint:
		return "--color-slate-500"
	case domain.PaletteBlue:
		return "--color-blue-300"
	case domain.PaletteGreen:
		return "--color-emerald-300"
	case domain.PaletteRed:
		return "--color-red-300"
	case domain.PaletteAmber:
		return "--color-amber-300"
	default:
		return "--color-slate-300"
	}
}

func toneEdgeDarkVar(p domain.TonePalette) string {
	switch p {
	case domain.PaletteGreyFaint:
		return "--color-slate-800"
	case domain.PaletteBlue:
		return "--color-blue-800"
	case domain.PaletteGreen:
		return "--color-emerald-800"
	case domain.PaletteRed:
		return "--color-red-800"
	case domain.PaletteAmber:
		return "--color-amber-800"
	default:
		return "--color-slate-700"
	}
}

// themeStyle writes themeCSS into the page's `<head>`. CSP already allows an inline `<style>`
// (`style-src 'self' 'unsafe-inline'`, internal/web/secureheaders.go).
templ themeStyle() {
	if css := themeCSS(ctx); css != "" {
		@templ.Raw("<style>" + css + "</style>")
	}
}

// backgroundClass is a surface role's class, one per role (DS-D15 stage 2), through `--color-bg-<role>`. The step
// each shade draws is backgroundShadeVar.
func backgroundClass(ctx context.Context, role domain.BackgroundRole) string {
	switch role {
	case domain.BackgroundBase:
		return "bg-bg-base"
	case domain.BackgroundSunken:
		return "bg-bg-sunken"
	default:
		return "bg-bg-raised"
	}
}

// backgroundShadeVar is the palette step each closed background shade draws.
func backgroundShadeVar(shade domain.BackgroundShade) string {
	switch shade {
	case domain.BackgroundShadeLighter:
		return "--color-slate-50"
	case domain.BackgroundShadeLight:
		return "--color-slate-100"
	default:
		return "--color-white"
	}
}

// paddingClass maps a padding role through this request's Workspace theme, on the same terms as radiusClass.
// **Three switches, one per axis**, because Tailwind needs each class as a literal and the ladders differ: the
// all-sides ladder has no half, one or one-and-a-half step (`domain.PaddingAmountAllowed`), so a shared switch
// would put classes in the bundle that nothing uses.
func paddingClass(ctx context.Context, role domain.PaddingRole) string {
	a := CurrentWorkspace(ctx).Theme.PaddingFor(role)
	switch role.Axis() {
	case domain.PaddingAxisX:
		switch a {
		case domain.PaddingAmountHalf:
			return "px-0.5"
		case domain.PaddingAmountOne:
			return "px-1"
		case domain.PaddingAmountOneHalf:
			return "px-1.5"
		case domain.PaddingAmountTwo:
			return "px-2"
		case domain.PaddingAmountTwoHalf:
			return "px-2.5"
		case domain.PaddingAmountThree:
			return "px-3"
		case domain.PaddingAmountFour:
			return "px-4"
		case domain.PaddingAmountFive:
			return "px-5"
		}
		return "px-2.5"
	case domain.PaddingAxisY:
		switch a {
		case domain.PaddingAmountHalf:
			return "py-0.5"
		case domain.PaddingAmountOne:
			return "py-1"
		case domain.PaddingAmountOneHalf:
			return "py-1.5"
		case domain.PaddingAmountTwo:
			return "py-2"
		case domain.PaddingAmountTwoHalf:
			return "py-2.5"
		case domain.PaddingAmountThree:
			return "py-3"
		case domain.PaddingAmountFour:
			return "py-4"
		case domain.PaddingAmountFive:
			return "py-5"
		}
		return "py-1"
	default:
		switch a {
		case domain.PaddingAmountTwo:
			return "p-2"
		case domain.PaddingAmountTwoHalf:
			return "p-2.5"
		case domain.PaddingAmountThree:
			return "p-3"
		case domain.PaddingAmountFour:
			return "p-4"
		case domain.PaddingAmountFive:
			return "p-5"
		}
		return "p-4"
	}
}

// toneClass maps a semantic tone to its background and text pair, through this request's Workspace theme.
//
// Returns both classes as one string because a palette **is** the pair: splitting them would let a Workspace
// declare a background without its text colour and produce an unreadable badge, which is the kind of
// half-valid state a closed set exists to prevent.
func toneClass(ctx context.Context, tone domain.BadgeTone) string {
	return toneFillClass(ctx, tone) + " " + toneInkClass(ctx, tone)
}

// toneFillClass and toneInkClass are the two halves of toneClass's pair, for the one caller (a tinted section) that
// wants the fill without the text colour. toneClass joins them, so a palette is still declared once.
//
// Since DS-D15 stage 2 every tone half is a property, `--color-tone-<tone>-bg|ink|border`, so each reader answers one
// class per tone and the Workspace's palette choice is written by themeCSS. The steps a palette draws are
// toneFillVar/toneInkVar/toneEdgeVar.
func toneFillClass(ctx context.Context, tone domain.BadgeTone) string {
	switch tone {
	case domain.ToneInfo:
		return "bg-tone-info-bg"
	case domain.ToneGood:
		return "bg-tone-good-bg"
	case domain.ToneBad:
		return "bg-tone-bad-bg"
	case domain.ToneWarn:
		return "bg-tone-warn-bg"
	case domain.ToneMuted:
		return "bg-tone-muted-bg"
	default:
		return "bg-tone-neutral-bg"
	}
}

// hoverWashClass is the Design System's `hover-wash`: the fill a list row, a menu row or a secondary button takes on
// hover (owner decision DS-D11, 2026-10-12: hover lives in recipes, not as a role of its own). The artifact defines
// `hover-wash` as an alias of `bg-base`, and input.css declares it so (`--color-hover-wash: var(--color-bg-base)`),
// so a Workspace that moves `background.base` moves both with one override.
func hoverWashClass(ctx context.Context) string {
	return "hover:bg-hover-wash"
}

// toneHoverFillClass is a tone's fill as a hover (DS-D11): the danger button and the danger menu row wash to the
// `bad` tone's fill on hover, so their edge, ink and hover all follow theme.tone together (DS-D16's triple, plus its
// hover).
func toneHoverFillClass(ctx context.Context, tone domain.BadgeTone) string {
	switch tone {
	case domain.ToneInfo:
		return "hover:bg-tone-info-bg"
	case domain.ToneGood:
		return "hover:bg-tone-good-bg"
	case domain.ToneBad:
		return "hover:bg-tone-bad-bg"
	case domain.ToneWarn:
		return "hover:bg-tone-warn-bg"
	case domain.ToneMuted:
		return "hover:bg-tone-muted-bg"
	default:
		return "hover:bg-tone-neutral-bg"
	}
}

// toneEdgeClass is the tone's edge (owner decision DS-D16, 2026-10-12): the pair becomes a triple of fill, ink and
// edge, all from the same palette, so a Workspace that remaps `warn` to red no longer keeps an amber rim. No Theme key
// was added: the edge follows `theme.tone` like the other two. The Design System names two of these
// (`tone-warn-border`, `danger-border`); GS1 checks both.
func toneEdgeClass(ctx context.Context, tone domain.BadgeTone) string {
	switch tone {
	case domain.ToneInfo:
		return "border-tone-info-border"
	case domain.ToneGood:
		return "border-tone-good-border"
	case domain.ToneBad:
		return "border-tone-bad-border"
	case domain.ToneWarn:
		return "border-tone-warn-border"
	case domain.ToneMuted:
		return "border-tone-muted-border"
	default:
		return "border-tone-neutral-border"
	}
}

func toneInkClass(ctx context.Context, tone domain.BadgeTone) string {
	switch tone {
	case domain.ToneInfo:
		return "text-tone-info-ink"
	case domain.ToneGood:
		return "text-tone-good-ink"
	case domain.ToneBad:
		return "text-tone-bad-ink"
	case domain.ToneWarn:
		return "text-tone-warn-ink"
	case domain.ToneMuted:
		return "text-tone-muted-ink"
	default:
		return "text-tone-neutral-ink"
	}
}

// toneFillVar, toneInkVar and toneEdgeVar are the palette steps each tone palette draws: the three halves of
// DS-D16's triple, written once and read by themeCSS and by the gates that need a tone's default palette class.
func toneFillVar(p domain.TonePalette) string {
	switch p {
	case domain.PaletteGreyFaint:
		return "--color-slate-50"
	case domain.PaletteBlue:
		return "--color-blue-50"
	case domain.PaletteGreen:
		return "--color-emerald-50"
	case domain.PaletteRed:
		return "--color-red-50"
	case domain.PaletteAmber:
		return "--color-amber-50"
	default:
		return "--color-slate-100"
	}
}

func toneInkVar(p domain.TonePalette) string {
	switch p {
	case domain.PaletteGreyFaint:
		return "--color-slate-400"
	case domain.PaletteBlue:
		return "--color-blue-700"
	case domain.PaletteGreen:
		return "--color-emerald-700"
	case domain.PaletteRed:
		return "--color-red-700"
	case domain.PaletteAmber:
		return "--color-amber-800"
	default:
		return "--color-slate-600"
	}
}

func toneEdgeVar(p domain.TonePalette) string {
	switch p {
	case domain.PaletteGreyFaint:
		return "--color-slate-100"
	case domain.PaletteBlue:
		return "--color-blue-200"
	case domain.PaletteGreen:
		return "--color-emerald-200"
	case domain.PaletteRed:
		return "--color-red-200"
	case domain.PaletteAmber:
		return "--color-amber-200"
	default:
		return "--color-slate-200"
	}
}

// metricValueClass is toneClass's text-only counterpart for a Metric's value. A value has no background to
// pair with, so it takes only the palette's text colour -- and only for the two tones that signal something;
// every other tone, and the unset one, stays the default ink rather than tinting a number nobody flagged.
func metricValueClass(ctx context.Context, tone domain.BadgeTone) string {
	// Whether the value is tinted is still the Workspace's palette choice (a tone drawn red or green signals); the
	// colour itself is the tone's ink property, so it is the same step the tone's badge draws.
	switch CurrentWorkspace(ctx).Theme.ToneFor(tone) {
	case domain.PaletteRed, domain.PaletteGreen:
		return toneInkClass(ctx, tone)
	default:
		return inkClass(ctx, domain.InkStrong)
	}
}

// layoutGap maps a declared Gap onto the spacing steps the measured corpus actually uses. An empty Gap is
// GapDefault, resolved here rather than requiring every caller to say so.
func layoutGap(ctx context.Context, g domain.Gap) string {
	switch CurrentWorkspace(ctx).Theme.GapFor(g) {
	case domain.GapAmountHalf:
		return "gap-0.5"
	case domain.GapAmountOne:
		return "gap-1"
	case domain.GapAmountOneHalf:
		return "gap-1.5"
	case domain.GapAmountTwo:
		return "gap-2"
	case domain.GapAmountThree:
		return "gap-3"
	case domain.GapAmountFour:
		return "gap-4"
	case domain.GapAmountFive:
		return "gap-5"
	case domain.GapAmountSix:
		return "gap-6"
	default:
		return "gap-3"
	}
}

// stackLayout is vertical flow -- `flex flex-col gap-N`, the shape counted 61 times across the bespoke
// screens on 2026-10-02 and the reason this primitive was built first.
templ stackLayout(gap domain.Gap) {
	<div class={ "flex flex-col", layoutGap(ctx, gap) }>
		{ children... }
	</div>
}

// **All five measured primitives are here now, and three of them were in this file once before with no
// callers.** The first pass built four and migrated nothing; `grid`, `panel` and `row` were deleted the same
// day, and the unused grid renderer had already put a *three-column desktop* class into the Tailwind bundle --
// a class no screen used. Each came back only with the sites it replaces. A primitive arrives with its uses,
// or it is a name with nothing behind it.
//
// **That class is described in prose rather than named, on purpose**, and the reason is the bug it caused:
// Tailwind scans these `.templ` files as *text*, so the comment recording the mistake re-committed it. The
// class sat in app.css for a day, sourced by nothing but the sentence saying it should not be.
// `conformance.TestNoClassLivesOnlyInAComment` holds this now, and found two more the same way.

// surfaceClasses is the look of something content sits inside: the surface radius, a one-pixel edge in the
// surface border role, and the raised fill. Padding is deliberately not part of it -- it is the one thing the
// callers disagree about (`panel`, `section`, a table wrapper with none, a popover) -- so each site keeps its own.
//
// **It is a class reader and not a registered Component**, for `fieldClasses`' reason: the sites using it are a
// `<section>`, an `<aside>`, a `<fieldset>`, a `<details>`, a `<ul>` and a link, and choosing the element is not
// something the vocabulary has a word for. Before it, 34 hand-written sites carried this recipe as a literal, so a
// Workspace declaring `theme.border.surface` recoloured the surfaces `panelLayout`/`sectionLayout` drew and left
// every other one on slate-200. Joined in the old literal's order, so the default theme renders the same bytes.
func surfaceClasses(ctx context.Context) string {
	return strings.Join([]string{
		radiusClass(ctx, domain.RadiusSurface), "border", borderClass(ctx, domain.BorderSurface), backgroundClass(ctx, domain.BackgroundRaised),
	}, " ")
}

// dialogClasses is the shell of a modal `<dialog>` (rencana 2.3d, 2026-10-14): the surface recipe with panel padding,
// the strong ink, an elevation and the scrim. Two dialogs drew it, `signatureModal` as a literal list and
// `leaveWorkspaceGuard` in another order; one reader keeps a Workspace's `theme:` moving both. **Width and centring are
// in it since owner decision DW-1 (2026-10-14)**: `max-w-md` (448px), a mobile `w-[calc(100%-2rem)]` and `m-auto`. The
// signature dialog was 440px wide with no auto margin, and Tailwind's preflight zeroes the margin the browser
// centres a modal with, so it opened in the page's top-left corner (measured in Chromium, 1280 and 360px wide). It is a class reader and not a registered Component: what makes a dialog a dialog here is when
// it opens and closes (a dirty-form check, a canvas), which is 007 §12.3's `actions` and has no declaration yet.
func dialogClasses(ctx context.Context) string {
	return strings.Join([]string{
		"m-auto w-[calc(100%-2rem)] max-w-md", radiusClass(ctx, domain.RadiusSurface), "border", borderClass(ctx, domain.BorderSurface), paddingClass(ctx, domain.PaddingPanel),
		backgroundClass(ctx, domain.BackgroundRaised), inkClass(ctx, domain.InkStrong), "shadow-lg", scrimClass(true),
	}, " ")
}

// tileClasses is the look of a small box that sits inside a surface -- a selectable option, a list item, a card in a
// column: the control radius and a one-pixel edge in the surface border role. **Two readings, both chosen so that the
// default theme moves nothing.** The radius is `control`, not `surface`, because the default steps differ (a tile has
// always been one step tighter than the box around it) and reading `surface` would have rounded eleven screens by two
// more pixels; the edge is `surface`, because a tile is an outlined box and not a control's rim (`BorderControl` is
// darker) nor a row separator (`BorderDivider` is fainter). The fill is left to the site -- some tiles are raised, some
// transparent -- and the four raised ones read `backgroundClass(ctx, domain.BackgroundRaised)` beside it. A tile whose
// radius should differ from a control's is the case that would earn a `tile` radius role; nothing declares one yet.
func tileClasses(ctx context.Context) string {
	return strings.Join([]string{radiusClass(ctx, domain.RadiusControl), "border", borderClass(ctx, domain.BorderSurface)}, " ")
}

// The forms below put an existing colour role into another utility (owner decision 3.2d, 2026-10-13: no new roles;
// every remaining colour pairs with one that exists). Each is a property `input.css` already declares, so a Workspace's
// override and a future dark mode move them with their role. Each arm is a whole literal for Tailwind's scanner.

// inkFillClass is a text-colour role used as a fill. The primary button is `strong` as a fill with `onFillClass` as
// its text -- an inverse pair whose contrast is the strong-on-raised pair the loader already measures (CP1) -- and
// the accent marks (the current step, an unread dot) are `accent` as a fill (CP2).
func inkFillClass(ctx context.Context, role domain.InkRole) string {
	if role == domain.InkAccent {
		return "bg-accent"
	}
	return "bg-ink-strong"
}

// inkEdgeClass is `strong` as an edge, for the selected filter chip whose rim matches its fill.
func inkEdgeClass(ctx context.Context) string {
	return "border-ink-strong"
}

// checkedFillClass is a toggle's fill when its peer checkbox is on: the primary fill.
func checkedFillClass(ctx context.Context) string {
	return "peer-checked:bg-ink-strong"
}

// onFillClass is text on a filled mark (a primary button, a step circle, a count badge): the raised surface's colour
// as ink, so it inverts with the fill (CP1).
func onFillClass(ctx context.Context) string {
	return "text-bg-raised"
}

// borderFillClass is an edge role used as a fill: a 1px rule (`h-px`, `w-px`), a drag handle, an avatar (the Design
// System's `avatar-fill` is `{border-surface}`), a toggle's track.
func borderFillClass(ctx context.Context, role domain.BorderRole) string {
	switch role {
	case domain.BorderDivider:
		return "bg-border-divider"
	case domain.BorderControl:
		return "bg-border-control"
	default:
		return "bg-border-surface"
	}
}

// inkHoverClass is a text-colour role as a hover, for grey controls that darken on hover.
func inkHoverClass(ctx context.Context, role domain.InkRole) string {
	if role == domain.InkBody {
		return "hover:text-ink-body"
	}
	return "hover:text-ink-strong"
}

// sunkenHoverClass is the stronger hover wash for small icon buttons and pills that sit on `base`.
func sunkenHoverClass(ctx context.Context) string {
	return "hover:bg-bg-sunken"
}

// controlAccentClass is a native checkbox's or radio's `accent-color`: the accent, so it follows the Workspace (CP2).
func controlAccentClass(ctx context.Context) string {
	return "accent-accent"
}

// accentActiveClass is the active navigation item's ink: the accent's hover step (owner decision NAV1, blue-700).
func accentActiveClass(ctx context.Context) string {
	return "text-accent-hover"
}

// baseTintClass is `base` as a translucent band (the role matrix's header and footer bands).
func baseTintClass(ctx context.Context, percent int) string {
	if percent == 40 {
		return "bg-bg-base/40"
	}
	return "bg-bg-base/50"
}

// toneInkHoverClass is a tone's ink as a hover: a grey control that turns to the danger ink on hover (CP6).
func toneInkHoverClass(ctx context.Context, tone domain.BadgeTone) string {
	switch tone {
	case domain.ToneInfo:
		return "hover:text-tone-info-ink"
	case domain.ToneGood:
		return "hover:text-tone-good-ink"
	case domain.ToneWarn:
		return "hover:text-tone-warn-ink"
	default:
		return "hover:text-tone-bad-ink"
	}
}

// toneInkFillClass is a tone's ink as a solid fill: a count badge or a rejected step drawn as a filled mark, with
// onFillClass as its text (CP3: the `bad` tone's ink, red-700, in place of red-600 and red-500).
func toneInkFillClass(ctx context.Context, tone domain.BadgeTone) string {
	if tone == domain.ToneGood {
		return "bg-tone-good-ink"
	}
	return "bg-tone-bad-ink"
}

// inkFillHoverClass is the primary fill's hover: `strong` at 90% (CP1), close to the slate-800 it replaced.
func inkFillHoverClass(ctx context.Context) string {
	return "hover:bg-ink-strong/90"
}

// accentEdgeClass and accentEdgeHoverClass are the accent as a soft edge: an unread notification's rim, and the rim a
// clickable card or tile takes on hover (CP3, in place of blue-200/300/400 and one grey).
func accentEdgeClass(ctx context.Context) string {
	return "border-accent/40"
}

func accentEdgeHoverClass(ctx context.Context) string {
	return "hover:border-accent/40"
}

// touchTargetClass grows a small icon control's hit area on a touch screen without changing how it looks: a pseudo-element
// 6px past each edge of the padding box, only under `pointer: coarse`. Measured in Chromium with touch emulation: the pencil
// (no border) is 32px to a finger and the completion circle (a 2px border) 28px; with a fine pointer both stay 20px. WCAG 2.5.8 (AA) asks 24px, and the
// 2026-10-14 audit measured three icon controls under it at 360px (the completion circle on a board card and in a checklist, and
// the card's edit pencil). The control must be `relative`, which this adds. Gap plan K-05, narrowed by that measurement: the
// 36px buttons and fields it first named already clear 24px, and the Design System asks 44px of the compact control alone.
func touchTargetClass() string {
	return "relative pointer-coarse:after:absolute pointer-coarse:after:-inset-1.5"
}

// accentRingClass is the halo around the current step (CP3, in place of blue-100).
func accentRingClass(ctx context.Context) string {
	return "ring-accent/20"
}

// inkClassFromSm is an ink role from the `sm` breakpoint up, for the one breadcrumb whose ink changes with width.
func inkClassFromSm(ctx context.Context, role domain.InkRole) string {
	return "sm:text-ink-strong"
}

// surfaceFromSm is the surface's edge from the `sm` breakpoint up: the More sheet becomes a bordered popover on a wide
// screen (3.2d review: its literal edge stayed grey behind a tinted theme).
func surfaceFromSm(ctx context.Context) string {
	return "sm:border-border-surface"
}

// openSurfaceClasses is a `<details>` popover's surface once open: the surface edge and the raised fill, under `open:`.
func openSurfaceClasses(ctx context.Context) string {
	return "open:border-border-surface open:bg-bg-raised"
}

// raisedTintClass is the raised colour as a translucent dot over a coloured chip (an approver's initials).
func raisedTintClass(ctx context.Context) string {
	return "bg-bg-raised/70"
}

// unreadTintClass is an unread row's tint: the `info` tone's fill at 40% (owner decision CP2).
func unreadTintClass(ctx context.Context) string {
	return "bg-tone-info-bg/40"
}

// markGoodFill, markGoodBorder and markGoodHoverBorder are the Design System artifact's `mark-good` token
// (emerald-600): the solid fill of a "finished" mark. That covers a ticked checklist circle and a progress bar's
// filled share. The artifact accepted it on 2026-10-07 and names it outside `tone-*` on purpose: a tone is a bg+ink
// pair a Workspace can remap through `theme.tone`, and this is one solid colour no Theme key moves. So it is a plain
// reader and **not** a `domain` role. A Workspace that remaps `tone.good` today keeps its marks emerald; making that
// follow would be a Theme decision, not a rename.
//
// Three readers rather than one string, because each is a different utility at its site. The hover form must stay a
// literal here: Tailwind finds classes by reading source text, so `"hover:" + markGoodBorder()` would never emit.
// Measured 2026-10-11: three sites carried these exact strings (checklist, the card checklist, Progress), so moving
// them changes no byte. Five more sites draw a finished mark in emerald-500, the value the artifact rejected for
// contrast (about 2.1:1 on white); those stay as they are until the owner decides, because moving them darkens the
// approval screens. Record: menata-app-document audits/2026-10-11-kajian-sinkron-design-system-kode-css.md, B4.
func markGoodFill() string { return "bg-emerald-600" }

func markGoodBorder() string { return "border-emerald-600" }

func markGoodHoverBorder() string { return "hover:border-emerald-600" }

// scrimClass is the dialog scrim (DK10): `--color-scrim`, slate-900 at 40% in light and black at 60% in dark, where the
// light value barely dimmed the page. backdrop says whether it is a `<dialog>`'s `::backdrop` or an element of its own.
func scrimClass(backdrop bool) string {
	if backdrop {
		return "backdrop:bg-scrim"
	}
	return "bg-scrim"
}

// paperClass and paperInkClass are the PDF paper layer (owner decision DK9): a page image and what is drawn over it
// stay light in both modes, because a document is printed on white. The page PNG is transparent, so the image itself
// carries the white (the 3.3 review found dark text on a dark page without it), and text on a marker over the page reads
// a fixed paper ink rather than a Theme role, which would turn light in dark mode (slate-200 on a pale marker, 1.2:1).
// The marker fills and accents beside them are literal for the same reason (handWrittenColours).
func paperClass() string {
	return "bg-white"
}

func paperInkClass(role domain.InkRole) string {
	if role == domain.InkSecondary {
		return "text-slate-500"
	}
	return "text-slate-700"
}

// htmxErrorToastClasses is the notice htmx shows for a refused request: the `bad` tone's edge, fill and ink, so it
// follows a Workspace's tone and dark mode like every other message. A script clones it from a `<template>` (appShell),
// because a class string written inside a script is one no reader moves.
func htmxErrorToastClasses(ctx context.Context) string {
	return "fixed inset-x-4 bottom-20 z-50 mx-auto max-w-md cursor-pointer border " + radiusClass(ctx, domain.RadiusSurface) + " " + toneEdgeClass(ctx, domain.ToneBad) + " " +
		toneFillClass(ctx, domain.ToneBad) + " px-4 py-3 " + textClass(ctx, domain.RoleBody) + " " + toneInkClass(ctx, domain.ToneBad) + " shadow-lg sm:bottom-6"
}

// draftTileEdgeClass and draftTileInkClass are the generated-draft tile's indigo (DK8: a categorical colour, so a
// property with its own dark step, not a role).
func draftTileEdgeClass() string {
	return "border-draft-edge"
}

// draftTileFillClass is the assistant tile's pale indigo: the draft edge at a fifth of its strength, so it takes the same dark step.
func draftTileFillClass() string {
	return "bg-draft-edge/20"
}

func draftTileInkClass() string {
	return "text-draft-ink"
}

// fileTypeTileClasses is the file-type tile's pair (DK8). PDF is the only type drawn today.
func fileTypeTileClasses() string {
	return "bg-file-pdf-bg text-file-pdf-ink"
}

// controlHeightCompact is the Design System artifact's `control-height-compact`: 32px for a small control inside a row
// (a row's own action links, an icon button, a filter chip). It is accepted with one condition: **mouse only**. On a
// touch screen the target stays 44px (WCAG 2.5.5). That condition is the second half of the string, so a site
// cannot take the height without the touch rule.
//
// It is a plain reader and not a Theme role, for the same reason `control-height` (36px, `h-9`) has none: Theme has
// no height category, and adding one is a decision this slice does not take. It arrived 2026-10-12 with its two
// measured sites, review's View PDF and Download links. Both were 32px on phones too, so on a touch screen they grow to
// 44px; on a mouse nothing moves. The third `h-8` in the tree, the attachment kind tile, is not a control, and stays
// (TestHandWrittenCompactHeightsOnlyShrink).
func controlHeightCompact() string { return "h-8 pointer-coarse:h-11" }

// panelLayout is the bordered, padded surface twelve sites across six screens carried as one identical
// class string -- the only one of §12.2's remaining candidates that is genuinely *one shape*. Three near
// variants (`p-5` twice, a `p-3` div once) are deliberately left alone: forcing them through this would
// change what renders, and a primitive that quietly restyles its callers is worse than a repeated class.
//
// **Measured 2026-10-06: it has one live caller.** The twelve sites above were rewritten into other shapes since
// (the Case 19 restyles), so the panel/section padding difference is one site wide today.
templ panelLayout(density domain.PanelDensity) {
	<section class={ panelClasses(ctx, density) }>
		{ children... }
	</section>
}

// panelClasses is a panel's surface: the 20px section box, or (`density: compact`) the small card with the meta size for its words.
func panelClasses(ctx context.Context, density domain.PanelDensity) string {
	if density == domain.PanelCompact {
		return compactCardClasses(ctx) + " " + textClass(ctx, domain.RoleMeta)
	}
	return surfaceClasses(ctx) + " " + paddingClass(ctx, domain.PaddingPanel)
}

// compactCardClasses is the small card a board column and a calendar day hold (mockups PM01, PM05): the tile's edge and radius, a raised fill and
// 10px by 8px of room. The board's card and a `layout: panel` with `density: compact` both read it, so the two are one recipe, not two literals
// that agree today.
func compactCardClasses(ctx context.Context) string {
	return tileClasses(ctx) + " " + backgroundClass(ctx, domain.BackgroundRaised) + " px-2.5 py-2"
}

// sectionLayout is §12.2's `section`: a bordered, padded surface that stacks its children -- the shape 17
// sites across nine screens carried as one class string, usually holding a heading as their first child
// (21 of 25 measured `<section>` blocks do).
//
// **Same padding as `panelLayout` by default since D6 (owner, 2026-10-07).** They stay two roles
// (`domain.PaddingSection`, `domain.PaddingPanel`) so a Workspace can declare them apart, but both default to
// p-5: the panel's p-4 had no rendered caller left to move, and two steps for one idea inside the token set was
// the harder thing to defend. `domain.LayoutSection` records the argument.
//
// It takes no title parameter. `sectionHeaderRow` (appshell.templ, 9 callers) is the heading half and takes
// a link target; a Layout that accepted one would be a Layout that knows about routes.
templ sectionLayout(gap domain.Gap) {
	@sectionSurface(gap, false, sectionBucket{}) {
		{ children... }
	}
}

// currentSectionLayout is sectionLayout for the one section a group marks as the request's own moment (today's
// day in a week). It keeps the surface's radius, border and padding and takes its fill from the `info` tone's
// palette instead of the raised background, so a Workspace's Theme moves it with the rest; `aria-current="date"`
// is what a screen reader hears. The palette's text colour is deliberately left out (toneFillClass): a section's
// children carry their own ink, and a colour inherited into whichever one does not would be a surprise.
templ currentSectionLayout(gap domain.Gap) {
	@sectionSurface(gap, true, sectionBucket{}) {
		{ children... }
	}
}

// sectionBucket is what makes a section one day of a grouped list: a day added only to fill out a week (`Outside`, drawn quieter and holding nothing)
// and the Field and value a card dropped on it writes (`DropField`, `DropValue`). The zero value is an ordinary section.
type sectionBucket struct {
	Outside              bool
	DropField, DropValue, DropLabel string
}

// bucketSection is a day of a grouped list: the section surface, marked for the move script where a card may be dropped on it.
templ bucketSection(gap domain.Gap, current bool, bucket sectionBucket) {
	@sectionSurface(gap, current, bucket) {
		{ children... }
	}
}

// sectionSurface is the one `<section>` both section layouts draw, so the surface is declared once.
templ sectionSurface(gap domain.Gap, current bool, bucket sectionBucket) {
	<section
		if current {
			aria-current="date"
		}
		if bucket.DropValue != "" {
			data-drop-field={ bucket.DropField }
			data-drop-value={ bucket.DropValue }
			data-drop-label={ bucket.DropLabel }
		}
		class={ "flex-col", templ.KV("flex", !bucket.Outside), templ.KV("hidden sm:flex", bucket.Outside), layoutGap(ctx, gap), radiusClass(ctx, domain.RadiusSurface), "border", borderClass(ctx, domain.BorderSurface), sectionFillClass(ctx, current, bucket.Outside), paddingClass(ctx, domain.PaddingSection) }
	>
		{ children... }
	</section>
}

// sectionFillClass is a section's fill. The current one sits on the `info` tone's fill, where `secondary` ink measures
// 4.38:1 (Chromium audit, 2026-10-14; the pair passes on white and fails on blue-50), and any section child may carry
// secondary ink (a placeholder, a meta line). So inside it `secondary` is the body ink: the property the role classes
// read is redefined for the subtree, which keeps every child's own class and needs no per-child decision.
func sectionFillClass(ctx context.Context, current, outside bool) string {
	switch {
	case current:
		return toneFillClass(ctx, domain.ToneInfo) + " [--color-ink-secondary:var(--color-ink-body)]"
	case outside:
		// A day added only to make a whole week sits on the page's own ground, not raised: it is the window's neighbour, not part of it.
		return backgroundClass(ctx, domain.BackgroundBase)
	}
	return backgroundClass(ctx, domain.BackgroundRaised)
}

// gridColsBelowBreakpoint and gridColsFromBreakpoint are **two switches rather than one**, and each emits a
// class only for a count the corpus measures at that breakpoint: one and two below `sm:`, two, four and
// seven from `sm:` up.
//
// The alternative -- one switch over all four, used at both breakpoints -- reads better and would put three
// utility classes into the shipped bundle that no screen uses. That is not a hypothetical cost. It is
// precisely the defect the first pass of this slice shipped, and the reason the second had to count the
// bundle before counting anything else.
func gridColsBelowBreakpoint(c domain.GridCols) string {
	switch c {
	case domain.GridCols1:
		return "grid-cols-1"
	case domain.GridCols2:
		return "grid-cols-2"
	default:
		return "grid-cols-1"
	}
}

func gridColsFromBreakpoint(c domain.GridCols) string {
	switch c {
	case domain.GridCols2:
		return "sm:grid-cols-2"
	case domain.GridCols4:
		return "sm:grid-cols-4"
	case domain.GridCols7:
		return "sm:grid-cols-7"
	default:
		return "sm:grid-cols-2"
	}
}

// gridLayout is the responsive card grid five screens carried as a hand-written class string: a summary-tile
// strip, a seven-day calendar, two card grids and the Machine `cards` View.
//
// The five differ in exactly two things, a column count and a gap, which is the whole argument for this
// being one primitive. An earlier measurement of mine counted the five class strings, found them all
// different, and concluded there was no shape here -- it had counted *configuration* and called it shape. A
// two-column desktop grid and a four-column one are not two primitives; they are one primitive and two
// arguments.
//
// Class order is `grid`, the mobile count, the gap, then the breakpoint count, which is the order all five
// call sites already wrote. That is why this migration is byte-identical rather than merely equivalent, and
// byte-identical is what let it be verified instead of eyeballed.
templ gridLayout(gap domain.Gap, mobile, columns domain.GridCols) {
	<div class={ "grid", gridColsBelowBreakpoint(mobile), layoutGap(ctx, gap), gridColsFromBreakpoint(columns) }>
		{ children... }
	</div>
}

// splitTracks is **one switch over the (side, width) pair rather than two independent ones**, because
// Tailwind needs the whole track list as a literal class -- a composed string is a class its scanner never
// sees, and the page then renders with no columns at all and nothing fails.
//
// Three of the four combinations are drawn, which are the three the corpus measures. A start-side wide aside
// has no site, so emitting it would put an arbitrary-value class into the bundle for nothing; it falls
// through to the most common combination instead, and
// `TestSplitLayout_unmeasuredCombinationFallsBackRatherThanEmittingANewClass` asserts that rather than
// leaving it to be met as a bug. Every main track is `minmax(0,1fr)`, which is a **deliberate change** to the
// two New Application screens -- see splitLayout's own comment.
func splitTracks(side domain.SplitSide, aside domain.AsideWidth) string {
	switch {
	case side == domain.SplitAsideStart && aside == domain.AsideCompact:
		return "sm:grid-cols-[220px_minmax(0,1fr)]"
	case side == domain.SplitAsideStart && aside == domain.AsideNarrow:
		return "lg:grid-cols-[320px_minmax(0,1fr)]"
	case side == domain.SplitAsideEnd && aside == domain.AsideWide:
		return "lg:grid-cols-[minmax(0,1fr)_360px]"
	default:
		// SplitAsideEnd + AsideNarrow, the most common of the three.
		return "lg:grid-cols-[minmax(0,1fr)_320px]"
	}
}

// splitLayout is §12.2's own `split`: a main area beside a fixed-width aside, stacking to one column below
// `lg`. Five sites -- the submit wizard's approver rail, the review screen's decision panel, the signature
// placement sidebar, and New Application's two preview panes.
//
// **This migration changes what renders on two of the five, and that is the point rather than a side
// effect.** The five asides were 316, 320, 320, 340 and 360 pixels wide. Four distinct widths for one idea is
// not four decisions; naming two steps makes the signature-placement aside 4px wider and the second New
// Application aside 20px wider, and leaves the other three untouched.
//
// **The second change is not cosmetic at all.** Three sites gave the main column `minmax(0,1fr)` and the two
// New Application sites gave it `1fr`. Those differ in behaviour: `minmax(0,1fr)` lets the main column shrink
// below its content's intrinsic width, and `1fr` does not, so wide content there pushes the layout out
// instead of scrolling or wrapping inside it. Both New Application screens render a `<pre>` of generated
// YAML. Normalising to `minmax(0,1fr)` fixes a latent overflow on exactly the two screens most likely to hit
// it -- which is why the inconsistency was worth finding, and why a primitive that has to pick one answer is
// how it got found.
templ splitLayout(gap domain.Gap, side domain.SplitSide, aside domain.AsideWidth) {
	<div class={ "grid grid-cols-1", layoutGap(ctx, gap), splitTracks(side, aside) }>
		{ children... }
	</div>
}

// columnsAlign maps a columns layout's cross-axis alignment, applied only from the breakpoint up.
func columnsAlign(a domain.ColumnsAlign) string {
	switch a {
	case domain.ColumnsAlignEnd:
		return "sm:items-end"
	case domain.ColumnsAlignCenter:
		return "sm:items-center"
	case domain.ColumnsAlignStart:
		return "sm:items-start"
	default:
		return "sm:items-center"
	}
}

// columnsLayout is §12.2's `columns`: different content per column on desktop, one stack on a phone.
//
// Five sites, all of them a heading or label beside its own action -- Workspace Members and Groups page
// headers, the inbox header, two role rows. The three further `sm:flex-row` sites that did **not** migrate are
// list rows carrying `border-b`/padding, which is `Collection`'s item shape rather than a bare columns, and one
// panel that becomes columns; naming why is what stops the next reader forcing them through this and
// restyling them.
//
// `sm:justify-between` is not a parameter because all five use it. A closed set with one member is a constant
// wearing an enum's clothes.
templ columnsLayout(gap domain.Gap, align domain.ColumnsAlign) {
	<div class={ "flex flex-col", layoutGap(ctx, gap), "sm:flex-row", columnsAlign(align), "sm:justify-between" }>
		{ children... }
	</div>
}

// collection is the registered renderer for `domain.ComponentCollection` -- §12.3's `Collection`, and the
// first Component here with a slot (§12.5). Items arrive **already composed**, one `templ.Component` each,
// which is what lets one list serve 21 different row shapes without the Component knowing any of them.
//
// **The two class strings are measured, not chosen.** `taskRowList` and `activityFeedListRow` were
// structurally identical and used exactly `flex flex-col gap-2` on the `<ul>` and
// `flex flex-wrap items-center gap-2 text-sm` on the `<li>` -- 2 of 2, so this is the shape rather than a
// preference. `text-sm` on the item wrapper is typography inside a Component, which is the same thing that
// kept seven `row` sites hand-written; it is accepted here only because both measured callers agree on it,
// and it is the first thing to revisit when a third caller does not.
//
// A real `<ul>`/`<li>` rather than divs: the list and its length are then announced without an explicit
// role, which is what the contract's accessibility clause records.
//
// `empty` is what to say when there are no items: the words are drawn as a `message` in place of an empty
// `<ul>`. "" keeps the old behaviour (an empty list), which the two hand-written callers rely on because they
// say it themselves.
//
// `ordered` draws an `<ol>` and a leading position number per item (Board Settings' lists: position is the content,
// "the order here is the order of the columns"). The number is `aria-hidden` because `<ol>` already announces
// position; it is typography through two Theme roles (`meta`, `faint`), `w-5` keeps the items aligned past
// nine, and it is counted by the renderer, so a page names no number.
//
// `divided` draws the items as rows of one surface, a rule between neighbours, instead of floating apart: the
// shape every mockup list (Board Settings' Lists and Labels) has. The surface is `surfaceClasses` and the rule
// reads the `divider` border role, so both follow the Workspace's theme; no gap separates the rows, because the
// rule does. `gap` still sets the space inside a row, between its own parts.
//
// `truncated` is the bound that cut the list short, drawn after it by the same `truncationNotice` the
// hand-written lists use, so a bound reads one way on every screen. It is the zero value for every list that
// did not claim completeness (or was not cut), and `truncationNotice` draws nothing for it.
func truncationFromProp(limit string) Truncation {
	limit, total, _ := strings.Cut(limit, "/")
	n, err := strconv.Atoi(limit)
	if err != nil || n <= 0 {
		return Truncation{}
	}
	t := Truncation{Limit: n, Hit: true}
	if m, err := strconv.Atoi(total); err == nil && m > n {
		t.Total = m
	}
	return t
}

templ collection(gap domain.Gap, empty string, ordered bool, divided bool, block bool, inline bool, density domain.ListDensity, truncated Truncation, heading string, hint string, items []templ.Component, move_routes []string) {
	if heading != "" {
		@stackLayout(domain.GapTight) {
			@collectionHeading(heading, hint, len(items))
			@collectionBody(gap, empty, ordered, divided, block, inline, density, items, move_routes)
			@truncationNotice(truncated)
		}
	} else {
		@collectionBody(gap, empty, ordered, divided, block, inline, density, items, move_routes)
		@truncationNotice(truncated)
	}
}

// listRowPadding is a divided Collection row's padding for each declared density: whole literal strings, as the scanner needs.
func listRowPadding(density domain.ListDensity) string {
	if density == domain.ListRoomy {
		return "px-5 py-3.5"
	}
	return "px-4 py-3"
}

// collectionHeading is a section's title row: the heading, how many items sit under it, and an optional qualifier.
// The count is the number of items drawn -- what the reader can check by counting -- and a list cut short says so in
// its truncation notice rather than here.
templ collectionHeading(heading string, hint string, count int) {
	@rowLayout(domain.GapTight, domain.RowAlignCenter, domain.RowJustifyStart) {
		@staticText(domain.StaticPanelHeading, heading)
		@statusBadge(strconv.Itoa(count), domain.ToneNeutral, domain.BadgeCompact)
		if hint != "" {
			@staticText(domain.StaticNote, hint)
		}
	}
}

templ collectionBody(gap domain.Gap, empty string, ordered bool, divided bool, block bool, inline bool, density domain.ListDensity, items []templ.Component, move_routes []string) {
	if len(items) == 0 && empty != "" {
		@staticText(domain.StaticMessage, empty)
	} else if divided && ordered {
		<ol
			if reorderRoutes(move_routes) {
				data-reorder-over={ "ring-2 " + accentRingClass(ctx) + " " + accentEdgeClass(ctx) }
			}
			class={ "m-0 list-none overflow-hidden p-0", surfaceClasses(ctx) }
		>
			for i, it := range items {
				<li
					if reorderRoute(move_routes, i) != "" {
						data-reorder-url={ reorderRoute(move_routes, i) }
					}
					class={ "flex flex-wrap items-center", layoutGap(ctx, gap), "border-b", borderClass(ctx, domain.BorderDivider), listRowPadding(density), textClass(ctx, domain.RoleBody), "last:border-b-0" }
				>
					if reorderRoute(move_routes, i) != "" {
						// The grip is the one place a row is picked up from (script: `reorderScript`); a row with no route is one this viewer may not move.
						<span data-reorder-grip role="button" tabindex="0" aria-label="Move this row" class={ "grid cursor-grab place-items-center", inkClass(ctx, domain.InkFaint), inkHoverClass(ctx, domain.InkBody), touchTargetClass() }>
							@icon("grip", "size-4")
						</span>
					}
					<span class={ "grid size-5.5 shrink-0 place-items-center", radiusClass(ctx, domain.RadiusControl), backgroundClass(ctx, domain.BackgroundSunken), textClass(ctx, domain.RoleLabel), inkClass(ctx, domain.InkBody) } aria-hidden="true">{ strconv.Itoa(i + 1) }</span>
					@it
				</li>
			}
		</ol>
		if reorderRoutes(move_routes) {
			@reorderScript()
		}
	} else if divided {
		<ul class={ "m-0 list-none overflow-hidden p-0", surfaceClasses(ctx) }>
			for _, it := range items {
				<li class={ "relative", templ.KV("flex flex-col", block), templ.KV("flex flex-wrap items-center", !block), layoutGap(ctx, gap), "border-b", borderClass(ctx, domain.BorderDivider), listRowPadding(density), textClass(ctx, domain.RoleBody), "last:border-b-0" }>
					@it
				</li>
			}
		</ul>
	} else if ordered {
		<ol class={ "m-0 flex list-none flex-col p-0", layoutGap(ctx, gap) }>
			for i, it := range items {
				<li class={ "flex flex-wrap items-center", layoutGap(ctx, gap), textClass(ctx, domain.RoleBody) }>
					<span class={ "w-5", textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkFaint) } aria-hidden="true">{ strconv.Itoa(i + 1) }</span>
					@it
				</li>
			}
		</ol>
	} else if inline {
		// `inline` is a run of short items laid side by side and wrapping (a row of chips), not a column: each item is one inline part.
		<ul class={ "m-0 flex list-none flex-wrap items-center p-0", layoutGap(ctx, gap) }>
			for _, it := range items {
				<li class={ textClass(ctx, domain.RoleBody) }>
					@it
				</li>
			}
		</ul>
	} else {
		<ul class={ "flex flex-col", layoutGap(ctx, gap) }>
			for _, it := range items {
				// `block` is an item that is one block filling the width (a record's whole screen), not a run of inline
				// parts that wrap: a column, so what it holds stretches instead of shrinking to its content.
				<li class={ templ.KV("flex flex-col", block), templ.KV("flex flex-wrap items-center", !block), layoutGap(ctx, gap), textClass(ctx, domain.RoleBody) }>
					@it
				</li>
			}
		</ul>
	}
}

// rowAlign and rowJustify map the two flexbox axes. Both return "" for their default member, and
// `RowAlignStretch`/`RowJustifyStart` are named in their switches rather than left to the fallthrough, because
// the vocabulary gate reads which members a renderer *names* -- one reachable only through a default arm is
// indistinguishable from one nothing draws.
//
// **rowClasses joins them in Go rather than handing templ a list**, which is not a style choice. templ's
// `class={ a, b, c }` does not drop an empty value, it emits a **double space** -- measured, not assumed, by
// rendering the three combinations before writing the call sites. Eighteen of the 24 migrated sites pass at
// least one default, so the list form would have left eighteen screens differing from their baseline by a
// space that no one would ever look for.
func rowAlign(a domain.RowAlign) string {
	switch a {
	case domain.RowAlignCenter:
		return "items-center"
	case domain.RowAlignStretch:
		return ""
	default:
		return ""
	}
}

func rowJustify(j domain.RowJustify) string {
	switch j {
	case domain.RowJustifySpread:
		return "justify-between"
	case domain.RowJustifyStart:
		return ""
	default:
		return ""
	}
}

// rowLayout is horizontal flow that wraps -- the second most common shape in the corpus after `stack`, and the
// last of §12.2's measured-in-use primitives to be built.
//
// **22 of its 33 sites migrate, and the other eleven are a floor rather than debt**, in three kinds (nine remain
// after later migrations; `handWrittenLayoutSites` in `internal/conformance` reads each of them by name):
//
//   - **seven carry non-layout classes on the same element** -- typography (`text-sm`, `text-3xs
//     a mid-grey ink), decoration (`border-b … pb-1.5`) or sizing (`sm:w-32`). Absorbing them would mean this
//     primitive accepting a CSS class string, which is 007 §15.2's prohibition with different syntax and
//     §12.3's "arbitrary properties" with the same one. A primitive taking `textClass string` is a `<div>`
//     with extra steps.
//   - **two want an asymmetric column/row gap** the single `Gap` ladder cannot express, and inventing a second
//     ladder for two sites would be shape-before-need.
//   - **two are not a `<div>`** -- one `<form>`, one `<span>`. This is the only one of the three that is a real
//     missing capability rather than a boundary: nothing lets a caller choose the element, and changing it
//     would break the form's submission and nest a block inside an inline context. The primitive that answers
//     it is §12.5 Slot or a Component with a declared element, which is Stage 2.
//
// Three further sites *did* migrate by **nesting**: `approvalinbox`'s filter groups keep `role="group"` and
// their `aria-label` on a wrapper with the row inside, for the same reason `signatureplacement` keeps its htmx
// wiring outside `splitLayout`. Accessibility semantics are not layout, and separating them is how a declared
// Page would express the pair anyway. Cost: three extra DOM nodes.
//
// Of the 22, **five render two pixels differently**: they used a gap one and a half steps wide, which folds
// into `GapTight`. `domain.Gap` records why that was the right call rather than declaring a half-step.
templ rowLayout(gap domain.Gap, align domain.RowAlign, justify domain.RowJustify) {
	<div class={ rowClasses(ctx, gap, align, justify) }>
		{ children... }
	</div>
}

// rowNoWrapLayout is a row whose children stay on one line (`wrap: nowrap`): the same classes with `flex-nowrap` for `flex-wrap`, and `min-w-0` children
// so a title beside a circle wraps within its own column.
templ rowNoWrapLayout(gap domain.Gap, align domain.RowAlign, justify domain.RowJustify) {
	<div class={ strings.Replace(rowClasses(ctx, gap, align, justify), "flex-wrap", "flex-nowrap", 1), "[&>*]:min-w-0" }>
		{ children... }
	</div>
}

// rowClasses is the join described above rowAlign: `flex flex-wrap`, then each axis that is not its default,
// then the gap -- the order all 24 call sites already wrote.
func rowClasses(ctx context.Context, gap domain.Gap, align domain.RowAlign, justify domain.RowJustify) string {
	parts := []string{"flex flex-wrap"}
	for _, c := range []string{rowAlign(align), rowJustify(justify), layoutGap(ctx, gap)} {
		if c != "" {
			parts = append(parts, c)
		}
	}
	return strings.Join(parts, " ")
}

// rowTrackClasses is the box a column of a row with `tracks:` draws around its child, a whole literal string for each step (the scanner
// reads this file's text). The two fixed columns are fixed only from `sm` up. On a phone a row is one line (it declares `wrap: nowrap`;
// one that wrapped put the icon, the name and the chevron on three lines, measured at 390px, 2026-10-22) and the badge keeps its own
// width. The `field` stays in the flow: put it in a `layout: columns` with the name and the columns stack it under the name on a phone
// (the mockup's phone row) and set it in its own column from `sm` up.
func rowTrackClasses(track domain.RowTrack) string {
	switch track {
	case domain.TrackFit:
		return "shrink-0"
	case domain.TrackField:
		return "min-w-0 sm:ml-2 sm:w-42 sm:shrink-0"
	case domain.TrackBadge:
		return "flex shrink-0 sm:w-30 sm:justify-end"
	default:
		return "min-w-0 grow"
	}
}

// rowMark is what a row draws after its last child (domain.RowMark): the disclosure chevron of a row that is a link. Nothing for no mark.
templ rowMark(mark domain.RowMark) {
	if mark == domain.MarkChevron {
		@rowChevron()
	}
}

// rowChevron is the chevron at the end of a row that opens something, in the faint ink: one drawing for the rows a `page:` declares and
// the rows Go still draws (settings, the launcher, the application menu's sheet), which had each written the same span.
templ rowChevron() {
	<span aria-hidden="true" class={ "shrink-0", inkClass(ctx, domain.InkFaint) }>
		@icon("chevron-right", "size-4")
	</span>
}

// dividerClasses is the one drawing of a thin rule: 1px tall, in the divider edge role as a fill. The `static: divider` node, and the
// separators inside the shell's menus and sheets, draw it; each menu site adds the margin its own geometry wants.
func dividerClasses(ctx context.Context) string {
	return "h-px " + borderFillClass(ctx, domain.BorderDivider)
}

// staticText renders one §12.6 static content node. Text arrives already resolved -- this function does
// not read metadata, derive a heading, or fall back; `titleByID`/`descriptionByID` and
// `domain.ResolveNavigationHeadings` own that, and a renderer that resolved its own content is the
// render-time inference removed on 2026-10-02.
templ staticText(kind domain.StaticKind, text string) {
	switch kind {
		case domain.StaticEyebrow:
			<span class={ textClass(ctx, domain.RoleEyebrow), "tracking-wide", inkClass(ctx, domain.InkAccent), "uppercase" }>{ text }</span>
		case domain.StaticHeading:
			<h1 class={ "m-0", textClass(ctx, domain.RoleHeading), weightClass(ctx, domain.WeightEmphasis) }>{ text }</h1>
		case domain.StaticParagraph:
			<div class={ textClass(ctx, domain.RoleBody), inkClass(ctx, domain.InkSecondary) }>{ text }</div>
		case domain.StaticOverline:
			<span class={ textClass(ctx, domain.RoleEyebrow), "tracking-wide", inkClass(ctx, domain.InkSecondary), "uppercase" }>{ text }</span>
		case domain.StaticPanelHeading:
			<h2 class={ "m-0", textClass(ctx, domain.RoleBody), weightClass(ctx, domain.WeightEmphasis) }>{ text }</h2>
		case domain.StaticDivider:
			<hr class={ "m-0 border-0", dividerClasses(ctx) }/>
		case domain.StaticCaption:
			<p class={ "m-0", textClass(ctx, domain.RoleCaption), inkClass(ctx, domain.InkSecondary) }>{ text }</p>
		case domain.StaticCode:
			<pre class={ "m-0 overflow-x-auto whitespace-pre-wrap", textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkBody) }>{ text }</pre>
		case domain.StaticSubheading:
			<h2 class={ "m-0", textClass(ctx, domain.RoleSubheading), weightClass(ctx, domain.WeightEmphasis) }>{ text }</h2>
		case domain.StaticMessage:
			<p class={ "m-0", textClass(ctx, domain.RoleBody), inkClass(ctx, domain.InkSecondary) }>{ text }</p>
		case domain.StaticNote:
			<p class={ "m-0", textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkSecondary) }>{ text }</p>
	}
}

// staticLink draws `domain.StaticLink` -- §12.6's `link`, and the only Static Content node that needs a
// destination as well as text.
//
// Separate from `staticText` rather than a fourth case in it, because that function takes only text and a
// link needs an href. The href arrives **already resolved**: callers pass `routeByID(...)` or a view model's
// own field, so this never looks a route up and stays as route-free as the Layout primitives beside it.
//
// **It only works in child position, and templ fails silently when it is not.** Three of the eight sites this
// migration tried were `<a>` inline inside a text run ("Don't have one? <a>Create a workspace</a>"), and templ
// renders `@staticLink(...)` there as **literal text** -- no error, no warning, the string `@staticLink("/register",
// "Create a workspace")` printed into the page. Caught only by the byte-diff; the build was green and the
// conformance suite passed. Those three were reverted and stay hand-written.
//
// `templ.URL` rather than `templ.SafeURL`: the sanitising one. Two migrated sites used `SafeURL` to bypass
// it; for internal routes the output is identical, and the byte-diff is what proved that rather than the
// assumption.
templ staticLink(href, text string) {
	if href == "" {
		// A link whose destination came to nothing (a record's `link` role the runtime refused to hand over) is its words.
		<span>{ text }</span>
	} else {
		<a href={ templ.URL(href) } class={ inkClass(ctx, domain.InkAccent), accentHoverClass(ctx) }>{ text }</a>
	}
}

// pageHeader is the primitives' first consumer: the heading / subtitle block that **eleven** screens carried as
// five identical lines each. It carried the Application's name as an eyebrow too, until the owner dropped it
// (2026-10-18): the application bar beside the menu already names the Application, and no mockup draws it.
//
// Both strings are already declarations -- the navigation item's `title:` and `description:` -- so this
// composes rather than decides. The subtitle is omitted when no
// description is declared, which is the guard `approvalinbox.templ` established and the seven Stage 0.5
// migrations adopted: an absent declaration must render nothing, not an empty styled element.
//
// **What it does not do**: it is not declared in metadata. A screen's *body* is what Stage 2 makes
// declarable, because a body needs a bounded Component (§12.3) -- "a panel per rule, each with a heading
// and three labelled values" is beyond Layout and Static Content, and pretending otherwise would be the
// unbounded `GenericComponent` §12.3 forbids by name.
templ pageHeader(navID string) {
	@uiNode(headerTree(titleByID(ctx, navID), descriptionByID(ctx, navID)))
}

// headerTree builds the header block as **UI IR** rather than as templ structure -- the first screen content
// in this runtime expressed as data (007 §15, §15.1's `Build UI IR` stage).
//
// Eight screens call `pageHeader`, and until now its composition was Go: a `stackLayout` holding three
// `staticText` calls. Every value in it was already a declaration (the Application's `name:`, the navigation
// item's `title:` and `description:`), so what was left hardcoded was only the *shape* -- which is 001 #3
// inverted, and which 007 §12.4 calls a breach of a normative rule when multiplied across 38 screens.
//
// **It is a small tree on purpose.** §24 prescribes *progressive* lowering, and a first lowering whose output
// can be diffed byte-for-byte against eight live screens is worth more than a large one that cannot. The
// subtitle node is omitted rather than emptied when no description is declared -- the same guard the templ
// version had, now a property of the tree.
func headerTree(title, description string) ir.UINode {
	children := []ir.UINode{
		{Kind: ir.NodeStatic, Type: string(domain.StaticHeading), Props: map[string]string{"text": title}},
	}
	if description != "" {
		children = append(children, ir.UINode{
			Kind: ir.NodeStatic, Type: string(domain.StaticParagraph),
			Props: map[string]string{"text": description},
		})
	}
	return ir.UINode{
		Kind:     ir.NodeLayout,
		Type:     string(domain.LayoutStack),
		Identity: "page_header",
		Props:    map[string]string{"gap": string(domain.GapTight)},
		Children: children,
	}
}

// uiLayout draws one Layout node through the primitives. A node that carries an `anchor` is wrapped by uiNode in one
// element that holds the id (the target of a `#fragment` link), so no primitive accepts an arbitrary attribute.
templ uiLayout(n ir.UINode) {
	switch domain.LayoutKind(n.Type) {
		case domain.LayoutStack:
			if n.Props[ir.StackMoveProp] != "" {
				// A card the viewer may move: one element that says where its patch goes, for the move script (no primitive takes an arbitrary attribute).
				<div data-move-url={ n.Props[ir.StackMoveProp] } draggable="true" class="cursor-grab">
					@stackLayout(domain.Gap(n.Props["gap"])) {
						@uiChildren(n)
					}
				</div>
			} else {
				@stackLayout(domain.Gap(n.Props["gap"])) {
					@uiChildren(n)
				}
			}
		case domain.LayoutPanel:
			@panelLayout(domain.PanelDensity(n.Props["density"])) {
				@uiChildren(n)
			}
		case domain.LayoutSection:
			if n.Props[ir.SectionDropValueProp] != "" || n.Props[ir.SectionOutsideProp] == "true" {
				@bucketSection(domain.Gap(n.Props["gap"]), n.Props[ir.SectionCurrentProp] == "true", sectionBucket{Outside: n.Props[ir.SectionOutsideProp] == "true", DropField: n.Props[ir.SectionDropFieldProp], DropValue: n.Props[ir.SectionDropValueProp], DropLabel: n.Props[ir.SectionLabelProp]}) {
					@uiChildren(n)
				}
			} else if n.Props[ir.SectionCurrentProp] == "true" {
				@currentSectionLayout(domain.Gap(n.Props["gap"])) {
					@uiChildren(n)
				}
			} else {
				@sectionLayout(domain.Gap(n.Props["gap"])) {
					@uiChildren(n)
				}
			}
		case domain.LayoutColumns:
			@columnsLayout(domain.Gap(n.Props["gap"]), domain.ColumnsAlign(n.Props["align"])) {
				@uiChildren(n)
			}
		case domain.LayoutRow:
			if domain.RowWrap(n.Props["wrap"]) == domain.RowNoWrap {
				@rowNoWrapLayout(domain.Gap(n.Props["gap"]), domain.RowAlign(n.Props["align"]), domain.RowJustify(n.Props["justify"])) {
					@uiChildren(n)
					@rowMark(domain.RowMark(n.Props["mark"]))
				}
			} else {
				@rowLayout(domain.Gap(n.Props["gap"]), domain.RowAlign(n.Props["align"]), domain.RowJustify(n.Props["justify"])) {
					@uiChildren(n)
					@rowMark(domain.RowMark(n.Props["mark"]))
				}
			}
		case domain.LayoutGrid:
			@gridLayout(domain.Gap(n.Props["gap"]), gridColsFromProp(n.Props["mobile"]), gridColsFromProp(n.Props["columns"])) {
				@uiChildren(n)
			}
		case domain.LayoutSplit:
			@splitLayout(domain.Gap(n.Props["gap"]), domain.SplitSide(n.Props["side"]), domain.AsideWidth(n.Props["aside"])) {
				@uiChildren(n)
			}
	}
}

// uiNode walks a UI IR tree and draws it through the primitives already registered.
//
// **It has no per-screen branch and cannot acquire anything.** Every value it draws arrives in `Props`,
// already resolved; the walker's whole job is dispatch on a closed kind. An unknown kind renders nothing
// rather than guessing, and `ir.Validate` is what refuses one before it gets here -- which is the division
// §15.3 states ("the compiler MUST reject") and the reason the walker stays this small.
templ uiNode(n ir.UINode) {
	if n.Track != "" {
		// A child of a row that declares `tracks:` keeps its column; the column is a box around the child, so the child itself is drawn as it always is.
		<div class={ rowTrackClasses(n.Track) }>
			@uiNodeBody(n)
		</div>
	} else if n.Props[ir.SpanProp] == "all" {
		// A notice about a grid, not one of its cells: it takes the whole row, whatever the column count at this width.
		<div class="col-span-full">
			@uiNodeBody(n)
		</div>
	} else {
		@uiNodeBody(n)
	}
}

// uiNodeBody is uiNode's dispatch on a closed kind: split off so the one wrapper above is not repeated in every branch.
templ uiNodeBody(n ir.UINode) {
	switch n.Kind {
		case ir.NodeLayout:
			if n.Props["anchor"] != "" {
				<div id={ n.Props["anchor"] }>
					@uiLayout(n)
				</div>
			} else {
				@uiLayout(n)
			}
		case ir.NodeStatic:
			switch domain.StaticKind(n.Type) {
				case domain.StaticLink:
					if v := domain.ButtonVariant(n.Props["variant"]); v == domain.LinkQuiet && n.Props["href"] != "" {
						@quietLink(n.Props["href"], n.Props["text"])
					} else if v == domain.LinkPlain && n.Props["href"] != "" {
						@plainLink(n.Props["href"], n.Props["text"])
					} else if v == domain.LinkRow && n.Props["href"] != "" {
						@rowLink(n.Props["href"], n.Props["text"])
					} else if v == domain.LinkChip && n.Props["href"] != "" {
						@chipLink(n.Props["href"], n.Props["text"])
					} else if v == "" && n.Props["icon"] != "" && n.Props["href"] != "" {
						@iconTextLink(n.Props["href"], n.Props["text"], n.Props["icon"])
					} else if v != "" && n.Props["icon"] != "" && n.Props["href"] != "" {
						@iconLinkButton(n.Props["text"], n.Props["href"], n.Props["icon"], v)
					} else if v != "" && n.Props["href"] != "" {
						@linkButton(n.Props["text"], n.Props["href"], v)
					} else {
						@staticLink(n.Props["href"], n.Props["text"])
					}
				default:
					if n.Props["tone"] != "" && domain.StaticKind(n.Type) == domain.StaticParagraph {
						// Words in a tone's ink with no badge around them: a date that is overdue, one that is finished.
						<div class={ textClass(ctx, domain.RoleBody), toneInkClass(ctx, domain.BadgeTone(n.Props["tone"])) }>{ n.Props["text"] }</div>
					} else {
						@staticText(domain.StaticKind(n.Type), n.Props["text"])
					}
			}
		case ir.NodeComponent:
			switch domain.ComponentType(n.Type) {
				case domain.ComponentStatusBadge:
					@statusBadge(n.Props["label"], domain.BadgeTone(n.Props["tone"]), domain.BadgeSize(n.Props["size"]))
				case domain.ComponentField:
					@field(n.Props["for"], n.Props["label"], n.Props["note"], n.Props["flag"]) {
						@uiChildren(n)
					}
				case domain.ComponentCollection:
					@collection(domain.Gap(n.Props["gap"]), n.Props["empty"], n.Props["ordered"] == "true", n.Props["divided"] == "true", n.Props["block"] == "true", n.Props["inline"] == "true", domain.ListDensity(n.Props["density"]), truncationFromProp(n.Props["truncated"]), n.Props["heading"], n.Props["hint"], uiChildComponents(n), strings.Fields(n.Props[ir.CollectionMoveRoutesProp]))
				case domain.ComponentTree:
					@tree(n.Props["label"], n.Props["query"], n.Props["empty"], n.Props["outline"], uiChildComponents(n))
				case domain.ComponentMetric:
					@metric(n.Props["label"], n.Props["value"], n.Props["hint"], n.Props["href"], domain.BadgeTone(n.Props["tone"]))
				case domain.ComponentAvatar:
					@avatar(n.Props["initials"], n.Props["label"], domain.AvatarSize(n.Props["size"]), domain.AvatarPresence(n.Props["presence"]))
				case domain.ComponentIconTile:
					@iconTile(n.Props["icon"], n.Props["color"], domain.TileSize(n.Props["size"]), domain.TileState(n.Props["state"]))
				case domain.ComponentButton:
					@requestButton(n.Props["label"], domain.ButtonVariant(n.Props["variant"]), n.Props["name"], n.Props["value"], n.Props["action"], n.Props["method"], n.Props["confirm"], n.Props["describes"])
				case domain.ComponentTag:
					@tagChip(n.Props["label"], domain.TagColor(n.Props["color"]))
				case domain.ComponentToggle:
					@toggle(n.Props["describes"], n.Props["checked"] == "true", n.Props["action"], n.Props["name"], n.Props["value"])
				case domain.ComponentForm:
					@form(n.Props["submit"], n.Props["action"], n.Props["method"], n.Props["multipart"] == "true", n.Props["carries"], n.Props["then"]) {
						@uiChildren(n)
					}
				case domain.ComponentProgress:
					@progressRow(n.Props["label"], n.Props["value"], n.Props["max"], n.Props["size"])
				case domain.ComponentCallout:
					@callout(n.Props["text"], domain.BadgeTone(n.Props["tone"]))
				case domain.ComponentEmptyState:
					@emptyState(n.Props["text"])
				case domain.ComponentDisclosure:
					@disclosure(n.Props["summary"]) {
						@uiChildren(n)
					}
				case domain.ComponentSegmentedControl:
					@segmentedControl(n.Props["label"], n.Props["query"], n.Props["options"], n.Props["selected"], n.Props["keep"])
				case domain.ComponentPopover:
					@popover(n.Props["label"], n.Props["title"], domain.PopoverTrigger(n.Props["trigger"]), domain.PopoverAlign(n.Props["align"]), domain.PopoverDensity(n.Props["density"])) {
						@uiChildren(n)
					}
				case domain.ComponentDiff:
					@diffView(n.Props["label"], n.Props["text"])
				case domain.ComponentSearchBox:
					@searchField(n.Props["label"], n.Props["query"], n.Props["placeholder"], n.Props["value"], n.Props["action"], n.Props["submit"], n.Props["keep"])
				case domain.ComponentStepper:
					@stepper(n.Props["label"], n.Props["steps"])
				case domain.ComponentActionBar:
					@actionBar(n.Props["label"]) {
						@uiChildren(n)
					}
				case domain.ComponentFilterChips:
					@filterChips(n.Props["label"], n.Props["chips"])
				case domain.ComponentFilterSelect:
					@filterSelect(n.Props["label"], n.Props["query"], n.Props["all"], n.Props["choices"], n.Props["selected"], n.Props["keep"])
				case domain.ComponentNavList:
					@navList(n.Props["label"], n.Props["variant"], n.Props["home"], n.Props["rows"])
				case domain.ComponentTable:
					@table(n.Props["label"], n.Props["empty"], n.Props["headers"], n.Props["aligns"], n.Props["hidden"], n.Props["framed"] == "true", truncationFromProp(n.Props["truncated"]), n.Props["footer"], uiChildComponents(n))
				case domain.ComponentFormInput:
					@formInput(n.Props["id"], n.Props["name"], n.Props["kind"], n.Props["options"], n.Props["value"], n.Props["label"], n.Props["required"] == "true", n.Props["fixed"] == "true", n.Props["money"] == "true")
			}
	}
}

// uiChildComponents turns a node's children into one composed component each, for a slotted Component that
// takes them as values rather than as `{ children... }`.
func uiChildComponents(n ir.UINode) []templ.Component {
	out := make([]templ.Component, 0, len(n.Children))
	for _, c := range n.Children {
		out = append(out, uiNode(c))
	}
	return out
}

// uiChildren walks a node's subtree. Extracted so each Layout arm above is one line -- five arms repeating a
// four-line loop is how a dispatch table starts drifting between its own cases.
templ uiChildren(n ir.UINode) {
	for _, c := range n.Children {
		@uiNode(c)
	}
}

// gridColsFromProp reads a column count off a resolved property.
//
// It is a **closed** parse, not `strconv.Atoi`: a count outside `domain.KnownGridCols` falls back rather than
// becoming a class Tailwind never scanned. `ir.Validate` is what refuses a bad tree; this is the second line
// of defence for a tree that reached the renderer anyway.
func gridColsFromProp(v string) domain.GridCols {
	for c := range domain.KnownGridCols {
		if strconv.Itoa(int(c)) == v {
			return c
		}
	}
	return domain.GridCols1
}

// appIconClasses maps a declared colour token to the icon tile's classes.
//
// TWO THINGS ABOUT THIS FUNCTION ARE LOAD-BEARING, and neither is style preference.
//
// It lives in a .templ file because static/css/input.css scans `internal/rendering/*.templ` and
// nothing else -- a Tailwind class string in a .go file, *including a .go file in this very
// package*, is invisible to the scanner and silently never reaches app.css.
//
// It returns whole literal strings rather than building "bg-" + color + "-50", for the same
// reason: the scanner reads source text, so a name assembled at runtime is never emitted. Both
// failures show up as missing styling in a browser, never as a build error -- which is why
// domain.KnownApplicationColors is a closed set that must be extended here in step.
func appIconClasses(color string) string {
	switch color {
	// Each pair is a property, `--color-app-<colour>-bg|ink` (owner decision DK8, 2026-10-13), so dark mode gives it
	// its own steps; input.css holds both.
	case "blue":
		return "bg-app-blue-bg text-app-blue-ink"
	case "emerald":
		return "bg-app-emerald-bg text-app-emerald-ink"
	case "amber":
		return "bg-app-amber-bg text-app-amber-ink"
	default:
		return "bg-app-slate-bg text-app-slate-ink"
	}
}

// iconTileSizeClasses is a tile's box and corner for each declared step, and the icon's own size inside it. Whole literal strings
// per case, for the reason appIconClasses records: the scanner reads this file's text, so a name assembled at runtime never
// reaches app.css. `compact` keeps the control corner it was drawn with; the other three were `rounded-lg`.
func iconTileSizeClasses(ctx context.Context, size domain.TileSize) (box, glyph string) {
	switch size {
	case domain.TileCompact:
		return "flex size-6 shrink-0 items-center justify-center " + radiusClass(ctx, domain.RadiusControl), "size-3.5"
	case domain.TileInline:
		return "flex size-8 shrink-0 items-center justify-center rounded-lg", "size-4.5"
	case domain.TileLead:
		return "flex size-10 shrink-0 items-center justify-center rounded-lg", "size-4.5"
	default:
		return "flex size-9 shrink-0 items-center justify-center rounded-lg", "size-5"
	}
}

// iconTile is the registered renderer for `domain.ComponentIconTile` (007 §12.3): one icon of `domain.KnownIcons` in a square on
// an Application's tint. A `draft` is the dashed outline of an Application nobody has published and the `assistant` state the assistant's own solid tile, both in the generated-draft indigo.
// It is decoration, so it is hidden from assistive technology: the Application's name is drawn beside it.
templ iconTile(iconName, color string, size domain.TileSize, state domain.TileState) {
	{{ box, glyph := iconTileSizeClasses(ctx, size) }}
	switch state {
		case domain.TileDraft:
			<span aria-hidden="true" class={ box, "border border-dashed", draftTileEdgeClass(), draftTileInkClass(), backgroundClass(ctx, domain.BackgroundRaised) }>
				@icon(iconName, glyph)
			</span>
		case domain.TileAssistant:
			<span aria-hidden="true" class={ box, draftTileFillClass(), draftTileInkClass() }>
				@icon(iconName, glyph)
			</span>
		default:
			<span aria-hidden="true" class={ box, appIconClasses(color) }>
				@icon(iconName, glyph)
			</span>
	}
}

func pluralS(n int) string {
	if n == 1 {
		return ""
	}
	return "s"
}

func displayRole(role string) string {
	if role == "" {
		return "—"
	}
	return role
}

// reorderRoute is row i's record route when this viewer may drag it, and "" for a row with no grip (a "-" entry, or a list that is not reorderable).
func reorderRoute(move_routes []string, i int) string {
	if i >= len(move_routes) || move_routes[i] == "-" {
		return ""
	}
	return move_routes[i]
}

// reorderRoutes is whether any row of the list can be dragged, so the script is on the page only where it has something to act on.
func reorderRoutes(move_routes []string) bool {
	for i := range move_routes {
		if reorderRoute(move_routes, i) != "" {
			return true
		}
	}
	return false
}

// reorderScript moves a row of a reorderable list: pick it up by its grip and drop it on another row, or press Up or Down while the grip has focus.
// Either ends in the one POST of the record's generic move route (`?to=<place>` for a drop, `?direction=` for a key), whose answer to a declared page
// is a refresh -- nothing is moved in the DOM, so the page that comes back is the proof it saved and a refused write leaves the row where it was.
// A named vanilla-JS exception beside `bucketMoveScript`: a gesture has no declarative form (007 §12.3's `actions` carries a click, not a gesture).
templ reorderScript() {
	<script>
		(function () {
			if (window.menataReorder) return;
			window.menataReorder = true;
			var dragged = null;
			function rows(row) { return Array.prototype.slice.call(row.parentNode.children); }
			// The look of the row a drop would land on is the list's own (`data-reorder-over`, drawn through the Theme's readers).
			function look(row) { return row.parentNode.dataset.reorderOver.split(" "); }
			function clear() {
				document.querySelectorAll("[data-reorder-url]").forEach(function (r) { r.classList.remove.apply(r.classList, look(r)); });
			}
			document.addEventListener("pointerdown", function (e) {
				var grip = e.target.closest && e.target.closest("[data-reorder-grip]");
				if (grip) grip.closest("[data-reorder-url]").draggable = true;
			});
			document.addEventListener("dragstart", function (e) {
				var row = e.target.closest && e.target.closest("[data-reorder-url]");
				if (!row || !row.draggable) return;
				dragged = row;
				e.dataTransfer.effectAllowed = "move";
				e.dataTransfer.setData("text/plain", row.dataset.reorderUrl);
				setTimeout(function () { row.classList.add("opacity-40"); }, 0);
			});
			document.addEventListener("dragover", function (e) {
				if (!dragged) return;
				var over = e.target.closest("[data-reorder-url]");
				if (!over || over === dragged || over.parentNode !== dragged.parentNode) return;
				e.preventDefault();
				e.dataTransfer.dropEffect = "move";
				clear();
				over.classList.add.apply(over.classList, look(over));
			});
			document.addEventListener("drop", function (e) {
				if (!dragged) return;
				var over = e.target.closest("[data-reorder-url]");
				if (!over || over === dragged || over.parentNode !== dragged.parentNode) return;
				e.preventDefault();
				var row = dragged;
				clear();
				htmx.ajax("POST", row.dataset.reorderUrl + "/move?to=" + (rows(over).indexOf(over) + 1), { source: row, swap: "none" });
			});
			document.addEventListener("dragend", function () {
				if (dragged) { dragged.classList.remove("opacity-40"); dragged.draggable = false; }
				dragged = null;
				clear();
			});
			document.addEventListener("keydown", function (e) {
				var grip = e.target.closest && e.target.closest("[data-reorder-grip]");
				if (!grip || (e.key !== "ArrowUp" && e.key !== "ArrowDown")) return;
				e.preventDefault();
				var row = grip.closest("[data-reorder-url]");
				htmx.ajax("POST", row.dataset.reorderUrl + "/move?direction=" + (e.key === "ArrowUp" ? "up" : "down"), { source: row, swap: "none" });
			});
		})();
	</script>
}
