package rendering

import (
	"context"
	"strconv"
	"strings"

	"menata.app/internal/domain"
	"menata.app/internal/ir"
)

// The generic renderers for domain's Layout and Static Content primitives (007 §12.2, §12.6).
//
// **This file is the only place a kind becomes CSS.** §15.2 forbids an intermediate representation
// embedding "HTML, CSS framework classes", so `domain` carries the vocabulary and the mapping lives here,
// in the plane entitled to know Tailwind exists. §14 permits exactly this shape -- "Existing templ
// functions may remain behind registered components during migration".
//
// **The gate that matters for these is not "is anything using them".** It is
// `conformance.TestLayoutRenderersHaveNoPerScreenBranch`: a generic renderer that needs to know *which
// screen* is calling it is not a primitive, it is one screen's shape with a new name. That is the only
// test of genericity these have, and it is why the four unmeasured §12.2 kinds were not built -- a
// primitive with no second caller cannot fail it.

// radiusClass maps a radius role through **this request's Workspace theme** — the first token category that a
// Workspace can redeclare without a recompile, which is what distinguishes a Theme from the Go vocabularies
// (`Gap`, `BadgeTone`) that already existed.
//
// Reads the theme off ctx rather than taking it as a parameter, because every primitive below would otherwise
// grow one, and the zero Theme is a working answer: a pre-auth screen has no Workspace on ctx and
// `Theme.RadiusFor` falls back to `DefaultTheme`, so it renders exactly what it rendered before.
func radiusClass(ctx context.Context, role domain.RadiusRole) string {
	switch CurrentWorkspace(ctx).Theme.RadiusFor(role) {
	case domain.RadiusStepSmall:
		return "rounded-md"
	case domain.RadiusStepLarge:
		return "rounded-lg"
	case domain.RadiusStepFull:
		return "rounded-full"
	default:
		return "rounded-lg"
	}
}

// weightClass maps a weight role through this request's Workspace theme, on the same terms as radiusClass.
func weightClass(ctx context.Context, role domain.WeightRole) string {
	switch CurrentWorkspace(ctx).Theme.WeightFor(role) {
	case domain.WeightStepNormal:
		return "font-normal"
	case domain.WeightStepMedium:
		return "font-medium"
	default:
		return "font-medium"
	}
}

// textClass maps a text role through this request's Workspace theme, on the same terms as radiusClass.
func textClass(ctx context.Context, role domain.TextRole) string {
	switch CurrentWorkspace(ctx).Theme.TextFor(role) {
	case domain.TextMicro:
		return "text-3xs"
	case domain.TextTiny:
		return "text-2xs"
	case domain.TextSmall:
		return "text-xs"
	case domain.TextNormal:
		return "text-sm"
	case domain.TextMedium:
		return "text-base"
	case domain.TextLarge:
		return "text-xl"
	case domain.TextHuge:
		return "text-2xl"
	default:
		return "text-sm"
	}
}

// borderClass maps a border role through this request's Workspace theme, on the same terms as radiusClass.
func borderClass(ctx context.Context, role domain.BorderRole) string {
	switch CurrentWorkspace(ctx).Theme.BorderFor(role) {
	case domain.BorderFaint:
		return "border-slate-100"
	case domain.BorderSoft:
		return "border-slate-200"
	case domain.BorderDefined:
		return "border-slate-300"
	default:
		return "border-slate-200"
	}
}

// inkClass maps a text-colour role through this request's Workspace theme, on the same terms as radiusClass.
func inkClass(ctx context.Context, role domain.InkRole) string {
	switch CurrentWorkspace(ctx).Theme.InkFor(role) {
	case domain.InkShadeDarkest:
		return "text-slate-900"
	case domain.InkShadeDark:
		return "text-slate-700"
	case domain.InkShadeMedium:
		return "text-slate-500"
	case domain.InkShadeLight:
		return "text-slate-400"
	default:
		return "text-slate-900"
	}
}

// backgroundClass maps a surface role through this request's Workspace theme, on the same terms as radiusClass.
func backgroundClass(ctx context.Context, role domain.BackgroundRole) string {
	switch CurrentWorkspace(ctx).Theme.BackgroundFor(role) {
	case domain.BackgroundShadeLightest:
		return "bg-white"
	case domain.BackgroundShadeLighter:
		return "bg-slate-50"
	case domain.BackgroundShadeLight:
		return "bg-slate-100"
	default:
		return "bg-white"
	}
}

// paddingClass maps a padding role through this request's Workspace theme, on the same terms as radiusClass.
// **Three switches, one per axis**, because Tailwind needs each class as a literal and the ladders differ: the
// all-sides ladder has no half, one or one-and-a-half step (`domain.PaddingAmountAllowed`), so a shared switch
// would put classes in the bundle that nothing uses.
func paddingClass(ctx context.Context, role domain.PaddingRole) string {
	a := CurrentWorkspace(ctx).Theme.PaddingFor(role)
	switch role.Axis() {
	case domain.PaddingAxisX:
		switch a {
		case domain.PaddingAmountHalf:
			return "px-0.5"
		case domain.PaddingAmountOne:
			return "px-1"
		case domain.PaddingAmountOneHalf:
			return "px-1.5"
		case domain.PaddingAmountTwo:
			return "px-2"
		case domain.PaddingAmountTwoHalf:
			return "px-2.5"
		case domain.PaddingAmountThree:
			return "px-3"
		case domain.PaddingAmountFour:
			return "px-4"
		case domain.PaddingAmountFive:
			return "px-5"
		}
		return "px-2.5"
	case domain.PaddingAxisY:
		switch a {
		case domain.PaddingAmountHalf:
			return "py-0.5"
		case domain.PaddingAmountOne:
			return "py-1"
		case domain.PaddingAmountOneHalf:
			return "py-1.5"
		case domain.PaddingAmountTwo:
			return "py-2"
		case domain.PaddingAmountTwoHalf:
			return "py-2.5"
		case domain.PaddingAmountThree:
			return "py-3"
		case domain.PaddingAmountFour:
			return "py-4"
		case domain.PaddingAmountFive:
			return "py-5"
		}
		return "py-1"
	default:
		switch a {
		case domain.PaddingAmountTwo:
			return "p-2"
		case domain.PaddingAmountTwoHalf:
			return "p-2.5"
		case domain.PaddingAmountThree:
			return "p-3"
		case domain.PaddingAmountFour:
			return "p-4"
		case domain.PaddingAmountFive:
			return "p-5"
		}
		return "p-4"
	}
}

// toneClass maps a semantic tone to its background and text pair, through this request's Workspace theme.
//
// Returns both classes as one string because a palette **is** the pair: splitting them would let a Workspace
// declare a background without its text colour and produce an unreadable badge, which is the kind of
// half-valid state a closed set exists to prevent.
func toneClass(ctx context.Context, tone domain.BadgeTone) string {
	switch CurrentWorkspace(ctx).Theme.ToneFor(tone) {
	case domain.PaletteGrey:
		return "bg-slate-100 text-slate-600"
	case domain.PaletteGreyFaint:
		return "bg-slate-50 text-slate-400"
	case domain.PaletteBlue:
		return "bg-blue-50 text-blue-700"
	case domain.PaletteGreen:
		return "bg-emerald-50 text-emerald-700"
	case domain.PaletteRed:
		return "bg-red-50 text-red-700"
	case domain.PaletteAmber:
		return "bg-amber-50 text-amber-800"
	default:
		return "bg-slate-100 text-slate-600"
	}
}

// metricValueClass is toneClass's text-only counterpart for a Metric's value. A value has no background to
// pair with, so it takes only the palette's text colour -- and only for the two tones that signal something;
// every other tone, and the unset one, stays the default ink rather than tinting a number nobody flagged.
func metricValueClass(ctx context.Context, tone domain.BadgeTone) string {
	switch CurrentWorkspace(ctx).Theme.ToneFor(tone) {
	case domain.PaletteRed:
		return "text-red-700"
	case domain.PaletteGreen:
		return "text-emerald-700"
	default:
		return inkClass(ctx, domain.InkStrong)
	}
}

// layoutGap maps a declared Gap onto the spacing steps the measured corpus actually uses. An empty Gap is
// GapDefault, resolved here rather than requiring every caller to say so.
func layoutGap(ctx context.Context, g domain.Gap) string {
	switch CurrentWorkspace(ctx).Theme.GapFor(g) {
	case domain.GapAmountHalf:
		return "gap-0.5"
	case domain.GapAmountOne:
		return "gap-1"
	case domain.GapAmountTwo:
		return "gap-2"
	case domain.GapAmountThree:
		return "gap-3"
	case domain.GapAmountFour:
		return "gap-4"
	case domain.GapAmountFive:
		return "gap-5"
	default:
		return "gap-3"
	}
}

// stackLayout is vertical flow -- `flex flex-col gap-N`, the shape counted 61 times across the bespoke
// screens on 2026-10-02 and the reason this primitive was built first.
templ stackLayout(gap domain.Gap) {
	<div class={ "flex flex-col", layoutGap(ctx, gap) }>
		{ children... }
	</div>
}

// **All five measured primitives are here now, and three of them were in this file once before with no
// callers.** The first pass built four and migrated nothing; `grid`, `panel` and `row` were deleted the same
// day, and the unused grid renderer had already put a *three-column desktop* class into the Tailwind bundle --
// a class no screen used. Each came back only with the sites it replaces. A primitive arrives with its uses,
// or it is a name with nothing behind it.
//
// **That class is described in prose rather than named, on purpose**, and the reason is the bug it caused:
// Tailwind scans these `.templ` files as *text*, so the comment recording the mistake re-committed it. The
// class sat in app.css for a day, sourced by nothing but the sentence saying it should not be.
// `conformance.TestNoClassLivesOnlyInAComment` holds this now, and found two more the same way.

// panelLayout is the bordered, padded surface twelve sites across six screens carried as one identical
// class string -- the only one of §12.2's remaining candidates that is genuinely *one shape*. Three near
// variants (`p-5` twice, a `p-3` div once) are deliberately left alone: forcing them through this would
// change what renders, and a primitive that quietly restyles its callers is worse than a repeated class.
//
// **Measured 2026-10-06: it has one live caller.** The twelve sites above were rewritten into other shapes since
// (the Case 19 restyles), so the panel/section padding difference is one site wide today.
templ panelLayout() {
	<section class={ radiusClass(ctx, domain.RadiusSurface), "border", borderClass(ctx, domain.BorderSurface), backgroundClass(ctx, domain.BackgroundRaised), paddingClass(ctx, domain.PaddingPanel) }>
		{ children... }
	</section>
}

// sectionLayout is §12.2's `section`: a bordered, padded surface that stacks its children -- the shape 17
// sites across nine screens carried as one class string, usually holding a heading as their first child
// (21 of 25 measured `<section>` blocks do).
//
// **Why a different padding here than in `panelLayout`.** They are two roles for what is arguably one idea
// (`domain.PaddingSection`, `domain.PaddingPanel`), and keeping them separate is the only default where no
// screen moves; `domain.LayoutSection` records the argument for merging them. Merging is now one line in a
// Workspace's own `theme.padding`, so the owner can see it on a real Workspace before deciding for the default.
// **Do not unify the defaults without saying which 12 or 21 screens shift.**
//
// It takes no title parameter. `sectionHeaderRow` (appshell.templ, 9 callers) is the heading half and takes
// a link target; a Layout that accepted one would be a Layout that knows about routes.
templ sectionLayout(gap domain.Gap) {
	<section class={ "flex flex-col", layoutGap(ctx, gap), radiusClass(ctx, domain.RadiusSurface), "border", borderClass(ctx, domain.BorderSurface), backgroundClass(ctx, domain.BackgroundRaised), paddingClass(ctx, domain.PaddingSection) }>
		{ children... }
	</section>
}

// gridColsBelowBreakpoint and gridColsFromBreakpoint are **two switches rather than one**, and each emits a
// class only for a count the corpus measures at that breakpoint: one and two below `sm:`, two, four and
// seven from `sm:` up.
//
// The alternative -- one switch over all four, used at both breakpoints -- reads better and would put three
// utility classes into the shipped bundle that no screen uses. That is not a hypothetical cost. It is
// precisely the defect the first pass of this slice shipped, and the reason the second had to count the
// bundle before counting anything else.
func gridColsBelowBreakpoint(c domain.GridCols) string {
	switch c {
	case domain.GridCols1:
		return "grid-cols-1"
	case domain.GridCols2:
		return "grid-cols-2"
	default:
		return "grid-cols-1"
	}
}

func gridColsFromBreakpoint(c domain.GridCols) string {
	switch c {
	case domain.GridCols2:
		return "sm:grid-cols-2"
	case domain.GridCols4:
		return "sm:grid-cols-4"
	case domain.GridCols7:
		return "sm:grid-cols-7"
	default:
		return "sm:grid-cols-2"
	}
}

// gridLayout is the responsive card grid five screens carried as a hand-written class string: a summary-tile
// strip, a seven-day calendar, two card grids and the Machine `cards` View.
//
// The five differ in exactly two things, a column count and a gap, which is the whole argument for this
// being one primitive. An earlier measurement of mine counted the five class strings, found them all
// different, and concluded there was no shape here -- it had counted *configuration* and called it shape. A
// two-column desktop grid and a four-column one are not two primitives; they are one primitive and two
// arguments.
//
// Class order is `grid`, the mobile count, the gap, then the breakpoint count, which is the order all five
// call sites already wrote. That is why this migration is byte-identical rather than merely equivalent, and
// byte-identical is what let it be verified instead of eyeballed.
templ gridLayout(gap domain.Gap, mobile, columns domain.GridCols) {
	<div class={ "grid", gridColsBelowBreakpoint(mobile), layoutGap(ctx, gap), gridColsFromBreakpoint(columns) }>
		{ children... }
	</div>
}

// splitTracks is **one switch over the (side, width) pair rather than two independent ones**, because
// Tailwind needs the whole track list as a literal class -- a composed string is a class its scanner never
// sees, and the page then renders with no columns at all and nothing fails.
//
// Three of the four combinations are drawn, which are the three the corpus measures. A start-side wide aside
// has no site, so emitting it would put an arbitrary-value class into the bundle for nothing; it falls
// through to the most common combination instead, and
// `TestSplitLayout_unmeasuredCombinationFallsBackRatherThanEmittingANewClass` asserts that rather than
// leaving it to be met as a bug. Every main track is `minmax(0,1fr)`, which is a **deliberate change** to the
// two New Application screens -- see splitLayout's own comment.
func splitTracks(side domain.SplitSide, aside domain.AsideWidth) string {
	switch {
	case side == domain.SplitAsideStart && aside == domain.AsideNarrow:
		return "lg:grid-cols-[320px_minmax(0,1fr)]"
	case side == domain.SplitAsideEnd && aside == domain.AsideWide:
		return "lg:grid-cols-[minmax(0,1fr)_360px]"
	default:
		// SplitAsideEnd + AsideNarrow, the most common of the three.
		return "lg:grid-cols-[minmax(0,1fr)_320px]"
	}
}

// splitLayout is §12.2's own `split`: a main area beside a fixed-width aside, stacking to one column below
// `lg`. Five sites -- the submit wizard's approver rail, the review screen's decision panel, the signature
// placement sidebar, and New Application's two preview panes.
//
// **This migration changes what renders on two of the five, and that is the point rather than a side
// effect.** The five asides were 316, 320, 320, 340 and 360 pixels wide. Four distinct widths for one idea is
// not four decisions; naming two steps makes the signature-placement aside 4px wider and the second New
// Application aside 20px wider, and leaves the other three untouched.
//
// **The second change is not cosmetic at all.** Three sites gave the main column `minmax(0,1fr)` and the two
// New Application sites gave it `1fr`. Those differ in behaviour: `minmax(0,1fr)` lets the main column shrink
// below its content's intrinsic width, and `1fr` does not, so wide content there pushes the layout out
// instead of scrolling or wrapping inside it. Both New Application screens render a `<pre>` of generated
// YAML. Normalising to `minmax(0,1fr)` fixes a latent overflow on exactly the two screens most likely to hit
// it -- which is why the inconsistency was worth finding, and why a primitive that has to pick one answer is
// how it got found.
templ splitLayout(gap domain.Gap, side domain.SplitSide, aside domain.AsideWidth) {
	<div class={ "grid grid-cols-1", layoutGap(ctx, gap), splitTracks(side, aside) }>
		{ children... }
	</div>
}

// columnsAlign maps a columns layout's cross-axis alignment, applied only from the breakpoint up.
func columnsAlign(a domain.ColumnsAlign) string {
	switch a {
	case domain.ColumnsAlignEnd:
		return "sm:items-end"
	case domain.ColumnsAlignCenter:
		return "sm:items-center"
	default:
		return "sm:items-center"
	}
}

// columnsLayout is §12.2's `columns`: different content per column on desktop, one stack on a phone.
//
// Five sites, all of them a heading or label beside its own action -- Workspace Members and Groups page
// headers, the inbox header, two role rows. The three further `sm:flex-row` sites that did **not** migrate are
// list rows carrying `border-b`/padding, which is `Collection`'s item shape rather than a bare columns, and one
// panel that becomes columns; naming why is what stops the next reader forcing them through this and
// restyling them.
//
// `sm:justify-between` is not a parameter because all five use it. A closed set with one member is a constant
// wearing an enum's clothes.
templ columnsLayout(gap domain.Gap, align domain.ColumnsAlign) {
	<div class={ "flex flex-col", layoutGap(ctx, gap), "sm:flex-row", columnsAlign(align), "sm:justify-between" }>
		{ children... }
	</div>
}

// collection is the registered renderer for `domain.ComponentCollection` -- §12.3's `Collection`, and the
// first Component here with a slot (§12.5). Items arrive **already composed**, one `templ.Component` each,
// which is what lets one list serve 21 different row shapes without the Component knowing any of them.
//
// **The two class strings are measured, not chosen.** `taskRowList` and `activityFeedListRow` were
// structurally identical and used exactly `flex flex-col gap-2` on the `<ul>` and
// `flex flex-wrap items-center gap-2 text-sm` on the `<li>` -- 2 of 2, so this is the shape rather than a
// preference. `text-sm` on the item wrapper is typography inside a Component, which is the same thing that
// kept seven `row` sites hand-written; it is accepted here only because both measured callers agree on it,
// and it is the first thing to revisit when a third caller does not.
//
// A real `<ul>`/`<li>` rather than divs: the list and its length are then announced without an explicit
// role, which is what the contract's accessibility clause records.
templ collection(gap domain.Gap, items []templ.Component) {
	<ul class={ "flex flex-col", layoutGap(ctx, gap) }>
		for _, it := range items {
			<li class={ "flex flex-wrap items-center", layoutGap(ctx, gap), "text-sm" }>
				@it
			</li>
		}
	</ul>
}

// rowAlign and rowJustify map the two flexbox axes. Both return "" for their default member, and
// `RowAlignStretch`/`RowJustifyStart` are named in their switches rather than left to the fallthrough, because
// the vocabulary gate reads which members a renderer *names* -- one reachable only through a default arm is
// indistinguishable from one nothing draws.
//
// **rowClasses joins them in Go rather than handing templ a list**, which is not a style choice. templ's
// `class={ a, b, c }` does not drop an empty value, it emits a **double space** -- measured, not assumed, by
// rendering the three combinations before writing the call sites. Eighteen of the 24 migrated sites pass at
// least one default, so the list form would have left eighteen screens differing from their baseline by a
// space that no one would ever look for.
func rowAlign(a domain.RowAlign) string {
	switch a {
	case domain.RowAlignCenter:
		return "items-center"
	case domain.RowAlignStretch:
		return ""
	default:
		return ""
	}
}

func rowJustify(j domain.RowJustify) string {
	switch j {
	case domain.RowJustifySpread:
		return "justify-between"
	case domain.RowJustifyStart:
		return ""
	default:
		return ""
	}
}

// rowLayout is horizontal flow that wraps -- the second most common shape in the corpus after `stack`, and the
// last of §12.2's measured-in-use primitives to be built.
//
// **22 of its 33 sites migrate, and the other eleven are a floor rather than debt**, in three kinds:
//
//   - **seven carry non-layout classes on the same element** -- typography (`text-sm`, `text-3xs
//     text-slate-600`), decoration (`border-b … pb-1.5`) or sizing (`sm:w-32`). Absorbing them would mean this
//     primitive accepting a CSS class string, which is 007 §15.2's prohibition with different syntax and
//     §12.3's "arbitrary properties" with the same one. A primitive taking `textClass string` is a `<div>`
//     with extra steps.
//   - **two want an asymmetric column/row gap** the single `Gap` ladder cannot express, and inventing a second
//     ladder for two sites would be shape-before-need.
//   - **two are not a `<div>`** -- one `<form>`, one `<span>`. This is the only one of the three that is a real
//     missing capability rather than a boundary: nothing lets a caller choose the element, and changing it
//     would break the form's submission and nest a block inside an inline context. The primitive that answers
//     it is §12.5 Slot or a Component with a declared element, which is Stage 2.
//
// Three further sites *did* migrate by **nesting**: `approvalinbox`'s filter groups keep `role="group"` and
// their `aria-label` on a wrapper with the row inside, for the same reason `signatureplacement` keeps its htmx
// wiring outside `splitLayout`. Accessibility semantics are not layout, and separating them is how a declared
// Page would express the pair anyway. Cost: three extra DOM nodes.
//
// Of the 22, **five render two pixels differently**: they used a gap one and a half steps wide, which folds
// into `GapTight`. `domain.Gap` records why that was the right call rather than declaring a half-step.
templ rowLayout(gap domain.Gap, align domain.RowAlign, justify domain.RowJustify) {
	<div class={ rowClasses(ctx, gap, align, justify) }>
		{ children... }
	</div>
}

// rowClasses is the join described above rowAlign: `flex flex-wrap`, then each axis that is not its default,
// then the gap -- the order all 24 call sites already wrote.
func rowClasses(ctx context.Context, gap domain.Gap, align domain.RowAlign, justify domain.RowJustify) string {
	parts := []string{"flex flex-wrap"}
	for _, c := range []string{rowAlign(align), rowJustify(justify), layoutGap(ctx, gap)} {
		if c != "" {
			parts = append(parts, c)
		}
	}
	return strings.Join(parts, " ")
}

// staticText renders one §12.6 static content node. Text arrives already resolved -- this function does
// not read metadata, derive a heading, or fall back; `titleByID`/`descriptionByID` and
// `domain.ResolveNavigationHeadings` own that, and a renderer that resolved its own content is the
// render-time inference removed on 2026-10-02.
templ staticText(kind domain.StaticKind, text string) {
	switch kind {
		case domain.StaticEyebrow:
			<span class={ textClass(ctx, domain.RoleEyebrow), "tracking-wide text-blue-600 uppercase" }>{ text }</span>
		case domain.StaticHeading:
			<h1 class={ "m-0", textClass(ctx, domain.RoleHeading), weightClass(ctx, domain.WeightEmphasis) }>{ text }</h1>
		case domain.StaticParagraph:
			<div class={ textClass(ctx, domain.RoleBody), inkClass(ctx, domain.InkSecondary) }>{ text }</div>
		case domain.StaticOverline:
			<span class={ textClass(ctx, domain.RoleEyebrow), "tracking-wide", inkClass(ctx, domain.InkFaint), "uppercase" }>{ text }</span>
		case domain.StaticPanelHeading:
			<h2 class={ "m-0", textClass(ctx, domain.RoleBody), weightClass(ctx, domain.WeightEmphasis) }>{ text }</h2>
		case domain.StaticCaption:
			<p class={ "m-0", textClass(ctx, domain.RoleCaption), inkClass(ctx, domain.InkSecondary) }>{ text }</p>
		case domain.StaticSubheading:
			<h2 class={ "m-0", textClass(ctx, domain.RoleSubheading), weightClass(ctx, domain.WeightEmphasis) }>{ text }</h2>
		case domain.StaticMessage:
			<p class={ "m-0", textClass(ctx, domain.RoleBody), inkClass(ctx, domain.InkSecondary) }>{ text }</p>
		case domain.StaticNote:
			<p class={ "m-0", textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkSecondary) }>{ text }</p>
	}
}

// staticLink draws `domain.StaticLink` -- §12.6's `link`, and the only Static Content node that needs a
// destination as well as text.
//
// Separate from `staticText` rather than a fourth case in it, because that function takes only text and a
// link needs an href. The href arrives **already resolved**: callers pass `routeByID(...)` or a view model's
// own field, so this never looks a route up and stays as route-free as the Layout primitives beside it.
//
// **It only works in child position, and templ fails silently when it is not.** Three of the eight sites this
// migration tried were `<a>` inline inside a text run ("Don't have one? <a>Create a workspace</a>"), and templ
// renders `@staticLink(...)` there as **literal text** -- no error, no warning, the string `@staticLink("/register",
// "Create a workspace")` printed into the page. Caught only by the byte-diff; the build was green and the
// conformance suite passed. Those three were reverted and stay hand-written.
//
// `templ.URL` rather than `templ.SafeURL`: the sanitising one. Two migrated sites used `SafeURL` to bypass
// it; for internal routes the output is identical, and the byte-diff is what proved that rather than the
// assumption.
templ staticLink(href, text string) {
	<a href={ templ.URL(href) } class="text-blue-600 hover:text-blue-700">{ text }</a>
}

// pageHeader is the primitives' first consumer: the eyebrow / heading / subtitle block that **eleven**
// screens carried as five identical lines each.
//
// All three strings are already declarations -- the Application's own `name:`, and the navigation item's
// `title:` and `description:` -- so this composes rather than decides. The subtitle is omitted when no
// description is declared, which is the guard `approvalinbox.templ` established and the seven Stage 0.5
// migrations adopted: an absent declaration must render nothing, not an empty styled element.
//
// **What it does not do**: it is not declared in metadata. A screen's *body* is what Stage 2 makes
// declarable, because a body needs a bounded Component (§12.3) -- "a panel per rule, each with a heading
// and three labelled values" is beyond Layout and Static Content, and pretending otherwise would be the
// unbounded `GenericComponent` §12.3 forbids by name.
templ pageHeader(navID string) {
	{{ app, _ := CurrentApplication(ctx) }}
	@uiNode(headerTree(app.Name, titleByID(ctx, navID), descriptionByID(ctx, navID)))
}

// headerTree builds the header block as **UI IR** rather than as templ structure -- the first screen content
// in this runtime expressed as data (007 §15, §15.1's `Build UI IR` stage).
//
// Eight screens call `pageHeader`, and until now its composition was Go: a `stackLayout` holding three
// `staticText` calls. Every value in it was already a declaration (the Application's `name:`, the navigation
// item's `title:` and `description:`), so what was left hardcoded was only the *shape* -- which is 001 #3
// inverted, and which 007 §12.4 calls a breach of a normative rule when multiplied across 38 screens.
//
// **It is a small tree on purpose.** §24 prescribes *progressive* lowering, and a first lowering whose output
// can be diffed byte-for-byte against eight live screens is worth more than a large one that cannot. The
// subtitle node is omitted rather than emptied when no description is declared -- the same guard the templ
// version had, now a property of the tree.
func headerTree(appName, title, description string) ir.UINode {
	children := []ir.UINode{
		{Kind: ir.NodeStatic, Type: string(domain.StaticEyebrow), Props: map[string]string{"text": appName}},
		{Kind: ir.NodeStatic, Type: string(domain.StaticHeading), Props: map[string]string{"text": title}},
	}
	if description != "" {
		children = append(children, ir.UINode{
			Kind: ir.NodeStatic, Type: string(domain.StaticParagraph),
			Props: map[string]string{"text": description},
		})
	}
	return ir.UINode{
		Kind:     ir.NodeLayout,
		Type:     string(domain.LayoutStack),
		Identity: "page_header",
		Props:    map[string]string{"gap": string(domain.GapTight)},
		Children: children,
	}
}

// uiNode walks a UI IR tree and draws it through the primitives already registered.
//
// **It has no per-screen branch and cannot acquire anything.** Every value it draws arrives in `Props`,
// already resolved; the walker's whole job is dispatch on a closed kind. An unknown kind renders nothing
// rather than guessing, and `ir.Validate` is what refuses one before it gets here -- which is the division
// §15.3 states ("the compiler MUST reject") and the reason the walker stays this small.
templ uiNode(n ir.UINode) {
	switch n.Kind {
		case ir.NodeLayout:
			switch domain.LayoutKind(n.Type) {
				case domain.LayoutStack:
					@stackLayout(domain.Gap(n.Props["gap"])) {
						@uiChildren(n)
					}
				case domain.LayoutPanel:
					@panelLayout() {
						@uiChildren(n)
					}
				case domain.LayoutSection:
					@sectionLayout(domain.Gap(n.Props["gap"])) {
						@uiChildren(n)
					}
				case domain.LayoutColumns:
					@columnsLayout(domain.Gap(n.Props["gap"]), domain.ColumnsAlign(n.Props["align"])) {
						@uiChildren(n)
					}
				case domain.LayoutRow:
					@rowLayout(domain.Gap(n.Props["gap"]), domain.RowAlign(n.Props["align"]), domain.RowJustify(n.Props["justify"])) {
						@uiChildren(n)
					}
				case domain.LayoutGrid:
					@gridLayout(domain.Gap(n.Props["gap"]), gridColsFromProp(n.Props["mobile"]), gridColsFromProp(n.Props["columns"])) {
						@uiChildren(n)
					}
				case domain.LayoutSplit:
					@splitLayout(domain.Gap(n.Props["gap"]), domain.SplitSide(n.Props["side"]), domain.AsideWidth(n.Props["aside"])) {
						@uiChildren(n)
					}
			}
		case ir.NodeStatic:
			if domain.StaticKind(n.Type) == domain.StaticLink {
				@staticLink(n.Props["href"], n.Props["text"])
			} else {
				@staticText(domain.StaticKind(n.Type), n.Props["text"])
			}
		case ir.NodeComponent:
			switch domain.ComponentType(n.Type) {
				case domain.ComponentStatusBadge:
					@statusBadge(n.Props["label"], domain.BadgeTone(n.Props["tone"]), domain.BadgeSize(n.Props["size"]))
				case domain.ComponentField:
					@field(n.Props["for"], n.Props["label"]) {
						@uiChildren(n)
					}
				case domain.ComponentCollection:
					@collection(domain.Gap(n.Props["gap"]), uiChildComponents(n))
				case domain.ComponentMetric:
					@metric(n.Props["label"], n.Props["value"], n.Props["hint"], domain.BadgeTone(n.Props["tone"]))
				case domain.ComponentAvatar:
					@avatar(n.Props["initials"], n.Props["label"], domain.AvatarSize(n.Props["size"]), domain.AvatarPresence(n.Props["presence"]))
			}
	}
}

// uiChildComponents turns a node's children into one composed component each, for a slotted Component that
// takes them as values rather than as `{ children... }`.
func uiChildComponents(n ir.UINode) []templ.Component {
	out := make([]templ.Component, 0, len(n.Children))
	for _, c := range n.Children {
		out = append(out, uiNode(c))
	}
	return out
}

// uiChildren walks a node's subtree. Extracted so each Layout arm above is one line -- five arms repeating a
// four-line loop is how a dispatch table starts drifting between its own cases.
templ uiChildren(n ir.UINode) {
	for _, c := range n.Children {
		@uiNode(c)
	}
}

// gridColsFromProp reads a column count off a resolved property.
//
// It is a **closed** parse, not `strconv.Atoi`: a count outside `domain.KnownGridCols` falls back rather than
// becoming a class Tailwind never scanned. `ir.Validate` is what refuses a bad tree; this is the second line
// of defence for a tree that reached the renderer anyway.
func gridColsFromProp(v string) domain.GridCols {
	for c := range domain.KnownGridCols {
		if strconv.Itoa(int(c)) == v {
			return c
		}
	}
	return domain.GridCols1
}
