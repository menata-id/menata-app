package rendering

// authShell is the page frame every pre-auth screen shares -- sign in, register, choose a
// workspace, the three password/verification screens. It is the pageShell counterpart for pages
// that have no Workspace or Application chosen yet, and therefore no navigation to project: what
// they share instead is a centered brand lockup over a single card.
//
// It exists because the seven screens listed above each carried their own near-identical <style>
// block before this (all eight stylesheets in internal/rendering repeated the same `body`
// rule verbatim), so a change to the sign-in frame reached exactly one of them. That is well past
// capabilities.md's own promotion bar for this table -- seven Pages needing the identical shape,
// not the two it asks for.
//
// heading/subtitle are the lockup's own text, which differs per screen ("Menata" / "Sign in to
// your account" on the sign-in board, "Choose a workspace" / "You have access to more than one
// workspace." on the next one). They are this screen's own copy, not metadata: no Workspace is
// resolved yet at this point in the flow, so there is no app.yaml label to read them from.
//
// Styling is Tailwind (static/css/app.css, built by `make css`), matching
// ui-sample/case-03-flow1's boards 01 and 02. One deliberate deviation: board 02 centers its card
// vertically while board 01 sits 110px from the top, and this frame top-aligns both. Centering
// would move the card up and down as the workspace list grows, which the fixed-height board
// cannot show.
templ authShell(title, heading, subtitle string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			// Shared with appShell (appshell.templ). No htmx here: every pre-auth screen posts a
			// plain <form>, so nothing on them is hx-driven.
			@headMeta(title)
		</head>
		<body class="m-0 bg-slate-50 font-sans text-slate-900">
			<div class="flex min-h-screen flex-col items-center gap-6 px-4 pt-18 pb-8 sm:gap-7 sm:pt-28">
				<div class="flex flex-col items-center gap-2">
					<div
						role="img"
						aria-label="Menata App"
						class="flex size-11 items-center justify-center rounded-[10px] bg-brand text-[26px] leading-none font-bold text-white"
					>
						M
					</div>
					<div class="mt-1.5 text-[21px] font-medium">{ heading }</div>
					<div class="text-[15px] text-slate-500">{ subtitle }</div>
				</div>
				{ children... }
			</div>
		</body>
	</html>
}

// authCard is the white panel the pre-auth screens put their form or list inside. Its width is
// the one thing that varies between boards (384px for the sign-in form, 448px for the workspace
// list), so it is a parameter rather than a second component; on a phone both go full-width
// inside authShell's own gutter.
templ authCard(widthClass string) {
	<div class={ "w-full rounded-lg border border-slate-200 bg-white shadow-[0_1px_2px_rgba(15,23,42,0.04)]", widthClass }>
		{ children... }
	</div>
}

// authError is the shared "that attempt failed" line -- same wording placement on every pre-auth
// screen that can fail (bad credentials, an expired reset token, a workspace that is no longer
// yours).
templ authError(msg string) {
	if msg != "" {
		<p role="alert" class="text-2xs text-red-600">{ msg }</p>
	}
}

// authFooterNote is the small slate line under the card ("Don't have an account? ..."), which
// every pre-auth screen ends with in some form.
templ authFooterNote() {
	<div class="text-2xs text-slate-400">
		{ children... }
	</div>
}

// authField is one labelled control on a pre-auth form. Four screens repeat this exact shape
// (registration's four fields, forgot-password's and resend-verification's single email box), and
// the control's own sizing is the part that must not drift between them: the boards step every
// input up on a phone (42px tall / 15px text) and back down on a wider viewport (38px / 14px),
// which is a touch-target rule, not decoration.
//
// LoginPage deliberately does not use this: its password row carries a "Forgot password?" link
// beside the label, so its markup genuinely differs rather than being this shape plus a flag.
templ authField(id, name, label, kind, autocomplete string, autofocus bool) {
	<div class="flex flex-col gap-2">
		<label for={ id } class="text-sm font-medium">{ label }</label>
		<input
			id={ id }
			type={ kind }
			name={ name }
			autocomplete={ autocomplete }
			required
			autofocus?={ autofocus }
			class="h-10.5 rounded-md border border-slate-300 bg-white px-3 text-[15px] text-slate-900 outline-none focus:outline-2 focus:outline-offset-1 focus:outline-blue-300 sm:h-9.5 sm:text-sm"
		/>
	</div>
}

// authPasswordField is authField's counterpart for a *new* password, carrying the minlength the
// server also enforces. Separate rather than a `kind` value so the length rule can't be forgotten
// at a call site -- registration and both reset-password callers all need it.
templ authPasswordField(id, name, label, autocomplete string, autofocus bool) {
	<div class="flex flex-col gap-2">
		<label for={ id } class="text-sm font-medium">{ label }</label>
		<div class="relative flex">
			<input
				id={ id }
				type="password"
				name={ name }
				autocomplete={ autocomplete }
				minlength="8"
				required
				autofocus?={ autofocus }
				class="h-10.5 w-full rounded-md border border-slate-300 bg-white pr-11 pl-3 text-[15px] text-slate-900 outline-none focus:outline-2 focus:outline-offset-1 focus:outline-blue-300 sm:h-9.5 sm:text-sm"
			/>
			@authPasswordToggle(id)
		</div>
	</div>
}

// authPasswordToggle is the eye button inside a password box that reveals what was typed
// (2026-09-20, requested for every password field: sign in, registration, set-password/accept-
// invite). It flips its input's own `type` between password and text, so nothing about how the
// value is submitted changes -- the field keeps its name, its minlength and its autocomplete.
//
// The *toggle* is the shared piece here, not the whole labelled control: the two password inputs
// on these screens genuinely differ (a new password carries minlength/required and
// autocomplete="new-password"; sign-in's carries neither and current-password, and its label row
// also holds a "Forgot password?" link), which is the same reason authPasswordField already exists
// separately from authField. A caller wraps its own input in a `relative flex` box, leaves pr-11
// of room for this button, and passes the input's id.
//
// The behavior is an inline onclick rather than hyperscript (`_="on click ..."`, the idiom
// documentsubmit.templ's approver-row buttons use) for one reason: authShell deliberately loads no
// JavaScript at all -- every pre-auth screen posts a plain <form> -- and pulling the hyperscript
// bundle onto three otherwise script-free pages to move one attribute's value is the larger
// change, not the smaller one. secureHeaders' CSP already allows inline script (secureheaders.go's
// own doc comment, script-src 'unsafe-inline' for machine.templ's blocks), so no header moves
// either. The input is found by aria-controls rather than by walking siblings, so the surrounding
// markup can change without the handler silently doing nothing.
//
// aria-pressed is what a screen reader announces (the button is a two-state control, not a
// navigation), and the label flips with it; the icons are aria-hidden because they say the same
// thing. Not a `hidden` <input type=checkbox> + CSS: nothing in CSS can change an input's type --
// the CSS-only route masks a `type="text"` input with -webkit-text-security instead, which fails
// *open* (a stylesheet that doesn't load shows the password in the clear) and stops password
// managers recognizing the field at all.
//
// Forward-checkable pointer for this exception (CLAUDE.md step 2b), both greppable:
//
//   - The moment authShell loads any <script> of its own, the reason above expires and this
//     should move to hyperscript for consistency with documentsubmit.templ.
//   - The moment script-src 'unsafe-inline' is tightened. secureheaders.go ties that header to
//     machine.templ's inline blocks, and pageStyles shrinks with every ui-sample/case-03-flow1
//     port phase (capabilities.md, "Styling: two systems, on purpose") -- when those blocks are
//     gone, this onclick is the one thing left holding 'unsafe-inline' open.
//
// Full write-up, including the three alternatives and why each lost: menata-app-document's
// development-history.md, "Ikon mata di field password" (2026-09-20).
templ authPasswordToggle(inputID string) {
	<button
		type="button"
		aria-controls={ inputID }
		aria-pressed="false"
		aria-label="Show password"
		title="Show password"
		onclick="var i=document.getElementById(this.getAttribute('aria-controls'));if(!i)return;var reveal=i.type==='password';i.type=reveal?'text':'password';this.setAttribute('aria-pressed',String(reveal));this.setAttribute('aria-label',reveal?'Hide password':'Show password');this.setAttribute('title',reveal?'Hide password':'Show password');this.querySelectorAll('svg').forEach(function(s){s.classList.toggle('hidden')});"
		class="absolute inset-y-0 right-0 flex w-11 cursor-pointer items-center justify-center rounded-r-md text-slate-400 hover:text-slate-600 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-300"
	>
		<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" d="M2.04 12.32a1.01 1.01 0 0 1 0-.64C3.42 7.51 7.36 4.5 12 4.5c4.64 0 8.57 3.01 9.96 7.18.07.21.07.43 0 .64C20.58 16.49 16.64 19.5 12 19.5c-4.64 0-8.57-3.01-9.96-7.18Z"></path>
			<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
		</svg>
		<svg class="hidden size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.22A10.48 10.48 0 0 0 1.93 12c1.29 4.34 5.31 7.5 10.07 7.5.99 0 1.95-.14 2.86-.4M6.23 6.23A10.45 10.45 0 0 1 12 4.5c4.76 0 8.77 3.16 10.07 7.5a10.52 10.52 0 0 1-4.3 5.77M6.23 6.23 3 3m3.23 3.23 3.65 3.65m7.89 7.89L21 21m-3.23-3.23-3.65-3.65m0 0a3 3 0 1 0-4.24-4.24m4.24 4.24L9.88 9.88"></path>
		</svg>
	</button>
}

// authSubmit is the pre-auth primary button. Slate-900, not blue: on these boards blue is the
// link color and the filled action is near-black, so using the brand blue here would read as a
// link-shaped button.
templ authSubmit(label string) {
	<button
		type="submit"
		class="flex h-11 cursor-pointer items-center justify-center rounded-md bg-slate-900 px-4 text-[15px] font-medium text-white hover:bg-slate-800 sm:h-9 sm:text-sm"
	>
		{ label }
	</button>
}
