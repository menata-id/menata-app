package rendering

import (
	"menata.app/internal/action"
	"menata.app/internal/domain"
)

// DocumentSubmitPage is Case 3's submission wizard, ported to
// ui-sample/case-03-flow1/08-submit-document.html (Fase 6c-2).
//
// EVERY OPTION LIST ON THIS SCREEN COMES FROM METADATA. `documentType` and `mode` are
// mch_document's own Fields, passed in rather than retyped: fld_document_type was fixed when the
// Field was added, and fld_mode was the last one left -- two `value="sequential"` /
// `value="parallel"` literals sitting two sections below a select that already did it correctly,
// so a metadata-only change to the mode vocabulary never reached this screen. `approvers` and
// `groups` are resolved by composition.Loader, not read off records here, which is what let this
// file out of internal/conformance's projection ratchet.
//
// TWO BOARD ELEMENTS ARE DELIBERATELY NOT RENDERED:
//
//   - The board's eyebrow reads "STEP 1 OF 3" and this says "Step 1 of 2". There is no third
//     screen: board 09 is step 2 and no step-3 board exists anywhere in the set. Writing "of 3"
//     would promise a screen nobody can reach. ROADMAP.md's deferral table carries what the third
//     step would be for, and the finding behind it -- a Document becomes in_review the moment this
//     form is submitted, before any signature is placed.
//   - "Save this as the default approval flow for <Type>". It needs a per-Document-Type template
//     entity and a write direction, not a checkbox; ROADMAP.md's deferral table has it with that
//     as the blocker.
templ DocumentSubmitPage(documentType, mode domain.Field, approvers RelationOptions, groups GroupOptions, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	// "New Document" is a literal for the same reason the button that opens this screen is -- see
	// approvalinbox.templ's own comment: nav_new_approval was deleted on 2026-09-21 because a submit
	// form is not a menu destination, and no Page-level title/action primitive exists yet (007
	// §12.3 ActionBar). activeNavID is "" -- this screen is a sub-page of the Approval Inbox, the
	// same way Edit member is one of Workspace Members.
	@appShell("New Document", workspaceName, viewer, switchWorkspaceHref) {
		<a href={ templ.SafeURL(routeByID("nav_approval_inbox")) } class="text-xs text-blue-600 hover:text-blue-700">
			← { labelByID("nav_approval_inbox") }
		</a>
		<div class="flex flex-col gap-2">
			<span class="text-3xs tracking-wide text-blue-600 uppercase">Step 1 of 2</span>
			<h1 class="m-0 text-xl font-medium">New Document</h1>
			<div class="text-sm text-slate-500">Submit a document for approval.</div>
		</div>
		<form
			hx-post="/documents"
			hx-encoding="multipart/form-data"
			class="flex flex-col gap-4"
		>
			@csrfHiddenInput()
			<section class="flex flex-col gap-4 rounded-lg border border-slate-200 bg-white p-5">
				<h2 class="m-0 text-sm font-medium">Document</h2>
				@wizardField("doc_title", "Title") {
					<input id="doc_title" type="text" name="fld_title" required class="h-9 rounded-md border border-slate-300 bg-white px-3 text-sm outline-none focus:outline-2 focus:outline-offset-1 focus:outline-blue-300"/>
				}
				@wizardField("doc_type", documentType.Name) {
					@wizardSelect("doc_type", documentType.ID, documentType.Options, "")
				}
				@wizardField("doc_file", "PDF file") {
					<input id="doc_file" type="file" name="fld_file" accept="application/pdf" required class="text-sm"/>
				}
			</section>
			<div class="grid grid-cols-1 gap-4 lg:grid-cols-[320px_minmax(0,1fr)]">
				<fieldset class="m-0 flex flex-col gap-3 rounded-lg border border-slate-200 bg-white p-5">
					<legend class="px-1 text-sm font-medium">{ mode.Name }</legend>
					<p class="m-0 text-2xs text-slate-500">
						Sequential activates each step in order. Parallel allows all assigned approvers to
						decide independently.
					</p>
					for i, opt := range mode.Options {
						<label class="flex cursor-pointer items-center gap-2.5 rounded-md border border-slate-200 p-3 text-sm hover:border-blue-300">
							<input type="radio" name={ mode.ID } value={ opt } checked?={ i == 0 } class="size-4 accent-blue-500"/>
							{ opt }
						</label>
					}
				</fieldset>
				<section class="flex flex-col gap-4 rounded-lg border border-slate-200 bg-white p-5">
					<div class="flex flex-wrap items-center justify-between gap-3">
						<h2 class="m-0 text-sm font-medium">Approval steps</h2>
						<button
							type="button"
							hx-get="/documents/new/approver-row"
							hx-target="#approver-rows"
							hx-swap="beforeend"
							class="cursor-pointer text-xs text-blue-600 hover:text-blue-700"
						>+ Add approver</button>
					</div>
					<p class="m-0 text-2xs text-slate-500">
						Each step is one person or a whole group. The order below is used only when
						{ mode.Name } is { firstOption(mode) } — use ▲/▼ to reorder.
					</p>
					<div id="approver-rows" class="flex flex-col gap-2.5 [counter-reset:approver-step]">
						@ApproverRow(approvers, groups)
					</div>
				</section>
			</div>
			<div class="flex justify-end">
				<button type="submit" class="h-9 cursor-pointer rounded-md bg-slate-900 px-4 text-sm font-medium text-white hover:bg-slate-800">Continue →</button>
			</div>
		</form>
	}
}

// wizardField is one labelled control on this page. Not authField (authshell.templ): that one is
// the pre-auth kit's, owns its own <input> and its own sizing, and its doc comment says so. This
// wraps whatever control it is given, because this form has four different ones.
templ wizardField(id, label string) {
	<div class="flex flex-col gap-2">
		<label for={ id } class="text-sm font-medium">{ label }</label>
		{ children... }
	</div>
}

// wizardSelect renders a status Field's own declared options. Taking the []string rather than the
// Field keeps it usable for the approver-type picker too, whose values are domain.ActorKind*
// rather than a Field's Options -- see approverTypeSelect.
templ wizardSelect(id, name string, options []string, placeholder string) {
	<select id={ id } name={ name } required class="h-9 rounded-md border border-slate-300 bg-white px-3 text-sm outline-none focus:outline-2 focus:outline-offset-1 focus:outline-blue-300">
		<option value="">{ placeholder }</option>
		for _, opt := range options {
			<option value={ opt }>{ opt }</option>
		}
	</select>
}

// firstOption names the mode whose ordering actually matters, without retyping "Sequential" -- the
// value is metadata's, and metadata/document.yaml declares sequential first for exactly the reason
// this sentence needs. Falls back to nothing rather than to a guessed word.
func firstOption(f domain.Field) string {
	if len(f.Options) == 0 {
		return ""
	}
	return f.Options[0]
}

// ApproverRow is one approval step: what the step is for, who decides it, and whether that "who"
// is a person or a whole Workspace Group (board 08's own User/Group toggle, CAP-F24).
//
// Rendered identically for the wizard's initial row and for the "+ Add approver" HTMX fragment,
// from one readWizardOptions call, so a later row can never offer a different set than the first.
//
// THE TYPE PICKER IS A <select>, NOT THE BOARD'S SEGMENTED BUTTONS, and that is a correctness
// choice rather than a styling one. Row order *is* fld_sequence -- there is no hidden sequence
// input, the browser submits repeated field names in DOM order and the server uses the index -- so
// the four per-row controls arrive as parallel slices that must stay aligned. An unchecked radio
// submits nothing at all, so a radio-pair toggle would drop an element and silently attach every
// later row's approver to the wrong step. A <select> always submits exactly one value per row.
//
// Reordering (put ... before/after the previous/next <.approver-row/>) and removal (remove closest
// <.approver-row/>) stay pure client-side DOM operations -- Hyperscript's own named case in
// README.md's Tech stack, and appShell loads it. The step number is a CSS counter for the same
// reason: rows are added, removed and reordered in the browser, so a number passed from Go would
// go stale on the first ▲.
templ ApproverRow(approvers RelationOptions, groups GroupOptions) {
	<div class="approver-row flex flex-wrap items-center gap-2 rounded-md border border-slate-200 p-2.5 [counter-increment:approver-step]">
		<span
			aria-hidden="true"
			class="flex size-7 shrink-0 items-center justify-center rounded-full bg-blue-600 text-3xs font-medium text-white before:[content:counter(approver-step)]"
		></span>
		<input
			type="text"
			name={ action.FieldStepName }
			placeholder="Step name (optional)"
			aria-label="Step name"
			class="h-9 w-36 rounded-md border border-slate-300 bg-white px-3 text-sm outline-none focus:outline-2 focus:outline-offset-1 focus:outline-blue-300"
		/>
		<select
			name={ action.FieldStepApproverType }
			aria-label="Approver type"
			class="approver-type h-9 rounded-md border border-slate-300 bg-white px-2 text-sm outline-none focus:outline-2 focus:outline-offset-1 focus:outline-blue-300"
			_="on change if my value is 'Group' then remove .hidden from the next <.approver-group/> then add .hidden to the next <.approver-user/> else add .hidden to the next <.approver-group/> then remove .hidden from the next <.approver-user/> end"
		>
			<option value={ domain.ActorKindUser }>{ domain.ActorKindUser }</option>
			<option value={ domain.ActorKindGroup }>{ domain.ActorKindGroup }</option>
		</select>
		<select
			name={ action.FieldStepAssignee }
			aria-label="Approver"
			class="approver-user h-9 min-w-44 grow rounded-md border border-slate-300 bg-white px-3 text-sm outline-none focus:outline-2 focus:outline-offset-1 focus:outline-blue-300"
		>
			<option value="">Select a person…</option>
			for _, opt := range approvers[domain.UserMachineID] {
				<option value={ opt.ID }>{ opt.Label }</option>
			}
		</select>
		<select
			name={ action.FieldStepApproverGroup }
			aria-label="Approver group"
			class="approver-group hidden h-9 min-w-44 grow rounded-md border border-slate-300 bg-white px-3 text-sm outline-none focus:outline-2 focus:outline-offset-1 focus:outline-blue-300"
		>
			<option value="">Select a group…</option>
			for _, opt := range groups {
				<option value={ opt.ID }>{ opt.Label }</option>
			}
		</select>
		<span class="ml-auto flex items-center gap-1">
			<button type="button" title="Move up" aria-label="Move step up" class="cursor-pointer px-1.5 text-slate-400 hover:text-slate-700" _="on click if the previous &lt;.approver-row/&gt; exists put closest &lt;.approver-row/&gt; before the previous &lt;.approver-row/&gt; end">▲</button>
			<button type="button" title="Move down" aria-label="Move step down" class="cursor-pointer px-1.5 text-slate-400 hover:text-slate-700" _="on click if the next &lt;.approver-row/&gt; exists put closest &lt;.approver-row/&gt; after the next &lt;.approver-row/&gt; end">▼</button>
			<button type="button" title="Remove" aria-label="Remove step" class="cursor-pointer px-1.5 text-slate-400 hover:text-red-600" _="on click remove closest &lt;.approver-row/&gt;">✕</button>
		</span>
	</div>
}
