package rendering

import (
	"context"

	"menata.app/internal/domain"
)

// DocumentSubmitPage is Case 3's submission wizard, ported to
// ui-sample/case-03-flow1/08-submit-document.html (Fase 6c-2).
//
// EVERY OPTION LIST ON THIS SCREEN COMES FROM METADATA. `documentType` and `mode` are
// mch_document's own Fields, passed in rather than retyped: fld_document_type was fixed when the
// Field was added, and fld_mode was the last one left -- two `value="sequential"` /
// `value="parallel"` literals sitting two sections below a select that already did it correctly,
// so a metadata-only change to the mode vocabulary never reached this screen. `approvers` and
// `groups` are resolved by composition.Loader, not read off records here, which is what let this
// file out of internal/conformance's projection ratchet.
//
// ONE BOARD ELEMENT IS DELIBERATELY NOT RENDERED: the board's eyebrow reads "STEP 1 OF 3" and this
// says "Step 1 of 2". There is no third screen: board 09 is step 2 and no step-3 board exists
// anywhere in the set. Writing "of 3" would promise a screen nobody can reach. ROADMAP.md's
// deferral table carries what the third step would be for, and the finding behind it -- a
// Document becomes in_review the moment this form is submitted, before any signature is placed.
//
// "Save this as the default approval flow for <Type>" -- CAP-V28, ROADMAP.md, 2026-09-27 -- is
// rendered now (the checkbox below the approver rows). Picking a Document Type fetches that
// type's own saved flow, if one exists (GET /documents/new/approval-flow-template, htmx-triggered
// on the doc_type <select>'s change event) and replaces the approver rows and mode fieldset with
// it -- see showApprovalFlowTemplateRows (internal/web/document.go) and ApprovalFlowTemplateRows
// below for the fragment this swaps in.
//
// draft is the zero value on a fresh submission and the Draft's own stored values when this page
// is reopened by "Continue" on My Documents (internal/web.showDocumentContinue, Flow 2 gap study
// Tahap 4, 2026-09-25) -- see DraftPrefill's own doc comment for what each half of this page does
// differently. Approver rows are never prefilled either way: a Draft is guaranteed to carry none
// (see internal/web.continueDocumentWizard's own doc comment).
templ DocumentSubmitPage(documentType, mode domain.Field, approvers RelationOptions, groups GroupOptions, fields StepFields, workspaceName string, viewer Viewer, switchWorkspaceHref string, draft DraftPrefill) {
	// "New Document" is a literal for the same reason the button that opens this screen is -- see
	// approvalinbox.templ's own comment: nav_new_approval was deleted on 2026-09-21 because a submit
	// form is not a menu destination, and no Page-level title/action primitive exists yet (007
	// §12.3 ActionBar). activeNavID is "" -- this screen is a sub-page of the Approval Inbox, the
	// same way Edit member is one of Workspace Members.
	@appShell("New Document", workspaceName, viewer, switchWorkspaceHref) {
		<a href={ templ.SafeURL(routeByID(ctx, "nav_approval_inbox")) } class="text-xs text-blue-600 hover:text-blue-700">
			← { labelByID(ctx, "nav_approval_inbox") }
		</a>
		<div class="flex flex-col gap-2">
			@staticText(domain.StaticEyebrow, "Step 1 of 2")
			@staticText(domain.StaticHeading, "New Document")
			<div class="text-sm text-slate-500">Submit a document for approval.</div>
		</div>
		<form
			hx-post={ documentSubmitAction(ctx, draft) }
			hx-encoding="multipart/form-data"
			class="flex flex-col gap-4"
		>
			@csrfHiddenInput()
			@sectionLayout(domain.GapComfortable) {
				@staticText(domain.StaticPanelHeading, "Document")
				@field("doc_title", "Title") {
					<input id="doc_title" type="text" name="fld_title" value={ draft.Title } required class={ fieldClasses(ctx) }/>
				}
				@field("doc_type", documentType.Name) {
					<select
						id="doc_type"
						name={ documentType.ID }
						required
						class={ fieldClasses(ctx) }
						hx-get="/documents/new/approval-flow-template"
						hx-trigger="change"
						hx-target="#approver-rows"
						hx-swap="innerHTML"
						hx-include="this"
					>
						<option value="">{ "" }</option>
						for _, opt := range documentType.Options {
							<option value={ opt } selected?={ opt == draft.DocumentType }>{ opt }</option>
						}
					</select>
				}
				@field("doc_file", "PDF file") {
					<input id="doc_file" type="file" name="fld_file" accept="application/pdf" required?={ draft.ID == "" } class="text-sm"/>
					if draft.ID != "" {
						@staticText(domain.StaticCaption, "Current file: " + draft.FileName + " — choose a new file to replace it.")
					}
				}
			}
			@splitLayout(domain.GapComfortable, domain.SplitAsideStart, domain.AsideNarrow) {
				@modeFieldset(mode, draft.Mode)
				@sectionLayout(domain.GapComfortable) {
					@rowLayout(domain.GapDefault, domain.RowAlignCenter, domain.RowJustifySpread) {
						@staticText(domain.StaticPanelHeading, "Approval steps")
						<button
							type="button"
							hx-get="/documents/new/approver-row"
							hx-target="#approver-rows"
							hx-swap="beforeend"
							class="cursor-pointer text-xs text-blue-600 hover:text-blue-700"
						>+ Add approver</button>
					}
					<p class="m-0 text-2xs text-slate-500">
						Each step is one person or a whole group. The order below is used only when
						{ mode.Name } is { firstOption(mode) } — use ▲/▼ to reorder.
					</p>
					<div id="approver-rows" class="flex flex-col gap-2.5 [counter-reset:approver-step]">
						@ApproverRow(approvers, groups, fields, StepPrefill{})
					</div>
				}
			}
			<label class="flex cursor-pointer items-center gap-2 text-sm text-slate-700">
				<input type="checkbox" name="save_as_default_flow" value="1" checked class="size-4 accent-blue-500"/>
				Save this as the default approval flow for this document type
			</label>
			<div class="flex justify-end gap-2">
				if draft.ID == "" {
					@button("Save as draft", domain.ButtonSecondary, "intent", "draft")
				}
				@button("Continue →", domain.ButtonPrimary, "intent", "submit")
			</div>
		</form>
	}
}

// DraftPrefill is DocumentSubmitPage's own "which mode is this render" switch (Flow 2 gap study
// Tahap 4, 2026-09-25). The zero value (ID == "") is a fresh submission: no prefill, both the
// "Save as draft" button and the file input's `required` are live, and the form posts to
// POST /documents. A non-empty ID is "Continue" reopening an existing Draft
// (internal/web.showDocumentContinue): the four fields already on this form are prefilled from it,
// there is no "Save as draft" button (continuing always finalizes -- see this file's own scope
// note above ApproverRow... no, see continueDocumentWizard's doc comment in internal/web), the file
// input is optional (a Draft already has one; internal/web's own carry-forward keeps it when
// nothing new is chosen), and the form posts to POST .../records/{ID}/continue-submit instead.
type DraftPrefill struct {
	ID           string
	Title        string
	DocumentType string
	Mode         string
	// FileName is the draft's current file, storage.DisplayName's own already-human-readable form
	// (never the raw storage key), shown so "no re-upload" doesn't look like an oversight.
	FileName string
}

// documentSubmitAction is this form's own POST target -- computed rather than hardcoded twice
// (once here, once as a literal), since the two routes it switches between are themselves internal
// routing detail, not metadata.
func documentSubmitAction(ctx context.Context, draft DraftPrefill) string {
	if draft.ID == "" {
		return "/documents"
	}
	return "/machines/" + approvalMachineID(ctx, domain.WorkflowRoleDocument) + "/records/" + draft.ID + "/continue-submit"
}

// modeChecked marks opt as the radio the browser should pre-check: the draft's own stored fld_mode
// when continuing one, otherwise the Field's first declared option (metadata/document.yaml
// declares sequential first for exactly the reason firstOption's own comment names).
func modeChecked(draftMode, opt string, i int) bool {
	if draftMode != "" {
		return opt == draftMode
	}
	return i == 0
}

// modeFieldset is DocumentSubmitPage's own Mode picker, extracted (CAP-V28, ROADMAP.md,
// 2026-09-27) so ApprovalFlowTemplateRows below can re-render it out-of-band when a saved
// template's own mode should replace whatever the wizard currently shows. selected is either a
// Draft's own stored fld_mode (the page's initial render) or a saved template's (the fragment's
// own re-render); "" means neither -- modeChecked's existing fallback to the Field's first option
// covers it unchanged.
templ modeFieldset(mode domain.Field, selected string) {
	<fieldset id="mode-fieldset" class="m-0 flex flex-col gap-3 rounded-lg border border-slate-200 bg-white p-5">
		@modeFieldsetContent(mode, selected)
	</fieldset>
}

// modeFieldsetOOB is modeFieldset's own out-of-band twin -- identical markup, plus
// hx-swap-oob="true" so htmx updates it wherever it already sits in the DOM regardless of what the
// same response's own hx-target/hx-swap replaces. Two templ functions rather than one with a bool
// flag deciding whether to print the attribute: templ has no clean way to omit an attribute
// conditionally on one element, and duplicating one wrapping <fieldset> tag around a shared
// modeFieldsetContent is simpler than the alternative.
templ modeFieldsetOOB(mode domain.Field, selected string) {
	<fieldset id="mode-fieldset" hx-swap-oob="true" class="m-0 flex flex-col gap-3 rounded-lg border border-slate-200 bg-white p-5">
		@modeFieldsetContent(mode, selected)
	</fieldset>
}

templ modeFieldsetContent(mode domain.Field, selected string) {
	<legend class="px-1 text-sm font-medium">{ mode.Name }</legend>
	<p class="m-0 text-2xs text-slate-500">
		Sequential activates each step in order. Parallel allows all assigned approvers to
		decide independently.
	</p>
	for i, opt := range mode.Options {
		<label class="flex cursor-pointer items-center gap-2.5 rounded-md border border-slate-200 p-3 text-sm hover:border-blue-300">
			<input type="radio" name={ mode.ID } value={ opt } checked?={ modeChecked(selected, opt, i) } class="size-4 accent-blue-500"/>
			{ opt }
		</label>
	}
}

// wizardField is one labelled control on this page. Not authField (authshell.templ): that one is
// the pre-auth kit's, owns its own <input> and its own sizing, and its doc comment says so. This
// wraps whatever control it is given, because this form has four different ones.
// **`wizardField` became `field` on 2026-10-03** -- `registry.Components`' fifth member and §12.3's own
// `Field`. The markup is unchanged: this was already a label plus a slotted control, which is exactly the
// contract, so registering it was naming what was here rather than building anything.
//
// `authField` (authshell.templ) carried the identical wrapper and label with one hardcoded `<input>` after
// them; it is an adapter over this now, and both migrations are byte-identical.
templ field(forID, label string) {
	<div class="flex flex-col gap-2">
		<label for={ forID } class="text-sm font-medium">{ label }</label>
		{ children... }
	</div>
}

// wizardSelect renders a status Field's own declared options. Taking the []string rather than the
// Field keeps it usable for the approver-type picker too, whose values are domain.ActorKind*
// rather than a Field's Options -- see approverTypeSelect. selected marks the matching option
// (a Draft's own stored value, when DocumentSubmitPage is reopened via "Continue"); "" selects
// none, leaving the placeholder shown, exactly as every fresh-wizard call already behaved.
templ wizardSelect(id, name string, options []string, placeholder, selected string) {
	<select id={ id } name={ name } required class={ fieldClasses(ctx) }>
		<option value="">{ placeholder }</option>
		for _, opt := range options {
			<option value={ opt } selected?={ opt == selected }>{ opt }</option>
		}
	</select>
}

// firstOption names the mode whose ordering actually matters, without retyping "Sequential" -- the
// value is metadata's, and metadata/document.yaml declares sequential first for exactly the reason
// this sentence needs. Falls back to nothing rather than to a guessed word.
func firstOption(f domain.Field) string {
	if len(f.Options) == 0 {
		return ""
	}
	return f.Options[0]
}

// StepPrefill is one saved Approval Flow Template step's own values, rendered back into an
// ApproverRow (CAP-V28, ROADMAP.md, 2026-09-27) the same way DraftPrefill renders a Draft's own
// stored Document Fields back into this page. The zero value renders ApproverRow's original blank
// row unchanged -- every existing caller (DocumentSubmitPage's initial row, newApproverRow's own
// "+ Add approver" fragment) passes it.

// StepFields are the form input names one approver row writes under, resolved from the step Machine's
// own declarations (action.DeclaredFields) and handed in -- the same shape PlacementFields already
// takes for board 09, and for the same reason.
//
// **The read side derived these from the moment they existed; this side did not.** parseStepInputs has
// always read req.Form[f.ActorType] and friends, while these three attributes were
// action.FieldStep* constants -- so the two ends of one form agreed by coincidence rather than by
// reading one declaration. A comment in internal/web claimed otherwise, including after an edit on
// 2026-09-29 that strengthened it to "**Every** input name comes from the step Machine's own
// declarations". That was false until this struct existed.
type StepFields struct {
	ApproverType  string
	Assignee      string
	ApproverGroup string
}

type StepPrefill struct {
	ApproverType string
	AssigneeID   string
	GroupID      string
}

// ApproverRow is one approval step: what the step is for, who decides it, and whether that "who"
// is a person or a whole Workspace Group (board 08's own User/Group toggle, CAP-F24).
//
// Rendered identically for the wizard's initial row, the "+ Add approver" HTMX fragment, and a
// saved Approval Flow Template's own rows (ApprovalFlowTemplateRows below), from one
// readWizardOptions call, so a later row can never offer a different set than the first.
//
// THE TYPE PICKER IS A <select>, NOT THE BOARD'S SEGMENTED BUTTONS, and that is a correctness
// choice rather than a styling one. Row order *is* fld_sequence -- there is no hidden sequence
// input, the browser submits repeated field names in DOM order and the server uses the index -- so
// the four per-row controls arrive as parallel slices that must stay aligned. An unchecked radio
// submits nothing at all, so a radio-pair toggle would drop an element and silently attach every
// later row's approver to the wrong step. A <select> always submits exactly one value per row.
//
// Reordering (put ... before/after the previous/next <.approver-row/>) and removal (remove closest
// <.approver-row/>) stay pure client-side DOM operations -- Hyperscript's own named case in
// README.md's Tech stack, and appShell loads it. The step number is a CSS counter for the same
// reason: rows are added, removed and reordered in the browser, so a number passed from Go would
// go stale on the first ▲.
//
// prefill's approver-type visibility (which of .approver-user/.approver-group starts hidden) is
// decided here, server-side, at render time -- the hyperscript toggle above only reacts to a
// future change event, so a row rendered already-Group needs the right starting classes, not just
// the right starting <select> value.
templ ApproverRow(approvers RelationOptions, groups GroupOptions, fields StepFields, prefill StepPrefill) {
	<div class="approver-row flex flex-wrap items-center gap-2 rounded-md border border-slate-200 p-2.5 [counter-increment:approver-step]">
		<span
			aria-hidden="true"
			class="flex size-7 shrink-0 items-center justify-center rounded-full bg-blue-600 text-3xs font-medium text-white before:[content:counter(approver-step)]"
		></span>
		<select
			name={ fields.ApproverType }
			aria-label="Approver type"
			class={ "approver-type px-2 " + fieldClasses(ctx) }
			_="on change if my value is 'Group' then remove .hidden from the next <.approver-group/> then add .hidden to the next <.approver-user/> else add .hidden to the next <.approver-group/> then remove .hidden from the next <.approver-user/> end"
		>
			<option value={ domain.ActorKindUser } selected?={ prefill.ApproverType != domain.ActorKindGroup }>{ domain.ActorKindUser }</option>
			<option value={ domain.ActorKindGroup } selected?={ prefill.ApproverType == domain.ActorKindGroup }>{ domain.ActorKindGroup }</option>
		</select>
		<select
			name={ fields.Assignee }
			aria-label="Approver"
			class={ approverUserClass(ctx, prefill.ApproverType == domain.ActorKindGroup) }
		>
			<option value="">Select a person…</option>
			for _, opt := range approvers[domain.UserMachineID] {
				<option value={ opt.ID } selected?={ opt.ID == prefill.AssigneeID }>{ opt.Label }</option>
			}
		</select>
		<select
			name={ fields.ApproverGroup }
			aria-label="Approver group"
			class={ approverGroupClass(ctx, prefill.ApproverType != domain.ActorKindGroup) }
		>
			<option value="">Select a group…</option>
			for _, opt := range groups {
				<option value={ opt.ID } selected?={ opt.ID == prefill.GroupID }>{ opt.Label }</option>
			}
		</select>
		<span class="ml-auto flex items-center gap-1">
			<button type="button" title="Move up" aria-label="Move step up" class="cursor-pointer px-1.5 text-slate-400 hover:text-slate-700" _="on click if the previous &lt;.approver-row/&gt; exists put closest &lt;.approver-row/&gt; before the previous &lt;.approver-row/&gt; end">▲</button>
			<button type="button" title="Move down" aria-label="Move step down" class="cursor-pointer px-1.5 text-slate-400 hover:text-slate-700" _="on click if the next &lt;.approver-row/&gt; exists put closest &lt;.approver-row/&gt; after the next &lt;.approver-row/&gt; end">▼</button>
			<button type="button" title="Remove" aria-label="Remove step" class="cursor-pointer px-1.5 text-slate-400 hover:text-red-600" _="on click remove closest &lt;.approver-row/&gt;">✕</button>
		</span>
	</div>
}

// approverUserClass/approverGroupClass are ApproverRow's own two arms' starting classes --
// "hidden" placed right after the arm's own class name, matching the literal string shape this
// markup always had, now decided from prefill.ApproverType instead of unconditionally hiding the
// Group arm the way every row did before StepPrefill existed.
func approverUserClass(ctx context.Context, hide bool) string {
	class := "approver-user"
	if hide {
		class += " hidden"
	}
	return class + " min-w-44 grow " + fieldClasses(ctx)
}

func approverGroupClass(ctx context.Context, hide bool) string {
	class := "approver-group"
	if hide {
		class += " hidden"
	}
	return class + " h-9 min-w-44 grow rounded-md border border-slate-300 bg-white px-3 text-sm outline-none focus:outline-2 focus:outline-offset-1 focus:outline-blue-300"
}

// ApprovalFlowTemplateRows is the doc_type <select>'s own htmx fragment (CAP-V28, ROADMAP.md,
// 2026-09-27, showApprovalFlowTemplateRows in internal/web/document.go): one ApproverRow per saved
// step (or one blank row when steps is empty, matching a fresh wizard's own starting state) inside
// #approver-rows' own innerHTML, plus modeFieldsetOOB updating the Mode picker independently --
// the response is two sibling fragments, not one, because the hx-target/hx-swap on the doc_type
// <select> can only ever point at one of them.
templ ApprovalFlowTemplateRows(approvers RelationOptions, groups GroupOptions, fields StepFields, mode domain.Field, steps []StepPrefill, selectedMode string) {
	if len(steps) == 0 {
		@ApproverRow(approvers, groups, fields, StepPrefill{})
	} else {
		for _, s := range steps {
			@ApproverRow(approvers, groups, fields, s)
		}
	}
	@modeFieldsetOOB(mode, selectedMode)
}
