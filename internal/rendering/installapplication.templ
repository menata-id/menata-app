package rendering

import "menata.app/internal/domain"

import (
	"fmt"
	"strings"
)

// InstallableTemplate is one row of the template library as this Workspace would receive it: what the
// template is, and what installing it here would actually do.
//
// Renames/AddShared/Refusals are decided by internal/installer.PlanInstall and handed here already
// resolved -- a Page renders what it was given (007 §20). It matters more than usual for this screen:
// the same function decides what the POST does, so what an admin reads before clicking is what happens
// when they click.
type InstallableTemplate struct {
	ApplicationID string
	Name          string
	Description   string
	Icon          string
	Color         string
	// Roles is the template's own role vocabulary; the install form offers them so the admin doing the
	// install holds one immediately (internal/web.grantInstallerRole -- without it they would be locked
	// out of the Application they just installed). Empty means the Application gates on no role.
	Roles []string
	// MachineNames is what the Application brings, by name rather than by id: the id is an
	// implementation detail of the copy, and a name is what tells someone whether they want it.
	MachineNames []string
	// Renames are the ids this Workspace already uses, and what the copy will call them instead.
	Renames []InstallRename
	// AddShared are the runtime-level Machines this Workspace is missing and will gain a reference to.
	AddShared []string
	// Refusals are why this template cannot be installed here. Non-empty disables the button.
	Refusals []string
}

// InstallRename is one id the install will change, and what to.
type InstallRename struct {
	From string
	To   string
}

// InstallApplicationPage is the template library: everything that can be installed into this
// Workspace, and for each one, exactly what that would do (ROADMAP.md, 2026-09-28).
//
// It is the first way to install anything without the AI assistant -- metadata/applications/ has been a
// library nothing could reach since it existed. **A named departure from the Flow 2 mockup**, which
// draws no install-from-library concept at all: the capability did not exist when the boards were
// drawn, so there is nothing there to match. Structurally it follows the Workspace-level screens it
// sits beside (appShell, a heading read from its own runtime screen, cards in a column).
templ InstallApplicationPage(templates []InstallableTemplate, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	@appShell(titleByID(ctx, "nav_install_application"), workspaceName, viewer, switchWorkspaceHref) {
		<div class="flex flex-col gap-1">
			@staticText(domain.StaticOverline, "Administration")
			@staticText(domain.StaticHeading, titleByID(ctx, "nav_install_application"))
			<p class="m-0 text-sm leading-6 text-slate-500">{ descriptionByID(ctx, "nav_install_application") }</p>
		</div>
		if len(templates) == 0 {
			<div class="rounded-lg border border-slate-200 bg-white p-5 text-sm text-slate-500">
				There are no ready-made applications in this installation's template library.
			</div>
		}
		<div class="flex flex-col gap-4">
			for _, t := range templates {
				@installableCard(t)
			}
		</div>
	}
}

templ installableCard(t InstallableTemplate) {
	@sectionLayout(domain.GapComfortable) {
		<div class="flex items-start gap-3.5">
			// appIconClasses, the same tile the Home card uses -- a template and an installed
			// Application are the same thing at two moments, so they should look it.
			<span class={ "flex size-10 shrink-0 items-center justify-center rounded-lg", appIconClasses(t.Color) }>
				if t.Icon != "" {
					@icon(t.Icon, "size-5.5")
				}
			</span>
			<div class="flex flex-col gap-1">
				<h2 class="m-0 text-[15px] font-medium">{ t.Name }</h2>
				if t.Description != "" {
					<span class="text-xs leading-5 text-slate-500">{ t.Description }</span>
				}
				<span class="text-2xs text-slate-400">{ machineSummary(t.MachineNames) }</span>
			</div>
		</div>
		if len(t.Refusals) > 0 {
			<div class="flex flex-col gap-1.5 rounded-md bg-amber-50 px-3.5 py-3">
				<span class="text-xs font-medium text-amber-900">Cannot be installed in this workspace</span>
				for _, reason := range t.Refusals {
					<span class="text-2xs leading-5 text-amber-800">{ reason }</span>
				}
			</div>
		} else {
			if len(t.Renames) > 0 || len(t.AddShared) > 0 {
				<div class="flex flex-col gap-1.5 rounded-md bg-slate-50 px-3.5 py-3">
					<span class="text-xs font-medium text-slate-700">What will change on the way in</span>
					for _, r := range t.Renames {
						<span class="text-2xs leading-5 text-slate-500">
							This workspace already uses <code class="font-mono">{ r.From }</code>, so the copy will be called <code class="font-mono">{ r.To }</code>.
						</span>
					}
					if len(t.AddShared) > 0 {
						<span class="text-2xs leading-5 text-slate-500">
							{ fmt.Sprintf("Adds the shared %s this application needs.", strings.Join(t.AddShared, " and ")) }
						</span>
					}
				</div>
			}
			<form method="POST" action={ templ.SafeURL(routeByID(ctx, "nav_install_application")) } class="flex flex-wrap items-center gap-2.5">
				@csrfHiddenInput()
				<input type="hidden" name="template" value={ t.ApplicationID }/>
				if len(t.Roles) > 0 {
					<label for={ "role-" + t.ApplicationID } class="text-2xs text-slate-500">Your role here</label>
					<select id={ "role-" + t.ApplicationID } name="role" class={ controlField }>
						for _, role := range t.Roles {
							<option value={ role }>{ role }</option>
						}
					</select>
				}
				@button("Install", domain.ButtonPrimary, "", "")
			</form>
		}
	}
}

// machineSummary is the one-line "what this brings" under a template's description -- names, not ids,
// and count-first so the shape of the Application is readable before the list is.
func machineSummary(names []string) string {
	if len(names) == 0 {
		return ""
	}
	return fmt.Sprintf("%d data model%s: %s", len(names), pluralS(len(names)), strings.Join(names, ", "))
}
