package rendering

import (
	"context"
	"strconv"
	"strings"

	"menata.app/internal/domain"
)

// TableColumn is one column of a Table: the words in its header and which edge its text sits on. A cell does not
// repeat either -- the cell is drawn by the caller, which asks `tableCellClasses`/`tableAlignClass` for its look.
type TableColumn struct {
	Header string
	Align  domain.TableAlign
	// Hidden keeps Header for assistive technology and draws none of it (`hide_header:` on a declared column).
	Hidden bool
}

// tableAlignClass is the edge a column's text sits on, for a header cell and for each body cell of that column.
func tableAlignClass(a domain.TableAlign) string {
	if a == domain.TableAlignEnd {
		return "text-right"
	}
	return "text-left"
}

// dataTable is the one `<table>` this tree draws (007 §12.3 `Table`; 006 "List View = Collection + Projection +
// Table renderer"). It owns the element, the header row and the scroll box; **the rows are a slot**, because the
// generic record table's row is a whole `<tr>` with its own htmx wiring (`RecordRow`) and the Dashboard's holds a
// badge beside a name. A Table that took cells as data would be a different function per screen.
//
// `label` is the table's accessible name. None of the six tables this replaced had one, so a screen-reader user
// reached "table, 3 columns" and was told nothing about which; making it a required input is what a contract can
// force that a reviewer reading six screens did not. Each header is `scope="col"` for the same reason.
//
// The frame (`surfaceClasses`) is the caller's, not the table's: three of the six sit in a panel that already has
// one, and a bordered box inside a bordered box is a defect, not a choice. The scroll box is the table's, since a
// table wider than a phone must scroll itself rather than the page.
templ dataTable(label string, columns []TableColumn) {
	<div class="overflow-x-auto">
		<table class={ "w-full border-collapse", textClass(ctx, domain.RoleBody) } aria-label={ label }>
			<thead>
				<tr>
					for _, c := range columns {
						<th scope="col" class={ tableHeadCellClassesFor(ctx, c.Align) }>
							if c.Hidden {
								<span class="sr-only">{ c.Header }</span>
							} else {
								{ c.Header }
							}
						</th>
					}
				</tr>
			</thead>
			<tbody>
				{ children... }
			</tbody>
		</table>
	</div>
}

// recordTableColumns is the generic record table's columns: one per Field, named by it, then an unnamed one for the
// row's own actions (edit, delete) -- the shape `tableLayout` and `ChildSectionView` both drew by hand.
func recordTableColumns(fields []domain.Field) []TableColumn {
	cols := make([]TableColumn, 0, len(fields)+1)
	for _, f := range fields {
		cols = append(cols, TableColumn{Header: f.Name})
	}
	return append(cols, TableColumn{})
}

// table is the registered renderer for `domain.ComponentTable` (007 §12.3 `Table`): `dataTable` with its rows drawn from
// cells that arrive composed, one row's worth at a time. headers is one header per line and aligns one alignment per
// header, both produced by lowering from the page's `columns:`; the cells are row-major, so cell i belongs to column
// i mod the number of headers and to row i div that number. A table with no cells and an `empty` text says that instead
// of drawing a header over nothing.
templ table(label, empty, headers, aligns, hidden string, framed bool, truncated Truncation, footer, density, group_by, row_tone, groups, rowtones string, cells []templ.Component) {
	{{ cols := tableColumnsFromProps(headers, aligns, hidden) }}
	if len(cells) == 0 && empty != "" {
		@staticText(domain.StaticMessage, empty)
	} else if framed {
		<div class={ surfaceClasses(ctx) }>
			@tableBody(label, cols, cells, footer, density, group_by, row_tone, groups, rowtones)
		</div>
		@truncationNotice(truncated)
	} else {
		@tableBody(label, cols, cells, footer, density, group_by, row_tone, groups, rowtones)
		@truncationNotice(truncated)
	}
}

// tableBody is a Table's rows: the cells arrive row-major, one row's worth at a time. With `groups` the rows are folded group by group -- each group a <details> open
// on its own, its header the group's name and how many rows are in it -- and with `rowtones` a row takes the tone its record has. Without either it is one table, as it always was.
templ tableBody(label string, cols []TableColumn, cells []templ.Component, footer, density, group_by, row_tone, groups, rowtones string) {
	if groups == "" {
		@dataTable(label, cols) {
			@tableRows(cols, cells, 0, len(cells)/max(len(cols), 1), density, row_tone, rowtones, 0)
			@tableFooterRow(cols, footer, density)
		}
	} else {
		{{ perRow := max(len(cols), 1) }}
		{{ at := 0 }}
		{{ lines := strings.Split(groups, "\n") }}
		for g, line := range lines {
			{{ name, count := tableGroupOf(line) }}
			<details open data-group-by={ group_by } class="mb-3">
				<summary class={ "flex cursor-pointer items-center", layoutGap(ctx, domain.GapTight), "py-2" }>
					@collectionHeading(name, "", count)
				</summary>
				@dataTable(label+": "+name, cols) {
					@tableRows(cols, cells, at, count, density, row_tone, rowtones, at/perRow)
					if g == len(lines)-1 {
						// The total row closes the last group's table, so its columns line up with the rows above it.
						@tableFooterRow(cols, footer, density)
					}
				}
			</details>
			{{ at += count * perRow }}
		}
	}
}

// tableRows draws `count` rows of the cells from cell index `from`; first is the place of the first of them among all the rows, which is where its tone is in rowtones.
templ tableRows(cols []TableColumn, cells []templ.Component, from, count int, density, row_tone, rowtones string, first int) {
	{{ tones := strings.Split(rowtones, ",") }}
	for r := 0; r < count && from+(r+1)*len(cols) <= len(cells); r++ {
		{{ tone := tableRowTone(ctx, tones, first+r) }}
		<tr if tone != "" { class={ tone } data-row-tone={ row_tone } }>
			for j, c := range cols {
				<td class={ tableCellClasses(ctx), tableCellDensity(domain.ListDensity(density)), tableAlignClass(c.Align) }>
					@cells[from+r*len(cols)+j]
				</td>
			}
		</tr>
	}
}

// tableFooterRow is the total row (`total:` on the columns): the same cells, emphasised, under the rows.
templ tableFooterRow(cols []TableColumn, footer, density string) {
	if footer != "" {
		<tr>
			for j, text := range strings.Split(footer, "\t") {
				if j < len(cols) {
					<td class={ tableCellClasses(ctx), tableCellDensity(domain.ListDensity(density)), tableAlignClass(cols[j].Align), weightClass(ctx, domain.WeightEmphasis), inkClass(ctx, domain.InkStrong) }>{ text }</td>
				}
			}
		</tr>
	}
}

// tableCellDensity is a body cell's padding for each declared density, whole literal strings as the scanner needs; regular is the padding tableCellClasses already gives, so it adds none.
func tableCellDensity(density domain.ListDensity) string {
	switch density {
	case domain.ListCompact:
		return "py-1"
	case domain.ListRoomy:
		return "py-4"
	}
	return ""
}

// tableRowTone is the wash a row takes for the tone its record has: nothing for no tone, a neutral one or an unknown word. It reads the tone's own fill, so a Workspace that remaps a
// tone moves the rows with it.
func tableRowTone(ctx context.Context, tones []string, i int) string {
	if i < 0 || i >= len(tones) {
		return ""
	}
	switch tone := domain.BadgeTone(tones[i]); tone {
	case domain.ToneBad, domain.ToneWarn, domain.ToneGood, domain.ToneInfo:
		return toneFillClass(ctx, tone)
	}
	return ""
}

// tableGroupOf reads one line of the lowered `groups`: the name, and how many rows it holds.
func tableGroupOf(line string) (string, int) {
	name, count, _ := strings.Cut(line, "\t")
	n, _ := strconv.Atoi(count)
	return name, n
}

// tableColumnsFromProps reads the two lowered properties back into columns. A missing or short alignment list is the
// start edge, never a panic: ir.Validate and the contract's validator refuse a tree whose counts disagree, and this is
// the second line of defence for one that reached the renderer anyway.
func tableColumnsFromProps(headers, aligns, hidden string) []TableColumn {
	if headers == "" {
		return nil
	}
	hs := strings.Split(headers, "\n")
	as := strings.Split(aligns, ",")
	out := make([]TableColumn, len(hs))
	for i, h := range hs {
		out[i].Header = h
		if i < len(as) && domain.TableAlign(as[i]) == domain.TableAlignEnd {
			out[i].Align = domain.TableAlignEnd
		}
	}
	for _, h := range strings.Split(hidden, ",") {
		if i, err := strconv.Atoi(strings.TrimSpace(h)); err == nil && i >= 0 && i < len(out) {
			out[i].Hidden = true
		}
	}
	return out
}
