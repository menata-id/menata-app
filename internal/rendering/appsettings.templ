package rendering

import (
	"strconv"

	"menata.app/internal/domain"
)

// permissionsSection is the query value that selects the Permissions view of a Settings hub. The view
// is the runtime's own (a role matrix derived from the Application's `roles:` and Machines), not a
// navigation item an Application declares, so it has no id to look up; its two strings below are the
// runtime's, like the Access heading beside them.
const permissionsSection = "permissions"

const (
	permissionsTitle       = "Permissions"
	permissionsDescription = "Who can do what in this application."
	membersRolesTitle      = "Members & roles"
	membersRolesBlurb      = "Who can use this application, and with which role."
)

// pageTitle is the <title> tag ApplicationSettingsPage renders -- the hub's own title normally, the
// Permissions view's while its content is what's showing, matching how every other screen's <title>
// tracks what a viewer is actually looking at.
func pageTitle(hub SettingsHubView, showingDetail bool) string {
	if showingDetail {
		return permissionsTitle
	}
	return hub.Title
}

// permissionsHref is the Permissions view of hub: the hub's own route plus the section query.
func permissionsHref(hub SettingsHubView) string {
	return hub.HubRoute + "?section=" + permissionsSection
}

// SettingsMember is one row under Configuration: a `settings_hub_member` navigation item, read whole.
type SettingsMember struct {
	Href        string
	Label       string
	Description string
}

// SettingsHubView is one Application's Settings hub, resolved by composition.ApplicationSettingsHub
// from what the Application declares. Nothing in it is specific to one Application.
type SettingsHubView struct {
	// HubRoute, Title and Description are the hub item's own route, heading and description.
	HubRoute    string
	Title       string
	Description string
	// ShowAccess is len(app.Roles) > 0 -- an Application declaring no roles has nothing to configure
	// access for, so the whole Access section is absent, not three empty-looking rows.
	ShowAccess bool
	// ShowMembersAndGroups additionally requires the viewer to be a Workspace admin -- hidden, not
	// shown-then-403. Permissions itself carries no such gate: it is read-only for any member.
	ShowMembersAndGroups bool
	// MembersHref is this Application's own Members & roles page (S2.2): the hub's route plus
	// /members, so it needs no navigation item of its own and names no Application.
	MembersHref string
	// Members are the Application's own settings_hub_member items, in declaration order.
	Members []SettingsMember
	// About: the Application's own name and description and what it holds.
	AppName        string
	AppDescription string
	MachineCount   int
	RoleCount      int
}

// settingsRow is one real, linked destination in the Access section -- styled like
// workspacehome.templ's own Application row (label, description, trailing chevron), reused rather
// than a new shape invented for this page. current marks the row for the screen already showing
// (only ever true for Permissions, and only on desktop -- the mobile list never renders alongside
// its own detail view, so current has nothing to highlight there).
templ settingsRow(href, label, description string, current bool) {
	<a
		href={ templ.SafeURL(href) }
		if current {
			aria-current="page"
		}
		class={ "flex items-start gap-3 rounded-md p-3", templ.KV("bg-slate-100", current), templ.KV("hover:bg-slate-50", !current) }
	>
		<span class="flex min-w-0 grow flex-col gap-0.5">
			<span class={ "text-sm text-slate-900", templ.KV("font-medium", current) }>{ label }</span>
			if description != "" {
				<span class="text-xs text-slate-500">{ description }</span>
			}
		</span>
		<span class="shrink-0 text-slate-300">
			@icon("chevron-right", "size-4")
		</span>
	</a>
}

// settingsPlaceholderRow is an honest, non-interactive row for a section this runtime cannot serve
// yet -- no <a href>, so it can never be a link to nowhere, plus a muted tag saying so rather than
// leaving the reason to be guessed.
templ settingsPlaceholderRow(label, description string) {
	<div class="flex items-start gap-3 rounded-md p-3">
		<span class="flex min-w-0 grow flex-col gap-0.5">
			<span class="flex flex-wrap items-center gap-2 text-sm text-slate-400">
				{ label }
				<span class="rounded-full bg-slate-100 px-1.5 py-0.5 text-3xs font-medium tracking-wide text-slate-400 uppercase">Not built yet</span>
			</span>
			<span class="text-xs text-slate-400">{ description }</span>
		</span>
	</div>
}

// settingsAccessRows is the Access section: Members & roles (admins only), then Permissions, gated
// on hub.ShowAccess/ShowMembersAndGroups -- never on which nav items happen to be declared. Shared
// verbatim between the desktop sidebar and the mobile list so the two can never disagree.
//
// Members & roles points at this Application's own scoped page (hub.MembersHref, S2.2) and, like
// Permissions, carries the runtime's own title and description -- it is a runtime view of the
// Application's `roles:`, not a navigation item the Application declares.
templ settingsAccessRows(hub SettingsHubView, showingDetail bool) {
	if hub.ShowAccess {
		<div class="flex flex-col gap-0.5">
			<h2 class="px-3 pb-1 text-3xs font-medium tracking-wide text-slate-400 uppercase">Access</h2>
			if hub.ShowMembersAndGroups {
				@settingsRow(hub.MembersHref, membersRolesTitle, membersRolesBlurb, false)
			}
			@settingsRow(permissionsHref(hub), permissionsTitle, permissionsDescription, showingDetail)
		</div>
	}
}

// settingsConfigRows is Configuration: one row per declared settings_hub_member item, then Groups for
// an admin of an Application with roles (a Workspace-level screen, placed here pending owner decision
// M-D1 -- a link placement only). A section with no row is absent.
templ settingsConfigRows(hub SettingsHubView) {
	if len(hub.Members) > 0 || hub.ShowMembersAndGroups {
		<div class="flex flex-col gap-0.5">
			<h2 class="px-3 pb-1 text-3xs font-medium tracking-wide text-slate-400 uppercase">Configuration</h2>
			for _, m := range hub.Members {
				@settingsRow(m.Href, m.Label, m.Description, false)
			}
			if hub.ShowMembersAndGroups {
				@settingsRow(routeByID(ctx, "nav_workspace_groups"), labelByID(ctx, "nav_workspace_groups"), "Named groups of members, used where a step is assigned to a group.", false)
			}
		</div>
	}
}

// settingsAbout is the About section: the Application's own name, description and what it holds, and
// the one thing the hub cannot do from here -- turning the Application off is a Workspace-level
// decision, so it points there. No install date or source template: nothing stores them.
templ settingsAbout(hub SettingsHubView) {
	<div class="flex flex-col gap-0.5">
		<h2 class="px-3 pb-1 text-3xs font-medium tracking-wide text-slate-400 uppercase">About</h2>
		<div class="flex flex-col gap-1 rounded-md p-3">
			<span class="text-sm font-medium text-slate-900">{ hub.AppName }</span>
			if hub.AppDescription != "" {
				<span class="text-xs text-slate-500">{ hub.AppDescription }</span>
			}
			<span class="text-xs text-slate-500">{ countWords(hub.MachineCount, "machine", "machines") }{ aboutRoles(hub.RoleCount) }</span>
			<span class="text-xs text-slate-400">
				To turn this application off, use
				<a href={ templ.SafeURL(routeByID(ctx, "nav_workspace_settings")) } class="text-blue-600 hover:text-blue-800">{ labelByID(ctx, "nav_workspace_settings") }</a>
				.
			</span>
		</div>
	</div>
}

func countWords(n int, one, other string) string {
	if n == 1 {
		return "1 " + one
	}
	return strconv.Itoa(n) + " " + other
}

func aboutRoles(n int) string {
	if n == 0 {
		return ""
	}
	return " · " + countWords(n, "role", "roles")
}

// settingsList is the whole hub as a list: Access, Configuration, About. The mobile page and the
// desktop sidebar both draw exactly this, so they cannot disagree.
templ settingsList(hub SettingsHubView, showingDetail bool) {
	@settingsAccessRows(hub, showingDetail)
	@settingsConfigRows(hub)
	@settingsAbout(hub)
}

// ApplicationSettingsPage draws any Application's Settings hub from a SettingsHubView, with one
// function for the landing view and the Permissions view (activeSection), the same mobile/desktop
// pair in one file every ported screen uses, extended with a third axis:
//
//   - Desktop with Access: a sidebar (settingsList) beside a pane that always shows the role matrix
//     (the Flow 2 mockup's RoleMatrix.dc.html always shows both together).
//   - Desktop without Access: the list alone -- a role matrix for an Application with no roles would
//     be an empty card.
//   - Mobile shows either the list (landing) or a back link plus the role matrix (Permissions) --
//     never both, which is why the Permissions view has its own address.
templ ApplicationSettingsPage(hub SettingsHubView, permissions RoleMatrixApp, activeSection, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	{{ showingDetail := hub.ShowAccess && activeSection == permissionsSection }}
	@appShell(pageTitle(hub, showingDetail), workspaceName, viewer, switchWorkspaceHref) {
		<div class="flex flex-col gap-1 sm:hidden">
			if showingDetail {
				<a href={ templ.SafeURL(hub.HubRoute) } class="text-xs text-blue-600 hover:text-blue-800">
					← { hub.Title }
				</a>
				@staticText(domain.StaticHeading, permissionsTitle)
			} else {
				@staticText(domain.StaticHeading, hub.Title)
				if hub.Description != "" {
					<p class="m-0 text-sm leading-6 text-slate-500">{ hub.Description }</p>
				}
			}
		</div>
		<div class="hidden flex-col gap-1 sm:flex">
			@staticText(domain.StaticHeading, hub.Title)
			if hub.Description != "" {
				<p class="m-0 text-sm leading-6 text-slate-500">{ hub.Description }</p>
			}
		</div>
		<div class="sm:hidden">
			if showingDetail {
				@roleMatrixApp(permissions)
			} else {
				<div class="flex flex-col gap-4">
					@settingsList(hub, showingDetail)
				</div>
			}
		</div>
		<div class="hidden gap-8 sm:flex">
			<aside class="flex w-55 shrink-0 flex-col gap-5">
				@settingsList(hub, showingDetail)
			</aside>
			if hub.ShowAccess {
				<div class="min-w-0 flex-1">
					@roleMatrixApp(permissions)
				</div>
			}
		</div>
	}
}
