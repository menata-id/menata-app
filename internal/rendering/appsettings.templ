package rendering

import (
	"context"
	"strconv"

	"menata.app/internal/domain"
)

// permissionsSection is the query value that selects the Permissions view of a Settings hub. The view
// is the runtime's own (a role matrix derived from the Application's `roles:` and Machines), not a
// navigation item an Application declares, so it has no id to look up; its two strings below are the
// runtime's, like the Access heading beside them.
const permissionsSection = "permissions"

const (
	permissionsTitle       = "Permissions"
	permissionsDescription = "Who can do what in this application."
	roleMatrixTitle        = "Roles in this application"
	settingsSidebarTitle   = "Settings"
	notificationsTitle     = "Notifications"
	notificationsBlurb     = "Which emails you receive from this application."
	membersRolesTitle      = "Members & roles"
	membersRolesBlurb      = "Who can use this application, and with which role."
)

// pageTitle is the <title> tag ApplicationSettingsPage renders -- the hub's own title normally, the
// Permissions view's while its content is what's showing, matching how every other screen's <title>
// tracks what a viewer is actually looking at.
func pageTitle(hub SettingsHubView, showingDetail bool) string {
	if showingDetail {
		return permissionsTitle
	}
	return hub.Title
}

// permissionsSubtitle is the line under the Permissions heading. It carries the sentence that used to head the
// role card ("a role here means nothing in other applications"), since it is about the page, not one card.
func permissionsSubtitle(appName string) string {
	return "Who can do what in " + appName + ". A role here means nothing in other applications."
}

// permissionsHref is the Permissions view of hub: the hub's own route plus the section query.
func permissionsHref(hub SettingsHubView) string {
	return hub.HubRoute + "?section=" + permissionsSection
}

// SettingsMember is one row under Configuration: a `settings_hub_member` navigation item, read whole.
type SettingsMember struct {
	Href        string
	Label       string
	Description string
}

// SettingsHubView is one Application's Settings hub, resolved by composition.ApplicationSettingsHub
// from what the Application declares. Nothing in it is specific to one Application.
type SettingsHubView struct {
	// HubRoute, Title and Description are the hub item's own route, heading and description.
	HubRoute    string
	Title       string
	Description string
	// ShowAccess is len(app.Roles) > 0 -- an Application declaring no roles has nothing to configure
	// access for, so the whole Access section is absent, not three empty-looking rows.
	ShowAccess bool
	// ShowMembersAndGroups additionally requires the viewer to be a Workspace admin -- hidden, not
	// shown-then-403. Permissions itself carries no such gate: it is read-only for any member.
	ShowMembersAndGroups bool
	// MembersHref is this Application's own Members & roles page (S2.2): the hub's route plus
	// /members, so it needs no navigation item of its own and names no Application.
	MembersHref string
	// Members are the Application's own settings_hub_member items, in declaration order.
	Members []SettingsMember
	// About: the Application's own name and description and what it holds.
	AppName        string
	AppDescription string
	MachineCount   int
	RoleCount      int
}

// settingsRow is one real, linked destination -- styled like workspacehome.templ's own Application row
// (label, description, trailing chevron), reused rather than a new shape invented for this page. current
// marks the row for the screen already showing. It is the Workspace Settings sidebar's row; this hub's
// own lists draw settingsListRow, which is the same destination on a divided surface.
templ settingsRow(href, label, description string, current bool) {
	<a
		href={ templ.SafeURL(href) }
		if current {
			aria-current="page"
		}
		class={ "flex items-start", layoutGap(ctx, domain.GapDefault), "p-3", radiusClass(ctx, domain.RadiusControl), templ.KV(backgroundClass(ctx, domain.BackgroundSunken), current), templ.KV(hoverWashClass(ctx), !current) }
	>
		<span class={ "flex min-w-0 grow flex-col", layoutGap(ctx, domain.GapHair) }>
			<span class={ textClass(ctx, domain.RoleBody), inkClass(ctx, domain.InkStrong), templ.KV(weightClass(ctx, domain.WeightEmphasis), current) }>{ label }</span>
			if description != "" {
				<span class={ textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkSecondary) }>{ description }</span>
			}
		</span>
		<span class="shrink-0 text-slate-300">
			@icon("chevron-right", "size-4")
		</span>
	</a>
}

// notBuiltYetTag is the muted tag a placeholder row wears instead of a link.
templ notBuiltYetTag() {
	<span class={ radiusClass(ctx, domain.RadiusPill), backgroundClass(ctx, domain.BackgroundSunken), "px-1.5 py-0.5", textClass(ctx, domain.RoleEyebrow), weightClass(ctx, domain.WeightEmphasis), "tracking-wide", inkClass(ctx, domain.InkFaint), "uppercase" }>Not built yet</span>
}

// settingsPlaceholderRow is an honest, non-interactive row for a section this runtime cannot serve
// yet -- no <a href>, so it can never be a link to nowhere, plus a muted tag saying so rather than
// leaving the reason to be guessed.
templ settingsPlaceholderRow(label, description string) {
	<div class={ "flex items-start", layoutGap(ctx, domain.GapDefault), "p-3", radiusClass(ctx, domain.RadiusControl) }>
		@settingsPlaceholderBody(label, description)
	</div>
}

// settingsPlaceholderBody is the muted label-plus-tag and description both placeholder rows share.
templ settingsPlaceholderBody(label, description string) {
	<span class={ "flex min-w-0 grow flex-col", layoutGap(ctx, domain.GapHair) }>
		<span class={ "flex flex-wrap items-center", layoutGap(ctx, domain.GapTight), textClass(ctx, domain.RoleBody), inkClass(ctx, domain.InkFaint) }>
			{ label }
			@notBuiltYetTag()
		</span>
		<span class={ textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkFaint) }>{ description }</span>
	</span>
}

// settingsSection is one titled group of a Settings hub (board M06a): an overline, then a bordered list
// surface whose rows are ruled by the divider shade. Both the phone's list and the role-less desktop page
// draw it; children are settingsListRow / settingsListPlaceholder / settingsAboutRow.
templ settingsSection(title string) {
	@stackLayout(domain.GapTight) {
		@staticText(domain.StaticOverline, title)
		<div class={ "overflow-hidden", surfaceClasses(ctx) }>
			{ children... }
		</div>
	}
}

// settingsListRow is one linked destination inside a settingsSection: 60px tall, a body-size label, a
// secondary description and a chevron. The label is an item title at 15px (RoleItem, owner decision DS-D13,
// 2026-10-12), as the mockup sets it; it read body (14px) while the ladder had no step between body and subheading.
templ settingsListRow(href, label, description string) {
	<a href={ templ.SafeURL(href) } class={ "flex min-h-15 items-center", layoutGap(ctx, domain.GapDefault), "border-b px-4 py-2.5 last:border-b-0", hoverWashClass(ctx), borderClass(ctx, domain.BorderDivider) }>
		<span class={ "flex min-w-0 grow flex-col", layoutGap(ctx, domain.GapHair) }>
			<span class={ textClass(ctx, domain.RoleItem), inkClass(ctx, domain.InkStrong) }>{ label }</span>
			if description != "" {
				<span class={ textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkSecondary) }>{ description }</span>
			}
		</span>
		<span class="shrink-0 text-slate-300">
			@icon("chevron-right", "size-4")
		</span>
	</a>
}

// settingsListPlaceholder is settingsListRow's honest twin for what this runtime cannot serve yet.
templ settingsListPlaceholder(label, description string) {
	<div class={ "flex min-h-15 items-center", layoutGap(ctx, domain.GapDefault), "border-b px-4 py-2.5 last:border-b-0", borderClass(ctx, domain.BorderDivider) }>
		@settingsPlaceholderBody(label, description)
	</div>
}

// settingsNavLink is a destination in the desktop sidebar: label only, the current one set apart.
// settingsNavLinkInk is the link's ink for its state, chosen in Go. As two `templ.KV` keys, a Workspace that gives
// `strong` and `body` one shade made both keys the same string, templ kept the last value, and the current link
// lost its ink class (the collision rencana 0.2c found on the approver chip).
func settingsNavLinkInk(ctx context.Context, current bool) string {
	if current {
		return inkClass(ctx, domain.InkStrong)
	}
	return inkClass(ctx, domain.InkBody)
}

templ settingsNavLink(href, label string, current bool) {
	<a
		href={ templ.SafeURL(href) }
		if current {
			aria-current="page"
		}
		class={ "flex items-center px-3 py-2", radiusClass(ctx, domain.RadiusControl), textClass(ctx, domain.RoleBody), templ.KV(backgroundClass(ctx, domain.BackgroundSunken), current), templ.KV(weightClass(ctx, domain.WeightEmphasis), current), settingsNavLinkInk(ctx, current), templ.KV(hoverWashClass(ctx), !current) }
	>
		{ label }
	</a>
}

// settingsNavGroup is one overline plus its links in the desktop sidebar.
templ settingsNavGroup(title string) {
	<div class={ "flex flex-col", layoutGap(ctx, domain.GapHair) }>
		<div class="px-3 pb-1">
			@staticText(domain.StaticOverline, title)
		</div>
		{ children... }
	</div>
}

// settingsTurnOffNote says the one thing the hub cannot do from here: turning an Application off is a
// Workspace-level decision, so it points there.
templ settingsTurnOffNote() {
	<span class={ textClass(ctx, domain.RoleMeta), "leading-5", inkClass(ctx, domain.InkSecondary) }>
		To turn this application off, use
		<a href={ templ.SafeURL(routeByID(ctx, "nav_workspace_settings")) } class="text-blue-600 hover:text-blue-800">{ labelByID(ctx, "nav_workspace_settings") }</a>.
	</span>
}

// settingsLists is the whole hub as list surfaces -- Access, Communication, Configuration, About -- each
// present only when it has a row (never gated on which nav items happen to be declared). Members & roles
// points at this Application's own scoped page and, like Permissions, carries the runtime's own title: it
// is a runtime view of the Application's `roles:`, not a navigation item the Application declares.
// Groups is a Workspace-level screen placed under Configuration pending owner decision M-D1 -- a link
// placement only. Communication holds one honest placeholder, and only for an Application with roles.
templ settingsLists(hub SettingsHubView) {
	if hub.ShowAccess {
		@settingsSection("Access") {
			if hub.ShowMembersAndGroups {
				@settingsListRow(hub.MembersHref, membersRolesTitle, membersRolesBlurb)
			}
			@settingsListRow(permissionsHref(hub), permissionsTitle, permissionsDescription)
		}
		@settingsSection("Communication") {
			@settingsListPlaceholder(notificationsTitle, notificationsBlurb)
		}
	}
	if len(hub.Members) > 0 || hub.ShowMembersAndGroups {
		@settingsSection("Configuration") {
			for _, m := range hub.Members {
				@settingsListRow(m.Href, m.Label, m.Description)
			}
			if hub.ShowMembersAndGroups {
				@settingsListRow(routeByID(ctx, "nav_workspace_groups"), labelByID(ctx, "nav_workspace_groups"), "Named groups of members, used where a step is assigned to a group.")
			}
		}
	}
	@settingsSection("About") {
		<div class={ "flex flex-col", layoutGap(ctx, domain.GapMicro), "px-4 py-3" }>
			<span class={ textClass(ctx, domain.RoleBody), inkClass(ctx, domain.InkStrong) }>{ hub.AppName }</span>
			if hub.AppDescription != "" {
				<span class={ textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkSecondary) }>{ hub.AppDescription }</span>
			}
			if !hub.ShowAccess {
				<span class={ textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkSecondary) }>This application declares no roles, so everyone in this workspace can open it.</span>
			}
		</div>
	}
	@settingsTurnOffNote()
}

// settingsSidebar is the desktop sidebar beside the Permissions pane (board RoleMatrix): the same sections
// as settingsLists as plain links with the current one highlighted, and the Application's own name,
// description and the turn-off note under a rule. Only drawn for an Application with roles.
templ settingsSidebar(hub SettingsHubView, showingDetail bool) {
	<aside class={ "flex w-55 shrink-0 flex-col", layoutGap(ctx, domain.GapLoose) } aria-label={ settingsSidebarTitle }>
		@staticText(domain.StaticSubheading, settingsSidebarTitle)
		@settingsNavGroup("Access") {
			if hub.ShowMembersAndGroups {
				@settingsNavLink(hub.MembersHref, membersRolesTitle, false)
			}
			@settingsNavLink(permissionsHref(hub), permissionsTitle, showingDetail)
		}
		@settingsNavGroup("Communication") {
			<div class={ "flex items-center", layoutGap(ctx, domain.GapTight), "px-3 py-2", textClass(ctx, domain.RoleBody), inkClass(ctx, domain.InkFaint) }>
				{ notificationsTitle }
				@notBuiltYetTag()
			</div>
		}
		if len(hub.Members) > 0 || hub.ShowMembersAndGroups {
			@settingsNavGroup("Configuration") {
				for _, m := range hub.Members {
					@settingsNavLink(m.Href, m.Label, false)
				}
				if hub.ShowMembersAndGroups {
					@settingsNavLink(routeByID(ctx, "nav_workspace_groups"), labelByID(ctx, "nav_workspace_groups"), false)
				}
			}
		}
		<div class={ "flex flex-col", layoutGap(ctx, domain.GapMicro), "border-t pt-4", borderClass(ctx, domain.BorderSurface) }>
			<span class={ "px-3", textClass(ctx, domain.RoleBody), weightClass(ctx, domain.WeightEmphasis), inkClass(ctx, domain.InkStrong) }>{ hub.AppName }</span>
			if hub.AppDescription != "" {
				<span class={ "px-3", textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkSecondary) }>{ hub.AppDescription }</span>
			}
			<span class="px-3">
				@settingsTurnOffNote()
			</span>
		</div>
	</aside>
}

func countWords(n int, one, other string) string {
	if n == 1 {
		return "1 " + one
	}
	return strconv.Itoa(n) + " " + other
}

// hubCounts is the line under a Settings hub's heading (board CompareAppSettings): roles first, since they are
// what this hub configures, then the Machines the Application holds.
func hubCounts(hub SettingsHubView) string {
	return countWords(hub.RoleCount, "role", "roles") + " · " + countWords(hub.MachineCount, "machine", "machines")
}

// settingsHubHeader is the landing view's heading block: title, the hub's description and the counts line.
templ settingsHubHeader(hub SettingsHubView) {
	<div class={ "flex flex-col", layoutGap(ctx, domain.GapMicro) }>
		@staticText(domain.StaticHeading, hub.Title)
		if hub.Description != "" {
			<p class={ "m-0", textClass(ctx, domain.RoleBody), "leading-6", inkClass(ctx, domain.InkSecondary) }>{ hub.Description }</p>
		}
		@staticText(domain.StaticCaption, hubCounts(hub))
	</div>
}

// settingsPermissionsPane is the Permissions view -- heading, the sentence about roles, the matrix card and
// the closing note -- shared by the phone's detail view and the desktop pane.
templ settingsPermissionsPane(hub SettingsHubView, permissions RoleMatrixApp) {
	<div class={ "flex flex-col", layoutGap(ctx, domain.GapMicro) }>
		@staticText(domain.StaticHeading, permissionsTitle)
		<p class={ "m-0", textClass(ctx, domain.RoleBody), "leading-6", inkClass(ctx, domain.InkSecondary) }>{ permissionsSubtitle(hub.AppName) }</p>
	</div>
	@roleMatrixApp(permissions, membersLinkFor(hub))
	@roleMatrixClosingNote()
}

// membersLinkFor is the Members & roles address for a viewer who may open it, "" for one who may not.
func membersLinkFor(hub SettingsHubView) string {
	if hub.ShowMembersAndGroups {
		return hub.MembersHref
	}
	return ""
}

// ApplicationSettingsPage draws any Application's Settings hub from a SettingsHubView, with one
// function for the landing view and the Permissions view (activeSection), the same mobile/desktop
// pair in one file every ported screen uses, extended with a third axis (boards M06a, RoleMatrix):
//
//   - Desktop with Access: a sidebar (settingsSidebar) beside the Permissions pane -- the mockup always
//     shows both together, so the page's own heading is the pane's, not the hub's.
//   - Without Access, on either breakpoint: the landing list alone -- a role matrix for an Application
//     with no roles would be an empty card.
//   - Mobile with Access shows either the list (landing) or a back link plus the Permissions pane --
//     never both, which is why the Permissions view has its own address.
templ ApplicationSettingsPage(hub SettingsHubView, permissions RoleMatrixApp, activeSection, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	{{ showingDetail := hub.ShowAccess && activeSection == permissionsSection }}
	@appShell(pageTitle(hub, showingDetail), workspaceName, viewer, switchWorkspaceHref) {
		if !hub.ShowAccess {
			<div class={ "flex flex-col", layoutGap(ctx, domain.GapLoose), "sm:max-w-xl" }>
				@settingsHubHeader(hub)
				@settingsLists(hub)
			</div>
		} else {
			<div class={ "flex flex-col", layoutGap(ctx, domain.GapLoose), "sm:hidden" }>
				if showingDetail {
					<a href={ templ.SafeURL(hub.HubRoute) } class={ textClass(ctx, domain.RoleMeta), "text-blue-600 hover:text-blue-800" }>
						← { hub.Title }
					</a>
					@settingsPermissionsPane(hub, permissions)
				} else {
					@settingsHubHeader(hub)
					@settingsLists(hub)
				}
			</div>
			<div class="hidden gap-8 sm:flex">
				@settingsSidebar(hub, showingDetail)
				<div class={ "flex min-w-0 flex-1 flex-col", layoutGap(ctx, domain.GapComfortable) }>
					@settingsPermissionsPane(hub, permissions)
				</div>
			</div>
		}
	}
}
