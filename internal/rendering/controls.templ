package rendering

import (
	"context"
	"sort"
	"strings"

	"menata.app/internal/domain"
	"menata.app/internal/storage"
)

// The app's in-screen control vocabulary: one string per control kind, read by every
// appShell-based screen instead of each hand-writing its own.
//
// WHY THIS EXISTS AT ALL, since it is a list of strings and could read as tidiness. Until
// 2026-09-24 the app rendered from two stylesheets, so a control written twice was written in two
// different systems and the duplication was invisible -- `pageStyles` had `button.primary`,
// Tailwind screens spelled it out. With one stylesheet left it became measurable, and the
// measurement was bad: **four different primary buttons** (`h-9 px-4`, `h-8 px-3`, `h-11 sm:h-9`,
// plus two that only differed by a leading `flex items-center`) and **six different text inputs**,
// some with a focus ring and some without. Two of those variants were added by the same change
// that made them countable -- the generic record screens' port -- which is the argument for fixing
// it now rather than after the next screen adds a seventh.
//
// WHOLE LITERAL STRINGS, never assembled from parts. Tailwind's scanner reads source text, so a
// class name built at runtime never reaches app.css (appIconClasses, workspacehome.templ, records
// the same rule at length). Callers may append with `+ " mr-1"` for one-off spacing, which is
// fine: both halves are still literal text in a scanned file.
//
// THE PRE-AUTH SCREENS ARE DELIBERATELY NOT HERE. authShell's own kit (`authField`,
// `authPasswordField`, `authSubmit`) renders at `h-10.5 sm:h-9.5` / `h-11 sm:h-9` with a 15px
// label -- a bigger touch target for a screen someone reaches on a phone before they have an
// account, which is a real decision rather than drift, and it already lives in named components.
// Unifying the two sizes would be undoing that decision, not removing a duplicate.
const (
	// controlField is one text/date/number input or select. The focus ring is part of the
	// definition, not decoration: half the inputs in the app carried it and half did not, and the
	// half without were the ones nobody had looked at since they were written.
	//
	// It carries no width on purpose. Every caller has an opinion -- `w-full` inside a table cell,
	// `min-w-44 grow` in the wizard's approver row, a fixed `w-36` for a filter -- and baking one
	// in would mean each of those fighting it with a second width utility whose winner depends on
	// the order Tailwind happens to emit them in, which is not a thing a caller should have to
	// reason about.
	controlField = "h-9 rounded-md border border-slate-300 bg-white px-3 font-sans text-sm text-slate-900 outline-none focus:outline-2 focus:outline-offset-1 focus:outline-blue-300"

	// tableCell / tableHeadCell are the generic record table's own two cells, kept beside the
	// controls because a table that half matches the rest of a screen is the same defect in a
	// different element.
	tableCell     = "border-b border-slate-100 px-3 py-2 align-middle"
	tableHeadCell = "border-b border-slate-200 px-3 py-2 text-left text-2xs font-medium tracking-wide text-slate-500 uppercase"
)

// buttonClasses is the one place a button's look is decided, and the first reader of `RadiusControl` and
// `InkBody` -- two Theme keys that were valid YAML with no effect until it existed.
//
// It replaces `controlPrimary`/`controlSecondary`/`controlDanger`, three literal strings read by 36 sites. Each
// fragment below is still literal text in a scanned file, which is what Tailwind's scanner needs; what changed
// is that the radius, the text size, the weight and (for the secondary variant) the ink come from the
// Workspace's theme, joined **in the order the old literal wrote them** so the default theme renders the same
// bytes (`TestButtonClasses_defaultIsTheLiteralEachSiteReplaced`).
//
// **What is deliberately still a literal, and why each is a finding rather than debt.**
//   - The primary fill (`bg-slate-900`, `text-white`) is a dark surface, and D3 declined to make those a role:
//     the 17 dark surfaces are three different jobs.
//   - The danger border and ink (`red-200`, `red-700`) are a tone, and a tone is a palette pair a Component
//     owns, not an ink role; a button's background is white where the `red` palette's is tinted.
//   - **The border of `secondary` is `slate-200`, which is not what `BorderControl` defaults to** (`slate-300`,
//     "an input's own box"). Reading the role would turn 14 buttons one shade darker; the mockups lean the other
//     way (5 of 8 bordered buttons use 200). That moves pixels and is the owner's call (D8), exactly as D6 and
//     D7 are, so `BorderControl` stays listed as unread until a Field reads it.
//
// A site that cannot be the `button` Component -- an `<a>`, an `hx-*` trigger, a `<summary>`, a button a script
// finds by class -- still draws its own tag and calls this for the look, so it moves with the Theme too.
// `conformance.TestHandWrittenButtonsOnlyShrink` holds how many of those remain, with a reason each.
func buttonClasses(ctx context.Context, variant domain.ButtonVariant) string {
	const prefix = "inline-flex h-9 cursor-pointer items-center justify-center"
	radius := radiusClass(ctx, domain.RadiusControl)
	text := textClass(ctx, domain.RoleBody)
	switch variant {
	case domain.ButtonPrimary:
		return strings.Join([]string{prefix, radius, "border-0 bg-slate-900 px-4 font-sans", text, weightClass(ctx, domain.WeightEmphasis), "text-white hover:bg-slate-800"}, " ")
	case domain.ButtonDanger:
		return strings.Join([]string{prefix, radius, "border border-red-200 bg-white px-4 font-sans", text, "text-red-700 hover:bg-red-50"}, " ")
	default:
		return strings.Join([]string{prefix, radius, "border border-slate-200 bg-white px-4 font-sans", text, inkClass(ctx, domain.InkBody), "hover:bg-slate-50"}, " ")
	}
}

// button is the registered renderer for `domain.ComponentButton`: a real `<button type="submit">` with a
// label and, optionally, the native name/value pair it posts. **Its signature is the contract's teeth** -- four
// strings and a closed variant, no `any` to parse and no attribute map to pass `hx-*` through, which is what
// §12.3 forbids by name ("MUST NOT become generic merely by accepting arbitrary properties").
//
// The attribute order is `type`, `name`, `value`, `class`: the order the 17 migrated sites already wrote.
templ button(label string, variant domain.ButtonVariant, name, value string) {
	<button type="submit" if name != "" { name={ name } value={ value } } class={ buttonClasses(ctx, variant) }>{ label }</button>
}

// searchBox is a plain GET form posting `q` back to path -- Enter submits it natively in every
// browser, matching every other filter on these screens (a filter chip is a plain <a>, this is a
// plain <form>), so the feature needs no script at all.
//
// path is the bare route with no query string of its own (e.g. routeByID(ctx, "nav_my_documents")
// returns "/approval-inbox?tab=mine", but a GET form's own submitted query string always replaces
// whatever query the action URL already carried -- the browser does not merge the two -- so any
// state that must survive the round trip, tab included, has to travel as a hidden input instead).
// q pre-fills the box with the current query so a search is never silently lost when a filter chip
// is clicked next to it.
// **The hidden inputs render in sorted key order, not map order.** `range` over a map is randomised in Go, so
// this form emitted its two hidden inputs in a different sequence between requests -- caught on 2026-10-03 by
// diffing one screen against a worktree baseline six times, where the *baseline alone* flipped. Harmless to
// the submission (both inputs are sent either way) and a straight breach of 007 §4.6, which makes identical
// input producing identical output a MUST; it also makes any byte-level comparison of this page -- a render
// diff, an ETag, a cache key -- unreliable in a way nothing would report.
templ searchBox(path, q, placeholder string, hidden map[string]string) {
	<form method="get" action={ templ.SafeURL(path) } role="search" class="flex items-center gap-2">
		for _, k := range sortedKeys(hidden) {
			<input type="hidden" name={ k } value={ hidden[k] }/>
		}
		<label for="q" class="sr-only">{ placeholder }</label>
		<input id="q" type="search" name="q" value={ q } placeholder={ placeholder } class={ controlField + " w-full sm:w-70" }/>
	</form>
}

// computedDisplay is what a computed Field shows in place of an input. It is never an input: the
// runtime derives it on save (data.ApplyComputed), so a name= would only invite a value it overwrites.
func computedDisplay(current any) string {
	if current == nil {
		return "—"
	}
	return toString(current)
}

// fieldInput renders the input control appropriate to a Field's semantic type, pre-filled with
// current (nil for a blank create-form field). relations supplies <select> options for any
// reference field (Relation or Person, per domain.Field.IsReference); unused for every other
// type.
templ fieldInput(f domain.Field, current any, relations RelationOptions, groups GroupOptions) {
	switch {
		case f.Compute != nil:
			<span class="text-sm text-slate-500" title="Calculated automatically when saved">{ computedDisplay(current) }</span>
		case f.Type == domain.FieldTypeStatus:
			<select name={ f.ID } class={ controlField + " w-full" }>
				<option value=""></option>
				for _, opt := range f.Options {
					<option value={ opt } selected?={ toString(current) == opt }>{ opt }</option>
				}
			</select>
		case f.IsReference():
			<select name={ f.ID } class={ controlField + " w-full" }>
				<option value=""></option>
				for _, opt := range relations[f.RelatedMachine] {
					<option value={ opt.ID } selected?={ toString(current) == opt.ID }>{ opt.Label }</option>
				}
			</select>
		// A group Field picks from the Workspace's own Groups (CAP-F24). Its own case rather than
		// the IsReference() one above precisely because IsReference() is false for it: a Group has
		// no target Machine to key relations by, so the options arrive in their own list.
		case f.Type == domain.FieldTypeGroup:
			<select name={ f.ID } class={ controlField + " w-full" }>
				<option value=""></option>
				for _, opt := range groups {
					<option value={ opt.ID } selected?={ toString(current) == opt.ID }>{ opt.Label }</option>
				}
			</select>
		case f.Type == domain.FieldTypeBoolean:
			<input type="checkbox" name={ f.ID } checked?={ toBool(current) } class="size-4 accent-blue-600"/>
		case f.Type == domain.FieldTypeDate:
			<input type="date" name={ f.ID } value={ toString(current) } class={ controlField + " w-full" }/>
		case f.Type == domain.FieldTypeNumber:
			<input type="number" step="any" name={ f.ID } value={ toString(current) } class={ controlField + " w-full" }/>
		case f.Type == domain.FieldTypeLongText:
			<textarea name={ f.ID } rows="5" class={ controlField + " w-full" }>{ toString(current) }</textarea>
		case f.Type == domain.FieldTypeFile:
			if key := toString(current); key != "" {
				<div class="flex flex-col gap-1">
					<a href={ templ.URL("/uploads/" + key) } target="_blank" class="truncate text-xs text-blue-600 hover:text-blue-700">{ storage.DisplayName(key) }</a>
					<input type="file" name={ f.ID } class="w-full font-sans text-xs text-slate-500"/>
				</div>
			} else {
				<input type="file" name={ f.ID } class="w-full font-sans text-xs text-slate-500"/>
			}
		default:
			<input type="text" name={ f.ID } value={ toString(current) } class={ controlField + " w-full" }/>
	}
}

// fileLink renders a FieldTypeFile value as a download link, or nothing if unset.
templ fileLink(v any) {
	if key := toString(v); key != "" {
		<a href={ templ.URL("/uploads/" + key) } target="_blank" class="text-blue-600 hover:text-blue-700">{ storage.DisplayName(key) }</a>
	}
}


// sortedKeys gives a map's keys in a stable order, so a `range` over it renders deterministically (007 §4.6).
func sortedKeys(m map[string]string) []string {
	out := make([]string, 0, len(m))
	for k := range m {
		out = append(out, k)
	}
	sort.Strings(out)
	return out
}
