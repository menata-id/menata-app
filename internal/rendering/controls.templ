package rendering

import (
	"context"
	"sort"
	"strings"

	"menata.app/internal/domain"
	"menata.app/internal/storage"
)

// The app's in-screen control vocabulary: one string per control kind, read by every
// appShell-based screen instead of each hand-writing its own.
//
// WHY THIS EXISTS AT ALL, since it is a list of strings and could read as tidiness. Until
// 2026-09-24 the app rendered from two stylesheets, so a control written twice was written in two
// different systems and the duplication was invisible -- `pageStyles` had `button.primary`,
// Tailwind screens spelled it out. With one stylesheet left it became measurable, and the
// measurement was bad: **four different primary buttons** (`h-9 px-4`, `h-8 px-3`, `h-11 sm:h-9`,
// plus two that only differed by a leading `flex items-center`) and **six different text inputs**,
// some with a focus ring and some without. Two of those variants were added by the same change
// that made them countable -- the generic record screens' port -- which is the argument for fixing
// it now rather than after the next screen adds a seventh.
//
// WHOLE LITERAL FRAGMENTS, never a class name built from parts at runtime (`buttonClasses` and `fieldClasses`
// join literal fragments in Go, and each fragment is still literal text). Tailwind's scanner reads source text, so a
// class name built at runtime never reaches app.css (appIconClasses, workspacehome.templ, records
// the same rule at length). Callers may append with `+ " mr-1"` for one-off spacing, which is
// fine: both halves are still literal text in a scanned file.
//
// THE PRE-AUTH SCREENS ARE DELIBERATELY NOT HERE. authShell's own kit (`authField`,
// `authPasswordField`, `authSubmit`) renders at `h-10.5 sm:h-9.5` / `h-11 sm:h-9` with a 15px
// label -- a bigger touch target for a screen someone reaches on a phone before they have an
// account, which is a real decision rather than drift, and it already lives in named components.
// Unifying the two sizes would be undoing that decision, not removing a duplicate.

// tableHeadCellClasses is the generic record table's header cell, kept beside the controls because a table that
// half matches the rest of a screen is the same defect in a different element. Its rule reads `surface`, the same
// role as the table's box, where the body cell (tableCellClasses) reads `divider`: a head rule bounds the header
// region, a body rule separates rows. Joined in the old literal's order so the default theme renders the same bytes.
func tableHeadCellClasses(ctx context.Context) string {
	return "border-b " + borderClass(ctx, domain.BorderSurface) + " px-3 py-2 text-left text-2xs font-medium tracking-wide text-slate-500 uppercase"
}

// fieldClasses is the one place an input's look is decided, and the first reader of `BorderControl` -- the
// Theme key `unreadThemeRoles` listed because only a Field draws "an input's own box". It also reads
// `RadiusControl`, `RoleBody` and `InkStrong`, joined **in the order the old literal wrote them** so the
// default theme renders the same bytes (`TestFieldClasses_defaultIsTheLiteralItReplaced`).
//
// It replaced `controlField`, one literal read by 24 sites, and it returns no width on purpose: every caller has
// an opinion (`w-full` in a table cell, `min-w-44 grow` in the wizard's approver row, a fixed width for a filter), and
// baking one in would make each fight it with a second width utility whose winner depends on the order Tailwind
// emits them.
//
// **It is a class reader and not a registered Component, and the reason is a finding.** An input's attributes
// are `name`, `value`, `required`, `placeholder`, `aria-label`, `min`, `step` and, in the wizard, a hyperscript
// handler -- that is 007 §11.3 Binding, which has no primitive yet, and a Component accepting them would be
// §12.3's "arbitrary properties" by another name. The three tags (`input`, `select`, `textarea`) are not one
// element either. `Field` (the label wrapper) stays the Component; its control is a child it never knew.
//
// What stays literal: the white fill (a surface, D3), `h-9`, `px-3` and `font-sans`, which are sizing and
// typeface rather than tokens, and the focus ring, which is part of the definition: half the inputs in the app
// carried one and half did not, and the half without were the ones nobody had looked at.
func fieldClasses(ctx context.Context) string {
	return strings.Join([]string{
		"h-9", radiusClass(ctx, domain.RadiusControl), "border", borderClass(ctx, domain.BorderControl),
		"bg-white px-3 font-sans", textClass(ctx, domain.RoleBody), inkClass(ctx, domain.InkStrong),
		"outline-none focus:outline-2 focus:outline-offset-1 focus:outline-blue-300",
	}, " ")
}

// dividedRowClasses is one row of a divided list that has column headers above it: a stack on a phone, the
// cells side by side from `sm:`, a divider rule under every row but the last. Three sites carried this as one
// literal (approvalinbox, and workspacemembers twice) and differed only in the gap, which is the parameter.
// It is a class reader and not a Layout for the reason `surfaceClasses` is not one: the rule and the padding
// are not layout, and a `columnsLayout` taking them would accept arbitrary classes (007 §12.3). Joined in the
// old literal's order so the default theme renders the same bytes.
func dividedRowClasses(ctx context.Context, gap domain.Gap) string {
	return strings.Join([]string{
		"flex flex-col", layoutGap(ctx, gap), "border-b", borderClass(ctx, domain.BorderDivider),
		"px-4 py-3 last:border-b-0 sm:flex-row sm:items-center sm:gap-4",
	}, " ")
}

// tableCellClasses is the generic record table's body cell: the first caller of the `divider` border role, which
// separates rows. Joined in the old literal's order so the default theme renders the same bytes.
func tableCellClasses(ctx context.Context) string {
	return "border-b " + borderClass(ctx, domain.BorderDivider) + " px-3 py-2 align-middle"
}

// buttonClasses is the one place a button's look is decided, and the first reader of `RadiusControl` and
// `InkBody` -- two Theme keys that were valid YAML with no effect until it existed.
//
// It replaces `controlPrimary`/`controlSecondary`/`controlDanger`, three literal strings read by 36 sites. Each
// fragment below is still literal text in a scanned file, which is what Tailwind's scanner needs; what changed
// is that the radius, the text size, the weight and (for the secondary variant) the ink come from the
// Workspace's theme, joined **in the order the old literal wrote them** so the default theme renders the same
// bytes (`TestButtonClasses_defaultIsTheLiteralEachSiteReplaced`).
//
// **What is deliberately still a literal, and why each is a finding rather than debt.**
//   - The primary fill (`bg-slate-900`, `text-white`) is a dark surface, and D3 declined to make those a role:
//     the 17 dark surfaces are three different jobs.
//   - The danger border and ink (`red-200`, `red-700`) are a tone, and a tone is a palette pair a Component
//     owns, not an ink role; a button's background is white where the `red` palette's is tinted.
//   - **The border of `secondary` reads `BorderSurface`, not `BorderControl` (owner decision D8, 2026-10-07).**
//     The two default to slate-200 and slate-300; the mockups lean to 200 (5 of 8 bordered buttons), so reading
//     `surface` moves no button while `control` would have darkened 14. A button is something clicked and an
//     input is something typed into, which is why they are two keys: a Workspace wanting one line declares both.
//
// A site that cannot be the `button` Component -- an `<a>`, an `hx-*` trigger, a `<summary>`, a button a script
// finds by class -- still draws its own tag and calls this for the look, so it moves with the Theme too.
// `conformance.TestHandWrittenButtonsOnlyShrink` holds how many of those remain, with a reason each.
func buttonClasses(ctx context.Context, variant domain.ButtonVariant) string {
	const prefix = "inline-flex h-9 cursor-pointer items-center justify-center"
	radius := radiusClass(ctx, domain.RadiusControl)
	text := textClass(ctx, domain.RoleBody)
	switch variant {
	case domain.ButtonPrimary:
		return strings.Join([]string{prefix, radius, "border-0 bg-slate-900 px-4 font-sans", text, weightClass(ctx, domain.WeightEmphasis), "text-white hover:bg-slate-800"}, " ")
	case domain.ButtonDanger:
		return strings.Join([]string{prefix, radius, "border border-red-200 bg-white px-4 font-sans", text, "text-red-700 hover:bg-red-50"}, " ")
	default:
		return strings.Join([]string{prefix, radius, "border", borderClass(ctx, domain.BorderSurface), "bg-white px-4 font-sans", text, inkClass(ctx, domain.InkBody), "hover:bg-slate-50"}, " ")
	}
}

// button is the registered renderer for `domain.ComponentButton`: a real `<button type="submit">` with a
// label and, optionally, the native name/value pair it posts. **Its signature is the contract's teeth** -- four
// strings and a closed variant, no `any` to parse and no attribute map to pass `hx-*` through, which is what
// §12.3 forbids by name ("MUST NOT become generic merely by accepting arbitrary properties").
//
// The attribute order is `type`, `name`, `value`, `class`: the order the 17 migrated sites already wrote.
templ button(label string, variant domain.ButtonVariant, name, value string) {
	<button type="submit" if name != "" { name={ name } value={ value } } class={ buttonClasses(ctx, variant) }>{ label }</button>
}

// requestButton is the registered renderer for `domain.ComponentButton`, and the one signature that names every
// input its contract declares (`TestRegisteredComponentsStayBounded` reads it): `button` is the submit button the
// seventeen hand-written sites call with four strings, and this is the same Component with the three inputs a
// lowered page adds. When lowering derived a `method` of delete the Button is a request instead of a submit:
// `hx-swap="none"` because the generic delete route answers a request from a declared page with
// `HX-Refresh: true`, so the list re-reads without the record; a refusal (403/422) surfaces through the shell's
// shared `htmx:responseError` notice. `confirm` is the author's sentence and the browser asks it before anything
// is sent (`hx-confirm`). A derived `post` is a move: the same request shape without the question, because the
// generic move route answers a declared page with the same `HX-Refresh`. `type="button"` so a delete placed inside a form's subtree never submits it.
templ requestButton(label string, variant domain.ButtonVariant, name, value, action, method, confirm string) {
	if method == domain.ButtonMethodDelete {
		<button type="button" hx-delete={ action } hx-swap="none" hx-confirm={ confirm } class={ buttonClasses(ctx, variant) }>{ label }</button>
	} else if method == domain.ButtonMethodPost {
		<button type="button" hx-post={ action } hx-swap="none" class={ buttonClasses(ctx, variant) }>{ label }</button>
	} else {
		@button(label, variant, name, value)
	}
}

// form is a registered Component: a POST to the Machine's create route -- or, when lowering derived a `method`,
// a PATCH of one record -- its controls in the `field` slot, and one primary Button. The author supplied the
// submit label; `action` (and `method`) were derived from the bound Machine.
//
// `hx-swap="none"` because the create route (and the patch route) answers a form sent from any page other than its Machine's own
// with `HX-Refresh: true`: the page re-reads and shows the new record, and a refusal (422/403) surfaces through
// the shell's shared `htmx:responseError` notice with the form left as typed. CSRF travels in the `hx-headers`
// the body already carries, so the form holds no token field of its own.
templ form(submit, action, method string) {
	<form if method == domain.FormMethodPatch { hx-patch={ action } } else { hx-post={ action } } hx-swap="none">
		@stackLayout(domain.GapDefault) {
			{ children... }
			<div>
				@button(submit, domain.ButtonPrimary, "", "")
			</div>
		}
	</form>
}

// formInput is the control a bound Form lowers each of its Machine's Fields to. Every property -- name, kind,
// choices, default, requiredness -- arrived derived from that Field, so this renders no `name=` of its own
// choosing. It reads the same `fieldClasses` the Machine pages' controls do, which is why a Theme change moves
// both. A boolean is a checkbox and never `required` (an unticked box is a valid answer).
templ formInput(id, name, kind, options, value string, required bool) {
	switch domain.InputKind(kind) {
		case domain.InputSelect:
			<select id={ id } name={ name } required?={ required } class={ fieldClasses(ctx) + " w-full" }>
				<option value=""></option>
				for _, opt := range strings.Split(options, domain.InputOptionsSep) {
					<option value={ opt } selected?={ opt == value }>{ opt }</option>
				}
			</select>
		case domain.InputBoolean:
			<input id={ id } type="checkbox" name={ name } checked?={ value == "true" } class="size-4 accent-blue-600"/>
		case domain.InputDate:
			<input id={ id } type="date" name={ name } value={ value } required?={ required } class={ fieldClasses(ctx) + " w-full" }/>
		case domain.InputNumber:
			<input id={ id } type="number" step="any" name={ name } value={ value } required?={ required } class={ fieldClasses(ctx) + " w-full" }/>
		case domain.InputLongText:
			<textarea id={ id } name={ name } rows="5" required?={ required } class={ fieldClasses(ctx) + " w-full" }>{ value }</textarea>
		default:
			<input id={ id } type="text" name={ name } value={ value } required?={ required } class={ fieldClasses(ctx) + " w-full" }/>
	}
}

// searchBox is a plain GET form posting `q` back to path -- Enter submits it natively in every
// browser, matching every other filter on these screens (a filter chip is a plain <a>, this is a
// plain <form>), so the feature needs no script at all.
//
// path is the bare route with no query string of its own (e.g. routeByID(ctx, "nav_my_documents")
// returns "/approval-inbox?tab=mine", but a GET form's own submitted query string always replaces
// whatever query the action URL already carried -- the browser does not merge the two -- so any
// state that must survive the round trip, tab included, has to travel as a hidden input instead).
// q pre-fills the box with the current query so a search is never silently lost when a filter chip
// is clicked next to it.
// **The hidden inputs render in sorted key order, not map order.** `range` over a map is randomised in Go, so
// this form emitted its two hidden inputs in a different sequence between requests -- caught on 2026-10-03 by
// diffing one screen against a worktree baseline six times, where the *baseline alone* flipped. Harmless to
// the submission (both inputs are sent either way) and a straight breach of 007 §4.6, which makes identical
// input producing identical output a MUST; it also makes any byte-level comparison of this page -- a render
// diff, an ETag, a cache key -- unreliable in a way nothing would report.
templ searchBox(path, q, placeholder string, hidden map[string]string) {
	<form method="get" action={ templ.SafeURL(path) } role="search" class="flex items-center gap-2">
		for _, k := range sortedKeys(hidden) {
			<input type="hidden" name={ k } value={ hidden[k] }/>
		}
		<label for="q" class="sr-only">{ placeholder }</label>
		<input id="q" type="search" name="q" value={ q } placeholder={ placeholder } class={ fieldClasses(ctx) + " w-full sm:w-70" }/>
	</form>
}

// computedDisplay is what a computed Field shows in place of an input. It is never an input: the
// runtime derives it on save (data.ApplyComputed), so a name= would only invite a value it overwrites.
func computedDisplay(current any) string {
	if current == nil {
		return "—"
	}
	return toString(current)
}

// fieldInput renders the input control appropriate to a Field's semantic type, pre-filled with
// current (nil for a blank create-form field). relations supplies <select> options for any
// reference field (Relation or Person, per domain.Field.IsReference); unused for every other
// type.
templ fieldInput(f domain.Field, current any, relations RelationOptions, groups GroupOptions) {
	switch {
		case f.Compute != nil:
			<span class="text-sm text-slate-500" title="Calculated automatically when saved">{ computedDisplay(current) }</span>
		case f.Type == domain.FieldTypeStatus:
			<select name={ f.ID } class={ fieldClasses(ctx) + " w-full" }>
				<option value=""></option>
				for _, opt := range f.Options {
					<option value={ opt } selected?={ toString(current) == opt }>{ opt }</option>
				}
			</select>
		case f.IsReference():
			<select name={ f.ID } class={ fieldClasses(ctx) + " w-full" }>
				<option value=""></option>
				for _, opt := range relations[f.RelatedMachine] {
					<option value={ opt.ID } selected?={ toString(current) == opt.ID }>{ opt.Label }</option>
				}
			</select>
		// A group Field picks from the Workspace's own Groups (CAP-F24). Its own case rather than
		// the IsReference() one above precisely because IsReference() is false for it: a Group has
		// no target Machine to key relations by, so the options arrive in their own list.
		case f.Type == domain.FieldTypeGroup:
			<select name={ f.ID } class={ fieldClasses(ctx) + " w-full" }>
				<option value=""></option>
				for _, opt := range groups {
					<option value={ opt.ID } selected?={ toString(current) == opt.ID }>{ opt.Label }</option>
				}
			</select>
		case f.Type == domain.FieldTypeBoolean:
			<input type="checkbox" name={ f.ID } checked?={ toBool(current) } class="size-4 accent-blue-600"/>
		case f.Type == domain.FieldTypeDate:
			<input type="date" name={ f.ID } value={ toString(current) } class={ fieldClasses(ctx) + " w-full" }/>
		case f.Type == domain.FieldTypeNumber:
			<input type="number" step="any" name={ f.ID } value={ toString(current) } class={ fieldClasses(ctx) + " w-full" }/>
		case f.Type == domain.FieldTypeLongText:
			<textarea name={ f.ID } rows="5" class={ fieldClasses(ctx) + " w-full" }>{ toString(current) }</textarea>
		case f.Type == domain.FieldTypeFile:
			if key := toString(current); key != "" {
				<div class="flex flex-col gap-1">
					<a href={ templ.URL("/uploads/" + key) } target="_blank" class="truncate text-xs text-blue-600 hover:text-blue-700">{ storage.DisplayName(key) }</a>
					<input type="file" name={ f.ID } class="w-full font-sans text-xs text-slate-500"/>
				</div>
			} else {
				<input type="file" name={ f.ID } class="w-full font-sans text-xs text-slate-500"/>
			}
		default:
			<input type="text" name={ f.ID } value={ toString(current) } class={ fieldClasses(ctx) + " w-full" }/>
	}
}

// fileLink renders a FieldTypeFile value as a download link, or nothing if unset.
templ fileLink(v any) {
	if key := toString(v); key != "" {
		<a href={ templ.URL("/uploads/" + key) } target="_blank" class="text-blue-600 hover:text-blue-700">{ storage.DisplayName(key) }</a>
	}
}


// sortedKeys gives a map's keys in a stable order, so a `range` over it renders deterministically (007 §4.6).
func sortedKeys(m map[string]string) []string {
	out := make([]string, 0, len(m))
	for k := range m {
		out = append(out, k)
	}
	sort.Strings(out)
	return out
}
