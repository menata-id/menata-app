package rendering

import "slices"

import "menata.app/internal/domain"
import "menata.app/internal/experience"

// launcherGroups is the launcher panel's own content: the Workspace's own destinations first,
// then one section per Application, minus the items this viewer must not be offered (see
// appShell's hiddenNavIDs). A section left with no visible items is dropped entirely rather than
// rendering a heading over nothing.
//
// Since Fase 3 the sections are real Applications rather than `group:` labels inside one -- which
// is what the launcher was always drawing (ui-sample/nav-metadata.js lists Applications here),
// only now the metadata says so directly.
//
// Each Application contributes its *unfiltered* navigation. An Application with show_nav: false
// has no menu chrome anywhere else, and the launcher is deliberately the one place its screens
// stay reachable: nav-metadata.js states outright that the launcher never reads that field.
// Viewer-level hiding (hiddenNavIDs) is a different question from that metadata-level one, which
// is why both filters exist and only this one is per-request.
func launcherGroups(hiddenNavIDs []string) []experience.NavGroup {
	sections := []experience.NavGroup{{Items: workspace.Navigation}}
	for _, app := range workspace.Applications {
		sections = append(sections, experience.NavGroup{Label: app.Name, Items: app.AllNavigation})
	}

	visible := make([]experience.NavGroup, 0, len(sections))
	for _, s := range sections {
		items := make([]domain.NavigationItem, 0, len(s.Items))
		for _, item := range s.Items {
			if !slices.Contains(hiddenNavIDs, item.ID) {
				items = append(items, item)
			}
		}
		if len(items) > 0 {
			visible = append(visible, experience.NavGroup{Label: s.Label, Items: items})
		}
	}
	return visible
}

// headMeta is the <head> content shared by every Tailwind-styled page -- the pre-auth screens
// (authShell) and the Workspace-level screens (appShell) alike. pageShell keeps its own pageHead
// instead, because that one loads the hand-written pageStyles block rather than app.css; the two
// stylesheets deliberately do not meet on a page (capabilities.md, "Styling: two systems, on
// purpose"), since Tailwind's Preflight resets the heading and list defaults pageStyles relies on.
templ headMeta(title string) {
	<meta charset="UTF-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<title>{ title } · Menata App</title>
	<link rel="manifest" href="/manifest.json"/>
	<link rel="icon" href="/icons/favicon-32.png"/>
	<link rel="apple-touch-icon" href="/icons/icon-180.png"/>
	<meta name="theme-color" content="#2563EB"/>
	<link rel="stylesheet" href="/css/app.css"/>
}

// appShell is the chrome every Workspace-level screen shares, ported from
// ui-sample/case-03-flow1's own boards (03 Workspace home, 04 Workspace members, 05 Edit member):
// a 9-dot application launcher, a "Workspace / Page" breadcrumb, and the viewer's avatar.
//
// It is the third shell, alongside authShell (no Workspace chosen yet) and pageShell (the
// Application screens' projected topbar). pageShell is deliberately untouched for now: a page
// linking app.css must have its content ported in the same change, or Preflight strips the
// heading sizes and list markers pageStyles leaves to the browser -- which is what scopes this
// phase to the three screens that have a board, rather than to all fourteen.
//
// workspaceName and userInitials are passed explicitly rather than read from ctx. Resolving them
// in requireAuth was the first design, and it was wrong: it would add a Workspace lookup and a
// user-record read to *every* authenticated request, including /api/* and every HTMX partial,
// to serve chrome that three full-page screens render. With three call sites, an explicit
// parameter is both cheaper and the plainer dependency (CLAUDE.md, "Where a metadata-derived
// value belongs").
//
// activeNavID names the navigation item this page *is*, so the launcher can mark it current; ""
// for a screen with no navigation item of its own (Edit member, which is a sub-page of Workspace
// Members). It is an id rather than a route so no caller has to hand-type a route string, which
// internal/conformance's TestHandlersHaveNoHardcodedApplicationRoute would reject anyway.
//
// hiddenNavIDs are navigation items this *viewer* must not be offered, by id. It exists because
// moving navigation into the launcher created the forcing condition ROADMAP.md's "Per-user/role
// navigation filtering" was explicitly waiting for: that entry reasoned the feature wasn't needed
// because "the one concrete case found, Workspace Home's Members link, was workspace-level chrome,
// not a metadata nav item". The launcher makes `nav_workspace_members` exactly that nav item, and
// /workspace-members* is requireWorkspaceAdmin-gated server-side -- so without this a plain member
// would be offered a link that only ever 403s, re-opening the code-review finding of 2026-09-19
// that TestWorkspaceHomePage_membersLinkVisibility exists to hold shut.
//
// It is a caller-supplied list rather than a declared `requires_role:` on the navigation item
// because the declared form is the real feature, and this is one case, not a shape: the handler
// naming the item it already gates is honest and small. Forward-checkable pointer: ROADMAP.md's
// "Per-user/role navigation filtering", which this is now the first real case for.
templ appShell(title, workspaceName, userInitials, activeNavID string, hiddenNavIDs []string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@headMeta(title)
			<script src="/vendor/htmx.min.js" defer></script>
			<script src="/vendor/hyperscript.min.js" defer></script>
		</head>
		<body hx-headers={ csrfHeadersAttr(ctx) } class="m-0 bg-slate-50 font-sans text-slate-900">
			<header class="flex h-15 shrink-0 items-center gap-2.5 border-b border-slate-200 bg-white px-4 sm:pr-7 sm:pl-9">
				@appLauncher(activeNavID, hiddenNavIDs)
				<nav aria-label="Breadcrumb" class="min-w-0 truncate text-sm text-slate-400">
					// "/home" is a runtime-level route -- it exists regardless of which Application is
					// configured (internal/conformance's runtimeLevelRoutes), the same literal
					// workspaceHomeShell used before this. Not routeByID("nav_home"), which would panic
					// if an Application ever declared no home item.
					<a href="/home" class="font-medium text-slate-900 hover:underline">{ workspaceName }</a>
					{ " / " }
					{ title }
				</nav>
				<span class="ml-auto flex size-8 shrink-0 items-center justify-center rounded-full bg-slate-200 text-xs font-medium text-slate-700" aria-label="Signed in">
					{ userInitials }
				</span>
			</header>
			<main class="mx-auto flex w-full max-w-[1180px] flex-col gap-4 px-4 pt-6 pb-10 sm:px-6 sm:pt-8">
				{ children... }
			</main>
			@pwaRegistrationScript()
		</body>
	</html>
}

// appLauncher is the 9-dot menu at the head of the bar. It reads allNavigation -- the full
// declared list, *before* hidden_nav_groups filtering -- not the filtered navigation, which is
// the distinction ui-sample/nav-metadata.js states outright: hiding an Application suppresses its
// own menu chrome, never its launcher entry ("the launcher itself stays uniform/unconfigurable
// ... while the per-Application menu is what metadata controls"). domain.Application.AllNavigation
// already exists for exactly this pre-filter case.
//
// It is also what keeps every declared route reachable on a screen that has no topbar. Today's
// metadata declares one Application whose nav groups ("Document Approval", "Project Management",
// "Workspace") are what the boards draw as separate Applications, so the panel lists groups --
// which is the same list it will show once Fase 3 makes those real Applications, only sourced
// from `applications:` instead.
//
// <details> rather than JavaScript, matching the details.nav-group dropdown pageShell already
// uses.
templ appLauncher(activeNavID string, hiddenNavIDs []string) {
	<details class="relative shrink-0">
		<summary class="flex size-7 cursor-pointer list-none items-center justify-center text-slate-500 [&::-webkit-details-marker]:hidden" aria-label="Open app launcher">
			<svg width="16" height="16" viewBox="0 0 18 18" fill="currentColor" aria-hidden="true">
				<circle cx="3" cy="3" r="1.6"></circle>
				<circle cx="9" cy="3" r="1.6"></circle>
				<circle cx="15" cy="3" r="1.6"></circle>
				<circle cx="3" cy="9" r="1.6"></circle>
				<circle cx="9" cy="9" r="1.6"></circle>
				<circle cx="15" cy="9" r="1.6"></circle>
				<circle cx="3" cy="15" r="1.6"></circle>
				<circle cx="9" cy="15" r="1.6"></circle>
				<circle cx="15" cy="15" r="1.6"></circle>
			</svg>
		</summary>
		<div class="absolute top-9 left-0 z-40 w-72 rounded-lg border border-slate-200 bg-white p-2 shadow-lg">
			for _, group := range launcherGroups(hiddenNavIDs) {
				if group.Label != "" {
					<p class="px-2 pt-2 pb-1 text-3xs font-medium tracking-wide text-slate-400 uppercase">{ group.Label }</p>
				}
				for _, item := range group.Items {
					@launcherLink(item, item.ID == activeNavID)
				}
			}
		</div>
	</details>
}

// launcherLink is one destination inside the launcher panel.
//
// The badge is carried forward from pageShell's own navLink exactly as it was, including its
// fixed hx-get: domain.NavBadgeApprovalInboxPending is a known Domain Plane leak (the engine
// naming one business screen), written up in menata-app-document's
// audits/2026-09-20-decomposition-criteria-drift.md, and it is *blocked* from being generalized
// rather than merely unfinished -- the count it renders depends on cross-record sequencing
// ("assigned to me AND pending AND actionable"), which no declared filter can express yet. It is
// deliberately not "fixed" here, and deliberately not dropped: dropping it would be a product
// decision, not a refactor.
templ launcherLink(item domain.NavigationItem, current bool) {
	<a
		href={ templ.SafeURL(item.Route) }
		class={ "flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-slate-50",
			templ.KV("bg-blue-50 font-medium text-blue-700", current),
			templ.KV("text-slate-600", !current) }
		if current {
			aria-current="page"
		}
	>
		{ item.Label }
		if item.Badge == domain.NavBadgeApprovalInboxPending {
			<span
				id="launcher-pending-badge"
				class="rounded-full bg-red-100 px-1.5 text-3xs font-semibold text-red-700 empty:hidden"
				hx-get="/api/approval-inbox/pending-count"
				hx-trigger="load"
				hx-swap="innerHTML"
			></span>
		}
	</a>
}
