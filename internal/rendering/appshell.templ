package rendering

import (
	"context"
	"sort"
	"strings"
	"time"

	"menata.app/internal/domain"
	"menata.app/internal/experience"
)

// launcherAppHomeRoute is an Application card's link target: its own declared HomeRoute, falling
// back to Workspace Home exactly the way internal/web.applicationCards does for the Workspace
// Home grid -- the two card faces should never disagree about where an Application with no
// home_card item goes.
func launcherAppHomeRoute(ctx context.Context, app domain.Application) string {
	if app.HomeRoute != "" {
		return app.HomeRoute
	}
	return routeByID(ctx, "nav_home")
}

// headMeta is the <head> content shared by every Tailwind-styled page -- the pre-auth screens
// (authShell) and the Workspace-level screens (appShell) alike. pageShell keeps its own pageHead
// instead, because that one loads the hand-written pageStyles block rather than app.css; the two
// stylesheets deliberately do not meet on a page (capabilities.md, "Styling: two systems, on
// purpose"), since Tailwind's Preflight resets the heading and list defaults pageStyles relies on.
templ headMeta(title string) {
	<meta charset="UTF-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<title>{ title } · Menata App</title>
	<link rel="manifest" href="/manifest.json"/>
	<link rel="icon" href="/icons/favicon-32.png"/>
	<link rel="apple-touch-icon" href="/icons/icon-180.png"/>
	<meta name="theme-color" content="#2563EB"/>
	<link rel="stylesheet" href="/css/app.css"/>
}

// appShell is the chrome every Workspace-level screen shares, ported from
// ui-sample/case-03-flow1's own boards (03 Workspace home, 04 Workspace members, 05 Edit member):
// a 9-dot application launcher, a "Workspace / Page" breadcrumb, and the viewer's avatar.
//
// It is the third shell, alongside authShell (no Workspace chosen yet) and pageShell (the
// Application screens' projected topbar). pageShell is deliberately untouched for now: a page
// linking app.css must have its content ported in the same change, or Preflight strips the
// heading sizes and list markers pageStyles leaves to the browser -- which is what scopes this
// phase to the three screens that have a board, rather than to all fourteen.
//
// workspaceName and viewer are passed explicitly rather than read from ctx. Resolving them in
// requireAuth was the first design, and it was wrong: it would add a Workspace lookup and a
// user-record read to *every* authenticated request, including /api/* and every HTMX partial,
// to serve chrome that three full-page screens render. With three call sites, an explicit
// parameter is both cheaper and the plainer dependency (CLAUDE.md, "Where a metadata-derived
// value belongs").
//
// Viewer groups the three identity fields the Account menu needs (Name, Email, Initials) --
// added together (Account menu port, 2026-09-21) rather than as three more positional strings,
// since appShell's signature already carried six. internal/web.resolveChrome/shellChrome is
// where all three are read, from the one mch_user record it already loads.
type Viewer struct {
	Name     string
	Email    string
	Initials string
}
//
// TWO PARAMETERS WERE REMOVED ON 2026-09-21, both dead the moment the launcher stopped listing
// navigation items:
//
//   - activeNavID named the item this page *is*, so the launcher could mark it current. The
//     launcher lists Applications now; there is no item row left to mark.
//   - hiddenNavIDs were the items this *viewer* must not be offered (rendering.membersHiddenFor,
//     deleted with it). It existed because moving navigation into the launcher would otherwise
//     have offered a plain member `nav_workspace_members`, a link that only ever 403s -- the
//     code-review finding of 2026-09-19. The launcher offers the Workspace's administration
//     screens to *nobody* now, so there is nothing left to filter, and a filter that filters
//     nothing reads as protection without being it. The server-side gate (requireWorkspaceAdmin)
//     was always the real one and is untouched; Workspace Home's own "Manage members" link keeps
//     its separate `workspaceRole != "member"` check, which is the half still capable of leaking.
//     ROADMAP.md's "Per-user/role navigation filtering" goes back to having no real case.
//
// switchWorkspaceHref is the launcher's own "All Workspaces" link target, or "" to omit it --
// internal/web.viewerWorkspaceContext's second return value. "" exactly for the shared admin
// credential's placeholder identity (no membership row, so no email a Workspace list could be
// keyed on); every real identity gets the link regardless of how many Workspaces they actually
// belong to, by owner request (2026-09-20) -- /switch-workspace is where an "add workspace" entry
// point is meant to land next, so it stays offered even to a single-Workspace identity.
templ appShell(title, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@headMeta(title)
			<script src="/vendor/htmx.min.js" defer></script>
			<script src="/vendor/hyperscript.min.js" defer></script>
		</head>
		<body hx-headers={ csrfHeadersAttr(ctx) } class="m-0 bg-slate-50 font-sans text-slate-900">
			// The current Application's own menu (defaultAppMenu below) -- owner spec, ui-sample/
			// README.md's "Menu Navigasi": level 2 is "untuk desktop ada di atas" (a second row inside
			// this same header, not a bar stacked above it) and "untuk mobile ada di bagian bawah
			// berupa bottom bar". hasAppMenu is false for a Workspace-level screen (no Application, or
			// one declaring no navigation at all -- Workspace Home, Members), which is exactly when
			// neither row below renders.
			{{ currentApp, inApp := CurrentApplication(ctx) }}
			{{ path, rawQuery := CurrentPath(ctx) }}
			{{ menu := defaultAppMenu(currentApp.AllNavigation, path, rawQuery) }}
			{{ hasAppMenu := inApp && len(menu) > 0 }}
			// sticky, not static (owner request, 2026-09-24: "top bar dan bottom bar dibuat selalu
			// terlihat di screen"). The bottom bar was already `fixed`; this is the half that was
			// missing, and on the Flow 2 mockup's own tallest boards it is not cosmetic -- M06
			// (Permissions) is 1500px and M08 (Submit) 1560px, so scrolling either one used to take
			// the launcher, the breadcrumb and the account menu off screen together, leaving a long
			// form with no way out of it but the browser's own back button.
			//
			// z-40 over the bottom bar's z-30 so the header always wins where they overlap. The
			// menus themselves no longer depend on this: they are `popover` elements, which the
			// browser paints in the top layer, above every z-index on the page.
			<header class="sticky top-0 z-40 flex flex-col border-b border-slate-200 bg-white">
				<div class="flex h-15 shrink-0 items-center gap-2.5 px-4 sm:pr-7 sm:pl-9">
					@appLauncher(workspaceName, switchWorkspaceHref)
					// Two breadcrumb shapes, because the Flow 2 mockup has two. Inside an Application
					// (board 07 / M07) the Workspace name stands alone up here and the Application
					// names itself on the row below -- except on a phone, which has no second row, so
					// the Application's name becomes a second line here instead (M07's own stacked
					// "Dokter Kecil" over "Document Approval"). A Workspace-level screen (board 04) has
					// no Application to name, so it keeps the plain "Workspace / Page" pair.
					//
					// "/home" is a runtime-level route -- it exists regardless of which Application is
					// configured (internal/conformance's runtimeLevelRoutes). Not routeByID(ctx,
					// "nav_home"), which would panic if an Application ever declared no home item.
					if hasAppMenu {
						<nav aria-label="Breadcrumb" class="flex min-w-0 flex-col justify-center">
							<a href="/home" class="truncate text-xs leading-4 font-medium text-slate-500 hover:text-slate-900 sm:text-sm sm:text-slate-900">{ workspaceName }</a>
							<span class="truncate text-sm leading-5 font-medium text-slate-900 sm:hidden">{ currentApp.Name }</span>
						</nav>
					} else {
						<nav aria-label="Breadcrumb" class="min-w-0 truncate text-sm text-slate-400">
							<a href="/home" class="font-medium text-slate-900 hover:underline">{ workspaceName }</a>
							{ " / " }
							{ title }
						</nav>
					}
					<span class="ml-auto">
						@accountMenu(viewer)
					</span>
				</div>
				if hasAppMenu {
					@applicationMenuRow(menu, currentApp)
				}
			</header>
			<main class={ "mx-auto flex w-full max-w-[1180px] flex-col gap-4 px-4 pt-6 sm:px-6 sm:pt-8", templ.KV("pb-24 sm:pb-10", hasAppMenu), templ.KV("pb-10", !hasAppMenu) }>
				{ children... }
			</main>
			if hasAppMenu {
				@applicationBottomBar(bottomBarItems(menu), currentApp, workspaceName, switchWorkspaceHref)
			}
			@pwaRegistrationScript()
		</body>
	</html>
}

// navMenuItem is one entry in the current Application's own menu -- appShell's desktop row and
// mobile bottom bar both render this, not domain.NavigationItem directly, because Active is a
// presentation decision (which item matches the current request) that neither belongs on the
// declared metadata shape nor need be recomputed by each of the two renderers separately.
type navMenuItem struct {
	Label string
	Href  string
	Icon  string
	// Badge is the declared domain.KnownNavigationBadges kind this item asks for, carried through
	// unchanged from domain.NavigationItem.Badge so the bottom bar can draw the same live count
	// pageShell's own navLink already draws. Empty for an item that declares none.
	Badge  string
	Active bool
}

// defaultAppMenu turns an Application's own declared navigation into appShell's menu, sorted by
// Priority (ties keep declaration order -- the same stable sort experience.GroupNavigation
// already uses) and with exactly one entry marked Active.
//
// Matching is path-plus-tab, not a plain prefix compare: Approval Inbox's own "My Documents" is a
// query on the same path as "Approval Inbox" (nav_my_documents's declared route is literally
// "/approval-inbox?tab=mine"), the one place this runtime uses a query to name a distinct
// destination (document-approval.yaml's own comment on that item). navItemActive compares each
// declared route's own ?tab= against the request's, generalizing what approvalinbox.templ's
// inboxTabs/routeTabParam did for that one Application to every Application's menu. Falling back
// to the first item when nothing matches keeps inboxTabs' own fallback behavior (a stale or
// tab-less link still shows something selected, rather than a menu with nothing marked).
//
// One accepted trade: inboxTabs used to carry the active `?filter=` SLA chip forward across a tab
// switch. A generic menu shared by every Application has no such per-Application concept to
// forward, so switching tabs here resets it -- a minor UX regression traded for one menu instead
// of a bespoke one per Application (CLAUDE.md's decomposition trigger: this is the second
// Application that needs this exact shape).
func defaultAppMenu(items []domain.NavigationItem, path, rawQuery string) []navMenuItem {
	sorted := make([]domain.NavigationItem, len(items))
	copy(sorted, items)
	sort.SliceStable(sorted, func(i, j int) bool { return sorted[i].Priority < sorted[j].Priority })

	menu := make([]navMenuItem, len(sorted))
	matched := -1
	for i, item := range sorted {
		active := navItemActive(item, path, rawQuery)
		if active && matched == -1 {
			matched = i
		}
		menu[i] = navMenuItem{Label: item.Label, Href: item.Route, Icon: item.Icon, Badge: item.Badge, Active: active}
	}
	if matched == -1 && len(menu) > 0 {
		menu[0].Active = true
	}
	return menu
}

// navItemActive reports whether item's declared route names the current request: same path, and
// the same ?tab= value (both empty counts as a match) -- see defaultAppMenu's own doc comment.
func navItemActive(item domain.NavigationItem, path, rawQuery string) bool {
	itemPath, itemQuery, _ := strings.Cut(item.Route, "?")
	return itemPath == path && tabParam(itemQuery) == tabParam(rawQuery)
}

// tabParam reads a raw query string's own "tab" value without a full net/url round trip --
// good enough here because every declared route's query is metadata this package itself wrote.
func tabParam(rawQuery string) string {
	for _, pair := range strings.Split(rawQuery, "&") {
		key, value, _ := strings.Cut(pair, "=")
		if key == "tab" {
			return value
		}
	}
	return ""
}

// bottomBarItems is appShell's mobile row: the menu's own first three entries (owner spec,
// ui-sample/README.md: "dengan 3-4 icon"), in the same Priority order the desktop row already
// uses -- not a separate declaration, so the two rows can never disagree about which items lead.
//
// THREE, not four, since 2026-09-24: the fourth column is always "More" (applicationBottomBar's
// own sheet), which is the Flow 2 mockup's M07/M07b pair. That is a real trade and worth naming --
// an Application declaring four or more navigation items now surfaces three of them here instead
// of four. It is the right way round: the items past the third are reachable from the desktop row
// and the launcher either way, while *leaving the Application* had no mobile affordance at all
// before this, because the launcher lives in the top bar that used to scroll away.
func bottomBarItems(menu []navMenuItem) []navMenuItem {
	return menu[:min(3, len(menu))]
}

// applicationMenuRow is appShell's header, second row: the current Application's own menu,
// `hidden` below `sm` where applicationBottomBar takes over instead (owner spec,
// ui-sample/README.md's "Menu Navigasi" -- see appShell's own doc comment above).
//
// It opens on the Application naming itself -- its own declared icon tile and name, then a rule --
// which is the Flow 2 mockup's board 07 and is not decoration: with the Workspace name one row up
// and the page's own <h1> below, this row was the only place that ever said *which Application you
// are in*, and before 2026-09-24 it said it nowhere.
//
// The mockup's right-hand "Settings" link is deliberately absent, the same call moreSheet makes
// for the same reason: no per-Application settings hub exists yet (the Flow 2 gap study's §5.3,
// menata-app-document's audits/2026-09-23-kajian-gap-mockup-flow2.md). Pointing it at
// /authorization-matrix -- a Workspace-level admin screen -- while labelling it this Application's
// would be a worse lie than the gap.
templ applicationMenuRow(menu []navMenuItem, app domain.Application) {
	<nav aria-label="Application" class="hidden items-center gap-1 border-t border-slate-100 px-4 py-1.5 sm:flex sm:px-6">
		<span class="mr-1 flex items-center gap-2">
			if app.Icon != "" {
				<span class={ "flex size-6 shrink-0 items-center justify-center rounded-md", appIconClasses(app.Color) }>
					@icon(app.Icon, "size-3.5")
				</span>
			}
			<span class="text-sm font-medium text-slate-900">{ app.Name }</span>
		</span>
		<span aria-hidden="true" class="mr-2 ml-1 h-5 w-px bg-slate-200"></span>
		for _, item := range menu {
			<a
				href={ templ.SafeURL(item.Href) }
				class={ "flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-sm", templ.KV("font-medium text-blue-700", item.Active), templ.KV("text-slate-600 hover:bg-slate-50 hover:text-slate-900", !item.Active) }
				if item.Active {
					aria-current="page"
				}
			>
				{ item.Label }
				@navBadge(item.Badge, "inline-flex h-4.5 min-w-4.5 items-center justify-center rounded-full bg-blue-50 px-1.5 text-3xs font-medium text-blue-700 empty:hidden")
			</a>
		}
	</nav>
}

// navBadge is the live count a navigation item declares, drawn wherever that item is (the header
// row's small blue pill, the bottom bar's red bubble -- class carries the difference).
//
// `empty:hidden` is load-bearing, not tidiness: the endpoint deliberately renders *nothing* when
// there is nothing pending (internal/web.showPendingCount), so without it a viewer with an empty
// inbox gets a bare coloured dot with no number in it. pageShell's own hand-written stylesheet has
// always carried the same rule as `.nav-badge:empty`; this is its Tailwind half, and it was missing
// for the first day the bottom-bar badge existed.
//
// Each badge is its own hx-get, so a screen drawing both rows pays for the count twice -- ~5
// queries, on Document Approval's screens only, and only because a count nobody threaded through
// appShell has to fetch itself. One request again the moment that stops being true (ROADMAP.md's
// `NavBadgeApprovalInboxPending` deferral row).
templ navBadge(badge, class string) {
	if badge == domain.NavBadgeApprovalInboxPending {
		<span
			class={ class }
			hx-get="/api/approval-inbox/pending-count"
			hx-trigger="load"
			hx-swap="innerHTML"
		></span>
	}
}

// applicationBottomBar is the mobile counterpart of applicationMenuRow -- owner spec's other half:
// a fixed bar, icon over label, shown only below `sm` where the header's own second row is
// `hidden`. The Flow 2 mockup's M07-Inbox board is the visual reference: 76px tall, evenly split
// columns, active in blue-600, the rest in slate-500, with a red count bubble on the tab whose
// item declares a badge.
//
// Four columns: three declared items (bottomBarItems) and "More", whose sheet is the one way out
// of an Application on a phone -- see moreSheet.
templ applicationBottomBar(items []navMenuItem, app domain.Application, workspaceName, switchWorkspaceHref string) {
	<nav aria-label="Application" class="fixed inset-x-0 bottom-0 z-30 flex h-19 items-start border-t border-slate-200 bg-white px-1 pb-3 sm:hidden">
		for _, item := range items {
			<a
				href={ templ.SafeURL(item.Href) }
				class={ "flex flex-1 flex-col items-center gap-1 py-2 text-2xs", templ.KV("font-medium text-blue-600", item.Active), templ.KV("text-slate-500", !item.Active) }
				if item.Active {
					aria-current="page"
				}
			>
				<span class="relative flex">
					@icon(item.Icon, "size-5.5")
					@navBadge(item.Badge, "absolute -top-1 -right-2.5 flex h-4 min-w-4 items-center justify-center rounded-full bg-red-600 px-1 text-3xs text-white empty:hidden")
				</span>
				{ item.Label }
			</a>
		}
		@moreSheet(app, workspaceName, switchWorkspaceHref)
	</nav>
}

// moreSheet is the bottom bar's fourth column: a bottom sheet holding the destinations that leave
// the current Application (Flow 2 mockup, M07b). It exists because a phone has no launcher of its
// own -- the 9-dot panel is a top-bar dropdown sized for a pointer -- so before this, the only way
// from an Application's screen back to the Workspace, or across to another Application, was the
// browser's back button.
//
// Its three groups are Workspace home, the Workspace's own Applications, and All Workspaces: the
// same three the launcher shows, deliberately, because they answer the same question. It marks the
// Application you are already in (aria-current), which the launcher never needs to.
//
// The mockup's third row, "<Application> settings", is NOT rendered: no per-Application settings
// hub exists yet (the Flow 2 gap study's §5.3, menata-app-document's
// audits/2026-09-23-kajian-gap-mockup-flow2.md). Drawing a row that links nowhere, or pointing it
// at a Workspace-level admin screen and calling it the Application's, would both be worse than
// its absence.
//
// THE POPOVER API, not <details> (2026-09-24, and it replaced <details> the same day it shipped
// on one). The owner's report was exact: "behaviour bottom sheet juga masih belum bisa tertutup,
// kecuali klik di avatar pojok kanan atas" -- a <details> panel closes only by re-clicking its own
// summary, and the shipped comment called that an "accepted cost" of having no JavaScript. It was
// not acceptable and it did not need JavaScript: `popover` gives light dismiss (a click anywhere
// outside closes it) and Escape for free, from the browser, and it paints in the top layer so no
// z-index anywhere can trap it. appLauncher and accountMenu moved with it, since all three had the
// identical flaw -- which is why the owner met it on the avatar.
//
// The shade is a *button* covering the screen above the bar, not a styled ::backdrop. Two reasons,
// both from M07b: a real ::backdrop covers the whole viewport, including the bottom bar the mockup
// deliberately leaves undimmed and legible; and light dismiss does not fire for clicks *inside*
// the popover, so the shade has to dismiss the sheet itself. `popovertargetaction="hide"` does
// that with no script, and being a <button> it is reachable by keyboard rather than a dead div.
templ moreSheet(app domain.Application, workspaceName, switchWorkspaceHref string) {
	<div class="flex flex-1 flex-col">
		<button
			type="button"
			popovertarget="menata-more-sheet"
			class="menata-more-tab flex w-full cursor-pointer flex-col items-center gap-1 border-0 bg-transparent py-2 font-sans text-2xs text-slate-500"
		>
			@icon("more", "size-5.5")
			More
		</button>
		<div id="menata-more-sheet" popover class="menata-sheet inset-x-0 top-0 bottom-19 m-0 h-auto max-h-none w-auto max-w-none overflow-visible border-0 bg-transparent p-0">
			<button
				type="button"
				popovertarget="menata-more-sheet"
				popovertargetaction="hide"
				aria-label="Close"
				class="absolute inset-0 w-full cursor-default border-0 bg-slate-900/40 p-0"
			></button>
			<div class="absolute inset-x-0 bottom-0 max-h-full overflow-y-auto rounded-t-2xl bg-white p-2 pb-4 shadow-[0_-8px_24px_rgba(15,23,42,0.16)]">
				<div class="mx-auto mb-2 h-1 w-10 rounded-full bg-slate-200"></div>
				<div class="flex items-center justify-between px-3 pt-1 pb-2">
					<span class="text-base font-medium text-slate-900">More</span>
					<span class="truncate text-xs text-slate-400">{ app.Name }</span>
				</div>
				<a href="/home" class="flex items-center gap-3.5 rounded-lg p-3 text-left hover:bg-slate-50">
					<span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-slate-50 text-slate-500">
						@icon("home", "size-5")
					</span>
					<span class="flex min-w-0 grow flex-col gap-0.5">
						<span class="text-sm text-slate-900">{ labelByID(ctx, "nav_home") }</span>
						<span class="truncate text-xs text-slate-400">{ workspaceName }</span>
					</span>
					<span class="text-slate-300">
						@icon("chevron-right", "size-4")
					</span>
				</a>
				<div class="mx-2.5 my-1.5 h-px bg-slate-100"></div>
				for _, other := range CurrentWorkspace(ctx).Applications {
					<a
						href={ templ.SafeURL(launcherAppHomeRoute(ctx, other)) }
						class="flex items-center gap-3.5 rounded-lg p-3 text-left hover:bg-slate-50"
						if other.ID == app.ID {
							aria-current="page"
						}
					>
						<span class={ "flex size-9 shrink-0 items-center justify-center rounded-lg", appIconClasses(other.Color) }>
							@icon(other.Icon, "size-5")
						</span>
						<span class="flex min-w-0 grow flex-col gap-0.5">
							<span class={ "text-sm text-slate-900", templ.KV("font-medium", other.ID == app.ID) }>{ other.Name }</span>
							if other.Description != "" {
								<span class="truncate text-xs text-slate-400">{ other.Description }</span>
							}
						</span>
						<span class="text-slate-300">
							@icon("chevron-right", "size-4")
						</span>
					</a>
				}
				if switchWorkspaceHref != "" {
					<div class="mx-2.5 my-1.5 h-px bg-slate-100"></div>
					<a href={ templ.SafeURL(switchWorkspaceHref) } class="block rounded-lg p-3 text-sm font-medium text-blue-600 hover:bg-slate-50">All Workspaces →</a>
				}
			</div>
		</div>
	</div>
}

// accountMenu is the avatar's own menu (Account menu port, 2026-09-21, from
// ui-sample/nav-chrome.js's accountHTML): identity, Profile, Security, Sign out. Page-internal --
// capabilities.md's own promotion rule ("earns a row here only once a second... Page needs the
// identical shape") -- since appShell is its only caller; it does not yet get a "Shared rendering
// components" row of its own.
//
// A `popover`, like appLauncher and moreSheet -- see moreSheet's own comment for why all three
// left <details> on 2026-09-24. This is the menu the owner actually hit the old behaviour on:
// with no light dismiss anywhere, the avatar was the only control that would close *anything*,
// so it became the way to dismiss the More sheet too.
//
// Its panel is positioned bottom-sheet-style on mobile (pinned to the viewport bottom, rounded top
// corners) and as a right-anchored dropdown at `sm` and up, via Tailwind classes alone -- ported
// from ui-sample/nav-chrome.js's sheetPanelClasses(). `top-17` rather than CSS anchor positioning:
// the header is a fixed 60px and sticky at top-0, so the panel's own offset is knowable without a
// feature that is still Chromium-only.
//
// Profile and Security are runtime-level routes (`/account-profile`, `/account-security`) --
// they exist regardless of which Applications a Workspace configures, the same category as
// `/home` above, so they're literals here rather than routeByID lookups (nothing declares them in
// app.yaml navigation) -- both are listed in internal/conformance's runtimeLevelRoutes for exactly
// this reason. Sign out reuses pageShell's own logout form shape (machine.templ) -- appShell-based
// screens had no sign-out at all before this.
templ accountMenu(viewer Viewer) {
	<div class="shrink-0">
		<button
			type="button"
			popovertarget="menata-account-menu"
			aria-label="Account menu"
			class="flex size-8 cursor-pointer items-center justify-center rounded-full border-0 bg-slate-200 font-sans text-xs font-medium text-slate-700"
		>
			{ viewer.Initials }
		</button>
		<div id="menata-account-menu" popover class="menata-popover inset-x-0 top-auto bottom-0 m-0 max-h-[80vh] w-auto max-w-none overflow-y-auto rounded-t-2xl rounded-b-none border-0 border-t border-slate-200 bg-white p-2 pb-6 shadow-xl sm:inset-auto sm:top-17 sm:right-4 sm:w-72 sm:rounded-lg sm:border sm:pb-2 sm:shadow-lg">
			<div class="mx-auto mb-1 h-1 w-10 rounded-full bg-slate-200 sm:hidden"></div>
			<div class="flex flex-col gap-0.5 px-2 pt-1 pb-2">
				<span class="truncate text-sm font-medium text-slate-900">{ viewer.Name }</span>
				<span class="truncate text-xs text-slate-400">{ viewer.Email }</span>
			</div>
			<div class="my-1 h-px bg-slate-100"></div>
			<a href="/account-profile" class="block rounded-md px-2 py-2 text-sm text-slate-700 hover:bg-slate-50">Profile</a>
			<a href="/account-security" class="block rounded-md px-2 py-2 text-sm text-slate-700 hover:bg-slate-50">Security</a>
			<div class="my-1 h-px bg-slate-100"></div>
			<form method="POST" action="/logout">
				@csrfHiddenInput()
				<button type="submit" class="w-full rounded-md px-2 py-2 text-left font-sans text-sm text-slate-700 hover:bg-slate-50">Sign out</button>
			</form>
		</div>
	</div>
}

// appLauncher is the 9-dot menu at the head of the bar (redesigned 2026-09-20, by owner request,
// from a flat list of every declared item to ui-sample/nav-chrome.js's own card shape). Three
// parts, top to bottom:
//
//  1. A header row -- "WORKSPACE" eyebrow + the Workspace's own name, linking to Workspace Home
//     (routeByID(ctx, "nav_home"), not the literal appShell's breadcrumb uses, since a missing
//     nav_home item should panic here exactly as it would for any other lookup) -- what nav_home
//     used to be as a flat item, promoted to the panel's own title, the same role it already
//     plays on Workspace Home itself (workspacehome.templ's "WORKSPACE" eyebrow + <h1>).
//  2. One entry per Application, in Workspace.Applications' own declaration order -- always a
//     single card (launcherAppCard): icon, name, description, linking straight to its HomeRoute.
//     The launcher's whole job is to get you *into* an Application; its screens are that
//     Application's own menu's problem.
//
//     Until 2026-09-21 an Application with ShowNav false (Document Approval) was the exception,
//     listing every one of its screens flat, "because the launcher is deliberately the only place
//     those screens stay reachable -- collapsing it to a card would orphan them". That premise is
//     gone: Document Approval has its own menu now, the strip across the top of its screens, which
//     projects its two declared navigation items (approvalinbox.templ's inboxTabs). Nothing is
//     orphaned by collapsing it, and the owner's own instruction for this panel is that it shows
//     links to the Applications in the Workspace -- not to their insides.
//
// "All Workspaces" at the very bottom is shown only when switchWorkspaceHref is non-empty (see
// appShell's own doc comment for who that excludes) -- routeByID would panic looking it up, since
// it names no declared navigation item at all, so the caller-supplied href stays a plain string
// exactly like ChooseWorkspacePage's own pre-auth links.
//
// A `popover` since 2026-09-24 (it was <details> before) -- see moreSheet for the reasoning and
// for what the old mechanism cost. pageShell's own details.nav-group dropdown is untouched: that
// stylesheet and that topbar are a separate system (capabilities.md, "Styling: two systems, on
// purpose"), and changing it here would be a port nobody asked for.
templ appLauncher(workspaceName, switchWorkspaceHref string) {
	<div class="shrink-0">
		<button
			type="button"
			popovertarget="menata-app-launcher"
			aria-label="Open app launcher"
			class="flex size-7 cursor-pointer items-center justify-center border-0 bg-transparent p-0 text-slate-500"
		>
			@icon("grid", "size-4")
		</button>
		<div id="menata-app-launcher" popover class="menata-popover inset-auto top-17 left-4 m-0 w-72 max-w-[calc(100vw-2rem)] rounded-lg border border-slate-200 bg-white p-2 shadow-lg sm:left-9">
			<a href={ templ.SafeURL(routeByID(ctx, "nav_home")) } class="mb-1 flex flex-col gap-0.5 rounded-md p-2 hover:bg-slate-50">
				<span class="text-3xs font-medium tracking-wide text-blue-600 uppercase">Workspace</span>
				<span class="text-sm font-medium text-slate-900">{ workspaceName }</span>
			</a>
			for _, app := range CurrentWorkspace(ctx).Applications {
				@launcherAppCard(app)
			}
			if switchWorkspaceHref != "" {
				<a href={ templ.SafeURL(switchWorkspaceHref) } class="mt-1 block rounded-md p-2 text-xs font-medium text-blue-600 hover:bg-slate-50">All Workspaces →</a>
			}
		</div>
	</div>
}

// launcherAppCard is one Application's face in the launcher -- ui-sample/nav-chrome.js's
// launcherPanelHTML row shape, reusing
// appIconClasses (workspacehome.templ) so an Application's icon tile matches its own Workspace
// Home card exactly.
templ launcherAppCard(app domain.Application) {
	<a href={ templ.SafeURL(launcherAppHomeRoute(ctx, app)) } class="flex items-start gap-3 rounded-md p-2 hover:bg-slate-50">
		<span class={ "flex size-8 shrink-0 items-center justify-center rounded-lg", appIconClasses(app.Color) }>
			@icon(app.Icon, "size-4.5")
		</span>
		<span class="flex min-w-0 flex-col">
			<span class="text-sm font-medium text-slate-900">{ app.Name }</span>
			if app.Description != "" {
				<span class="text-xs text-slate-500">{ app.Description }</span>
			}
		</span>
	</a>
}

// launcherLink was deleted on 2026-09-21 with its last caller (launcherAppGroup). The launcher
// lists Applications now, not their screens, so there is no per-screen row left to render.
//
// It carried the pending-approval badge (hx-get /api/approval-inbox/pending-count) on the Approval
// Inbox row. That badge is not lost -- pageShell's own navLink still renders it, from the same
// domain.NavBadgeApprovalInboxPending declaration -- but the launcher no longer shows one, because
// it no longer shows that screen. Putting a count on an Application *card* is a different feature
// (Workspace Home's cards already do it) and was not folded in here.

// summaryCountTiles / activityFeedListRow / sectionHeaderRow are the Tailwind twins of
// machine.templ's summaryCounts / activityFeedList / sectionHeader -- same data shapes
// (SummaryItem, ActivityEntry), different markup, for the same reason reviewdocument.templ's own
// reviewProgress is deliberately not approvalStepper even though both draw a []StepApprover:
// Preflight ties chrome to content (capabilities.md, "Styling: two systems, on purpose"), so a
// pageStyles class name (.summary-counts, .activity-feed, .section-link) renders unstyled under
// appShell's app.css. Dashboard, Sprint Dashboard, My Tasks, Team Capacity and Activity (Project
// Management's own pageShell -> appShell port, 2026-09-22) use these; detail.templ still uses the
// originals, being still pageStyles.
templ summaryCountTiles(items []SummaryItem) {
	<div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
		for _, it := range items {
			<div class="rounded-lg border border-slate-200 bg-white p-3">
				<div class="text-2xl font-medium">{ it.Value }</div>
				<div class="text-xs text-slate-500">{ it.Label }</div>
			</div>
		}
	</div>
}

templ activityFeedListRow(entries []ActivityEntry) {
	<ul class="flex flex-col gap-2">
		for _, a := range entries {
			<li class="flex flex-wrap items-center gap-2 text-sm">
				<span>{ a.Summary }</span>
				if a.Actor != "" {
					<span class="rounded-full bg-slate-100 px-2 py-0.5 text-2xs text-slate-600">{ a.Actor }</span>
				}
				<span class="ml-auto text-xs text-slate-400">{ a.When }</span>
			</li>
		}
	</ul>
}

templ sectionHeaderRow(title, linkHref, linkLabel string) {
	<div class="flex items-center justify-between">
		<h2 class="m-0 text-base font-medium">{ title }</h2>
		if linkHref != "" {
			<a href={ templ.URL(linkHref) } class="text-sm text-blue-600 hover:text-blue-700">{ linkLabel }</a>
		}
	</div>
}

// slaBadgePill is machine.templ's slaBadge, Tailwind side -- same experience.EvaluateSLA
// resolution, red text over a plain badge for overdue, a slate pill otherwise.
templ slaBadgePill(v any) {
	if due, err := time.Parse("2006-01-02", toString(v)); err == nil {
		{{ status, label := experience.EvaluateSLA(due, time.Now()) }}
		if status == experience.SLAOverdue {
			<span class="text-xs font-medium text-red-600">{ label }</span>
		} else {
			<span class="rounded-full bg-slate-100 px-2 py-0.5 text-2xs text-slate-600">{ label }</span>
		}
	}
}
