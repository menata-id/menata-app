package rendering

import (
	"context"
	"sort"
	"strings"

	"menata.app/internal/domain"
)

// launcherAppHomeRoute is an Application card's link target: its own declared HomeRoute, falling
// back to Workspace Home exactly the way internal/web.applicationCards does for the Workspace
// Home grid -- the two card faces should never disagree about where an Application with no
// home_card item goes.
func launcherAppHomeRoute(ctx context.Context, app domain.Application) string {
	if app.HomeRoute != "" {
		return app.HomeRoute
	}
	return routeByID(ctx, "nav_home")
}

// headMeta is the <head> content shared by every Tailwind-styled page -- the pre-auth screens
// (authShell) and the Workspace-level screens (appShell) alike. pageShell keeps its own pageHead
// instead, because that one loads the hand-written pageStyles block rather than app.css; the two
// stylesheets deliberately do not meet on a page (capabilities.md, "Styling: two systems, on
// purpose"), since Tailwind's Preflight resets the heading and list defaults pageStyles relies on.
templ headMeta(title string) {
	<meta charset="UTF-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<title>{ title } · Menata App</title>
	<link rel="manifest" href="/manifest.json"/>
	<link rel="icon" href="/icons/favicon-32.png"/>
	<link rel="apple-touch-icon" href="/icons/icon-180.png"/>
	<meta name="theme-color" content="#2563EB"/>
	<link rel="stylesheet" href={ assetURL("/css/app.css") }/>
}

// appShell is the chrome every Workspace-level screen shares, ported from
// ui-sample/case-03-flow1's own boards (03 Workspace home, 04 Workspace members, 05 Edit member):
// a 9-dot application launcher, a "Workspace / Page" breadcrumb, and the viewer's avatar.
//
// It is the third shell, alongside authShell (no Workspace chosen yet) and pageShell (the
// Application screens' projected topbar). pageShell is deliberately untouched for now: a page
// linking app.css must have its content ported in the same change, or Preflight strips the
// heading sizes and list markers pageStyles leaves to the browser -- which is what scopes this
// phase to the three screens that have a board, rather than to all fourteen.
//
// workspaceName and viewer are passed explicitly rather than read from ctx. Resolving them in
// requireAuth was the first design, and it was wrong: it would add a Workspace lookup and a
// user-record read to *every* authenticated request, including /api/* and every HTMX partial,
// to serve chrome that three full-page screens render. With three call sites, an explicit
// parameter is both cheaper and the plainer dependency (CLAUDE.md, "Where a metadata-derived
// value belongs").
//
// Viewer groups the three identity fields the Account menu needs (Name, Email, Initials) --
// added together (Account menu port, 2026-09-21) rather than as three more positional strings,
// since appShell's signature already carried six. internal/web.resolveChrome/shellChrome is
// where all three are read, from the one mch_user record it already loads.
type Viewer struct {
	Name     string
	Email    string
	Initials string
	// WorkspaceRole is the viewer's role in the Workspace they are looking at ("admin"/"member"),
	// added 2026-09-24 with the Workspace menu -- which offers a requireWorkspaceAdmin-gated
	// destination and must not offer it to someone it would only ever 403.
	//
	// It sits on Viewer rather than arriving as a fourth appShell parameter because it is a fact
	// about *who is looking*, which is what this type already is. It is presentation only: the
	// server-side gate is the real one and is untouched, exactly as the deleted hiddenNavIDs
	// parameter's own note records.
	WorkspaceRole string
	// Applications is the installed Applications this viewer can open, in declaration order --
	// internal/web.openableApplications, the same predicate requireApplicationAccess gates with. The
	// launcher and the mobile "More" sheet list these rather than CurrentWorkspace(ctx).Applications,
	// so neither offers an Application that would only answer 403 (S0.1, 2026-10-10). Presentation
	// only, like WorkspaceRole: the middleware is the real gate.
	Applications []domain.Application
}
//
// TWO PARAMETERS WERE REMOVED ON 2026-09-21, both dead the moment the launcher stopped listing
// navigation items:
//
//   - activeNavID named the item this page *is*, so the launcher could mark it current. The
//     launcher lists Applications now; there is no item row left to mark.
//   - hiddenNavIDs were the items this *viewer* must not be offered (rendering.membersHiddenFor,
//     deleted with it). It existed because moving navigation into the launcher would otherwise
//     have offered a plain member `nav_workspace_members`, a link that only ever 403s -- the
//     code-review finding of 2026-09-19. The launcher offers the Workspace's administration
//     screens to *nobody* now, so there is nothing left to filter, and a filter that filters
//     nothing reads as protection without being it. The server-side gate (requireWorkspaceAdmin)
//     was always the real one and is untouched; Workspace Home's own "Manage members" link keeps
//     its separate `workspaceRole != "member"` check, which is the half still capable of leaking.
//     development-history.md's "Per-user/role navigation filtering" goes back to having no real case.
//
// switchWorkspaceHref is the launcher's own "All Workspaces" link target, or "" to omit it --
// internal/web.viewerWorkspaceContext's second return value. "" exactly for the shared admin
// credential's placeholder identity (no membership row, so no email a Workspace list could be
// keyed on); every real identity gets the link regardless of how many Workspaces they actually
// belong to, by owner request (2026-09-20) -- /switch-workspace is where an "add workspace" entry
// point is meant to land next, so it stays offered even to a single-Workspace identity.
templ appShell(title, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@headMeta(title)
			@themeStyle()
			<script src={ assetURL("/vendor/htmx.min.js") } defer></script>
			<script src={ assetURL("/vendor/hyperscript.min.js") } defer></script>
			// htmx swaps nothing in for a 4xx/5xx, so a refused write (a 422 "signature required", a 403)
			// looked exactly like a button that does nothing -- the Approve bug of 2026-10-05 was silent
			// for that reason alone. One notice for every htmx request, instead of one per form.
			// The notice's look, cloned by the script below: a class string written inside a script is one no reader moves.
			<template id="htmx-error-template"><div role="alert" class={ htmxErrorToastClasses(ctx) }></div></template>
			<script>
				document.addEventListener("htmx:responseError", function (e) {
					var xhr = e.detail.xhr;
					var msg = xhr.status >= 500
						? "Something went wrong on our side. Please try again."
						: (xhr.responseText || "").trim().slice(0, 300) || "That request was refused.";
					var box = document.getElementById("htmx-error");
					if (!box) {
						box = document.getElementById("htmx-error-template").content.firstElementChild.cloneNode(true);
						box.id = "htmx-error";
						box.addEventListener("click", function () { box.hidden = true; });
						document.body.appendChild(box);
					}
					box.textContent = msg;
					box.hidden = false;
					clearTimeout(box._t);
					box._t = setTimeout(function () { box.hidden = true; }, 8000);
				});
			</script>
		</head>
		<body hx-headers={ csrfHeadersAttr(ctx) } class={ "m-0", backgroundClass(ctx, domain.BackgroundBase), "font-sans " + inkClass(ctx, domain.InkStrong) }>
			// Read-only banner (Flow 2 gap study Tahap 7) -- the "keep the UI honest" half of
			// blockWritesToArchivedWorkspace (internal/web/middleware.go), which is what actually
			// enforces it. One banner on every authenticated page rather than disabling each
			// individual form/button across the app -- the server refuses the write regardless.
			if CurrentWorkspaceArchived(ctx) {
				<div class={ "border-b", toneEdgeClass(ctx, domain.ToneWarn), toneFillClass(ctx, domain.ToneWarn), "px-4 py-2 text-center", textClass(ctx, domain.RoleMeta), weightClass(ctx, domain.WeightEmphasis), toneInkClass(ctx, domain.ToneWarn) }>This workspace is archived and read-only.</div>
			}
			// The current Application's own menu (defaultAppMenu below) -- owner spec, ui-sample/
			// README.md's "Menu Navigasi": level 2 is "untuk desktop ada di atas" (a second row inside
			// this same header, not a bar stacked above it) and "untuk mobile ada di bagian bawah
			// berupa bottom bar". hasAppMenu is false for a Workspace-level screen (no Application, or
			// one declaring no navigation at all -- Workspace Home, Members), which is exactly when
			// neither row below renders.
			{{ currentApp, inApp := CurrentApplication(ctx) }}
			{{ path, rawQuery := CurrentPath(ctx) }}
			{{ menu := defaultAppMenu(currentApp.AllNavigation, path, rawQuery) }}
			{{ hasAppMenu := inApp && len(menu) > 0 }}
			// sticky, not static (owner request, 2026-09-24: "top bar dan bottom bar dibuat selalu
			// terlihat di screen"). The bottom bar was already `fixed`; this is the half that was
			// missing, and on the Flow 2 mockup's own tallest boards it is not cosmetic -- M06
			// (Permissions) is 1500px and M08 (Submit) 1560px, so scrolling either one used to take
			// the launcher, the breadcrumb and the account menu off screen together, leaving a long
			// form with no way out of it but the browser's own back button.
			//
			// z-40 over the bottom bar's z-30 so the header always wins where they overlap. The
			// menus themselves no longer depend on this: they are `popover` elements, which the
			// browser paints in the top layer, above every z-index on the page.
			<header class={ "sticky top-0 z-40 flex flex-col border-b", borderClass(ctx, domain.BorderSurface), backgroundClass(ctx, domain.BackgroundRaised) }>
				<div class={ "flex h-15 shrink-0 items-center", layoutGap(ctx, domain.GapTight), "px-4 sm:pr-7 sm:pl-9" }>
					@appLauncher(workspaceName, switchWorkspaceHref, viewer, hasAppMenu)
					// Two breadcrumb shapes, because the Flow 2 mockup has two. Inside an Application
					// (board 07 / M07) the Workspace name stands alone up here and the Application
					// names itself on the row below -- except on a phone, which has no second row, so
					// the Application's name becomes a second line here instead (M07's own stacked
					// "Dokter Kecil" over "Document Approval"). A Workspace-level screen (board 04) has
					// no Application to name, so it keeps the plain "Workspace / Page" pair.
					//
					// "/home" is a runtime-level route -- it exists regardless of which Application is
					// configured (internal/conformance's runtimeLevelRoutes). Not routeByID(ctx,
					// "nav_home"), which would panic if an Application ever declared no home item.
					if hasAppMenu {
						<nav aria-label="Breadcrumb" class="flex min-w-0 flex-col justify-center">
							<a href="/home" class={ "truncate", textClass(ctx, domain.RoleMeta), "leading-4", weightClass(ctx, domain.WeightEmphasis), inkClass(ctx, domain.InkSecondary), inkHoverClass(ctx, domain.InkStrong) + " sm:text-sm" + " " + inkClassFromSm(ctx, domain.InkStrong) }>{ workspaceName }</a>
							<span class={ "truncate", textClass(ctx, domain.RoleBody), "leading-5", weightClass(ctx, domain.WeightEmphasis), inkClass(ctx, domain.InkStrong), "sm:hidden" }>{ currentApp.Name }</span>
						</nav>
					} else {
						// gap-1.5 rather than spaces inside the separator: both parts are flex items, and
					// whitespace at a flex item's own edge collapses, so " / " rendered as "/Title".
					<nav aria-label="Breadcrumb" class={ "flex min-w-0 items-center", layoutGap(ctx, domain.GapXtight), textClass(ctx, domain.RoleBody) + " " + inkClass(ctx, domain.InkSecondary) }>
							@workspaceMenu(workspaceName, viewer, switchWorkspaceHref)
							// Workspace Home names itself in its own <h1>, so repeating it here as
							// "Dokter Kecil / Home" is the duplication board 03 leaves out -- its
							// breadcrumb is the Workspace name alone. Every other Workspace-level
							// screen still says which one it is.
							if title != labelByID(ctx, "nav_home") {
								<span class="shrink-0">/</span>
								<span class="truncate">{ title }</span>
							}
						</nav>
					}
					<span class={ "ml-auto flex items-center", layoutGap(ctx, domain.GapMicro) }>
						@notificationBell()
						@accountMenu(viewer, hasAppMenu)
					</span>
				</div>
				if hasAppMenu {
					@applicationMenuRow(menu, currentApp)
				}
			</header>
			<main class={ "mx-auto flex w-full max-w-[1180px] flex-col", layoutGap(ctx, domain.GapComfortable), "px-4 pt-6 sm:px-6 sm:pt-8", templ.KV("pb-24 sm:pb-10", hasAppMenu), templ.KV("pb-10", !hasAppMenu) }>
				{ children... }
			</main>
			if hasAppMenu {
				@applicationBottomBar(bottomBarItems(menu), currentApp, workspaceName, switchWorkspaceHref, viewer)
			}
			if switchWorkspaceHref != "" {
				@leaveWorkspaceGuard(workspaceName, viewer.WorkspaceRole, switchWorkspaceHref)
			}
			@pwaRegistrationScript()
		</body>
	</html>
}

// navMenuItem is one entry in the current Application's own menu -- appShell's desktop row and
// mobile bottom bar both render this, not domain.NavigationItem directly, because Active is a
// presentation decision (which item matches the current request) that neither belongs on the
// declared metadata shape nor need be recomputed by each of the two renderers separately.
type navMenuItem struct {
	Label string
	Href  string
	Icon  string
	// Badge is the declared domain.KnownNavigationBadges kind this item asks for, carried through
	// unchanged from domain.NavigationItem.Badge so the bottom bar can draw the same live count
	// pageShell's own navLink already draws. Empty for an item that declares none.
	Badge  string
	Active bool
}

// defaultAppMenu turns an Application's own declared navigation into appShell's menu, sorted by
// Priority (ties keep declaration order -- the same stable sort experience.GroupNavigation
// already uses) and with exactly one entry marked Active.
//
// Matching is path-plus-tab, not a plain prefix compare: Approval Inbox's own "My Documents" is a
// query on the same path as "Approval Inbox" (nav_my_documents's declared route is literally
// "/approval-inbox?tab=mine"), the one place this runtime uses a query to name a distinct
// destination (document-approval.yaml's own comment on that item). navItemActive compares each
// declared route's own ?tab= against the request's, generalizing what approvalinbox.templ's
// inboxTabs/routeTabParam did for that one Application to every Application's menu. Falling back
// to the first item when nothing matches keeps inboxTabs' own fallback behavior (a stale or
// tab-less link still shows something selected, rather than a menu with nothing marked).
//
// One accepted trade: inboxTabs used to carry the active `?filter=` SLA chip forward across a tab
// switch. A generic menu shared by every Application has no such per-Application concept to
// forward, so switching tabs here resets it -- a minor UX regression traded for one menu instead
// of a bespoke one per Application (CLAUDE.md's decomposition trigger: this is the second
// Application that needs this exact shape).
func defaultAppMenu(items []domain.NavigationItem, path, rawQuery string) []navMenuItem {
	var filtered []domain.NavigationItem
	for _, item := range items {
		// A Settings hub item (or one of its own hub members, e.g. Permissions) belongs to the
		// chrome's dedicated "Settings" link, not this Application's main menu --
		// domain.NavigationItem's own SettingsHub/SettingsHubMember doc comments.
		if item.SettingsHub || item.SettingsHubMember {
			continue
		}
		filtered = append(filtered, item)
	}

	sorted := make([]domain.NavigationItem, len(filtered))
	copy(sorted, filtered)
	sort.SliceStable(sorted, func(i, j int) bool { return sorted[i].Priority < sorted[j].Priority })

	menu := make([]navMenuItem, len(sorted))
	matched := -1
	for i, item := range sorted {
		active := navItemActive(item, path, rawQuery)
		if active && matched == -1 {
			matched = i
		}
		menu[i] = navMenuItem{Label: item.Label, Href: item.Route, Icon: item.Icon, Badge: item.Badge, Active: active}
	}
	if matched == -1 && len(menu) > 0 {
		menu[0].Active = true
	}
	return menu
}

// settingsHubItem finds app's own SettingsHub-marked item, if it declares one (development-history.md "In
// progress", "Application Settings hub") -- a search, not a fixed id, so applicationMenuRow/
// moreSheet never panic on an Application that declares no hub at all.
// domain.NavigationItem's own validation guarantees at most one match per Application.
func settingsHubItem(app domain.Application) (domain.NavigationItem, bool) {
	for _, item := range app.AllNavigation {
		if item.SettingsHub {
			return item, true
		}
	}
	return domain.NavigationItem{}, false
}

// navItemActive reports whether item's declared route names the current request: same path, and
// the same ?tab= value (both empty counts as a match) -- see defaultAppMenu's own doc comment.
func navItemActive(item domain.NavigationItem, path, rawQuery string) bool {
	itemPath, itemQuery, _ := strings.Cut(item.Route, "?")
	return itemPath == path && tabParam(itemQuery) == tabParam(rawQuery)
}

// tabParam reads a raw query string's own "tab" value without a full net/url round trip --
// good enough here because every declared route's query is metadata this package itself wrote.
func tabParam(rawQuery string) string {
	for _, pair := range strings.Split(rawQuery, "&") {
		key, value, _ := strings.Cut(pair, "=")
		if key == "tab" {
			return value
		}
	}
	return ""
}

// bottomBarItems is appShell's mobile row: the menu's own first three entries (owner spec,
// ui-sample/README.md: "dengan 3-4 icon"), in the same Priority order the desktop row already
// uses -- not a separate declaration, so the two rows can never disagree about which items lead.
//
// THREE, not four, since 2026-09-24: the fourth column is always "More" (applicationBottomBar's
// own sheet), which is the Flow 2 mockup's M07/M07b pair. That is a real trade and worth naming --
// an Application declaring four or more navigation items now surfaces three of them here instead
// of four. It is the right way round: the items past the third are reachable from the desktop row
// and the launcher either way, while *leaving the Application* had no mobile affordance at all
// before this, because the launcher lives in the top bar that used to scroll away.
func bottomBarItems(menu []navMenuItem) []navMenuItem {
	return menu[:min(3, len(menu))]
}

// appMenuTabLimit is how many of an Application's menu items applicationMenuRow draws as tabs
// before the rest collapse behind a "More" dropdown -- the desktop twin of bottomBarItems' three.
// Four because Project Management's mockup (Case 19 canvas, PM01..PM06) draws Board / My Tasks /
// Dashboard / Calendar and then "More"; Document Approval declares three items, so it never
// overflows. A Go literal describing behaviour the metadata cannot express yet (no per-item
// "overflow" declaration exists): 007 §12.2 is the target, and writing-guide.md's "What comes free
// vs. what's hardcoded today" table carries the row.
const appMenuTabLimit = 4

// splitAppMenu separates the tabs applicationMenuRow draws from the ones behind "More". Priority
// order is already applied by defaultAppMenu, so the first appMenuTabLimit are the leading ones.
func splitAppMenu(menu []navMenuItem) (tabs, overflow []navMenuItem) {
	if len(menu) <= appMenuTabLimit {
		return menu, nil
	}
	return menu[:appMenuTabLimit], menu[appMenuTabLimit:]
}

// anyActive reports whether one of items is the current page -- "More" is marked when the page
// you are on lives inside it, so the strip never shows nothing selected.
func anyActive(items []navMenuItem) bool {
	for _, item := range items {
		if item.Active {
			return true
		}
	}
	return false
}

// applicationMenuRow is appShell's header, second row: the current Application's own menu,
// `hidden` below `sm` where applicationBottomBar takes over instead (owner spec,
// ui-sample/README.md's "Menu Navigasi" -- see appShell's own doc comment above).
//
// It opens on the Application naming itself -- its own declared icon tile and name, then a rule --
// which is the Flow 2 mockup's board 07 and is not decoration: with the Workspace name one row up
// and the page's own <h1> below, this row was the only place that ever said *which Application you
// are in*, and before 2026-09-24 it said it nowhere.
//
// The mockup's right-hand "Settings" link is now drawn, the same call moreSheet makes for the
// same reason it used to defer this: it is present exactly when app declares a SettingsHub item
// (settingsHubItem) -- absent for an Application that declares none, rather than pointing at
// /authorization-matrix (a Workspace-level admin screen) and calling it this Application's own,
// which would have been a worse lie than the gap.
templ applicationMenuRow(menu []navMenuItem, app domain.Application) {
	<nav aria-label="Application" class={ "hidden items-center", layoutGap(ctx, domain.GapMicro), "border-t " + borderClass(ctx, domain.BorderDivider) + " px-4 py-1.5 sm:flex sm:px-6" }>
		<span class={ "mr-1 flex items-center", layoutGap(ctx, domain.GapTight) }>
			if app.Icon != "" {
				<span class={ "flex size-6 shrink-0 items-center justify-center", radiusClass(ctx, domain.RadiusControl), appIconClasses(app.Color) }>
					@icon(app.Icon, "size-3.5")
				</span>
			}
			<span class={ textClass(ctx, domain.RoleBody), weightClass(ctx, domain.WeightEmphasis), inkClass(ctx, domain.InkStrong) }>{ app.Name }</span>
		</span>
		<span aria-hidden="true" class={ "mr-2 ml-1 h-5 w-px", borderFillClass(ctx, domain.BorderSurface) }></span>
		{{ tabs, overflow := splitAppMenu(menu) }}
		for _, item := range tabs {
			<a
				href={ templ.SafeURL(item.Href) }
				class={ "flex items-center", layoutGap(ctx, domain.GapXtight), radiusClass(ctx, domain.RadiusControl), "px-2.5 py-1.5", textClass(ctx, domain.RoleBody), templ.KV(weightClass(ctx, domain.WeightEmphasis) + " " + accentActiveClass(ctx), item.Active), templ.KV(inkClass(ctx, domain.InkSecondary) + " "+hoverWashClass(ctx)+" " + inkHoverClass(ctx, domain.InkStrong), !item.Active) }
				if item.Active {
					aria-current="page"
				}
			>
				{ item.Label }
				@navBadge(item.Badge, "inline-flex h-4.5 min-w-4.5 items-center justify-center "+radiusClass(ctx, domain.RadiusPill)+" "+toneFillClass(ctx, domain.ToneInfo)+" px-1.5 text-3xs font-medium "+toneInkClass(ctx, domain.ToneInfo)+" empty:hidden")
			</a>
		}
		if len(overflow) > 0 {
			<button
				type="button"
				popovertarget="menata-app-more-menu"
				class={ "ml-auto flex cursor-pointer items-center", layoutGap(ctx, domain.GapMicro), radiusClass(ctx, domain.RadiusControl), "border-0 bg-transparent px-2.5 py-1.5 font-sans", textClass(ctx, domain.RoleBody), templ.KV(weightClass(ctx, domain.WeightEmphasis) + " " + accentActiveClass(ctx), anyActive(overflow)), templ.KV(inkClass(ctx, domain.InkSecondary) + " "+hoverWashClass(ctx)+" " + inkHoverClass(ctx, domain.InkStrong), !anyActive(overflow)) }
			>
				More
				@icon("chevron-down", "size-3.5")
			</button>
			@sheetPanel("menata-app-more-menu", true, "tabs") {
				for _, item := range overflow {
					<a
						href={ templ.SafeURL(item.Href) }
						class={ "flex items-center", layoutGap(ctx, domain.GapDefault), radiusClass(ctx, domain.RadiusControl), "px-3 py-2", textClass(ctx, domain.RoleBody), hoverWashClass(ctx), templ.KV(weightClass(ctx, domain.WeightEmphasis) + " " + accentActiveClass(ctx), item.Active), templ.KV(inkClass(ctx, domain.InkBody), !item.Active) }
						if item.Active {
							aria-current="page"
						}
					>
						{ item.Label }
					</a>
				}
			}
		}
		if hub, ok := settingsHubItem(app); ok {
			<a
				href={ templ.SafeURL(hub.Route) }
				class={ "flex items-center", layoutGap(ctx, domain.GapXtight), radiusClass(ctx, domain.RadiusControl), "px-2.5 py-1.5 " + textClass(ctx, domain.RoleBody) + " " + inkClass(ctx, domain.InkSecondary), hoverWashClass(ctx), inkHoverClass(ctx, domain.InkStrong), templ.KV("ml-auto", len(overflow) == 0) }
			>
				@icon(hub.Icon, "size-4")
				{ hub.Label }
			</a>
		}
	</nav>
}

// navBadge is the live count a navigation item declares, drawn wherever that item is (the header
// row's small blue pill, the bottom bar's red bubble -- class carries the difference).
//
// `empty:hidden` is load-bearing, not tidiness: the endpoint deliberately renders *nothing* when
// there is nothing pending (internal/web.showPendingCount), so without it a viewer with an empty
// inbox gets a bare coloured dot with no number in it. pageShell's own hand-written stylesheet has
// always carried the same rule as `.nav-badge:empty`; this is its Tailwind half, and it was missing
// for the first day the bottom-bar badge existed.
//
// Each badge is its own hx-get, so a screen drawing both rows pays for the count twice -- ~5
// queries, on Document Approval's screens only, and only because a count nobody threaded through
// appShell has to fetch itself. One request again the moment that stops being true (ROADMAP.md's
// `NavBadgeApprovalInboxPending` deferral row).
templ navBadge(badge, class string) {
	if badge == domain.NavBadgeApprovalInboxPending {
		<span
			class={ class }
			hx-get="/api/approval-inbox/pending-count"
			hx-trigger="load"
			hx-swap="innerHTML"
		></span>
	}
}

// applicationBottomBar is the mobile counterpart of applicationMenuRow -- owner spec's other half:
// a fixed bar, icon over label, shown only below `sm` where the header's own second row is
// `hidden`. The Flow 2 mockup's M07-Inbox board is the visual reference: 76px tall, evenly split
// columns, active in blue-600, the rest in slate-500, with a red count bubble on the tab whose
// item declares a badge.
//
// Four columns: three declared items (bottomBarItems) and "More", whose sheet is the one way out
// of an Application on a phone -- see moreSheet.
templ applicationBottomBar(items []navMenuItem, app domain.Application, workspaceName, switchWorkspaceHref string, viewer Viewer) {
	<nav aria-label="Application" class={ "fixed inset-x-0 bottom-0 z-30 flex h-19 items-start border-t", borderClass(ctx, domain.BorderSurface), backgroundClass(ctx, domain.BackgroundRaised), "px-1 pb-3 sm:hidden" }>
		for _, item := range items {
			<a
				href={ templ.SafeURL(item.Href) }
				class={ "flex flex-1 flex-col items-center", layoutGap(ctx, domain.GapMicro), "py-2", textClass(ctx, domain.RoleCaption), templ.KV(weightClass(ctx, domain.WeightEmphasis) + " " + accentActiveClass(ctx), item.Active), templ.KV(inkClass(ctx, domain.InkSecondary), !item.Active) }
				if item.Active {
					aria-current="page"
				}
			>
				<span class="relative flex">
					@icon(item.Icon, "size-5.5")
					@navBadge(item.Badge, "absolute -top-1 -right-2.5 flex h-4 min-w-4 items-center justify-center "+radiusClass(ctx, domain.RadiusPill)+" " + toneInkFillClass(ctx, domain.ToneBad) + " " + "px-1 text-3xs " + onFillClass(ctx) + " empty:hidden")
				</span>
				{ item.Label }
			</a>
		}
		@moreSheet(app, workspaceName, switchWorkspaceHref, viewer)
	</nav>
}

// moreSheet is the bottom bar's fourth column: a bottom sheet holding the destinations that leave
// the current Application (Flow 2 mockup, M07b). It exists because a phone has no launcher of its
// own -- the 9-dot panel is a top-bar dropdown sized for a pointer -- so before this, the only way
// from an Application's screen back to the Workspace, or across to another Application, was the
// browser's back button.
//
// Its three groups are Workspace home, the Workspace's own Applications, and All Workspaces: the
// same three the launcher shows, deliberately, because they answer the same question. It marks the
// Application you are already in (aria-current), which the launcher never needs to.
//
// The mockup's third row, "<Application> settings", is now drawn -- present exactly when app
// declares a SettingsHub item (settingsHubItem), same as applicationMenuRow's own right-hand link
// added the same day ("Application Settings hub", development-history.md "In progress"). Absent for an
// Application declaring none (Project Management, today), never a link to nowhere.
//
// THE POPOVER API, not <details> (2026-09-24, and it replaced <details> the same day it shipped
// on one). The owner's report was exact: "behaviour bottom sheet juga masih belum bisa tertutup,
// kecuali klik di avatar pojok kanan atas" -- a <details> panel closes only by re-clicking its own
// summary, and the shipped comment called that an "accepted cost" of having no JavaScript. It was
// not acceptable and it did not need JavaScript: `popover` gives light dismiss (a click anywhere
// outside closes it) and Escape for free, from the browser, and it paints in the top layer so no
// z-index anywhere can trap it. appLauncher and accountMenu moved with it, since all three had the
// identical flaw -- which is why the owner met it on the avatar.
//
// The sheet itself -- the shade, the panel, the handle -- is sheetPanel, shared with the launcher
// and the account menu since 2026-09-24. It was written here first and *only* here, which is what
// let the account menu keep its old bare panel for a day: no shade, sitting over the bottom bar,
// so the one thing that would dismiss it was the avatar that opened it.
templ moreSheet(app domain.Application, workspaceName, switchWorkspaceHref string, viewer Viewer) {
	<div class="flex flex-1 flex-col">
		<button
			type="button"
			popovertarget="menata-more-sheet"
			class={ "menata-more-tab flex w-full cursor-pointer flex-col items-center", layoutGap(ctx, domain.GapMicro), "border-0 bg-transparent py-2 font-sans " + textClass(ctx, domain.RoleCaption) + " " + inkClass(ctx, domain.InkSecondary) }
		>
			@icon("more", "size-5.5")
			More
		</button>
		@sheetPanel("menata-more-sheet", true, "") {
			<div class="flex items-center justify-between px-3 pt-1 pb-2">
				<span class={ textClass(ctx, domain.RoleSubheading), weightClass(ctx, domain.WeightEmphasis), inkClass(ctx, domain.InkStrong) }>More</span>
				<span class={ "truncate", textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkSecondary) }>{ app.Name }</span>
			</div>
			<a href="/home" class={ "flex items-center", layoutGap(ctx, domain.GapDefault), radiusClass(ctx, domain.RadiusControl), "p-3 text-left", hoverWashClass(ctx) }>
				<span class={ "flex size-9 shrink-0 items-center justify-center rounded-lg", backgroundClass(ctx, domain.BackgroundBase), inkClass(ctx, domain.InkSecondary) }>
					@icon("home", "size-5")
				</span>
				<span class={ "flex min-w-0 grow flex-col", layoutGap(ctx, domain.GapHair) }>
					<span class={ textClass(ctx, domain.RoleBody), inkClass(ctx, domain.InkStrong) }>{ labelByID(ctx, "nav_home") }</span>
					<span class={ "truncate", textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkSecondary) }>{ workspaceName }</span>
				</span>
				<span class={ inkClass(ctx, domain.InkFaint) }>
					@icon("chevron-right", "size-4")
				</span>
			</a>
			if hub, ok := settingsHubItem(app); ok {
				<a href={ templ.SafeURL(hub.Route) } class={ "flex items-center", layoutGap(ctx, domain.GapDefault), radiusClass(ctx, domain.RadiusControl), "p-3 text-left", hoverWashClass(ctx) }>
					<span class={ "flex size-9 shrink-0 items-center justify-center rounded-lg", backgroundClass(ctx, domain.BackgroundBase), inkClass(ctx, domain.InkSecondary) }>
						@icon(hub.Icon, "size-5")
					</span>
					<span class={ "flex min-w-0 grow flex-col", layoutGap(ctx, domain.GapHair) }>
						<span class={ textClass(ctx, domain.RoleBody), inkClass(ctx, domain.InkStrong) }>{ hub.Title }</span>
					</span>
					<span class={ inkClass(ctx, domain.InkFaint) }>
						@icon("chevron-right", "size-4")
					</span>
				</a>
			}
			<div class={ "mx-2.5 my-1.5 h-px", borderFillClass(ctx, domain.BorderDivider) }></div>
			for _, other := range viewer.Applications {
				<a
					href={ templ.SafeURL(launcherAppHomeRoute(ctx, other)) }
					class={ "flex items-center", layoutGap(ctx, domain.GapDefault), radiusClass(ctx, domain.RadiusControl), "p-3 text-left", hoverWashClass(ctx) }
					if other.ID == app.ID {
						aria-current="page"
					}
				>
					<span class={ "flex size-9 shrink-0 items-center justify-center rounded-lg", appIconClasses(other.Color) }>
						@icon(other.Icon, "size-5")
					</span>
					<span class={ "flex min-w-0 grow flex-col", layoutGap(ctx, domain.GapHair) }>
						<span class={ textClass(ctx, domain.RoleBody) + " " + inkClass(ctx, domain.InkStrong), templ.KV(weightClass(ctx, domain.WeightEmphasis), other.ID == app.ID) }>{ other.Name }</span>
						if other.Description != "" {
							<span class={ "truncate", textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkSecondary) }>{ other.Description }</span>
						}
					</span>
					<span class={ inkClass(ctx, domain.InkFaint) }>
						@icon("chevron-right", "size-4")
					</span>
				</a>
			}
			if switchWorkspaceHref != "" {
				<div class={ "mx-2.5 my-1.5 h-px", borderFillClass(ctx, domain.BorderDivider) }></div>
				<a href={ templ.SafeURL(switchWorkspaceHref) } data-leave-guard class={ "block", radiusClass(ctx, domain.RadiusControl), "p-3", textClass(ctx, domain.RoleBody), weightClass(ctx, domain.WeightEmphasis), inkClass(ctx, domain.InkAccent), hoverWashClass(ctx) }>All Workspaces →</a>
			}
		}
	</div>
}

// workspaceMenu is the Workspace's own name, made into a menu (Flow 2 mockup, boards 03b / M03b):
// which Workspace you are in, and the two things you can do *to* it rather than inside it.
//
// It renders at Workspace level only, never inside an Application, which is the mockup's own
// split rather than a simplification: board 03b is drawn on Workspace Home, while board 07's
// in-Application breadcrumb keeps "Dokter Kecil" a plain one-tap link back to Home. Nothing is
// lost by that -- inside an Application the launcher and the More sheet already offer these same
// destinations -- and it keeps the breadcrumb's job unambiguous in the place a user is deepest.
//
// Two rows, not the mockup's three. **"Invite members" is not rendered**: this app has no invite
// route of its own, the invite form is a <details> inside the Members screen, and a second row
// pointing at the same place the row above it already goes is worse than one honest row. The
// mockup can afford three because it has an Invitations screen (Flow 2 gap study §5.3); we do not
// yet. The mockup's "Admin · 24 members" line loses its count for the recorded reason: a member
// count is not a field on domain.Workspace, and inventing one here is the hardcoding CLAUDE.md's
// decision path rules out.
//
// The Workspace-settings row follows the viewer's role, because its destination is
// requireWorkspaceAdmin-gated and offering a plain member a link that could only ever 403 is the
// 2026-09-19 code-review finding arriving again on a different menu. That gate is the real one and
// is untouched; this is chrome.
//
// `!= member`, not `== admin`, which is workspacehome.templ's own deliberate three-way split
// rather than a looser test: the shared admin credential holds no membership row at all, so its
// role reads as "" -- and it *can* open the destination. Hiding the row from it would hide a link
// that works. A real member is the only case that must not see it.
templ workspaceMenu(workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	<div class="flex min-w-0">
		<button
			type="button"
			popovertarget="menata-workspace-menu"
			aria-haspopup="menu"
			class={ "flex min-w-0 cursor-pointer items-center", layoutGap(ctx, domain.GapXtight), radiusClass(ctx, domain.RadiusControl), "border-0 bg-transparent px-2 py-1 font-sans " + textClass(ctx, domain.RoleBody) + " " + weightClass(ctx, domain.WeightEmphasis) + " " + inkClass(ctx, domain.InkStrong) + " " + sunkenHoverClass(ctx) }
		>
			<span class="truncate">{ workspaceName }</span>
			@icon("chevron-down", "size-3.5 shrink-0 " + inkClass(ctx, domain.InkSecondary))
		</button>
		@sheetPanel("menata-workspace-menu", false, "left") {
			<div class={ "flex items-center", layoutGap(ctx, domain.GapDefault), "px-3 pt-1 pb-2.5" }>
				<span class={ "flex size-9 shrink-0 items-center justify-center rounded-lg", inkFillClass(ctx, domain.InkStrong), "text-[13px]", weightClass(ctx, domain.WeightEmphasis), onFillClass(ctx) }>
					{ personInitials(workspaceName, "") }
				</span>
				<span class={ "flex min-w-0 flex-col", layoutGap(ctx, domain.GapHair) }>
					<span class={ "truncate", textClass(ctx, domain.RoleBody), weightClass(ctx, domain.WeightEmphasis), inkClass(ctx, domain.InkStrong) }>{ workspaceName }</span>
					if viewer.WorkspaceRole != "" {
						<span class={ textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkSecondary) }>{ displayRole(viewer.WorkspaceRole) }</span>
					}
				</span>
			</div>
			<div class={ "my-1 h-px", borderFillClass(ctx, domain.BorderDivider) }></div>
			// Workspace settings (Flow 2 gap study Tahap 5, 2026-09-25) replaced this menu's own
			// direct "Workspace Members" link, matching M03b-WorkspaceMenu.dc.html: the mockup
			// shows one settings entry, not a shortcut to one of the hub's own rows. Members stays
			// fully reachable -- one hop further, through the hub's own People section -- and
			// Workspace Home's own "Manage members" link (workspacehome.templ) is untouched.
			if viewer.WorkspaceRole != domain.WorkspaceRoleMember {
				<a href={ templ.SafeURL(routeByID(ctx, "nav_workspace_settings")) } class={ workspaceMenuRowClasses(ctx) }>
					<span class={ inkClass(ctx, domain.InkSecondary) }>
						@icon("settings", "size-4")
					</span>
					{ labelByID(ctx, "nav_workspace_settings") }
				</a>
				// The pages this Workspace declares itself (`navigation:` on its manifest, with a `page:`): admins only,
				// like the screen they open (showWorkspacePage). Declared, never typed: the row is the item's own label,
				// route and icon.
				for _, p := range workspacePages(ctx) {
					<a href={ templ.SafeURL(p.Route) } class={ workspaceMenuRowClasses(ctx) }>
						<span class={ inkClass(ctx, domain.InkSecondary) }>
							@icon(workspacePageIcon(p), "size-4")
						</span>
						{ p.Label }
					</a>
				}
				// New application (Flow 2 gap study Tahap 8, 2026-09-26): the mockup's own
				// M03b-WorkspaceMenu.dc.html panel is a whole describe-it box inline in this menu;
				// this is a scoped-down link to the same destination (/new-application) rather than
				// replicating that box here, since the real conversation screen already exists at
				// that route. Always shown rather than hidden when GEMINI_API_KEY is unset --
				// threading that flag through appShell's whole call chain for one link was judged
				// not worth it; the route itself explains plainly when the assistant isn't
				// configured yet, rather than 403ing or looking broken.
				//
				// METADATA CANNOT EXPRESS THIS YET, same category as /documents/new right above it
				// in spirit (CLAUDE.md, "Deciding whether a literal is a metadata-hardcoding
				// violation" step 2): this is a Workspace-level action triggered from chrome, not a
				// menu destination any navigation list could declare. Missing capability: 007
				// §12.3's ActionBar component, still unbuilt. Listed in
				// internal/conformance's applicationSubScreens and writing-guide.md's own
				// "What comes free vs. what's hardcoded today" table.
				<a href="/new-application" class={ workspaceMenuRowClasses(ctx) }>
					<span class={ inkClass(ctx, domain.InkSecondary) }>
						@icon("sparkle", "size-4")
					</span>
					New application
				</a>
			}
			if switchWorkspaceHref != "" {
				<a href={ templ.SafeURL(switchWorkspaceHref) } data-leave-guard class={ workspaceMenuRowClasses(ctx) }>
					<span class={ inkClass(ctx, domain.InkSecondary) }>
						@icon("switch", "size-4")
					</span>
					Switch workspace
				</a>
			}
		}
	</div>
}

// workspaceMenuRowClasses is one row of the Workspace menu: an icon and a label that wash on hover. Four rows drew it as
// the same hand-written class list; the fifth (a declared Workspace page) is what made it a function.
func workspaceMenuRowClasses(ctx context.Context) string {
	return strings.Join([]string{"flex items-center", layoutGap(ctx, domain.GapDefault), radiusClass(ctx, domain.RadiusControl), "p-3",
		textClass(ctx, domain.RoleBody), inkClass(ctx, domain.InkStrong), hoverWashClass(ctx), "sm:py-2.5"}, " ")
}

// workspacePages are the Workspace's own declared pages, in the order its manifest lists them.
func workspacePages(ctx context.Context) []domain.NavigationItem {
	var out []domain.NavigationItem
	for _, item := range CurrentWorkspace(ctx).Navigation {
		if item.Page != nil {
			out = append(out, item)
		}
	}
	return out
}

// workspacePageIcon is the icon a declared Workspace page asks for, or the dashboard glyph when it names none.
func workspacePageIcon(item domain.NavigationItem) string {
	if item.Icon != "" {
		return item.Icon
	}
	return "dashboard"
}

// sheetPanel is the one shape all three of appShell's menus share: a `popover` that is a bottom
// sheet on a phone -- a dark shade over everything except the bottom bar, and a rounded panel
// pinned to the bottom -- and, for the two in the header, an anchored dropdown at `sm` and up.
//
// Extracted on 2026-09-24, at the third use rather than the second, which is what
// menata-app-document's ui-composition-decomposition-criteria.md asks for. The second use is also
// what created the bug that forced it: the More sheet was built with a shade and positioned above
// the bar, the account menu was left as the bare panel it had always been, and the owner found the
// difference immediately -- its sheet covered the bottom bar, had no shade, and so the only thing
// that would dismiss it was the avatar that opened it. Tapping the bar to escape was a tap *inside*
// the popover, which is exactly where light dismiss does not fire.
//
// aboveBar is appShell's own hasAppMenu: a Workspace-level screen has no bottom bar, so its shade
// covers the whole viewport (mockup M11/M12, `inset: 0`), while inside an Application it stops at
// the bar's top edge (M07b, `bottom: 76px`) and leaves the bar lit and legible.
//
// The shade is a <button popovertargetaction="hide">, not a styled ::backdrop and not a div: a real
// ::backdrop covers the whole viewport including that bar, light dismiss does not fire inside a
// popover so the shade must dismiss it itself, and a button is keyboard-reachable where a div with
// a click handler is not.
//
// desktop is "" for a menu that stays a sheet at every width (moreSheet -- its whole bar is
// sm:hidden), or "left"/"right" for one that becomes a dropdown anchored under its own control.
// Whole literal class strings per case, never assembled, for the reason appIconClasses records:
// Tailwind's scanner reads source text, so a name built at runtime never reaches app.css.
templ sheetPanel(id string, aboveBar bool, desktop string) {
	<div
		id={ id }
		popover
		class={ "inset-x-0 top-0 m-0 h-auto max-h-none w-auto max-w-none overflow-visible border-0 bg-transparent p-0",
			templ.KV("bottom-19", aboveBar), templ.KV("bottom-0", !aboveBar),
			sheetContainerClasses(desktop) }
	>
		<button
			type="button"
			popovertarget={ id }
			popovertargetaction="hide"
			aria-label="Close"
			class={ "absolute inset-0 w-full cursor-default border-0", scrimClass(false), "p-0 sm:hidden" }
		></button>
		<div class={ "absolute inset-x-0 bottom-0 max-h-full overflow-y-auto rounded-t-2xl", backgroundClass(ctx, domain.BackgroundRaised), "p-2 pb-6 shadow-[0_-8px_24px_rgba(15,23,42,0.16)]", sheetPanelClasses(ctx, desktop) }>
			<div class={ "mx-auto mb-2 h-1 w-10 rounded-full", borderFillClass(ctx, domain.BorderSurface), "sm:hidden" }></div>
			{ children... }
		</div>
	</div>
}

// sheetContainerClasses positions the popover box itself at `sm` and up: full-width sheet frame
// below that breakpoint, a 288px box under its own control above it. `sm:top-17` rather than CSS
// anchor positioning -- the header is a fixed 60px and sticky at top-0, so the offset is knowable
// without a feature that is still Chromium-only.
func sheetContainerClasses(desktop string) string {
	switch desktop {
	case "left":
		return "sm:inset-auto sm:top-17 sm:right-auto sm:bottom-auto sm:left-9 sm:w-72"
	case "right":
		return "sm:inset-auto sm:top-17 sm:right-7 sm:bottom-auto sm:left-auto sm:w-72"
	case "tabs":
		return "sm:inset-auto sm:top-26 sm:right-7 sm:bottom-auto sm:left-auto sm:w-56"
	default:
		return ""
	}
}

// sheetPanelClasses turns the sheet's own white panel back into an ordinary dropdown body at `sm`:
// no longer pinned to the bottom of its container, squared-off shadow, its own border.
func sheetPanelClasses(ctx context.Context, desktop string) string {
	if desktop == "" {
		return ""
	}
	return "sm:static sm:max-h-none sm:overflow-visible sm:rounded-lg sm:border " + surfaceFromSm(ctx) + " sm:pb-2 sm:shadow-lg"
}

// accountMenu is the avatar's own menu (Account menu port, 2026-09-21, from
// ui-sample/nav-chrome.js's accountHTML): identity, Profile, Security, Notifications, Sign out. Page-internal --
// capabilities.md's own promotion rule ("earns a row here only once a second... Page needs the
// identical shape") -- since appShell is its only caller; it does not yet get a "Shared rendering
// components" row of its own.
//
// A `popover`, like appLauncher and moreSheet -- see moreSheet's own comment for why all three
// left <details> on 2026-09-24. This is the menu the owner actually hit the old behaviour on:
// with no light dismiss anywhere, the avatar was the only control that would close *anything*,
// so it became the way to dismiss the More sheet too.
//
// Its panel is positioned bottom-sheet-style on mobile (pinned to the viewport bottom, rounded top
// corners) and as a right-anchored dropdown at `sm` and up, via Tailwind classes alone -- ported
// from ui-sample/nav-chrome.js's sheetPanelClasses(). `sm:top-17` rather than CSS anchor positioning:
// the header is a fixed 60px and sticky at top-0, so the panel's own offset is knowable without a
// feature that is still Chromium-only.
//
// Profile and Security are runtime-level routes (`/account-profile`, `/account-security`) -- they
// exist regardless of which Applications a Workspace configures, the same category as `/home`
// above, so they're literals here rather than routeByID lookups (nothing declares them in app.yaml
// navigation) -- both are listed in internal/conformance's runtimeLevelRoutes for exactly this
// reason. Sign out reuses pageShell's own logout form shape (machine.templ) -- appShell-based
// screens had no sign-out at all before this.
//
// Notifications (`/account-notifications`) is listed beside them: it is the same kind of route, and
// it was reached only from the Application Settings hub's own row until S2.1 (2026-10-10) removed
// that row -- a per-Application row linking to a personal page -- which would otherwise have left the
// page with no link at all. A per-Application notification policy is S3.3.
// notificationBell is the header's own entry point into /notifications (Flow 2 gap study Tahap 6)
// -- a plain link, not a popover, since the destination is a real page rather than a short menu.
// The badge mirrors navBadge's own shape exactly (empty:hidden, hx-get/hx-trigger=load) but isn't
// routed through it: navBadge dispatches on domain.NavBadgeApprovalInboxPending, a per-Application
// nav-item concept, while this is Workspace-level chrome with its own fixed endpoint, the same way
// accountMenu's own links are literals rather than routeByID lookups.
templ notificationBell() {
	<a
		href="/notifications"
		aria-label="Notifications"
		class={ "relative flex size-8 shrink-0 items-center justify-center rounded-full", inkClass(ctx, domain.InkSecondary), sunkenHoverClass(ctx) + " " + inkHoverClass(ctx, domain.InkBody) }
	>
		@icon("bell", "size-4.5")
		<span
			class={ "absolute top-0.5 right-0.5 flex h-4 min-w-4 items-center justify-center", radiusClass(ctx, domain.RadiusPill), toneInkFillClass(ctx, domain.ToneBad) + " " + "px-1 text-3xs " + onFillClass(ctx) + " empty:hidden" }
			hx-get="/api/notifications/unread-count"
			hx-trigger="load"
			hx-swap="innerHTML"
		></span>
	</a>
}

templ accountMenu(viewer Viewer, aboveBar bool) {
	<div class="shrink-0">
		<button
			type="button"
			popovertarget="menata-account-menu"
			aria-label="Account menu"
			class={ "flex size-8 cursor-pointer items-center justify-center rounded-full border-0 " + borderFillClass(ctx, domain.BorderSurface) + " font-sans text-xs " + weightClass(ctx, domain.WeightEmphasis), inkClass(ctx, domain.InkBody) }
		>
			{ viewer.Initials }
		</button>
		@sheetPanel("menata-account-menu", aboveBar, "right") {
			// The shared admin credential resolves to a placeholder identity with no name and no
			// email (its avatar is the "?" glyph), so rendering the block unconditionally left an
			// empty strip above a divider -- invisible as a bare dropdown, obvious as a sheet.
			if viewer.Name != "" || viewer.Email != "" {
				<div class={ "flex flex-col", layoutGap(ctx, domain.GapHair), "px-3 pt-1 pb-2" }>
					if viewer.Name != "" {
						<span class={ "truncate", textClass(ctx, domain.RoleBody), weightClass(ctx, domain.WeightEmphasis), inkClass(ctx, domain.InkStrong) }>{ viewer.Name }</span>
					}
					if viewer.Email != "" {
						<span class={ "truncate", textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkSecondary) }>{ viewer.Email }</span>
					}
				</div>
				<div class={ "my-1 h-px", borderFillClass(ctx, domain.BorderDivider) }></div>
			}
			<a href="/account-profile" class={ "block", radiusClass(ctx, domain.RadiusControl), "px-3 py-2.5 " + textClass(ctx, domain.RoleBody) + " " + inkClass(ctx, domain.InkBody), hoverWashClass(ctx) }>Profile</a>
			<a href="/account-notifications" class={ "block", radiusClass(ctx, domain.RadiusControl), "px-3 py-2.5 " + textClass(ctx, domain.RoleBody) + " " + inkClass(ctx, domain.InkBody), hoverWashClass(ctx) }>Notifications</a>
			<a href="/account-security" class={ "block", radiusClass(ctx, domain.RadiusControl), "px-3 py-2.5 " + textClass(ctx, domain.RoleBody) + " " + inkClass(ctx, domain.InkBody), hoverWashClass(ctx) }>Security</a>
			<div class={ "my-1 h-px", borderFillClass(ctx, domain.BorderDivider) }></div>
			// Workspaces (AccountMenu.dc.html, Flow 2 canvas re-audit -- ROADMAP.md, 2026-09-27):
			// loaded lazily, not threaded through appShell's own parameters, because appShell
			// renders on almost every authenticated page and the list needs a real query
			// (store.ListMemberships, showAccountMenuWorkspaces/internal/web/accountmenu.go) --
			// paying that on every page load for a menu most requests never open is exactly the
			// query-budget cost this repo's own TestAuthenticatedPageQueryCost/
			// TestNoGetRouteRepeatsAReadOrLeavesOneUnnamed exist to catch. `toggle` is the native
			// Popover-API event sheetPanel's own "menata-account-menu" div already dispatches on
			// open/close (capabilities.md, "All three menus are the native Popover API"); `once`
			// means the fetch happens at most one time per page view, the first time this menu is
			// actually opened, matching notificationBell's own hx-trigger="load" simplicity but
			// gated on interaction instead of paid on every render.
			<div
				id="account-menu-workspaces"
				hx-get="/api/account-menu/workspaces"
				hx-trigger="toggle once from:#menata-account-menu"
				hx-swap="innerHTML"
			></div>
			<div class={ "my-1 h-px", borderFillClass(ctx, domain.BorderDivider) }></div>
			<form method="POST" action="/logout">
				@csrfHiddenInput()
				<button type="submit" class={ "w-full", radiusClass(ctx, domain.RadiusControl), "px-3 py-2.5 text-left font-sans " + textClass(ctx, domain.RoleBody) + " " + inkClass(ctx, domain.InkBody), hoverWashClass(ctx) }>Sign out</button>
			</form>
		}
	</div>
}

// AccountMenuWorkspaceRows is #account-menu-workspaces' own fetched content (showAccountMenuWorkspaces,
// internal/web/accountmenu.go) -- every Workspace the identity belongs to that is not archived (the
// mockup's own account menu draws none archived, unlike the full Choose Workspace page's own
// expandable Archived section), the current one marked with a checkmark rather than a role pill
// the way the other rows are, and "Switch workspace →" to the full picker. WorkspaceChoice is
// chooseworkspace.templ's own type, reused as-is rather than declaring a second one for the
// identical shape.
templ AccountMenuWorkspaceRows(choices []WorkspaceChoice, currentWorkspaceID string) {
	<div class={ "px-3 pt-1 pb-1", textClass(ctx, domain.RoleEyebrow), weightClass(ctx, domain.WeightEmphasis), "tracking-wide", inkClass(ctx, domain.InkSecondary), "uppercase" }>Workspaces</div>
	for _, c := range choices {
		<a href="/switch-workspace" class={ "flex items-center", layoutGap(ctx, domain.GapTight), radiusClass(ctx, domain.RadiusControl), "px-3 py-2 " + textClass(ctx, domain.RoleBody) + " " + inkClass(ctx, domain.InkStrong), hoverWashClass(ctx) }>
			if c.ID == currentWorkspaceID {
				@icon("check", "size-3.5 shrink-0 " + inkClass(ctx, domain.InkAccent))
			} else {
				<span class="size-3.5 shrink-0"></span>
			}
			<span class="grow truncate">{ c.Name }</span>
			<span class={ "shrink-0", textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkSecondary) }>{ displayRole(c.Role) }</span>
		</a>
	}
	<a href="/switch-workspace" class={ "block px-3 py-2 text-xs", inkClass(ctx, domain.InkAccent) }>Switch workspace →</a>
}

// appLauncher is the 9-dot menu at the head of the bar (redesigned 2026-09-20, by owner request,
// from a flat list of every declared item to ui-sample/nav-chrome.js's own card shape). Three
// parts, top to bottom:
//
//  1. A header row -- "WORKSPACE" eyebrow + the Workspace's own name, linking to Workspace Home
//     (routeByID(ctx, "nav_home"), not the literal appShell's breadcrumb uses, since a missing
//     nav_home item should panic here exactly as it would for any other lookup) -- what nav_home
//     used to be as a flat item, promoted to the panel's own title, the same role it already
//     plays on Workspace Home itself (workspacehome.templ's "WORKSPACE" eyebrow + <h1>).
//  2. One entry per Application, in Workspace.Applications' own declaration order -- always a
//     single card (launcherAppCard): icon, name, description, linking straight to its HomeRoute.
//     The launcher's whole job is to get you *into* an Application; its screens are that
//     Application's own menu's problem.
//
//     Until 2026-09-21 an Application with ShowNav false (Document Approval) was the exception,
//     listing every one of its screens flat, "because the launcher is deliberately the only place
//     those screens stay reachable -- collapsing it to a card would orphan them". That premise is
//     gone: Document Approval has its own menu now, the strip across the top of its screens, which
//     projects its two declared navigation items (approvalinbox.templ's inboxTabs). Nothing is
//     orphaned by collapsing it, and the owner's own instruction for this panel is that it shows
//     links to the Applications in the Workspace -- not to their insides.
//
// "All Workspaces" at the very bottom is shown only when switchWorkspaceHref is non-empty (see
// appShell's own doc comment for who that excludes) -- routeByID would panic looking it up, since
// it names no declared navigation item at all, so the caller-supplied href stays a plain string
// exactly like ChooseWorkspacePage's own pre-auth links.
//
// A `popover` since 2026-09-24 (it was <details> before) -- see moreSheet for the reasoning and
// for what the old mechanism cost. pageShell's own details.nav-group dropdown is untouched: that
// stylesheet and that topbar are a separate system (capabilities.md, "Styling: two systems, on
// purpose"), and changing it here would be a port nobody asked for.
templ appLauncher(workspaceName, switchWorkspaceHref string, viewer Viewer, aboveBar bool) {
	<div class="shrink-0">
		<button
			type="button"
			popovertarget="menata-app-launcher"
			aria-label="Open app launcher"
			class={ "flex size-7 cursor-pointer items-center justify-center border-0 bg-transparent p-0", inkClass(ctx, domain.InkSecondary) }
		>
			@icon("grid", "size-4")
		</button>
		@sheetPanel("menata-app-launcher", aboveBar, "left") {
			<a href={ templ.SafeURL(routeByID(ctx, "nav_home")) } class={ "mb-1 flex flex-col", layoutGap(ctx, domain.GapHair), radiusClass(ctx, domain.RadiusControl), "p-3", hoverWashClass(ctx), "sm:p-2" }>
				<span class={ textClass(ctx, domain.RoleEyebrow), weightClass(ctx, domain.WeightEmphasis), "tracking-wide", inkClass(ctx, domain.InkAccent), "uppercase" }>Workspace</span>
				<span class={ textClass(ctx, domain.RoleBody), weightClass(ctx, domain.WeightEmphasis), inkClass(ctx, domain.InkStrong) }>{ workspaceName }</span>
			</a>
			for _, app := range viewer.Applications {
				@launcherAppCard(app)
			}
			// Administration (AppLauncher.dc.html, Flow 2 canvas re-audit -- ROADMAP.md,
			// 2026-09-27): the same two rows workspaceMenu already offers behind the Workspace
			// name, duplicated here because the board draws them in both dropdowns independently.
			// Gated identically -- an admin-only destination offered to a plain member is exactly
			// the code-review finding (2026-09-19) that emptied this launcher of Workspace-level
			// items in the first place; the fix here is additive, not a reversal of that gate.
			if viewer.WorkspaceRole != domain.WorkspaceRoleMember {
				<div class={ "my-1 h-px", borderFillClass(ctx, domain.BorderDivider) }></div>
				<div class={ "px-3 pt-1 pb-1", textClass(ctx, domain.RoleEyebrow), weightClass(ctx, domain.WeightEmphasis), "tracking-wide", inkClass(ctx, domain.InkSecondary), "uppercase sm:px-2" }>Administration</div>
				<a href={ templ.SafeURL(routeByID(ctx, "nav_workspace_settings")) } class={ "flex items-center", layoutGap(ctx, domain.GapDefault), radiusClass(ctx, domain.RadiusControl), "p-3 " + textClass(ctx, domain.RoleBody) + " " + inkClass(ctx, domain.InkStrong), hoverWashClass(ctx), "sm:p-2" }>
					<span class={ inkClass(ctx, domain.InkSecondary) }>
						@icon("settings", "size-4")
					</span>
					<span class="flex flex-col">
						{ labelByID(ctx, "nav_workspace_settings") }
						// Board 14's one-line hint under each Administration row. A hint is not the screen's own
						// `description:` (that is the subtitle on the screen itself, and says something else), and
						// no navigation key declares a menu hint -- the missing capability is 007 §12.3's ActionBar
						// (below). It names what the destination holds, so it moves with that screen.
						<span class={ textClass(ctx, domain.RoleMeta) + " " + inkClass(ctx, domain.InkSecondary), weightClass(ctx, domain.WeightBody) }>Members, applications, security</span>
					</span>
				</a>
				// METADATA CANNOT EXPRESS THIS YET, same exception workspaceMenu's own copy of
				// this link already carries (CLAUDE.md, "Deciding whether a literal is a
				// metadata-hardcoding violation" step 2): a Workspace-level action triggered from
				// chrome, not a menu destination any navigation list could declare. Missing
				// capability: 007 §12.3's ActionBar component, still unbuilt. Listed in
				// internal/conformance's applicationSubScreens and writing-guide.md's own "What
				// comes free vs. what's hardcoded today" table.
				<a href="/new-application" class={ "flex items-center", layoutGap(ctx, domain.GapDefault), radiusClass(ctx, domain.RadiusControl), "p-3 " + textClass(ctx, domain.RoleBody) + " " + inkClass(ctx, domain.InkStrong), hoverWashClass(ctx), "sm:p-2" }>
					<span class={ inkClass(ctx, domain.InkSecondary) }>
						@icon("sparkle", "size-4")
					</span>
					<span class="flex flex-col">
						New application
						<span class={ textClass(ctx, domain.RoleMeta) + " " + inkClass(ctx, domain.InkSecondary), weightClass(ctx, domain.WeightBody) }>Describe it, Menata builds a draft</span>
					</span>
				</a>
			}
			if switchWorkspaceHref != "" {
				<a href={ templ.SafeURL(switchWorkspaceHref) } data-leave-guard class={ "mt-1 block", radiusClass(ctx, domain.RadiusControl), "p-3 text-xs", weightClass(ctx, domain.WeightEmphasis), inkClass(ctx, domain.InkAccent), hoverWashClass(ctx), "sm:p-2" }>All Workspaces →</a>
			}
		}
	</div>
}

// launcherAppCard is one Application's face in the launcher -- ui-sample/nav-chrome.js's
// launcherPanelHTML row shape, reusing
// appIconClasses (workspacehome.templ) so an Application's icon tile matches its own Workspace
// Home card exactly.
templ launcherAppCard(app domain.Application) {
	<a href={ templ.SafeURL(launcherAppHomeRoute(ctx, app)) } class={ "flex items-start", layoutGap(ctx, domain.GapDefault), radiusClass(ctx, domain.RadiusControl), "p-2", hoverWashClass(ctx) }>
		<span class={ "flex size-8 shrink-0 items-center justify-center rounded-lg", appIconClasses(app.Color) }>
			@icon(app.Icon, "size-4.5")
		</span>
		<span class="flex min-w-0 flex-col">
			<span class={ textClass(ctx, domain.RoleBody), weightClass(ctx, domain.WeightEmphasis), inkClass(ctx, domain.InkStrong) }>{ app.Name }</span>
			if app.Description != "" {
				<span class={ textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkSecondary) }>{ app.Description }</span>
			}
		</span>
	</a>
}

// launcherLink was deleted on 2026-09-21 with its last caller (launcherAppGroup). The launcher
// lists Applications now, not their screens, so there is no per-screen row left to render.
//
// It carried the pending-approval badge (hx-get /api/approval-inbox/pending-count) on the Approval
// Inbox row. That badge is not lost -- pageShell's own navLink still renders it, from the same
// domain.NavBadgeApprovalInboxPending declaration -- but the launcher no longer shows one, because
// it no longer shows that screen. Putting a count on an Application *card* is a different feature
// (Workspace Home's cards already do it) and was not folded in here.

// activityFeedListRow / sectionHeaderRow are the Tailwind twins of machine.templ's activityFeedList /
// sectionHeader -- same data shape (ActivityEntry), different markup, for the same reason
// reviewdocument.templ's own reviewProgress is deliberately not approvalStepper even though both draw a
// []StepApprover: Preflight ties chrome to content (capabilities.md, "Styling: two systems, on purpose"), so a
// pageStyles class name (.activity-feed, .section-link) renders unstyled under appShell's app.css.
// The count strip these once shared with `summaryCountTiles` is a `page:` grid of Metrics now (K15 D4,
// 2026-10-11); the helper and its `SummaryItem` went with the last bespoke screen that called it.
// activityFeedListRow is the activity feed as a `Collection` whose item slot holds one entry row. It and
// `taskRowList` were structurally identical and are the two independent callers `Collection` arrived with.
templ activityFeedListRow(entries []ActivityEntry) {
	@collection(domain.GapTight, "", false, false, Truncation{}, "", "", activityItems(entries))
}

// activityItems fills the item slot, one composed component per entry. A plain Go helper rather than a templ
// block because building a `[]templ.Component` is a loop, and the slot takes values.
func activityItems(entries []ActivityEntry) []templ.Component {
	out := make([]templ.Component, 0, len(entries))
	for _, a := range entries {
		out = append(out, activityEntryRow(a))
	}
	return out
}

templ activityEntryRow(a ActivityEntry) {
	<span>{ a.Summary }</span>
	if a.Actor != "" {
		@statusBadge(a.Actor, domain.ToneNeutral, domain.BadgeCompact)
	}
	<span class={ "ml-auto", textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkSecondary) }>{ a.When }</span>
}

templ sectionHeaderRow(title, linkHref, linkLabel string) {
	<div class="flex items-center justify-between">
		@staticText(domain.StaticSubheading, title)
		if linkHref != "" {
			<a href={ templ.URL(linkHref) } class={ textClass(ctx, domain.RoleBody), inkClass(ctx, domain.InkAccent), accentHoverClass(ctx) }>{ linkLabel }</a>
		}
	</div>
}

// **slaBadgePill was deleted on 2026-10-03 and its four callers now take a resolved badge.** It took an
// `any`, parsed `"2006-01-02"` out of it and called `experience.EvaluateSLA(due, time.Now())` -- a renderer
// acquiring business data its contract does not represent (007 §12.3) and reading the clock, so identical
// input did not produce identical output (§4.6, a MUST: the same record rendered "1 day left" and then
// "OVERDUE" with nothing having changed). `experience.ResolveSLABadge` does it where `now` is an argument,
// and `machine.templ`'s `slaBadge` draws the result through the registered `statusBadge` Component.
//
// **That unified two renderings of one idea, and it changes what four screens draw.** This one gave overdue
// red *text* with no pill and everything else a slate pill a half-step tighter than `statusBadge`'s; overdue
// is now a red pill, which is what `domain.ToneBad` already meant everywhere else. Two markups for one
// semantic state is the same accident as `split`'s four aside widths, and a Component is where it stops.
