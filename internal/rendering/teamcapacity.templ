package rendering

import (
	"fmt"

	"menata.app/internal/data"
)

// MemberCapacity is one User's row on the Team Capacity page (ROADMAP.md Phase 14,
// project-team.html): their own record, declared weekly capacity, and how many Tasks currently
// assigned to them are still open -- all derived from already-fetched User/Task data, not a new
// aggregation mechanism.
//
// Name is resolved by composition from the identity behind the record (data.Store.MemberNames),
// not read off it: since 2026-09-22 a person's name is not a Field on mch_user at all. The record
// stays because the row still renders what *is* Workspace-scoped -- the declared weekly capacity.
type MemberCapacity struct {
	User        *data.Record
	Name        string
	ActiveCards int
	TotalCards  int
}

// TeamCapacityPage is Case 19's workload/ownership view: People, weekly capacity (declared on
// mch_user), and active Task counts, composed from existing Machines.
templ TeamCapacityPage(members []MemberCapacity, totalCapacity, totalActive int) {
	@pageShell(labelByID("nav_team_capacity")) {
		<h1>{ labelByID("nav_team_capacity") }</h1>
		<p>People, weekly capacity, and active work, composed from existing Member and Task data.</p>

		@summaryCounts([]SummaryItem{
			{Label: "Team capacity", Value: fmt.Sprint(totalCapacity) + "h/week"},
			{Label: "Active cards", Value: fmt.Sprint(totalActive)},
		})

		<table>
			<thead>
				<tr>
					<th>Member</th>
					<th>Weekly Capacity</th>
					<th>Active Cards</th>
					<th>Total Cards</th>
				</tr>
			</thead>
			<tbody>
				for _, m := range members {
					<tr>
						<td>{ m.Name }</td>
						<td>
							if cap, ok := m.User.Values["fld_weekly_capacity"]; ok && toString(cap) != "" {
								{ toString(cap) }h/week
							} else {
								<span class="muted">not set</span>
							}
						</td>
						<td>{ fmt.Sprint(m.ActiveCards) }</td>
						<td>{ fmt.Sprint(m.TotalCards) }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}
