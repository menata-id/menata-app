package rendering

// RegistrationPage is login.html's "Create a workspace" flow (ROADMAP.md Phase 21 Step 3):
// registration creates a new Workspace and its first member (that Workspace's Admin) in one step
// -- there is no path to a bare user account with nowhere to go. errorMsg is shown when a prior
// attempt failed; empty renders no message.
//
// Ported onto the shared authShell kit (Fase 1, 2026-09-20). ui-sample/case-03-flow1 has no
// registration board of its own, so this follows board 01's own control sizing and card shape
// rather than inventing a second visual language for the one screen the design skipped.
templ RegistrationPage(errorMsg string) {
	@authShell("Create a workspace", "Create a workspace", "This creates a new Workspace and makes you its Admin.") {
		@authCard("max-w-96") {
			<form method="POST" action="/register" class="flex flex-col gap-4.5 px-4 py-5 sm:p-6">
				@csrfHiddenInput()
				@authField("workspace_name", "workspace_name", "Workspace name", "text", "organization", true)
				@authField("fld_name", "fld_name", "Your name", "text", "name", false)
				@authField("fld_email", "fld_email", "Email", "email", "username", false)
				@authPasswordField("password", "password", "Password", "new-password", false)
				@authError(errorMsg)
				@authSubmit("Create workspace")
			</form>
		}
		@authFooterNote() {
			Already have a workspace? <a href="/login" class="text-blue-600 hover:text-blue-700">Sign in</a>
		}
	}
}
