package rendering

import "menata.app/internal/aiassist"
import "menata.app/internal/domain"

// ConversationView is one render of the AI Metadata Assistant's own conversation screen
// (NewApp.dc.html/M03c-NewApp.dc.html, Flow 2 gap study Tahap 8) -- built by internal/web from a
// stored data.AISession's own turns.
type ConversationView struct {
	SessionID     string
	Turns         []ConversationTurn
	ReadyToReview bool
	Summary       aiassist.GeneratedChange
	// PrefillIdea pre-fills the first message when this conversation has not started yet (Workspace
	// Home's own "Add an application" box/chips, Flow 2 canvas re-audit, ROADMAP.md, 2026-09-27) --
	// never set once len(Turns) > 0. The conversation form below auto-submits itself on load
	// whenever this is non-empty (owner reversal, 2026-09-27: the person typed or picked the idea
	// already on Workspace Home, so asking them to press Send again on the very next screen was
	// redundant), so in practice this both fills the box and starts the conversation.
	PrefillIdea string
}

// ConversationTurn is one message already resolved for display -- a user's own text, or the
// assistant's plain-language Message (never the raw structured JSON it was decoded from).
type ConversationTurn struct {
	FromUser      bool
	Message       string
	CapabilityGap string // set when this assistant turn named one, shown as a small inline note
}

// NewApplicationPage is the conversation screen itself: a chat log and a live "What will be
// built" summary, updated from the session's own latest valid proposal once one exists.
//
// Scope, stated once: this is a plain form POST + redirect per message
// (internal/web.postNewApplicationMessage), not an htmx fragment swap -- there is no chat-log
// precedent anywhere else in this app to extend, and a full round trip per message is an honest
// simplification for a screen used rarely and deliberately.
templ NewApplicationPage(view ConversationView, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	@appShell("New application", workspaceName, viewer, switchWorkspaceHref) {
		<a href={ templ.SafeURL(routeByID(ctx, "nav_home")) } class={ "text-xs", inkClass(ctx, domain.InkAccent), accentHoverClass(ctx) }>← { titleByID(ctx, "nav_home") }</a>
		<div class={ "flex flex-col", layoutGap(ctx, domain.GapTight) }>
			@staticText(domain.StaticOverline, "Step 1 of 2")
			@staticText(domain.StaticHeading, "New application")
			<div class={ textClass(ctx, domain.RoleBody), inkClass(ctx, domain.InkSecondary) }>Tell Menata what your team needs. It asks a few questions, shows what it will build, then generates a draft only you can see.</div>
		</div>
		@splitLayout(domain.GapLoose, domain.SplitAsideEnd, domain.AsideWide) {
			<section aria-label="Conversation" class={ "flex min-h-96 flex-col", layoutGap(ctx, domain.GapComfortable), surfaceClasses(ctx), paddingClass(ctx, domain.PaddingSection) }>
				if len(view.Turns) == 0 {
					@staticText(domain.StaticMessage, "What should this application do? Describe it the way you would explain it to a new colleague.")
				}
				for _, t := range view.Turns {
					@conversationBubble(t)
				}
				<div class={ "mt-auto flex flex-col", layoutGap(ctx, domain.GapTight), "border-t " + borderClass(ctx, domain.BorderDivider) + " pt-4" }>
					// Auto-submits itself when #msg already holds a value on load -- true only for a
					// PrefillIdea'd first message (see that field's own doc comment), never for a
					// redirect back into an existing conversation, since that always renders #msg
					// empty. Client-side rather than server-side so showNewApplication's GET keeps
					// performing no write of its own (internal/conformance's "GET never writes"
					// discipline) -- the Gemini call still only ever happens from
					// postNewApplicationMessage's POST, just triggered by the browser instead of a
					// click.
					//
					// "on submit" is this screen's only feedback for the wait that follows: a plain
					// form POST (this templ's own doc comment above explains why -- no htmx fragment
					// swap), so the browser shows nothing of its own beyond a tab spinner until the
					// next full page arrives. Gemini's reply time is real, not instant -- a
					// schema-constrained call has taken up to a minute in production -- so disabling
					// the button and revealing #thinking-note (below) is what tells the person
					// something is happening rather than the screen looking frozen or broken.
					//
					// #msg itself gets @readonly, never @disabled: a disabled control is dropped from
					// the form's own submission entirely (the browser excludes it from the request it
					// is already mid-way through sending), which would post an empty "message" and
					// hit postNewApplicationMessage's own 422. readonly blocks editing the same way
					// without that.
					<form
						method="post"
						action="/new-application/message"
						class={ "flex", layoutGap(ctx, domain.GapTight) }
						_="on submit add @disabled to #send-btn then add @readonly to #msg then set #send-btn's textContent to 'Sending…' then remove .hidden from #thinking-note
						   on load if #msg's value is not '' then call me.requestSubmit()"
					>
						@csrfHiddenInput()
						<input type="hidden" name="session" value={ view.SessionID }/>
						<label for="msg" class="sr-only">Your answer</label>
						<input id="msg" type="text" name="message" required value={ view.PrefillIdea } placeholder="Type your answer…" class={ fieldClasses(ctx) + " grow" }/>
						<button id="send-btn" type="submit" class={ buttonClasses(ctx, domain.ButtonPrimary) }>Send</button>
					</form>
					<p id="thinking-note" class={ "hidden m-0", textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkSecondary) }>Menata is thinking — this can take up to a minute.</p>
				</div>
			</section>
			<aside aria-label="What will be built" class={ "flex flex-col", layoutGap(ctx, domain.GapComfortable), surfaceClasses(ctx), paddingClass(ctx, domain.PaddingPanel) }>
				<div class={ "flex flex-col", layoutGap(ctx, domain.GapMicro) }>
					@staticText(domain.StaticPanelHeading, "What will be built")
					<span class={ textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkSecondary) }>Updated as you answer.</span>
				</div>
				if !view.ReadyToReview {
					@staticText(domain.StaticNote, "Nothing to show yet -- keep answering.")
				} else {
					@changeSummary(view.Summary)
					<a href={ templ.SafeURL("/new-application/" + view.SessionID + "/review") } class={ buttonClasses(ctx, domain.ButtonPrimary) + " justify-center" }>
						Review →
					</a>
				}
				if view.SessionID != "" {
					<form method="post" action={ templ.SafeURL("/new-application/" + view.SessionID + "/discard") }>
						@csrfHiddenInput()
						<button type="submit" class={ "cursor-pointer text-xs", inkClass(ctx, domain.InkSecondary), toneInkHoverClass(ctx, domain.ToneBad) }>Discard this conversation</button>
					</form>
				}
			</aside>
		}
	}
}

templ conversationBubble(t ConversationTurn) {
	if t.FromUser {
		<div class="flex justify-end">
			<div class={ "max-w-md rounded-lg", toneFillClass(ctx, domain.ToneInfo), "px-3.5 py-2.5", textClass(ctx, domain.RoleBody) }>{ t.Message }</div>
		</div>
	} else {
		<div class="flex flex-col gap-1.5">
			<div class={ "max-w-md rounded-lg", backgroundClass(ctx, domain.BackgroundBase), "px-3.5 py-2.5", textClass(ctx, domain.RoleBody) }>{ t.Message }</div>
			if t.CapabilityGap != "" {
				<span class={ textClass(ctx, domain.RoleCaption), toneInkClass(ctx, domain.ToneWarn) }>Noted for later: "{ t.CapabilityGap }" isn't something Menata can build yet.</span>
			}
		</div>
	}
}

// changeSummary is the "What will be built" panel's own body, shared between the conversation
// screen's live preview and (in a fuller form) the review screen.
templ changeSummary(change aiassist.GeneratedChange) {
	if change.Kind == aiassist.KindNewApplication && change.Application != nil {
		{{ app := change.Application }}
		<div class={ "flex flex-col", layoutGap(ctx, domain.GapDefault), textClass(ctx, domain.RoleBody) }>
			<div class={ "flex flex-col", layoutGap(ctx, domain.GapMicro) }>
				<span class={ textClass(ctx, domain.RoleEyebrow), inkClass(ctx, domain.InkSecondary), "uppercase" }>Name</span>
				<span>{ app.Name }</span>
			</div>
			if app.Description != "" {
				<div class={ "flex flex-col", layoutGap(ctx, domain.GapMicro) }>
					<span class={ textClass(ctx, domain.RoleEyebrow), inkClass(ctx, domain.InkSecondary), "uppercase" }>What it does</span>
					<span class={ inkClass(ctx, domain.InkBody) }>{ app.Description }</span>
				</div>
			}
			<div class={ "flex flex-col", layoutGap(ctx, domain.GapMicro) }>
				<span class={ textClass(ctx, domain.RoleEyebrow), inkClass(ctx, domain.InkSecondary), "uppercase" }>Data it keeps</span>
				@rowLayout(domain.GapTight, domain.RowAlignStretch, domain.RowJustifyStart) {
					for _, m := range app.Machines {
						@statusBadge(m.Name, domain.ToneNeutral, domain.BadgeRegular)
					}
				}
			</div>
			if len(app.Navigation) > 0 {
				<div class={ "flex flex-col", layoutGap(ctx, domain.GapMicro) }>
					<span class={ textClass(ctx, domain.RoleEyebrow), inkClass(ctx, domain.InkSecondary), "uppercase" }>Menu</span>
					<ol class={ "m-0 flex flex-col", layoutGap(ctx, domain.GapHair), "pl-4 " + inkClass(ctx, domain.InkBody) }>
						for _, item := range app.Navigation {
							<li>{ item.Label }</li>
						}
					</ol>
				</div>
			}
			if len(app.Roles) > 0 {
				<div class={ "flex flex-col", layoutGap(ctx, domain.GapMicro) }>
					<span class={ textClass(ctx, domain.RoleEyebrow), inkClass(ctx, domain.InkSecondary), "uppercase" }>Roles</span>
					@rowLayout(domain.GapTight, domain.RowAlignStretch, domain.RowJustifyStart) {
						for _, r := range app.Roles {
							@statusBadge(r, domain.ToneNeutral, domain.BadgeRegular)
						}
					}
				</div>
			}
		</div>
	} else if change.Kind == aiassist.KindUpdateApplication && change.Application != nil {
		<div class={ "flex flex-col", layoutGap(ctx, domain.GapMicro), textClass(ctx, domain.RoleBody) }>
			<span class={ textClass(ctx, domain.RoleEyebrow), inkClass(ctx, domain.InkSecondary), "uppercase" }>Updates</span>
			<span>{ change.Application.Name }</span>
		</div>
	}
}

// planOpLabel is the heading a plan item is grouped under on the review page.
func planOpLabel(op string) string {
	switch op {
	case "add":
		return "Added"
	case "remove":
		return "Removed"
	default:
		return "Changed"
	}
}

// planItemsFor is the plan's items for one op, in plan order.
func planItemsFor(plan aiassist.Plan, op string) []aiassist.PlanItem {
	var out []aiassist.PlanItem
	for _, item := range plan.Items {
		if item.Op == op {
			out = append(out, item)
		}
	}
	return out
}

// publishFormID ties a plan item's confirmation checkbox, which sits in the plan, to the publish form in the
// aside: a checkbox outside a <form> is submitted by naming it with the form attribute.
const publishFormID = "publish-application"

// updatePlan is an update's review: what it adds, changes and removes, computed by
// aiassist.PlanUpdate from the installed Application and the one the conversation proposes -- the
// same plan the writer recomputes before it touches a file.
templ updatePlan(plan aiassist.Plan) {
	<div class={ "flex flex-col", layoutGap(ctx, domain.GapComfortable), textClass(ctx, domain.RoleBody) }>
		for _, op := range []string{"add", "change", "remove"} {
			if items := planItemsFor(plan, op); len(items) > 0 {
				<div class={ "flex flex-col", layoutGap(ctx, domain.GapMicro) }>
					<span class={ textClass(ctx, domain.RoleEyebrow), inkClass(ctx, domain.InkSecondary), "uppercase" }>{ planOpLabel(op) }</span>
					<ul class={ "m-0 flex flex-col", layoutGap(ctx, domain.GapMicro), "pl-4 " + inkClass(ctx, domain.InkBody) }>
						for _, item := range items {
							<li>
								{ item.What }
								if item.Confirm != "" {
									<label class={ "mt-1 flex items-center", layoutGap(ctx, domain.GapTight), textClass(ctx, domain.RoleMeta) + " " + inkClass(ctx, domain.InkBody) }>
										<input type="checkbox" name="confirm_remove" value={ item.Confirm } form={ publishFormID } class={ controlAccentClass(ctx) }/>
										Remove it from the Application. Values already stored in records are kept, unseen.
									</label>
								}
							</li>
						}
					</ul>
				</div>
			}
		}
	</div>
}

// GeneratedFilesView is the YAML a change would write, as aiassist.Preview produced it: the files with their diffs,
// or -- when the writer refused the change -- the reason. Both empty means no preview was available (a process with no
// metadata directory), and the panel is not drawn.
type GeneratedFilesView struct {
	Files  []FileDiffView
	Reason string
}

templ generatedFiles(v GeneratedFilesView) {
	if len(v.Files) > 0 || v.Reason != "" {
		<div class={ "flex flex-col", layoutGap(ctx, domain.GapDefault) }>
			@staticText(domain.StaticPanelHeading, "The files this would write")
			if v.Reason != "" {
				@staticText(domain.StaticNote, "The files could not be previewed: " + v.Reason)
			}
			@fileDiffList(v.Files)
		</div>
	}
}

// NewApplicationReviewPage is NewAppReview.dc.html's shape: what will be built, and -- for
// new_application only, the mockup's own scope -- who gets access before publishing. An
// update_application review shows its plan instead: what is added, changed and removed.
templ NewApplicationReviewPage(change aiassist.GeneratedChange, plan aiassist.Plan, files GeneratedFilesView, sessionID, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	@appShell("Review new application", workspaceName, viewer, switchWorkspaceHref) {
		<a href={ templ.SafeURL("/new-application?session=" + sessionID) } class={ "text-xs", inkClass(ctx, domain.InkAccent), accentHoverClass(ctx) }>← Back to conversation</a>
		<div class={ "flex flex-col", layoutGap(ctx, domain.GapTight) }>
			@staticText(domain.StaticOverline, "Step 2 of 2")
			@rowLayout(domain.GapTight, domain.RowAlignStretch, domain.RowJustifyStart) {
				@statusBadge("Draft", domain.ToneWarn, domain.BadgeRegular)
			}
			if change.Kind == aiassist.KindNewApplication && change.Application != nil {
				@staticText(domain.StaticHeading, change.Application.Name)
			} else {
				@staticText(domain.StaticHeading, "Update " + change.TargetAppID)
			}
			<div class={ textClass(ctx, domain.RoleBody), inkClass(ctx, domain.InkSecondary) }>Look it over before it becomes real. Generating does not publish anything by itself.</div>
		</div>
		@splitLayout(domain.GapLoose, domain.SplitAsideEnd, domain.AsideWide) {
			@panelLayout(domain.PanelRegular) {
				if change.Kind == aiassist.KindUpdateApplication {
					@updatePlan(plan)
				} else {
					@changeSummary(change)
				}
				@generatedFiles(files)
			}
			<aside class={ "flex flex-col", layoutGap(ctx, domain.GapDefault), surfaceClasses(ctx), paddingClass(ctx, domain.PaddingPanel) }>
				@staticText(domain.StaticPanelHeading, "Before you publish")
				if change.Kind == aiassist.KindNewApplication && change.Application != nil && change.Application.PublisherRole != "" {
					<p class={ "m-0", textClass(ctx, domain.RoleMeta), inkClass(ctx, domain.InkSecondary) }>You'll hold the "{ change.Application.PublisherRole }" role in it once published, so you can open it right away. Access for everyone else is a Settings change, made after publishing, not part of this step.</p>
				} else if change.Kind == aiassist.KindNewApplication {
					@staticText(domain.StaticNote, "This application declares no roles, so nothing gates who can open it. Access for everyone is a Settings change, made after publishing, not part of this step.")
				} else {
					@staticText(domain.StaticNote, "Nothing that holds records is removed: machines, fields, options, roles and permissions can only be added or relabelled. Who holds which role does not change.")
				}
				<form id={ publishFormID } method="post" action={ templ.SafeURL("/new-application/" + sessionID + "/publish") } class={ "flex flex-col", layoutGap(ctx, domain.GapTight) }>
					@csrfHiddenInput()
					@button("Publish to workspace", domain.ButtonPrimary, "", "")
				</form>
				// The draft is already stored (Home lists it as a row), so this is a way out that says so, not
				// a save: it only leaves.
				<a href={ templ.SafeURL(routeByID(ctx, "nav_home")) } class={ tileClasses(ctx), "inline-flex h-9 items-center justify-center " + backgroundClass(ctx, domain.BackgroundRaised) + " px-4 " + textClass(ctx, domain.RoleBody) + " " + inkClass(ctx, domain.InkStrong), hoverWashClass(ctx) }>Keep as draft</a>
				<form method="post" action={ templ.SafeURL("/new-application/" + sessionID + "/discard") }>
					@csrfHiddenInput()
					<button type="submit" class={ "cursor-pointer text-xs", inkClass(ctx, domain.InkSecondary), toneInkHoverClass(ctx, domain.ToneBad) }>
						if change.Kind == aiassist.KindNewApplication {
							Discard application
						} else {
							Discard
						}
					</button>
				</form>
			</aside>
		}
	}
}
