package rendering

import (
	"fmt"
	"strconv"

	"menata.app/internal/domain"
)

// progressRow is the registered renderer for `domain.ComponentProgress`: a label, a bar filled to value out of
// max, and the same two numbers in words beside it -- a percentage-only bar tells a screen-reader user nothing
// about how many. The numbers arrive resolved; this computes only the fill, and a max of zero is an empty bar.
templ progressRow(label, value, max string) {
	{{ pct := progressShare(value, max) }}
	// w-full: inside a Collection item (itself a wrapping flex row) a wrapper only as wide as its content leaves
	// the bar's `grow` nothing to fill, and the bar drew 0px wide.
	<div class="w-full">
	@rowLayout(domain.GapComfortable, domain.RowAlignCenter, domain.RowJustifyStart) {
		<span class={ "w-24 shrink-0 truncate", textClass(ctx, domain.RoleBody) } title={ label }>{ label }</span>
		<div
			role="progressbar"
			aria-label={ label }
			aria-valuenow={ fmt.Sprint(pct) }
			aria-valuemin="0"
			aria-valuemax="100"
			aria-valuetext={ value + " of " + max }
			class={ "h-2 grow overflow-hidden rounded-full", backgroundClass(ctx, domain.BackgroundSunken) }
		>
			<div class={ "h-full rounded-full", markGoodFill() } style={ fmt.Sprintf("width:%d%%", pct) }></div>
		</div>
		<span class={ "w-16 shrink-0 text-right", textClass(ctx, domain.RoleMeta), "whitespace-nowrap", inkClass(ctx, domain.InkSecondary) }>{ value + " of " + max }</span>
	}
	</div>
}

// progressShare is value as a whole percentage of max, clamped to 0..100; anything unparseable, or a max of zero,
// is 0 -- an empty bar is the honest picture of "nothing out of nothing".
func progressShare(value, max string) int {
	v, errV := strconv.ParseFloat(value, 64)
	m, errM := strconv.ParseFloat(max, 64)
	if errV != nil || errM != nil || m <= 0 || v <= 0 {
		return 0
	}
	if v >= m {
		return 100
	}
	return int(v * 100 / m)
}
