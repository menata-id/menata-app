package rendering

import "menata.app/internal/data"

// BoardSettingsPage is Case 19's board-configuration hub (ROADMAP.md Phase 14,
// project-settings.html): a read-only preview of the two catalogs every board shares -- Lists
// (a board's ordered statuses) and Labels -- each linking to its own already-built generic
// Machine page for the actual create/rename/reorder/delete. This is pure composition of what
// Phases 3-10 already built, not a new settings mechanism: mch_list and mch_label are ordinary
// Machines, so their own table page already is board settings.
templ BoardSettingsPage(lists []*data.Record, labels []*data.Record, workspaceName string, viewer Viewer, switchWorkspaceHref string) {
	@appShell(labelByID("nav_board_settings"), workspaceName, viewer, switchWorkspaceHref) {
		<div class="flex flex-col gap-2">
			<span class="text-3xs tracking-wide text-blue-600 uppercase">Project Management</span>
			<h1 class="m-0 text-xl font-medium">{ labelByID("nav_board_settings") }</h1>
			<div class="text-sm text-slate-500">Lists (statuses) and labels shared across every Project's board.</div>
		</div>
		<section class="rounded-lg border border-slate-200 bg-white p-4">
			<h2 class="m-0 mb-3 text-base font-medium">Lists &amp; Statuses</h2>
			if len(lists) == 0 {
				<p class="text-sm text-slate-500">No lists yet.</p>
			} else {
				<ol class="flex flex-col gap-1.5 text-sm">
					for _, l := range lists {
						<li>{ toString(l.Values["fld_name"]) }</li>
					}
				</ol>
			}
			<a href="/machines/mch_list" class="mt-3 inline-block text-sm text-blue-600 hover:text-blue-700">Manage lists →</a>
		</section>
		<section class="rounded-lg border border-slate-200 bg-white p-4">
			<h2 class="m-0 mb-3 text-base font-medium">Labels</h2>
			if len(labels) == 0 {
				<p class="text-sm text-slate-500">No labels yet.</p>
			} else {
				<div class="flex flex-wrap gap-2">
					for _, l := range labels {
						<span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs text-slate-600">{ toString(l.Values["fld_name"]) } ({ toString(l.Values["fld_color"]) })</span>
					}
				</div>
			}
			<a href="/machines/mch_label" class="mt-3 inline-block text-sm text-blue-600 hover:text-blue-700">Manage labels →</a>
		</section>
	}
}
