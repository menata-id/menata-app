# Use a dedicated role scoped to menataapp, not the shared "postgres" superuser -- on a shared
# host, that role is cluster-wide, so changing its password here breaks every other app on the
# host.
DATABASE_URL=postgres://menataapp_owner:CHANGE_ME@localhost:5432/menataapp?sslmode=disable
PORT=4000
METADATA_PATH=metadata/workspaces

# Phase 2 (ROADMAP.md): one shared admin credential, no per-user login yet. All three are
# required -- the process refuses to start without them, there is no safe default for a credential.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME

# Phase 7 (ROADMAP.md): the mch_user record the shared admin credential resolves to. Bootstrap
# order: log in with the shared credential above (works even with zero mch_user records), create
# the first mch_user through the app, then set this to its id and restart. Defaults to the
# placeholder "admin" until set.
ADMIN_USER_ID=

# false only for local http://localhost dev -- a Secure cookie sent over plain http is silently
# dropped by the browser, which breaks login. Production (HTTPS, menata.app) must stay true.
SECURE_COOKIES=true

# Phase 11 (ROADMAP.md): local-disk root for uploaded files. Relative paths resolve against the
# process's working directory.
UPLOADS_DIR=uploads

# AI Metadata Assistant (Tahap 8, ROADMAP.md): powers "New application" at /new-application.
# Unset leaves the feature visibly disabled (a clear 503, not a hidden entry point -- see
# internal/web/newapplication.go's own doc comment) rather than refusing to start, since this
# capability is optional. Which Gemini model this key calls is NOT configured here -- it's a
# one-line Go constant, internal/aiassist/gemini.go's own geminiModel (gemini-3.5-flash-lite as of
# 2026-09-27 -- gemini-2.5-flash-lite lasted under an hour before Google's API refused it outright,
# see that file's own doc comment) -- so check that file for the current model, not this one.
GEMINI_API_KEY=

# Peers allowed to tell the app the real client address via X-Forwarded-For (rate limiting).
# Default is loopback, where the local Caddy connects from. Comma-separated IPs or CIDRs.
# TRUSTED_PROXIES=127.0.0.1,::1

# Where a Workspace's installation is snapshotted before an install or assistant publish rewrites it
# (last 20 per Workspace). Empty disables snapshots.
# BACKUP_DIR=backups/metadata
